DATABASE_URL=postgresql://127.0.0.1:5432/your-database-name
PAYLOAD_SECRET=YOUR_SECRET_HERE

# S3 Custom CDN Configuration (Optional)
S3_BUCKET=quadem-cdn
S3_ACCESS_KEY_ID=your_access_key
S3_SECRET_ACCESS_KEY=your_secret_key
S3_REGION=auto
S3_ENDPOINT=https://your-cloudflare-account-id.r2.cloudflarestorage.com

# Bloom (hero mockup generation) — see https://www.trybloom.ai/docs/api
BLOOM_API_KEY=bloom_sk_your_key_here
BLOOM_API_URL=https://www.trybloom.ai/api/v1
BLOOM_BRAND_SESSION_ID=your_brand_session_uuid
