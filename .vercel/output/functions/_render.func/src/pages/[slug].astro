---
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";

export async function getStaticPaths() {
  const pages = await sanityClient.fetch(`*[_type == "page" && defined(slug.current)]`);
  
  return pages.map((page: any) => {
    return {
      params: { slug: page.slug.current },
      props: { page },
    };
  });
}

const { page } = Astro.props;
const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{page.title} | Quadem Digital</title>
    {page.seoDescription && <meta name="description" content={page.seoDescription}>}
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
    <style>
        .page-hero {
            padding-top: 150px;
            padding-bottom: 60px;
            text-align: center;
            background: radial-gradient(circle at top, rgba(0, 174, 239, 0.1), transparent 50%);
        }
        .text-block-section {
            max-width: 800px;
            margin: 0 auto;
        }
        .text-block-section h2 {
            margin-bottom: 24px;
            color: var(--text-color);
        }
        .text-block-content {
            color: var(--text-muted);
            line-height: 1.8;
            font-size: 1.1rem;
        }
    </style>
</head>
<body>
    <header class="navbar scrolled" id="navbar">
        <div class="container navbar-container">
            <a href="/" class="logo active-logo">
                <img src="/images/logo.png" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
            </a>
            
            <nav class="nav-links">
                <a href="/services">Services</a>
                <a href="/projects">Projects</a>
                <a href="/about">About</a>
                <a href="/contact">Contact</a>
            </nav>
            
            <div class="nav-cta">
                <a href="/contact" class="btn btn-primary btn-pill">Book a Call</a>
            </div>
            
            <button class="mobile-menu-btn" aria-label="Toggle menu">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>

    <div class="mobile-menu-drawer">
        <nav class="mobile-nav-links">
            <a href="/services">Services</a>
            <a href="/projects">Projects</a>
            <a href="/about">About</a>
            <a href="/contact">Contact</a>
            <a href="/contact" class="btn btn-primary btn-pill mt-4">Book a Call</a>
        </nav>
    </div>

    <!-- Dynamic Page Builder Renderer -->
    <main style="min-height: 60vh;">
        {page.pageBuilder && page.pageBuilder.length > 0 ? (
            page.pageBuilder.map((block: any) => {
                
                // 1. Hero Section
                if (block._type === 'heroSection') {
                    return (
                        <section class="page-hero">
                            <div class="container">
                                <h1><span class="text-gradient">{block.heading || page.title}</span></h1>
                                {block.subheading && <p class="hero-subtitle">{block.subheading}</p>}
                            </div>
                        </section>
                    );
                }
                
                // 2. Text Block
                if (block._type === 'textBlock') {
                    return (
                        <section class="section-padding">
                            <div class="container text-block-section">
                                {block.heading && <h2>{block.heading}</h2>}
                                {block.content && (
                                    <div class="text-block-content">
                                        <PortableText value={block.content} />
                                    </div>
                                )}
                            </div>
                        </section>
                    );
                }

                // 3. Contact Form Section
                if (block._type === 'contactFormSection') {
                    return (
                        <section class="contact section-padding" id="contact">
                            <div class="container">
                                <div class="section-header animate-on-scroll slide-up">
                                    <h2><span class="text-gradient">{block.heading || "Let's build something great"}</span></h2>
                                    <p>{block.subheading || "Fill out the form below or chat directly with us on WhatsApp to get started."}</p>
                                </div>
                                <div class="contact-grid">
                                    <div class="contact-info animate-on-scroll slide-right">
                                        <h3 class="contact-subtitle">Get in Touch</h3>
                                        <p class="contact-text">We're ready to help you scale your business. Reach out today and let's start the conversation.</p>
                                        <a href="https://wa.me/1234567890?text=Hi%20Quadem%20Digital!%20I'd%20like%20to%20discuss%20a%20project." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect mb-4 w-100">
                                            Chat on WhatsApp
                                        </a>
                                        <a href="mailto:hello@quademdigital.com" class="contact-email">hello@quademdigital.com</a>
                                    </div>
                                    <div class="contact-form-container animate-on-scroll slide-left delay-200">
                                        <form class="contact-form">
                                            <div class="form-group">
                                                <label for="name">Name</label>
                                                <input type="text" id="name" required placeholder="John Doe">
                                            </div>
                                            <div class="form-group">
                                                <label for="email">Email</label>
                                                <input type="email" id="email" required placeholder="john@example.com">
                                            </div>
                                            <div class="form-group">
                                                <label for="message">Message</label>
                                                <textarea id="message" rows="4" required placeholder="Tell us about your project..."></textarea>
                                            </div>
                                            <button type="submit" class="btn btn-ghost btn-pill w-100">Send Message</button>
                                        </form>
                                    </div>
                                </div>
                            </div>
                        </section>
                    );
                }
                
                return null;
            })
        ) : (
            // Fallback if no blocks are defined
            <section class="page-hero">
                <div class="container">
                    <h1><span class="text-gradient">{page.title}</span></h1>
                    <p class="hero-subtitle">Page content coming soon.</p>
                </div>
            </section>
        )}
    </main>

    <footer class="footer" style="margin-top: 40px; border-top: 1px solid var(--border-color);">
        <div class="container footer-container">
            <div class="footer-col">
                <a href="/" class="logo footer-logo active-logo">
                    <img src="/images/logo.png" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                    <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
                </a>
                <p class="footer-tagline">{siteSettings?.footerTagline || "Elevating brands with premium design and data-driven strategies."}</p>
            </div>
            
            <div class="footer-col">
                <h4>Quick Links</h4>
                <nav class="footer-nav">
                    <a href="/services">Services</a>
                    <a href="/projects">Projects</a>
                    <a href="/about">About</a>
                    <a href="/contact">Contact</a>
                </nav>
            </div>
            
            <div class="footer-col footer-bottom">
                <p class="copyright">&copy; 2026 Quadem Digital Enterprise. All rights reserved.</p>
                <a href="#" class="back-to-top">Back to top ↑</a>
            </div>
        </div>
    </footer>

    <script is:inline src="/js/main.js"></script>
</body>
</html>
