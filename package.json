{
  "name": "temp_astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "prebuild": "node scripts/optimize-images.mjs && node scripts/check-markets.mjs",
    "build": "astro build",
    "optimize-images": "node scripts/optimize-images.mjs",
    "ping-indexnow": "node scripts/indexnow.js",
    "preview": "astro preview",
    "astro": "astro",
    "postinstall": "pnpm rebuild sharp || true",
    "check:theme": "node scripts/check-theme-literals.mjs",
    "check:price-cards": "node scripts/check-price-cards.mjs",
    "tokenize:theme": "node scripts/tokenize-theme-literals.mjs",
    "check:copy": "node scripts/check-em-dashes.mjs",
    "check:handoff": "node scripts/check-handoff.mjs",
    "check:blog": "node scripts/check-blog-routes.mjs",
    "check:global": "node scripts/check-global-exclusions.mjs",
    "charts:analysis": "node scripts/build-analysis-charts.mjs",
    "check:images": "node scripts/image-weight.mjs",
    "check:csp": "node scripts/check-csp.mjs",
    "optimize:video": "node scripts/optimize-video.mjs",
    "fix:images": "node scripts/image-weight.mjs --fix",
    "check:cdn": "node scripts/check-cdn.mjs",
    "check:booking": "node scripts/check-booking-links.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:markets": "node scripts/check-markets.mjs",
    "check:all": "npm run check:markets && npm run check:price-cards && npm run check:copy && npm run check:csp && npm run check:booking && npm run check:migrations && npm run check:theme && npm run check:blog && npm run check:global"
  },
  "dependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^5.0.7",
    "@astrojs/rss": "^4.0.18",
    "@astrojs/vercel": "^10.0.8",
    "@fontsource-variable/bricolage-grotesque": "^5.2.10",
    "@fontsource/inter": "^5.2.8",
    "@fontsource/space-grotesk": "^5.2.10",
    "@portabletext/react": "^6.2.0",
    "astro": "^6.4.2",
    "docx": "^9.7.1",
    "framer-motion": "^12.40.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "resend": "^6.12.4",
    "sharp": "0.34.2",
    "typescript": "^5.9.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "sharp",
      "esbuild",
      "unrs-resolver"
    ]
  }
}
