---
import { payloadFetchGlobal } from "../lib/payload";
import { ClientRouter } from "astro:transitions";
import '@fontsource/inter/400.css';
import '@fontsource/inter/500.css';
import '@fontsource/space-grotesk/500.css';
import '@fontsource/space-grotesk/600.css';
import '@fontsource/space-grotesk/700.css';
import '@fontsource-variable/bricolage-grotesque/wght.css';
import '../styles/style.css';
import '../styles/animations.css';

interface Props {
    title: string;
    description?: string;
    activePage?: string;
    navbarScrolled?: boolean;
    ogImage?: string;
    jsonLd?: any;
}

const { title, description = "Quadem Digital Enterprise is a full-service digital agency offering web design, digital marketing, branding, AI video and reels, and SEO services.", activePage = "", navbarScrolled = false, ogImage = "/images/og-card.png", jsonLd } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
// Open Graph requires an absolute URL; WhatsApp, LinkedIn and Facebook all
// enforce it, so a relative path renders link previews with no image at all.
// new URL() is a no-op on values that are already absolute (CMS cover images).
const ogImageURL = new URL(ogImage, Astro.site ?? Astro.url).href;
// Declared dimensions let a crawler lay out the preview before it finishes
// downloading the image, and LinkedIn in particular is happier with them. Only
// safe for the built-in card: blog and project pages pass CMS cover images
// whose size we don't know here, and a wrong width is worse than none.
const isDefaultOgImage = ogImage === "/images/og-card.png";

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";
const socialLinks = siteSettings?.socialLinks || [];
const getSocialLink = (platform: string) => socialLinks.find((l: any) => l.platform === platform)?.url;
const defaultNavLinks = [
    { label: 'Services', url: '/services/' },
    { label: 'Projects', url: '/projects/' },
    { label: 'QuadERP', url: 'https://quaderp.app' },
    { label: 'Blog', url: '/blog/' },
    { label: 'About', url: '/about/' },
    { label: 'Offers', url: '/offers/' },
    { label: 'Contact', url: '/contact/' }
];
// Filter out invalid CMS entries (e.g. items with only _key but no label/url)
const cmsNavLinks = (siteSettings?.navLinks || []).filter((link: any) => link.label && link.url);
const rawNavLinks = cmsNavLinks.length > 0 ? cmsNavLinks : defaultNavLinks;
// Ensure QuadERP link is always present
const hasQuadERP = rawNavLinks.some((link: any) => (link.url || '').includes('store-manager') || (link.url || '').includes('quaderp.app'));
let navLinks = hasQuadERP ? rawNavLinks : [
    ...rawNavLinks.slice(0, 2),
    { label: 'QuadERP', url: 'https://quaderp.app' },
    ...rawNavLinks.slice(2)
];
// Ensure Offers link is always present (inject just before Contact if missing)
const hasOffers = navLinks.some((link: any) => (link.url || '').includes('/offers'));
if (!hasOffers) {
    const contactIdx = navLinks.findIndex((link: any) => (link.url || '').includes('/contact'));
    const insertAt = contactIdx >= 0 ? contactIdx : navLinks.length;
    navLinks = [
        ...navLinks.slice(0, insertAt),
        { label: 'Offers', url: '/offers/' },
        ...navLinks.slice(insertAt)
    ];
}

// Enforce trailing slashes on all local nav links for SEO
navLinks = navLinks.map((link: any) => {
    if (link.url && link.url.startsWith('/') && !link.url.endsWith('/')) {
        return { ...link, url: `${link.url}/` };
    }
    return link;
});

const footerLinks = siteSettings?.footerLinks || navLinks;
---
<!DOCTYPE html>
<html lang="en">
<head>
    {/* Theme bootstrap. Must be the first script in <head> and must stay inline
         and blocking: it runs before the stylesheet paints, so a light-mode
         visitor never sees a flash of the dark theme. Defaults to dark when
         nothing is stored — deliberately NOT reading prefers-color-scheme, which
         would silently flip every existing visitor whose OS is set to light. */}
    <script is:inline>
        try {
            if (localStorage.getItem('quadem-theme') === 'light') {
                document.documentElement.setAttribute('data-theme', 'light');
            }
        } catch (e) { /* private mode: fall through to dark */ }
    </script>

    <!-- Google Tag Manager (Deferred to footer) -->
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0d0d14">
    <meta name="color-scheme" content="dark light">
    
    <!-- Ahrefs Analytics -->
    <link rel="preconnect" href="https://analytics.ahrefs.com" crossorigin>
    <script src="https://analytics.ahrefs.com/analytics.js" data-key="rLG9enHa3Ne7Ob/OK/j4uQ" async></script>
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImageURL}>
    <meta property="og:image:alt" content={title}>
    {isDefaultOgImage && (
        <Fragment>
            <meta property="og:image:type" content="image/png">
            <meta property="og:image:width" content="1200">
            <meta property="og:image:height" content="630">
        </Fragment>
    )}
    <meta property="og:site_name" content="Quadem Digital Enterprise">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImageURL}>

    {jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <!-- Favicon -->
    <!-- logo.webp is 2000px square and 37KB. It stays as the canonical logo for
         schema.org and the email templates, which are absolute URLs other
         systems already hold, but nothing a browser paints small should ask
         for it: this pair is 2.7KB and 5KB. -->
    <link rel="icon" type="image/webp" href="/images/logo-104.webp">
    <link rel="apple-touch-icon" href="/images/logo-180.webp">
    
    <!-- Preconnect to external services -->
    <link rel="preconnect" href="https://www.googletagmanager.com" crossorigin>
    <link rel="dns-prefetch" href="https://embed.tawk.to">

    
    <!-- Smooth Page Transitions -->
    <ClientRouter />
    
    <slot name="head" />
</head>
<body>
    <a href="#main-content" class="skip-link sr-only">Skip to main content</a>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src="https://www.googletagmanager.com/ns.html?id=GTM-5CPTKQDB"
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Custom Cursor Removed for Performance -->

    <!-- Sticky Navbar -->
    {/* transition:animate="none" as well as persist. The node survives the swap,
         but it is still painted into BOTH the outgoing and incoming snapshots,
         and navigating resets the scroll to the top — so the compact .scrolled
         navbar (85px, blurred backdrop) cross-faded against the tall transparent
         one (94px) and the logo, links and Book a Call pill visibly doubled.
         "none" gives it its own group with no animation, so it simply redraws in
         place. */}
    <header class={`navbar ${navbarScrolled ? 'scrolled' : ''}`} id="navbar" transition:persist transition:animate="none">
        <div class="container navbar-container">
            <a href="/" class="logo active-logo">
                <img src="/images/logo-104.webp" alt="Quadem Digital Enterprise Logo" width="52" height="52" onerror="this.style.display='none'">
                <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
            </a>
            
            <nav class="nav-links">
                {navLinks.map((link: any) => (
                    <a
                        href={link.url}
                        class={link.label === 'QuadERP' ? 'nav-product-link' : ''}
                        style={activePage === (link.url || '').replace('/', '') ? 'color: var(--accent-text);' : ''}
                    >{link.label}{link.label === 'QuadERP' ? <span class="nav-new-badge">NEW</span> : null}</a>
                ))}
            </nav>
            
            <div class="nav-cta">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark/light mode">☀️</button>
                <a href="/contact/" class="btn btn-primary btn-pill" data-track="book_call" data-loc="nav">Book a Call</a>
            </div>
            
            <button class="mobile-menu-btn" aria-label="Toggle menu" aria-expanded="false">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>

    <!-- Mobile Menu Drawer -->
    <div class="mobile-menu-drawer" role="dialog" aria-label="Navigation menu">
        <nav class="mobile-nav-links">
            {navLinks.map((link: any) => (
                <a href={link.url} style={activePage === (link.url || '').replace('/', '') ? 'color: var(--accent-text);' : ''}>{link.label}</a>
            ))}
            <a href="/contact/" class="btn btn-primary btn-pill mt-4" data-track="book_call" data-loc="mobile-nav">Book a Call</a>
        </nav>
    </div>

    {/* Main Content.

         Deliberately NOT given transition:animate. Naming an element pulls it
         out of the viewport-sized "root" snapshot and gives it its own view
         transition group, whose geometry is animated from the old element's box
         to the new one's over 250ms. <main> is the whole page, so its box is
         wildly different on either side of a navigation: leaving the homepage
         scrolled to 2500px, the group animated height 12182px -> 1675px and
         translateY -2500px -> 185px. Both snapshots ride that animation, so the
         old page slid down the screen while the incoming page flew in from
         above — the further down the page you clicked, the worse it looked.

         Unnamed, the page is captured as "root", which is always exactly the
         viewport: the group animation is a no-op and the browser's default
         cross-fade plays cleanly. */}
    <main id="main-content">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="footer-glow"></div>
        <div class="container footer-container">
            <div class="footer-col brand-col">
                <a href="/" class="logo footer-logo active-logo">
                    <img src="/images/logo-104.webp" alt="Quadem Digital Enterprise Logo" width="52" height="52" onerror="this.style.display='none'">
                    <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
                </a>
                <p class="footer-tagline">{siteSettings?.footerTagline || "Premium design and smart strategy for brands that want to grow."}</p>
                <div class="footer-socials">
                    <a href={getSocialLink('twitter') || '#'} target="_blank" rel="noopener noreferrer" aria-label="Twitter">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/></svg>
                    </a>
                    <a href={getSocialLink('instagram') || '#'} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zM12 16a4 4 0 110-8 4 4 0 010 8zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"/></svg>
                    </a>
                    <a href={getSocialLink('linkedin') || '#'} target="_blank" rel="noopener noreferrer" aria-label="LinkedIn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433c-1.144 0-2.063-.926-2.063-2.065 0-1.138.92-2.063 2.063-2.063 1.14 0 2.064.925 2.064 2.063 0 1.139-.925 2.065-2.064 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
                    </a>
                </div>
            </div>
            
            <div class="footer-col link-col">
                <h3>Company</h3>
                <nav class="footer-nav">
                    <a href="/about/">About Us</a>
                    <a href="/projects/">Portfolio</a>
                    <a href="/blog/">Blog</a>
                    <a href="/contact/">Contact</a>
                </nav>
                <h3 style="margin-top: 1.5rem;"><a href="/offers/" style="color: inherit; text-decoration: none;">Special Offers</a></h3>
                <nav class="footer-nav">
                    <a href="/offers/free-seo-audit/">Free SEO Audit</a>
                    <a href="/offers/social-media-bonus/">Social Media Bonus</a>
                    <a href="/offers/web-dev-discount/">Web Dev Discount</a>
                </nav>
            </div>

            <div class="footer-col link-col">
                <h3>Services</h3>
                <nav class="footer-nav">
                    {/* Full service names, matching the CMS and each page's own
                        title, and pointing at the service pages themselves —
                        these used to be shortened labels ("Branding") linking to
                        anchors on /services/, so the same service went by three
                        different names depending on where you met it. */}
                    <a href="/services/web-design/">Web Design &amp; Development</a>
                    <a href="/services/brand-identity/">Branding &amp; Graphic Design</a>
                    <a href="/services/seo/">SEO &amp; Content Marketing</a>
                    <a href="/services/video-production/">AI Video &amp; Reels</a>
                    <a href="/services/digital-marketing-social-media/">Digital Marketing &amp; Social Media</a>
                    <a href="https://quaderp.app" target="_blank" rel="noopener noreferrer">QuadERP</a>
                    <a href="/calculator/">Price Calculator</a>
                </nav>
            </div>
            
            <div class="footer-col contact-col">
                <h3>Get in Touch</h3>
                <p class="footer-contact-info"><a href={`mailto:${siteSettings?.email || "hello@quademdigital.com"}`}>{siteSettings?.email || "hello@quademdigital.com"}</a></p>
                <p class="footer-contact-info"><a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">+{whatsappNumber}</a></p>
                <div class="footer-newsletter">
                    <h4>Join our newsletter</h4>
                    <form class="mini-newsletter-form" action="/api/newsletter/" method="POST">
                        <label for="miniNewsletterEmail" class="sr-only">Email address</label>
                        <input type="email" id="miniNewsletterEmail" name="email" placeholder="Email address" required>
                        <button type="submit" aria-label="Subscribe">→</button>
                    </form>
                </div>
            </div>
        </div>
        
        <div class="footer-bottom-bar">
            <div class="container footer-bottom-container">
                <p class="copyright">&copy; {new Date().getFullYear()} Quadem Digital Enterprise. All rights reserved.</p>
                <div class="footer-legal-links">
                    <a href="/privacy-policy/">Privacy Policy</a>
                    <a href="/terms-of-service/">Terms of Service</a>
                </div>
                <a href="#" class="back-to-top">Top ↑</a>
            </div>
        </div>
    </footer>

    <!-- WhatsApp Floating Button (smart per-page message) -->
    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
        activePage === 'services' ? "Hi Quadem! I'm interested in your services. Can we chat?" :
        activePage === 'projects' ? "Hi Quadem! I saw your portfolio and I'm impressed. Let's talk!" :
        activePage === 'blog' ? "Hi Quadem! I read your blog and have a question." :
        activePage === 'contact' ? "Hi Quadem! I'd like to book a strategy call." :
        activePage === 'about' ? "Hi Quadem! I'd love to learn more about your team." :
        "Hi Quadem Digital! I'd like to discuss a project."
    )}`} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Chat on WhatsApp" data-track="whatsapp_click" data-loc="float" transition:persist>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
    </a>

    <!-- Exit-Intent Popup -->
    <div class="exit-popup-overlay" id="exitPopup">
        <div class="exit-popup">
            <button class="exit-popup-close" id="exitPopupClose" aria-label="Close popup">×</button>
            <h3><span class="text-gradient">Wait! Before You Go...</span></h3>
            <p>Get a <strong>free website audit</strong> and discover how to double your leads. No strings attached.</p>
            <a href="/offers/free-seo-audit/" class="btn btn-primary btn-pill glow-effect" data-track="exit_popup_cta" data-loc="exit-popup">Get My Free Audit</a>
            <br />
            <button class="btn-skip" id="exitPopupSkip">No thanks, I'm good</button>
        </div>
    </div>

    <!-- Video Modal -->
    <div class="video-modal-overlay" id="videoModal">
        <div class="video-modal-content">
            <button class="video-modal-close" id="videoModalClose">×</button>
            <div class="video-iframe-container" id="videoIframeContainer"></div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        import '../scripts/main.js';
    </script>

    <!-- Deferred Analytics & Live Chat (Optimized for INP/TBT) -->
    <script is:inline>
        // Queue stubs must exist at load time, not inside the deferred loader:
        // events fired early are queued here and replayed once GA/Vercel init.
        window.dataLayer = window.dataLayer || [];
        window.gtag = window.gtag || function () { window.dataLayer.push(arguments); };
        window.gtag('js', new Date());
        window.gtag('config', 'G-VWQNS4KFSX');
        window.va = window.va || function () { (window.vaq = window.vaq || []).push(arguments); };

        let scriptsLoaded = false;

        function loadThirdPartyScripts() {
            if (scriptsLoaded) return;
            scriptsLoaded = true;

            // 1. Google Analytics 4, loaded by GTM below.
            //
            // gtag.js used to be loaded directly here as well, so the same
            // 562 KB script was downloaded and parsed twice per visit: with
            // gtm.js that was 483 KB of a 1,112 KB page, 43% of its weight,
            // for one working analytics setup.
            //
            // Removing it is only safe if GTM's copy picks up the gtag()
            // commands this page queues, which container config decides and
            // the repo cannot see. That was measured rather than assumed, on
            // the live site, by blocking the direct script and comparing what
            // GA4 was sent. Identical either way: one page_view, and every
            // data-track click arriving with the same event name and the same
            // parameters on the same property. Both copies read the same
            // window.dataLayer, which is why the stub above still works.
            //
            // If tracking ever goes quiet, that is the thing to re-check:
            // docs/analytics-duplicate-gtag.md has the method.

            // GTM initialization
            (function(w,d,s,l,i){w[l]=w[l]||[];w[l].push({'gtm.start':
            new Date().getTime(),event:'gtm.js'});var f=d.getElementsByTagName(s)[0],
            j=d.createElement(s),dl=l!='dataLayer'?'&l='+l:'';j.async=true;j.src=
            'https://www.googletagmanager.com/gtm.js?id='+i+dl;f.parentNode.insertBefore(j,f);
            })(window,document,'script','dataLayer','GTM-5CPTKQDB');

            // 2. Metricool
            const metricoolScript = document.createElement('script');
            metricoolScript.type = 'text/javascript';
            metricoolScript.src = 'https://tracker.metricool.com/resources/be.js';
            metricoolScript.onload = metricoolScript.onreadystatechange = function () {
                if (window.beTracker) {
                    window.beTracker.t({ hash: 'bcdd5bfa41ecd1f677666e2700228d65' });
                }
            };
            document.head.appendChild(metricoolScript);

            // 3. Ahrefs Analytics (Moved to head for proper crawler verification)

            // Cleanup listeners
            ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'].forEach(evt => {
                window.removeEventListener(evt, loadThirdPartyScripts, { passive: true });
            });
        }

        // Load immediately on user interaction
        ['scroll', 'mousemove', 'touchstart', 'click', 'keydown'].forEach(evt => {
            window.addEventListener(evt, loadThirdPartyScripts, { passive: true, once: true });
        });

        // Fallback: load after 3.5s if no interaction
        setTimeout(loadThirdPartyScripts, 3500);
    </script>
</body>
</html>
