---
import { sanityClient } from "sanity:client";
import { ClientRouter } from "astro:transitions";

interface Props {
    title: string;
    description?: string;
    activePage?: string;
    navbarScrolled?: boolean;
    ogImage?: string;
    jsonLd?: any;
}

const { title, description = "Quadem Digital Enterprise is a full-service digital agency offering web design, digital marketing, branding, video production, and SEO services.", activePage = "", navbarScrolled = false, ogImage = "/images/og-default.png", jsonLd } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;

const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";
const socialLinks = siteSettings?.socialLinks || {};
const navLinks = siteSettings?.navLinks || [
    { label: 'Services', url: '/services' },
    { label: 'Projects', url: '/projects' },
    { label: 'Blog', url: '/blog' },
    { label: 'About', url: '/about' },
    { label: 'Contact', url: '/contact' }
];
const footerLinks = siteSettings?.footerLinks || navLinks;
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{title}</title>
    <meta name="description" content={description}>
    <link rel="canonical" href={canonicalURL} />
    <meta name="theme-color" content="#0d0d14">
    
    <!-- Open Graph / Social -->
    <meta property="og:type" content="website">
    <meta property="og:url" content={canonicalURL}>
    <meta property="og:title" content={title}>
    <meta property="og:description" content={description}>
    <meta property="og:image" content={ogImage}>
    <meta property="og:site_name" content="Quadem Digital Enterprise">
    
    <!-- Twitter Card -->
    <meta name="twitter:card" content="summary_large_image">
    <meta name="twitter:title" content={title}>
    <meta name="twitter:description" content={description}>
    <meta name="twitter:image" content={ogImage}>

    {jsonLd && (
        <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
    )}
    <!-- Favicon -->
    <link rel="icon" type="image/jpeg" href="/images/qd-logo.jpg">
    
    <!-- DNS Prefetch for external services -->
    <link rel="dns-prefetch" href="https://fonts.googleapis.com">
    <link rel="dns-prefetch" href="https://fonts.gstatic.com">
    <link rel="dns-prefetch" href="https://cdn.sanity.io">
    <link rel="dns-prefetch" href="https://www.googletagmanager.com">
    <link rel="dns-prefetch" href="https://embed.tawk.to">

    <!-- Google Fonts with display=swap for non-blocking load -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    
    <!-- CSS -->
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
    
    <!-- Smooth Page Transitions -->
    <ClientRouter />
    
    <slot name="head" />
</head>
<body>
    <!-- Loading Screen (first visit only) -->
    <div class="loading-screen" id="loadingScreen">
        <div class="loader-content">
            <div class="loader-logo">Quadem <span class="logo-highlight">Digital</span></div>
            <div class="loader-bar"></div>
        </div>
    </div>

    <!-- Parallax Depth Orbs -->
    <div class="parallax-orb parallax-orb-1" data-parallax-speed="0.03"></div>
    <div class="parallax-orb parallax-orb-2" data-parallax-speed="0.05"></div>
    <div class="parallax-orb parallax-orb-3" data-parallax-speed="0.02"></div>

    <!-- Custom Cursor -->
    <div class="custom-cursor" id="customCursor"></div>
    <div class="cursor-follower" id="cursorFollower"></div>

    <!-- Sticky Navbar -->
    <header class={`navbar ${navbarScrolled ? 'scrolled' : ''}`} id="navbar" transition:persist>
        <div class="container navbar-container">
            <a href="/" class="logo active-logo">
                <img src="/images/qd-logo.jpg" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
            </a>
            
            <nav class="nav-links">
                {navLinks.map((link: any) => (
                    <a href={link.url} style={activePage === link.url.replace('/', '') ? 'color: var(--accent);' : ''}>{link.label}</a>
                ))}
            </nav>
            
            <div class="nav-cta">
                <button class="theme-toggle" id="themeToggle" aria-label="Toggle dark/light mode">☀️</button>
                <a href="/contact" class="btn btn-primary btn-pill">Book a Call</a>
            </div>
            
            <button class="mobile-menu-btn" aria-label="Toggle menu">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>

    <!-- Mobile Menu Drawer -->
    <div class="mobile-menu-drawer">
        <nav class="mobile-nav-links">
            {navLinks.map((link: any) => (
                <a href={link.url} style={activePage === link.url.replace('/', '') ? 'color: var(--accent);' : ''}>{link.label}</a>
            ))}
            <a href="/contact" class="btn btn-primary btn-pill mt-4">Book a Call</a>
        </nav>
    </div>

    <!-- Main Content -->
    <main transition:animate="fade">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container footer-container">
            <div class="footer-col">
                <a href="/" class="logo footer-logo active-logo">
                    <img src="/images/qd-logo.jpg" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                    <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
                </a>
                <p class="footer-tagline">{siteSettings?.footerTagline || "Elevating brands with premium design and data-driven strategies."}</p>
            </div>
            
            <div class="footer-col">
                <h4>Quick Links</h4>
                <nav class="footer-nav">
                    {footerLinks.map((link: any) => (
                        <a href={link.url}>{link.label}</a>
                    ))}
                </nav>
            </div>
            
            <div class="footer-col footer-bottom">
                <p class="copyright">&copy; 2026 Quadem Digital Enterprise. All rights reserved.</p>
                <a href="#" class="back-to-top">Back to top ↑</a>
            </div>
        </div>
    </footer>

    <!-- WhatsApp Floating Button (smart per-page message) -->
    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
        activePage === 'services' ? "Hi Quadem! I'm interested in your services. Can we chat?" :
        activePage === 'projects' ? "Hi Quadem! I saw your portfolio and I'm impressed. Let's talk!" :
        activePage === 'blog' ? "Hi Quadem! I read your blog and have a question." :
        activePage === 'contact' ? "Hi Quadem! I'd like to book a strategy call." :
        activePage === 'about' ? "Hi Quadem! I'd love to learn more about your team." :
        "Hi Quadem Digital! I'd like to discuss a project."
    )}`} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Chat on WhatsApp" transition:persist>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
    </a>

    <!-- Exit-Intent Popup -->
    <div class="exit-popup-overlay" id="exitPopup">
        <div class="exit-popup">
            <button class="exit-popup-close" id="exitPopupClose">×</button>
            <h3><span class="text-gradient">Wait! Before You Go...</span></h3>
            <p>Get a <strong>free website audit</strong> and discover how to double your leads. No strings attached.</p>
            <a href="/contact" class="btn btn-primary btn-pill glow-effect">Get My Free Audit</a>
            <br />
            <button class="btn-skip" id="exitPopupSkip">No thanks, I'm good</button>
        </div>
    </div>

    <!-- Video Modal -->
    <div class="video-modal-overlay" id="videoModal">
        <div class="video-modal-content">
            <button class="video-modal-close" id="videoModalClose">×</button>
            <div class="video-iframe-container" id="videoIframeContainer"></div>
        </div>
    </div>

    <!-- Scripts -->
    <script is:inline src="/js/main.js"></script>

    <!-- Google Analytics 4 -->
    <script is:inline async src="https://www.googletagmanager.com/gtag/js?id=G-EBEW2F59JH"></script>
    <script is:inline>
        window.dataLayer = window.dataLayer || [];
        function gtag(){dataLayer.push(arguments);}
        gtag('js', new Date());
        gtag('config', 'G-EBEW2F59JH');
    </script>

    <!-- Tawk.to Live Chat -->
    <script is:inline>
        var Tawk_API=Tawk_API||{}, Tawk_LoadStart=new Date();
        (function(){
            var s1=document.createElement("script"),s0=document.getElementsByTagName("script")[0];
            s1.async=true;
            s1.src='https://embed.tawk.to/6a2041209a52f51c317623e8/1jq6vsq50';
            s1.charset='UTF-8';
            s1.setAttribute('crossorigin','*');
            s0.parentNode.insertBefore(s1,s0);
        })();
    </script>
</body>
</html>
