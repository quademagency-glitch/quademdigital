---
import CertificationBadges from '../components/CertificationBadges.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { normaliseLocalHref } from '../lib/publicSettings.js';
import StrokeIcon from '../components/StrokeIcon.astro';
import { BOOKING_PATH } from '../lib/booking';
import { payloadFetchGlobal } from "../lib/payload";
import SiteHead from "../components/SiteHead.astro";
import SiteScripts from "../components/SiteScripts.astro";
import '../styles/style.css';
import '../styles/animations.css';
import '../styles/studio.css';
import '../styles/studio-motion.css';
import '../styles/marketinglab.css';
import '../styles/story-motion.css';
import '../styles/page-hero.css';
import '../styles/media-presentation.css';
import '../styles/visual-story.css';
import MotionControl from '../components/MotionControl.astro';

interface Props {
    title: string;
    description?: string;
    activePage?: string;
    navbarScrolled?: boolean;
    ogImage?: string;
    /*
      Size of the Open Graph card, when it is known. Omit for a CMS cover image
      whose dimensions we cannot see from here. See SiteHead for why.
    */
    ogImageSize?: { width: number; height: number; type?: string };
    jsonLd?: any;
    /*
      Keep this page out of search. Pairs with a Disallow in public/robots.txt
      and, for a page that is a file rather than a CMS route, an entry in
      UNLISTED in sitemap.xml.ts. All three, or the page leaks.
    */
    noindex?: boolean;
    /*
      Suppress the exit-intent popup. Set on pages whose credibility depends on
      not selling: the analysis pieces, which four of the five cold email
      sequences link on day 9. docs/analysis-format.md is explicit that a piece
      which ends in a sales pitch gets read once and never linked, and a modal
      advert on the way out is exactly that pitch.
    */
    suppressExitPopup?: boolean;
}

const { title, description, activePage = "", navbarScrolled = false, ogImage = "/images/og-card.png", ogImageSize, jsonLd, noindex = false, suppressExitPopup = true } = Astro.props;
const canonicalURL = Astro.site ? new URL(Astro.url.pathname, Astro.site) : Astro.url;
// The built-in card is the one size we always know. A caller that ships its own
// card passes ogImageSize explicitly; a CMS cover image passes nothing.
const resolvedOgImageSize = ogImageSize
    ?? (ogImage === "/images/og-card.png" ? { width: 1200, height: 630, type: "image/png" } : undefined);

const [siteSettings, homepageSettings] = await Promise.all([payloadFetchGlobal("siteSettings"), payloadFetchGlobal("homepage")]);
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";
const socialLinks = siteSettings?.socialLinks || [];

/*
  Tracking codes, from siteSettings.analytics with the previous literals as
  fallbacks. Three of the four are interpolated into inline JavaScript below,
  so each is checked against the shape its provider issues and anything else
  falls back. That is both a safety net for a typo, which would otherwise kill
  measurement silently with nothing on the page to show for it, and the reason
  a value typed into the CMS cannot become script.

  Tawk is not here: it is loaded by the GTM container, not by this file.
*/
const trackingId = (value: unknown, shape: RegExp, fallback: string) => {
    const v = typeof value === "string" ? value.trim() : "";
    return shape.test(v) ? v : fallback;
};
const analytics = siteSettings?.analytics || {};
const gtmId = trackingId(analytics.gtmId, /^GTM-[A-Z0-9]{4,20}$/, "GTM-5CPTKQDB");
const ga4Id = trackingId(analytics.ga4Id, /^G-[A-Z0-9]{6,20}$/, "G-VWQNS4KFSX");
const ahrefsKey = trackingId(analytics.ahrefsKey, /^[A-Za-z0-9+/=_-]{10,64}$/, "rLG9enHa3Ne7Ob/OK/j4uQ");
const metricoolHash = trackingId(analytics.metricoolHash, /^[a-f0-9]{16,64}$/, "bcdd5bfa41ecd1f677666e2700228d65");
const defaultNavLinks = [
    { label: 'Services', url: '/services/' },
    { label: 'Projects', url: '/projects/' },
    { label: 'Blog', url: '/blog/' },
    { label: 'About', url: '/about/' },
    { label: 'Offers', url: '/offers/' },
    { label: 'Contact', url: '/contact/' }
];
/*
  The menu is whatever the CMS says, in the CMS's order.

  It used to be whatever the CMS said plus QuadERP forced in at position three
  and Offers forced in before Contact, so neither could be removed, renamed or
  moved from the admin however hard an editor tried. Both are in the seeded
  list instead, where they can be edited like everything else. The built-in
  list above is still the fallback for an empty CMS, so an accidental
  save-with-nothing does not leave the site without navigation.
*/
/*
  /offers is the Ghana path and only the Ghana path.

  The discounts there ("15% off your first project") read as value to a buyer in
  Accra and as risk to one in London or Dallas, which is the whole reason the
  global landing page exists. Rather than removing them, links into /offers are
  marked here and taken out of the page for a visitor outside Ghana by
  initGhanaOnlyLinks in src/scripts/main.js.

  Marked rather than hidden server-side because public pages are edge-cached for
  60 seconds, so country-varying HTML would be cached and served to the wrong
  country. Shown by default and removed after the lookup, because Ghana is the
  main site's primary audience and that is the reading that should never flicker.
*/
const isOffersLink = (url: unknown) =>
    typeof url === 'string' && (url.startsWith('/offers') || url.includes('quademdigital.com/offers'));

// A whole footer column of discounts ("Special Offers") goes as a unit, heading
// included, rather than leaving an empty heading behind.
const isOffersGroup = (group: any) =>
    Array.isArray(group?.links) && group.links.length > 0 && group.links.every((l: any) => isOffersLink(l?.url));

const cmsNavLinks = (siteSettings?.navLinks || []).filter((link: any) => link.label && link.url);
const navLinks = (cmsNavLinks.length > 0 ? cmsNavLinks : defaultNavLinks).map((link: any) => ({ ...link, url: normaliseLocalHref(link.url) }));


/*
  The footer's two link columns. `footerLinks` was read here and then never
  rendered; the columns were typed into the markup below, which is how the
  Services list came to name the same service differently from the pages it
  linked to. Rows without a heading are dropped: production still holds one
  empty row from when this field did nothing.
*/
const footerGroups = (siteSettings?.footerLinks || [])
    .filter((group: any) => group?.label)
    .map((group: any) => ({
        ...group,
        links: (group.links || []).filter((link: any) => link?.label && link?.url),
    }));
footerGroups.sort((a: any, b: any) => Number(a.column === 'right') - Number(b.column === 'right'));
const activeHref = (href: string) => {
    try {
        const url = new URL(href, canonicalURL);
        return url.origin === canonicalURL.origin && !url.hash && url.pathname === Astro.url.pathname;
    } catch { return false; }
};
---
<!DOCTYPE html>
<html lang="en">
<head>
    {/* Every tag in here lives in SiteHead, so /global can reuse the head
         without inheriting a body full of Ghana-path offers. Page-specific
         <style> and <link rel=preload> still arrive through slot="head" and
         are forwarded into SiteHead's default slot, so they still land last. */}
    <SiteHead
        title={title}
        description={description || siteSettings?.description || "Quadem Digital Enterprise is a full-service digital agency offering web design, digital marketing, branding, AI video and reels, and SEO services."}
        canonicalURL={canonicalURL}
        ogImage={ogImage}
        ogImageSize={resolvedOgImageSize}
        jsonLd={jsonLd}
        noindex={noindex}
        ahrefsKey={ahrefsKey}
        siteName={siteSettings?.title || "Quadem Digital Enterprise"}
    >
        <slot name="head" />
    </SiteHead>
</head>
<body class:list={["studio", "lab-site", { "lab-home": activePage === "home" }]}>
    <!-- THESIS: Quadem makes its digital services clear through the user's MarketingLab reference.
    OWN-WORLD: Quadem's original CMS artwork fills a raised blue hero; monumental Urbanist, a moving service ribbon, cream introduction, black pinned process and cream service/work sections.
    STORY: Understand the offer, follow the process, inspect real work, compare prices and contact Ernest.
    FIRST VIEWPORT: Viewport-filling original image, wide navigation, two monumental lines: WEB DESIGN then right-aligned italic AGENCY. Bottom copy and location facts; contact action upper right. Original image gallery follows the introduction.
    FORM: User-pinned MarketingLab composition supersedes seed f5a2818c and the previous Web-De world.
    FINISH: unreviewed and undocumented is unfinished; this build ends with the finish review, the verdict, and DESIGN.md -->
    <MotionControl />
    <a href="#main-content" class="skip-link sr-only">Skip to main content</a>
    <!-- Google Tag Manager (noscript) -->
    <noscript><iframe src={`https://www.googletagmanager.com/ns.html?id=${gtmId}`}
    height="0" width="0" style="display:none;visibility:hidden"></iframe></noscript>
    <!-- End Google Tag Manager (noscript) -->

    <!-- Custom Cursor Removed for Performance -->

    <!-- Sticky Navbar -->
    {/* The constant-size header is recreated on navigation so active links,
         mobile state and the browser's painted layer follow the new route. */}
    <header class={`navbar ${navbarScrolled ? 'scrolled' : ''}`} id="navbar">
        <div class="container navbar-container">
            <a href="/" class="logo active-logo">
                <img src="/images/logo-104.webp" alt="Quadem Digital Enterprise Logo" width="52" height="52" onerror="this.style.display='none'">
                <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
            </a>
            
            <nav class="nav-links" aria-label="Main navigation">
                {navLinks.map((link: any) => <a href={link.url} aria-current={activeHref(link.url) ? 'page' : undefined} data-ghana-only={isOffersLink(link.url) ? "" : undefined} target={/^https?:/i.test(link.url) ? '_blank' : undefined} rel={/^https?:/i.test(link.url) ? 'noopener noreferrer' : undefined}>{link.label}</a>)}
                <details class="nav-pages">
                    <summary>All pages <svg aria-hidden="true" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="m5 9 7 7 7-7"/></svg></summary>
                    <div class="nav-pages-menu">
                        <a href="/calculator/">Project calculator</a>
                        <a href="/#faq">Questions & answers</a>
                        <a href="/offers/" data-ghana-only>Special offers</a>
                        <a href="/contact/">Contact</a>
                    </div>
                </details>
            </nav>
            <div class="nav-cta">
                <a href={BOOKING_PATH} class="btn btn-primary btn-pill" data-track="book_call" data-loc="nav">Let's talk <svg aria-hidden="true" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M5 19 19 5M5 5h14v14"/></svg></a>
            </div>
            
            <button class="mobile-menu-btn" aria-label="Open navigation" aria-controls="mobile-navigation" aria-expanded="false">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>

    <!-- Mobile Menu Drawer -->
    <div class="mobile-menu-drawer" id="mobile-navigation" role="dialog" aria-label="Navigation menu" inert>
        <nav class="mobile-nav-links">
            {[...navLinks, { label: "Pricing", url: "/#pricing" }, { label: "FAQ", url: "/#faq" }].map((link: any) => (
                <a
                    href={link.url}
                    data-ghana-only={isOffersLink(link.url) ? "" : undefined}
                    aria-current={activeHref(link.url) ? 'page' : undefined}
                    target={/^https?:/i.test(link.url) ? '_blank' : undefined}
                    rel={/^https?:/i.test(link.url) ? 'noopener noreferrer' : undefined}
                >{link.label}</a>
            ))}
            <a href={BOOKING_PATH} class="btn btn-primary btn-pill mt-4" data-track="book_call" data-loc="mobile-nav">Book a Call</a>
        </nav>
    </div>

    {/* Main Content.

         Deliberately NOT given transition:animate. Naming an element pulls it
         out of the viewport-sized "root" snapshot and gives it its own view
         transition group, whose geometry is animated from the old element's box
         to the new one's over 250ms. <main> is the whole page, so its box is
         wildly different on either side of a navigation: leaving the homepage
         scrolled to 2500px, the group animated height 12182px -> 1675px and
         translateY -2500px -> 185px. Both snapshots ride that animation, so the
         old page slid down the screen while the incoming page flew in from
         above: the further down the page you clicked, the worse it looked.

         Unnamed, the page is captured as "root", which is always exactly the
         viewport: the group animation is a no-op and the browser's default
         cross-fade plays cleanly. */}
    <main id="main-content">
        <slot />
    </main>

    <!-- Footer -->
    <footer class="footer">
        <div class="container">
            <div class="studio-footer-cta">
                <img class="lab-footer-art" src="/images/logo-180.webp" alt="Quadem Digital" width="180" height="180" loading="lazy" />
                <h2>Ready for your next chapter?</h2>
                <p>Tell me what you are building. We will work out the right next step.</p>
                <div class="studio-actions">
                    <a href={BOOKING_PATH} class="btn btn-primary btn-pill" data-track="book_call" data-loc="footer">Book a free call <span aria-hidden="true"><StrokeIcon /></span></a>
                    <a href="/contact/#contact" class="btn btn-light btn-pill">Send a project brief</a>
                </div>
            </div>
        </div>
        <div class="lab-footer-base lab-dark" id="newsletter">
        <div class="container footer-container">
            <div class="footer-col brand-col">
                <a href="/" class="logo footer-logo active-logo">
                    <img src="/images/logo-104.webp" alt="Quadem Digital Enterprise Logo" width="52" height="52" onerror="this.style.display='none'">
                    <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
                </a>
                <p class="footer-tagline">{siteSettings?.footerTagline || "Premium design and smart strategy for brands that want to grow."}</p>
                <SocialLinks links={socialLinks} class="footer-socials" />
                <CertificationBadges certifications={siteSettings?.certifications || []} />
            </div>
            
            {footerGroups.length > 0 ? (
                footerGroups.map((group: any) => <div class="footer-col link-col" data-ghana-only={isOffersGroup(group) ? "" : undefined}>
                    <h3>{group.url ? <a href={group.url} style="color: inherit; text-decoration: none;">{group.label}</a> : group.label}</h3>
                    <nav class="footer-nav">
                        {group.links.map((link: any) => <a href={link.url} data-ghana-only={isOffersLink(link.url) ? "" : undefined} target={/^https?:/i.test(link.url) ? '_blank' : undefined} rel={/^https?:/i.test(link.url) ? 'noopener noreferrer' : undefined}>{link.label}</a>)}
                    </nav>
                </div>)
            ) : (
                /*
                  The built-in footer, for an empty CMS. Kept rather than
                  deleted because the footer grid is four fixed columns: with
                  nothing here the brand block and the contact block would
                  stretch across a gap where the links should be.
                */
                <>
                    <div class="footer-col link-col">
                        <h3>Company</h3>
                        <nav class="footer-nav">
                            <a href="/about/">About</a>
                            <a href="/projects/">Portfolio</a>
                            <a href="/blog/">Blog</a>
                            <a href="/contact/">Contact</a>
                        </nav>
                        <h3 style="margin-top: 1.5rem;"><a href="/offers/" style="color: inherit; text-decoration: none;">Special Offers</a></h3>
                        <nav class="footer-nav">
                            <a href="/offers/free-seo-audit/">Free SEO Audit</a>
                            <a href="/offers/social-media-bonus/">Social Media Bonus</a>
                            <a href="/offers/web-dev-discount/">Web Dev Discount</a>
                        </nav>
                    </div>

                    <div class="footer-col link-col">
                        <h3>Services</h3>
                        <nav class="footer-nav">
                            {/* Full service names, matching the CMS and each page's own
                                title, and pointing at the service pages themselves,
                                these used to be shortened labels ("Branding") linking to
                                anchors on /services/, so the same service went by three
                                different names depending on where you met it. */}
                            <a href="/services/web-design/">Web Design &amp; Development</a>
                            <a href="/services/brand-identity/">Branding &amp; Graphic Design</a>
                            <a href="/services/seo/">SEO &amp; Content Marketing</a>
                            <a href="/services/video-production/">AI Video &amp; Reels</a>
                            <a href="/services/digital-marketing-social-media/">Digital Marketing &amp; Social Media</a>
                            <a href="https://quaderp.app" target="_blank" rel="noopener noreferrer">QuadERP</a>
                            <a href="/calculator/">Price Calculator</a>
                        </nav>
                    </div>
                </>
            )}
            
                <div class="footer-col footer-newsletter lab-footer-signup">
                    <h4>{homepageSettings?.newsletterHeading || "Get weekly digital growth tips for free"}</h4>
                    <p>{homepageSettings?.newsletterSubheading || "Join my community of founders and creators building better brands."}</p>
                    <form id={activePage === "home" ? "newsletterForm" : undefined} class="mini-newsletter-form" action="/api/newsletter/" method="POST">
                        <label for="miniNewsletterEmail" class="sr-only">Email address</label>
                        <input type="email" id="miniNewsletterEmail" name="email" placeholder="Email address" required>
                        <button type="submit" aria-label="Subscribe"><StrokeIcon name="right" /></button>
                    </form>
                </div>
            <div class="footer-col contact-col">
                <h3>Get in Touch</h3>
                {/* The postal address US anti-spam law requires in every
                     commercial email, shown here so the site and the emails
                     agree. Deliberately no hardcoded fallback: if the CMS read
                     fails, show nothing. The legal duty attaches to the email,
                     not to this footer, and a stale address left behind after a
                     move is worse than an absent one. Edit it in Site Settings,
                     and change the outbound sequences to match. */}
                {siteSettings?.address && (
                    <address class="footer-contact-info footer-address">{siteSettings.address}</address>
                )}
                <p class="footer-contact-info"><a href={`mailto:${siteSettings?.email || "ernest@quademdigital.com"}`}>{siteSettings?.email || "ernest@quademdigital.com"}</a></p>
                <p class="footer-contact-info"><a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer">+{whatsappNumber}</a></p>

            </div>
        </div>
        
        <div class="footer-bottom-bar">
            <div class="container footer-bottom-container">
                <p class="copyright">&copy; {new Date().getFullYear()} Quadem Digital Enterprise. All rights reserved.</p>
                <div class="footer-legal-links">
                    <a href="/privacy-policy/">Privacy Policy</a>
                    <a href="/terms-of-service/">Terms of Service</a>
                </div>
                <a href="#" class="back-to-top">Top <StrokeIcon name="up" /></a>
            </div>
        </div>
        </div>
    </footer>

    <!-- WhatsApp Floating Button (smart per-page message) -->
    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(
        siteSettings?.whatsappMessage || (activePage === 'services' ? "Hi Quadem! I'm interested in your services. Can we chat?" :
        activePage === 'projects' ? "Hi Quadem! I saw your portfolio and I'm impressed. Let's talk!" :
        activePage === 'blog' ? "Hi Quadem! I read your blog and have a question." :
        activePage === 'contact' ? "Hi Quadem! I'd like to book a strategy call." :
        activePage === 'about' ? "Hi Quadem! I'd love to learn more about what you do." :
        "Hi Quadem Digital! I'd like to discuss a project.")
    )}`} target="_blank" rel="noopener noreferrer" class="whatsapp-float" aria-label="Chat on WhatsApp" data-track="whatsapp_click" data-loc="float" transition:persist>
        <svg width="28" height="28" viewBox="0 0 24 24" fill="white">
            <path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/>
        </svg>
    </a>

    {/* Exit-Intent Popup. Off on pages that have to read as analysis rather
         than as advertising: see the suppressExitPopup prop above. */}
    {!suppressExitPopup && (
    <div class="exit-popup-overlay" id="exitPopup" data-ghana-only>
        <div class="exit-popup">
            <button class="exit-popup-close" id="exitPopupClose" aria-label="Close popup"><StrokeIcon name="close" /></button>
            <h3><span class="text-gradient">Wait! Before You Go...</span></h3>
            <p>Get a <strong>free website audit</strong> to find what makes it harder for customers to enquire or buy, with practical next steps.</p>
            <a href="/offers/free-seo-audit/" class="btn btn-primary btn-pill glow-effect" data-track="exit_popup_cta" data-loc="exit-popup">Get My Free Audit</a>
            <br />
            <button class="btn-skip" id="exitPopupSkip">No thanks, I'm good</button>
        </div>
    </div>
    )}

    <!-- Video Modal -->
    <div class="video-modal-overlay" id="videoModal" role="dialog" aria-modal="true" aria-label="Video">
        <div class="video-modal-content">
            <button class="video-modal-close" id="videoModalClose" aria-label="Close video"><StrokeIcon name="close" /></button>
            <div class="video-iframe-container" id="videoIframeContainer"></div>
        </div>
    </div>

    <!-- Scripts -->
    <script>
        import '../scripts/main.js';
        import '../scripts/studio-motion.js';
    </script>

    <SiteScripts gtmId={gtmId} ga4Id={ga4Id} metricoolHash={metricoolHash} />
</body>
</html>
