---
import BaseLayout from "../layouts/BaseLayout.astro";

interface Props {
    error: unknown;
}
const { error } = Astro.props;
---
<BaseLayout title="Server Error | Quadem Digital" description="An unexpected error occurred." activePage="500" navbarScrolled={true}>
    <section class="section-padding" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; text-align: center;">
        <div class="container">
            <h1 style="font-size: 6rem; margin-bottom: 1rem;"><span class="text-gradient">500</span></h1>
            <h2 style="margin-bottom: 2rem;">Server Error</h2>
            <p style="color: var(--text-muted); margin-bottom: 3rem;">Sorry, something went wrong on our end. Please try again later.</p>
            <a href="/" class="btn btn-primary btn-pill glow-effect">Return Home</a>
            
            {import.meta.env.DEV && error instanceof Error ? (
                <div style="margin-top: 3rem; text-align: left; background: rgba(255,0,0,0.1); padding: 2rem; border-radius: 8px; border: 1px solid rgba(255,0,0,0.3); overflow-x: auto;">
                    <h3 style="color: #ff6b6b; margin-bottom: 1rem;">Developer Details (DEV ONLY)</h3>
                    <pre style="color: #ff6b6b; font-family: monospace;">{error.message}</pre>
                    <pre style="color: #ff6b6b; font-family: monospace; font-size: 0.8rem; margin-top: 1rem;">{error.stack}</pre>
                </div>
            ) : null}
        </div>
    </section>
</BaseLayout>
