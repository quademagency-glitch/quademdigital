---
import BaseLayout from '../layouts/BaseLayout.astro';
import { payloadFetch, payloadFetchGlobal, safeHref } from '../lib/payload';
import { resolveBookingHref } from '../lib/booking';
import { resolveSeo } from '../lib/seo';
import { normaliseLocalHref, isRetiredService } from '../lib/publicSettings.js';
import DHero from '../components/homeD/DHero.astro';
import DProblem from '../components/homeD/DProblem.astro';
import DSolutions from '../components/homeD/DSolutions.astro';
import DWork from '../components/homeD/DWork.astro';
import DTestimonials from '../components/homeD/DTestimonials.astro';
import DProcess from '../components/homeD/DProcess.astro';
import DPrices from '../components/homeD/DPrices.astro';
import DFaq from '../components/homeD/DFaq.astro';
import DContact from '../components/homeD/DContact.astro';
import { loadHero } from '../lib/homeD/hero';
import { loadProblem } from '../lib/homeD/problem';
import { loadSolutions } from '../lib/homeD/solutions';
import { loadWork } from '../lib/homeD/work';
import { loadTestimonials } from '../lib/homeD/testimonials';
import { loadProcess } from '../lib/homeD/process';
import { loadPrices } from '../lib/homeD/prices';
import { loadFaq } from '../lib/homeD/faq';
import { loadContact } from '../lib/homeD/contact';

/*
  The home page from the approved "D final" design (24 October 2026): one phone
  tells the story, in Geist, Instrument Serif and Geist Mono with colour for
  emphasis and no italics. Hero, the problem, our solutions, our work, what
  clients say, how it works, prices, then the FAQ and the contact form (order
  set by Ernest on 25 October 2026: the separate proof section came out, its
  numbers live in our work). One scroll moves one step; between sections a
  blue panel wipes across (.d-wipe, driven by d-story.js). Every section's
  words come from the homepage global's "New home page" fields over the
  approved defaults in src/lib/homeD/*.defaults.json; prices come from
  pricingPlans under the market rule. Ernest chose the pinned scroll stories,
  which replace the 19 October "no pinned sections" rule for this page.
*/
const [studies, settings, plans, faqs, homepage, allServices, testimonials] = await Promise.all([
  payloadFetch('caseStudies', { sort: 'order', limit: '100' }),
  payloadFetchGlobal('siteSettings'),
  payloadFetch('pricingPlans', { sort: 'order', 'where[kind][not_equals]': 'package', limit: '100' }),
  // Payload returns 10 documents unless asked; there are more FAQs than that.
  payloadFetch('faqs', { sort: 'order', limit: '100' }),
  payloadFetchGlobal('homepage'),
  payloadFetch('services', { sort: 'order', limit: '100' }),
  payloadFetch('testimonials', { sort: 'order', limit: '100' }),
]);
// A retired service (branding, 19 October 2026) keeps its CMS row but is not sold, so it is not named anywhere here.
const cmsServices = (allServices || []).filter((service: any) => !isRetiredService(service.slug));
const heroTagline = homepage?.heroTagline || 'Websites, AI automation, AI video, search and ads that bring businesses more enquiries and sales.';
const primaryCta = homepage?.primaryCta || { label: 'Get a free website check-up', link: '/offers/free-seo-audit/' };
const ctaHref = resolveBookingHref(safeHref(normaliseLocalHref(primaryCta.link)) || '/offers/free-seo-audit/', primaryCta.label);
const seo = resolveSeo(homepage, { title: 'Quadem Digital | Websites, AI Automation, AI Video, SEO and Ads That Bring In Customers', description: 'We build fast websites and AI automations that answer every enquiry, then keep you visible on Google and social media every month.' });
const faqRows = (faqs || []).filter((faq: any) => faq.question && faq.answer);
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'LocalBusiness', '@id': 'https://quademdigital.com/#business', name: settings?.title || 'Quadem Digital Enterprise', url: 'https://quademdigital.com', description: heroTagline, priceRange: '$$', image: 'https://quademdigital.com/images/logo.webp', email: settings?.email || 'ernest@quademdigital.com', ...(settings?.whatsappNumber ? { telephone: `+${settings.whatsappNumber}` } : {}), address: { '@type': 'PostalAddress', ...(settings?.address ? { streetAddress: String(settings.address).split(',')[0].trim() } : {}), addressLocality: 'Accra', addressCountry: 'GH' }, areaServed: [{ '@type': 'Country', name: 'Ghana' }, { '@type': 'AdministrativeArea', name: 'Worldwide' }], sameAs: (settings?.socialLinks || []).map((link: any) => link.url).filter(Boolean) },
  ...(faqRows.length ? [{ '@type': 'FAQPage', '@id': 'https://quademdigital.com/#faq', mainEntity: faqRows.map((faq: any) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }] : []),
] };
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="home" jsonLd={jsonLd}>
  <DHero words={loadHero(homepage)} studies={studies} />
  <DProblem data={loadProblem(homepage)} ctaHref={ctaHref} studies={studies} />
  <DSolutions data={loadSolutions(homepage)} ctaHref={ctaHref} studies={studies} />
  <DWork words={loadWork(homepage)} studies={studies} />
  <DTestimonials words={loadTestimonials(homepage)} testimonials={testimonials} studies={studies} />
  <DProcess words={loadProcess(homepage)} />
  <DPrices words={loadPrices(homepage)} pricingPlans={plans} />
  <DFaq words={loadFaq(homepage)} faqs={faqRows} />
  <DContact words={loadContact(homepage)} settings={settings} services={cmsServices} />
  <div class="d-wipe" aria-hidden="true"></div>
</BaseLayout>

<script>
  import { initStories } from '../scripts/d-story.js';
  initStories();
  document.addEventListener('astro:page-load', () => initStories());
</script>
