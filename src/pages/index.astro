---
import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetch, payloadFetchGlobal, buildPayloadImageUrl, resolveHeroMedia, getPayloadImageSize, resolveVideo } from '../lib/payload';
import Picture from '../components/Picture.astro';
import HeroSection from '../components/home/HeroSection.astro';
import { Image, getImage } from 'astro:assets';
import founderMock from '../images/founder-mock.webp';

import imgWebDesign from '../images/service-web-design.webp';
// The branding slide used to fall back to the logo itself, so if the CMS hero
// list were ever empty the carousel showed the navbar's own mark as a "service".
import imgBranding from '../images/service-branding.webp';
import imgDigitalMarketing from '../images/service-digital-marketing.webp';
import imgVideo from '../images/service-video.webp';
import imgSeo from '../images/service-seo.webp';
import imgQuademProp from '../images/quadem-prop-2.webp';
import imgHeroBg from '../images/hero-bg.webp';

// 16:9 hero art for phones. See MOBILE_HERO_ART below.
import mobileHeroWebsites from '../images/hero-mobile-websites.webp';
import mobileHeroBrand from '../images/hero-mobile-brand-identity.webp';
import mobileHeroSeo from '../images/hero-mobile-seo.webp';
import mobileHeroReels from '../images/hero-mobile-reels.webp';
import SocialProof from '../components/home/SocialProof.astro';

import FeaturedWork from '../components/home/FeaturedWork.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import PricingSection from '../components/home/PricingSection.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import FAQSection from '../components/home/FAQSection.astro';
import VideoPromoSection from '../components/home/VideoPromoSection.astro';
import WebDesignPromoSection from '../components/home/WebDesignPromoSection.astro';
import BrandIdentityPromoSection from '../components/home/BrandIdentityPromoSection.astro';
import SeoPromoSection from '../components/home/SeoPromoSection.astro';
import { resolveSeo } from "../lib/seo";

// These CMS reads are independent, so fetch them concurrently. Awaiting them
// in series meant ~12 sequential round trips to the (US-East) CMS per render.
const [
  homepage,
  aboutData,
  fetchedServices,
  fetchedCaseStudies,
  webapps,
  siteSettings,
  stats,
  processSteps,
  pricingPlans,
  testimonials,
  faqs,
  calculatorServices,
] = await Promise.all([
  payloadFetchGlobal('homepage'),
  payloadFetchGlobal('about'),
  payloadFetch('services', { sort: 'order' }),
  payloadFetch('caseStudies', { sort: 'order' }),
  payloadFetch('webapps', { sort: 'order' }),
  payloadFetchGlobal('siteSettings'),
  payloadFetch('stats', { sort: 'order' }),
  payloadFetch('processSteps', { sort: 'stepNumber' }),
  payloadFetch('pricingPlans', { sort: 'order' }),
  payloadFetch('testimonials', { sort: 'order' }),
  payloadFetch('faqs', { sort: 'order' }),
  payloadFetch('calculatorServices', { sort: 'order' }),
]);

const rawHeadline = homepage?.heroHeadline || '';
const heroHeadline = rawHeadline.includes('|') ? rawHeadline : "I design | that grow your business.";
const heroTagline = homepage?.heroTagline || "A founder-led digital studio in Accra. You work directly with the person building your brand, with fast turnarounds, honest pricing and work built to make you money.";
const heroSubheadline = homepage?.heroSubheadline || '';
/*
  The four service promo cards. `visual` picks which illustration is drawn, so
  the order and the wording are the CMS's and the artwork stays in the four
  components. An empty array means the CMS has nothing to say yet, in which
  case each component renders its own built in copy, exactly what the page
  showed before these became editable.
*/
const PROMO_COMPONENTS: Record<string, any> = {
  video: VideoPromoSection,
  webDesign: WebDesignPromoSection,
  brandIdentity: BrandIdentityPromoSection,
  seo: SeoPromoSection,
};
const cmsPromos = (homepage?.promoSections || []).filter(
  (p: any) => p?.visual && PROMO_COMPONENTS[p.visual] && p.heading && p.body,
);
/*
  Two cards using the same artwork would otherwise emit the same element id
  twice. Only the repeats get a suffix, so the usual one-of-each case keeps
  the ids the page has always had.
*/
const seenVisual: Record<string, number> = {};
const promoCards = cmsPromos.map((p: any) => {
  const n = (seenVisual[p.visual] = (seenVisual[p.visual] || 0) + 1);
  return { ...p, Component: PROMO_COMPONENTS[p.visual], idSuffix: n > 1 ? `-${n}` : '' };
});

const primaryCta = homepage?.primaryCta || {};
const secondaryCta = homepage?.secondaryCta || {};
const defaultHeroBg = await getImage({ src: imgHeroBg, width: 800, format: 'webp' });

/*
  Hero art for phones.

  The art in the CMS is 4:5 portrait, which is right for the tall panel that
  sits beside the headline on a desktop. A phone gets that same panel laid out
  wide, and `background-size: contain` then fits the portrait picture whole
  inside it: measured at 375px the image filled about 144px of a 343px box and
  sat between two empty bars. These are 16:9 versions of the same four subjects
  for that slot, so nothing is cropped and nothing is letterboxed.

  Keyed on the CMS filename rather than the service word, because the word is
  editable copy ("Websites" could become "Web Design" tomorrow) while the
  filename identifies the artwork. A filename with no entry here just falls
  through to the desktop image, which is the old letterboxed look rather than a
  broken one.
*/
const MOBILE_HERO_ART: Record<string, ImageMetadata> = {
  'hero-websites-stack': mobileHeroWebsites,
  'hero-brand-identity-real-r3': mobileHeroBrand,
  'hero-seo-black': mobileHeroSeo,
  'hero-ai-video': mobileHeroReels,
};

const heroServices = (homepage?.heroServices && homepage.heroServices.length > 0)
  ? homepage.heroServices.map((s: any) => {
      if (typeof s === 'string') return { service: s, suffix: '', mediaUrl: defaultHeroBg.src, mimeType: 'image/jpeg', mobileUrl: null };
      const media = resolveHeroMedia(s);
      const stem = String(media?.filename || '').replace(/\.[^.]+$/, '');
      const mobileArt = MOBILE_HERO_ART[stem];
      return { service: s.service, suffix: s.suffix || '', mediaUrl: media ? (getPayloadImageSize(media, 'large') || buildPayloadImageUrl(media)) : defaultHeroBg.src, mimeType: media?.mimeType || 'image/jpeg', mobileUrl: mobileArt ? mobileArt.src : null, video: resolveVideo(media) };
    }).filter((s: any) => Boolean(s.service))
  : [
      { service: 'Websites', suffix: '', mediaUrl: (await getImage({ src: imgQuademProp, width: 800 })).src, mimeType: 'image/png' },
      { service: 'Brands', suffix: '', mediaUrl: (await getImage({ src: imgBranding, width: 800 })).src, mimeType: 'image/png' },
      { service: 'Campaigns', suffix: '', mediaUrl: (await getImage({ src: imgDigitalMarketing, width: 800 })).src, mimeType: 'image/png' },
      { service: 'Reels', suffix: '', mediaUrl: (await getImage({ src: imgVideo, width: 800 })).src, mimeType: 'image/png' },
      { service: 'Growth', suffix: '', mediaUrl: (await getImage({ src: imgSeo, width: 800 })).src, mimeType: 'image/png' }
    ];

/*
  Only the first slide is on the critical path, and the preload has to name the
  file that breakpoint actually paints. Unconditional, it made a phone fetch the
  1200x1500 portrait desktop art at high priority (74KB) and then never show it,
  because the 992px rule in HeroSection.astro swaps to the wide art whenever one
  exists. That delayed the 34KB file which is the mobile LCP.

  With no wide art for this slide the portrait file is what phones paint, so the
  preload stays unconditional.
*/
const heroFirst: any = heroServices[0];
const heroFirstIsVideo = Boolean(heroFirst?.mimeType?.startsWith('video'));
/*
  When slide one is a video its poster is what paints, and no video byte is
  fetched until script runs. So the poster is the hero LCP and gets the same
  preload the image path gets, rather than the page having no preload at all
  simply because the slide happens to be a video.
*/
const heroPreloadDesktop = heroFirstIsVideo
  ? (heroFirst?.video?.poster ?? null)
  : (heroFirst?.mediaUrl ?? null);
const heroPreloadMobile = !heroFirstIsVideo && heroFirst?.mobileUrl ? heroFirst.mobileUrl : null;
const showStats = homepage?.showStats ?? false;
const trustHighlights = homepage?.trustHighlights ?? [];
const riskReversal = homepage?.riskReversal ?? {};

// Fallbacks for homepage fields
const founderTitle = aboutData?.headline || homepage?.founderTitle || "Hey, I'm the face behind Quadem Digital.";
const bioRaw = aboutData?.bio || "I started this agency with one simple belief: great design and smart strategy shouldn't just look good, they should make you money.\n\nAt bigger agencies you're often just another account number. Quadem works as your digital growth partner instead, so you get direct communication, quick execution and someone who actually cares about your bottom line.\n\nNeed a high-converting website, a fresh brand identity, or a marketing campaign that works? I've got you covered.";
const founderText = aboutData?.bio ? bioRaw.split('\n').filter((p: string) => p.trim() !== '') : (homepage?.founderText ? homepage.founderText.map((item: any) => item.paragraph) : bioRaw.split('\n').filter((p: string) => p.trim() !== ''));
const newsletterHeading = homepage?.newsletterHeading || "Get weekly digital growth tips for free";
const newsletterSubheading = homepage?.newsletterSubheading || "Join my community of founders and creators building better brands.";

// Contact section fields
const contactHeading = homepage?.contactHeading || "Let's build something great";
const contactSubheading = homepage?.contactSubheading || "Fill out the form below or chat directly with me on WhatsApp to get started.";
const contactInfoTitle = homepage?.contactInfoTitle || "Get in Touch";
const contactInfoText = homepage?.contactInfoText || "I'm ready to help you scale your business. Reach out today and let's start the conversation.";
const contactWhatsappButtonText = homepage?.contactWhatsappButtonText || "Chat on WhatsApp";
const contactSubmitButtonText = homepage?.contactSubmitButtonText || "Send Message";
const contactFormSuccessMessage = homepage?.contactFormSuccessMessage || "Thanks for reaching out! I'll be in touch shortly.";
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";
const contactEmail = siteSettings?.email || "hello@quademdigital.com";
const socialLinks = siteSettings?.socialLinks || [];
const getSocialLink = (platform: string) => socialLinks.find((l: any) => l.platform === platform)?.url;

// Extract Founder Image if it exists
let founderImageUrl = null;
const imageDoc = aboutData?.founderImage || homepage?.founderImage;
if (imageDoc) {
    founderImageUrl = getPayloadImageSize(imageDoc, 'medium') || buildPayloadImageUrl(imageDoc);
}

/*
  Structured data.

  LocalBusiness rather than Organization: this is a studio serving a named city,
  and LocalBusiness is what earns the map/knowledge treatment. FAQPage is added
  from the FAQs already in the CMS: the cheapest expanded search result
  available here. Both ride in an @graph because the layout emits one JSON-LD
  block per page.

  The phone number is omitted entirely rather than emitted as the placeholder:
  whatsappNumber falls back to the literal "1234567890", and publishing that as
  structured data is worse than publishing nothing.
*/
const hasRealPhone = Boolean(siteSettings?.whatsappNumber);

const schemaFaqs = (faqs ?? [])
  .filter((f: any) => f?.question && f?.answer)
  .map((f: any) => ({
    "@type": "Question",
    "name": f.question,
    "acceptedAnswer": { "@type": "Answer", "text": f.answer },
  }));

const jsonLd = {
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "LocalBusiness",
      "@id": "https://quademdigital.com/#business",
      "name": "Quadem Digital Enterprise",
      "image": "https://quademdigital.com/images/logo.webp",
      "url": "https://quademdigital.com",
      ...(hasRealPhone ? { "telephone": `+${whatsappNumber}` } : {}),
      "email": contactEmail,
      "description": heroTagline,
      "priceRange": "$$",
      "address": {
        "@type": "PostalAddress",
        "addressLocality": "Accra",
        "addressCountry": "GH",
      },
      "areaServed": [
        { "@type": "Country", "name": "Ghana" },
        { "@type": "AdministrativeArea", "name": "Worldwide" },
      ],
      "sameAs": socialLinks.map((l: any) => l.url).filter(Boolean),
    },
    ...(schemaFaqs.length > 0
      ? [{ "@type": "FAQPage", "@id": "https://quademdigital.com/#faq", "mainEntity": schemaFaqs }]
      : []),
  ],
};

const seo = resolveSeo(homepage, {
  title: "Quadem Digital Enterprise | Full-Service Digital Agency",
  description: "Quadem Digital Enterprise is a full-service digital agency offering web design, digital marketing, branding, AI video and reels, and SEO services.",
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="home" jsonLd={jsonLd}>
    <Fragment slot="head">
        {heroPreloadDesktop && (
            <link rel="preload" as="image" href={heroPreloadDesktop} media={heroPreloadMobile ? '(min-width: 993px)' : undefined} />
        )}
        {heroPreloadMobile && (
            <link rel="preload" as="image" href={heroPreloadMobile} media="(max-width: 992px)" />
        )}
    </Fragment>
    <HeroSection heroHeadline={heroHeadline} heroTagline={heroTagline} heroServices={heroServices} heroSubheadline={heroSubheadline} primaryCta={primaryCta} secondaryCta={secondaryCta} />

    <!-- Risk reversal. Unconditional by design: the CMS defaultValue only
         applies when the document is first created, so on an older saved
         Homepage doc heading/body are null and this silently disappeared. The
         copy below is the fallback, not a placeholder. -->
    <section class="risk-strip" id="risk-reversal">
        <div class="container risk-strip-inner">
            <span class="risk-strip-icon" aria-hidden="true">🛡️</span>
            <p class="risk-strip-text">
                {riskReversal?.body || "Clear scope · Weekly updates · If I don't deliver what I agreed, you don't pay."}
            </p>
            <a
                href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(siteSettings?.whatsappMessage || "Hi, I'd like to discuss a project with Quadem Digital.")}`}
                target="_blank" rel="noopener noreferrer"
                class="risk-strip-cta"
                data-track="whatsapp_click" data-loc="risk-strip"
            >Let's talk, zero pressure →</a>
        </div>
    </section>

    <SocialProof stats={stats} siteSettings={siteSettings} showStats={showStats} trustHighlights={trustHighlights} />



    {promoCards.length > 0 ? (
        promoCards.map(({ Component, ...card }: any) => (
            <Component
                badge={card.badge}
                heading={card.heading}
                headingAccent={card.headingAccent}
                body={card.body}
                ctaLabel={card.ctaLabel}
                ctaUrl={card.ctaUrl}
                idSuffix={card.idSuffix}
            />
        ))
    ) : (
        <>
            <VideoPromoSection />
            <WebDesignPromoSection />
            <BrandIdentityPromoSection />
            <SeoPromoSection />
        </>
    )}

    {/* Section 4.5: In-House Products / Webapps */}
    {webapps && webapps.length > 0 && (
        <section class="section-padding" id="products">
            <div class="container">
                <div class="section-header text-center animate-on-scroll slide-up">
                    <span class="badge premium-badge">In-House Products</span>
                    <h2>Software I'm <span class="text-gradient">Building</span></h2>
                    <p>Beyond client work, I build my own tools and platforms to solve real problems for businesses.</p>
                </div>
                
                <div class="webapp-grid mt-5">
                    {webapps.map((app: any, index: number) => (
                        <div class={`webapp-card animate-on-scroll slide-up delay-${index * 100}`}>
                            <div class="webapp-card-inner">
                                <div class="webapp-image-wrapper">
                                    {app.coverImage ? (
                                        <Picture image={app.coverImage} alt={`${app.name} Preview`} sizes="(max-width: 640px) 100vw, 600px" size="medium" width={600} height={400} class="webapp-cover" />
                                    ) : (
                                        <div class="webapp-cover-placeholder"></div>
                                    )}
                                    <div class="webapp-overlay"></div>
                                    <div class="webapp-status-badge">{app.status || 'Live'}</div>
                                </div>
                                <div class="webapp-content">
                                    <div class="webapp-header">
                                        {app.logo && (
                                            <img src={getPayloadImageSize(app.logo, 'thumbnail') || buildPayloadImageUrl(app.logo)} alt={`${app.name} Logo`} class="webapp-logo" width="100" height="100" loading="lazy" />
                                        )}
                                        <h3>{app.name}</h3>
                                    </div>
                                    <p class="webapp-tagline">{app.tagline}</p>
                                    <p class="webapp-description">{app.description}</p>
                                    <a href={app.link === '/store-manager' ? 'https://quaderp.app' : (app.link || '#')} class="btn btn-outline btn-sm mt-3 webapp-btn">
                                        {app.status === 'Live' ? 'Explore Platform' : 'View Details'}
                                    </a>
                                </div>
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        </section>
    )}

    <FeaturedWork fetchedCaseStudies={fetchedCaseStudies} />

    <ProcessSection processSteps={processSteps} />

    <TestimonialsSection testimonials={testimonials} />
    <PricingSection pricingPlans={pricingPlans} calculatorServices={calculatorServices} whatsappNumber={whatsappNumber} />


    {/* Section 9: About / Founder Story */}
    <section class="about section-padding" id="about">
        <div class="container">
            <div class="about-grid">
                <div class="about-image-col animate-on-scroll slide-right">
                    <div class="about-image-wrapper glow-effect">
                        {founderImageUrl ? (
                            <Picture image={imageDoc} alt="Founder" sizes="(max-width: 640px) 45vw, 600px" size="medium" width={600} height={800} style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" />
                        ) : (
                            <Image src={founderMock} alt="Founder" widths={[300, 600]} sizes="(max-width: 640px) 45vw, 600px" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;" loading="lazy" />
                        )}
                    </div>
                </div>
                <div class="about-content-col animate-on-scroll slide-left delay-200">
                    <h2 class="about-title"><span class="text-gradient">{founderTitle}</span></h2>
                    {founderText.map((p: string) => (
                        <p class="about-text">{p}</p>
                    ))}
                    <a href="/contact/" class="btn btn-primary btn-pill glow-effect mt-4">Let's Work Together</a>
                </div>
            </div>
        </div>
    </section>

    {/* Section 10: Newsletter / Community */}
    <section class="newsletter section-padding" id="newsletter">
        <div class="container newsletter-container">
            <div class="newsletter-content">
                <h2>{newsletterHeading}</h2>
                <p>{newsletterSubheading}</p>
            </div>
            <form class="newsletter-form" id="newsletterForm" action="/api/newsletter/" method="POST">
                <label for="mainNewsletterEmail" class="sr-only">Email address</label>
                <input type="email" id="mainNewsletterEmail" name="email" placeholder="Enter your email address" required class="newsletter-input">
                <button type="submit" class="btn btn-primary newsletter-btn glow-effect">Subscribe</button>
            </form>
            <p class="newsletter-microcopy">No spam. Unsubscribe anytime.</p>
        </div>
    </section>

    <FAQSection faqs={faqs} />

    {/* Section 11: Contact / Book a Call */}
    <section class="contact section-padding" id="contact">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">{contactHeading}</span></h2>
                <p>{contactSubheading}</p>
            </div>
            
            <div class="contact-grid">
                <div class="contact-info animate-on-scroll slide-right">
                    <h3 class="contact-subtitle">{contactInfoTitle}</h3>
                    <p class="contact-text">{contactInfoText}</p>
                    
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(siteSettings?.whatsappMessage || "Hi Quadem Digital! I'd like to discuss a project.")}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect mb-4 w-100">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        {contactWhatsappButtonText}
                    </a>
                    
                    <a href={`mailto:${contactEmail}`} class="contact-email">{contactEmail}</a>
                    
                    <div class="social-links">
                        <a href={getSocialLink('linkedin') || '#'} aria-label="LinkedIn">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                        </a>
                        <a href={getSocialLink('instagram') || '#'} aria-label="Instagram">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                        </a>
                        <a href={getSocialLink('twitter') || '#'} aria-label="Twitter/X">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
                        </a>
                    </div>
                </div>
                
                <div class="contact-form-container animate-on-scroll slide-left delay-200">
                    <form class="contact-form" id="contactForm" action="/api/submit-form/" method="POST">
                        <input type="hidden" name="source" value="homepage">
                        <div class="form-group" id="formSuccess" style="display: none; background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); padding: 16px; border-radius: 8px; margin-bottom: 20px; color: var(--accent-text);">
                            {contactFormSuccessMessage}
                        </div>
                        <div class="form-group" id="formError" style="display: none; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 16px; border-radius: 8px; margin-bottom: 20px; color: #ef4444;">
                            Something went wrong. Please try again or use WhatsApp.
                        </div>
                        <div class="form-group">
                            <label for="homeName">Name</label>
                            <input type="text" id="homeName" name="name" required placeholder="John Doe">
                        </div>
                        <div class="form-group">
                            <label for="homeEmail">Email</label>
                            <input type="email" id="homeEmail" name="email" required placeholder="john@example.com">
                        </div>
                        <div class="form-group">
                            <label for="homeService">Service Interested In</label>
                            <select id="homeService" name="services[]" required>
                                <option value="" disabled selected>Select a service...</option>
                                <option value="web">Web Design & Development</option>
                                <option value="marketing">Digital Marketing</option>
                                <option value="branding">Branding & Design</option>
                                <option value="video">AI Video &amp; Reels</option>
                                <option value="seo">SEO & Paid Ads</option>
                                <option value="other">Other / Custom Package</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="homeMessage">Message</label>
                            <textarea id="homeMessage" name="message" rows="4" required placeholder="Tell me about your project..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-ghost btn-pill w-100" id="contactSubmitBtn">{contactSubmitButtonText}</button>
                    </form>
                </div>
            </div>
        </div>
    </section>

</BaseLayout>
