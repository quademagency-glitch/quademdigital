---
import { PORTRAIT_MEDIA_SIZES, SPLIT_MEDIA_SIZES } from "../lib/mediaPresentation";
import StrokeIcon from '../components/StrokeIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import { payloadFetch, payloadFetchGlobal, safeHref } from '../lib/payload';
import { resolveBookingHref } from '../lib/booking';
import { resolveSeo } from '../lib/seo';
import { normaliseLocalHref } from '../lib/publicSettings.js';
import SocialProof from '../components/home/SocialProof.astro';
import TestimonialsSection from '../components/home/TestimonialsSection.astro';
import ContactSection from '../components/home/ContactSection.astro';
import ProductsSection from '../components/home/ProductsSection.astro';
import Picture from '../components/Picture.astro';
import FeaturedWork from '../components/home/FeaturedWork.astro';
import ProcessSection from '../components/home/ProcessSection.astro';
import PricingSection from '../components/home/PricingSection.astro';
import FAQSection from '../components/home/FAQSection.astro';
import ServiceStories from '../components/home/ServiceStories.astro';
import workImages from '../lib/workImageManifest.json';
const [about, studies, settings, steps, plans, faqs, posts, homepage, cmsServices, stats, testimonials, webapps] = await Promise.all([
  payloadFetchGlobal('about'), payloadFetch('caseStudies', { sort: 'order' }),
  payloadFetchGlobal('siteSettings'), payloadFetch('processSteps', { sort: 'stepNumber' }),
  payloadFetch('pricingPlans', { sort: 'order' }), payloadFetch('faqs', { sort: 'order' }),
  payloadFetch('blogPosts', { sort: '-publishedAt', depth: '1' }),
  payloadFetchGlobal('homepage'), payloadFetch('services', { sort: 'order' }),
  payloadFetch('stats', { sort: 'order' }), payloadFetch('testimonials', { sort: 'order' }), payloadFetch('webapps', { sort: 'order' }),
]);
const serviceNames = cmsServices.map((service: any) => service.title);
const latestPosts = posts.filter((post: any) => post.slug).slice(0, 3);
const founder = about?.founderImage || homepage?.founderImage;
const founderTitle = about?.headline || homepage?.founderTitle || 'Your project. My full attention.';
const founderText = about?.bio ? about.bio.split(/\n+/).filter(Boolean) : (homepage?.founderText || []).map((item: any) => item.paragraph).filter(Boolean);
const heroWords = (homepage?.heroServices || []).map((item: any) => item.service).filter(Boolean);
const heroHeadline = (homepage?.heroHeadline || '| for businesses ready to grow.').replace('|', heroWords.join(', ') || 'Websites, brands and content');
const heroTagline = homepage?.heroTagline || 'You work directly with the founder.';
const primaryCta = homepage?.primaryCta || { label: 'Book a Free Strategy Call', link: '#contact' };
const secondaryCta = homepage?.secondaryCta || { label: 'View Our Work', link: '#work' };
const riskReversal = homepage?.riskReversal;
const hero = homepage?.heroPresentation || {};
const heroImage = hero.image || workImages['home-studio'];
const heroCaption = hero.caption ?? (hero.image ? '' : 'Omek (in progress) · QuajoSpeaks (internal)');
const heroCredit = hero.credit ?? (hero.image ? '' : 'AI-assisted studio scene featuring our work');
const heroMeta = (homepage?.heroMetaLabels || 'Founder-led digital studio,Ghana & worldwide').split(',').map((s: string) => s.trim()).filter(Boolean).slice(0, 4);
const seo = resolveSeo(homepage, { title: 'Quadem Digital Enterprise | Full-Service Digital Agency', description: 'Quadem Digital Enterprise is a full-service digital agency offering web design, digital marketing, branding, AI video and reels, and SEO services.' });
const jsonLd = { '@context': 'https://schema.org', '@graph': [
  { '@type': 'LocalBusiness', '@id': 'https://quademdigital.com/#business', name: settings?.title || 'Quadem Digital Enterprise', url: 'https://quademdigital.com', description: heroTagline, priceRange: '$$', image: 'https://quademdigital.com/images/logo.webp', email: settings?.email || 'ernest@quademdigital.com', ...(settings?.whatsappNumber ? { telephone: `+${settings.whatsappNumber}` } : {}), address: { '@type': 'PostalAddress', ...(settings?.address ? { streetAddress: String(settings.address).split(',')[0].trim() } : {}), addressLocality: 'Accra', addressCountry: 'GH' }, areaServed: [{ '@type': 'Country', name: 'Ghana' }, { '@type': 'AdministrativeArea', name: 'Worldwide' }], sameAs: (settings?.socialLinks || []).map((link: any) => link.url).filter(Boolean) },
  ...(faqs.length ? [{ '@type': 'FAQPage', '@id': 'https://quademdigital.com/#faq', mainEntity: faqs.filter((faq: any) => faq.question && faq.answer).map((faq: any) => ({ '@type': 'Question', name: faq.question, acceptedAnswer: { '@type': 'Answer', text: faq.answer } })) }] : []),
] };
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="home" jsonLd={jsonLd}>
  <div class="lab-hero-scene">
  <section class="lab-hero q-story-hero" aria-labelledby="home-title">
    <div class="q-hero-studio-media">
      <Picture class="lab-hero-image" image={heroImage} alt={hero.image?.alt || ''} sizes="100vw" priority />
    </div>
    <div class="q-hero-content">
      <p class="lab-hero-eyebrow">{homepage?.heroEyebrow || 'Websites. Brands. Content. / Made in Accra.'}</p>
      <h1 id="home-title"><span class="lab-hero-display">{hero.heading || 'Make your business'}</span><span class="lab-hero-italic">{hero.accent || 'the clear choice.'}</span></h1>
      <div class="lab-hero-intro">
        <p>{hero.body || 'A sharper brand. A better website. A clearer path from first impression to enquiry.'}</p>
        <div class="studio-actions q-hero-actions">
          {primaryCta.label && <a href={resolveBookingHref(safeHref(normaliseLocalHref(primaryCta.link)), primaryCta.label)} class="btn btn-primary btn-pill" data-track="hero_primary_cta" data-loc="home-hero">{primaryCta.label}<StrokeIcon /></a>}
          {secondaryCta.label && <a href={safeHref(normaliseLocalHref(secondaryCta.link)) || '#work'} class="q-hero-work" data-track="hero_secondary_cta" data-loc="home-hero">{secondaryCta.label}<StrokeIcon /></a>}
        </div>
        <p class="q-hero-note">{hero.note || `Work directly with ${about?.founderName || 'Ernest'}, from your first conversation to launch.`}</p>
      </div>
    </div>
    {(heroCaption || heroCredit) && <p class="q-hero-credit">{heroCaption}{heroCaption && heroCredit && <br />}{heroCredit}</p>}
    <div class="q-hero-baseline">{heroMeta[0] && <span>{heroMeta[0]}</span>}<a href="#services">Find your next step<StrokeIcon /></a>{heroMeta.slice(1).map((label: string) => <span>{label}</span>)}</div>
  </section>
  </div>

  <div class="lab-service-ribbon" aria-label="Our services">
    <div class="lab-ribbon-track">
      {[0, 1].map(copy => <div class="lab-ribbon-group" aria-hidden={copy === 1 ? 'true' : undefined}>{serviceNames.map(name => <span><i aria-hidden="true">/</i>{name}</span>)}</div>)}
    </div>
  </div>
  <section class="lab-intro-band" id="brand">
    <div class="container">
      <div class="lab-origin">
        {riskReversal?.enabled !== false && riskReversal?.heading ? <><h3>{riskReversal.heading}</h3><p>{riskReversal.body}</p></> : <><span>Based in Accra</span><span>Working worldwide</span></>}
        <a href="/about/">Direct with {about?.founderName || 'Ernest'} <span aria-hidden="true"><StrokeIcon /></span></a>
      </div>
      <div><h2 data-scroll-statement>{heroHeadline}</h2>{homepage?.heroSubheadline && <p>{homepage.heroSubheadline}</p>}<div class="studio-actions lab-cms-actions">
        {primaryCta.label && <a href={resolveBookingHref(safeHref(normaliseLocalHref(primaryCta.link)), primaryCta.label)} class="btn btn-primary btn-pill" data-track="hero_primary_cta" data-loc="home-hero">{primaryCta.label}<StrokeIcon /></a>}
        {secondaryCta.label && <a href={safeHref(normaliseLocalHref(secondaryCta.link)) || '#work'} class="btn btn-ghost btn-pill" data-track="hero_secondary_cta" data-loc="home-hero">{secondaryCta.label}<StrokeIcon /></a>}
      </div></div>
    </div>
  </section>
  <ServiceStories homepage={homepage} services={cmsServices} />
  <SocialProof stats={stats} siteSettings={settings} showStats={homepage?.showStats ?? false} trustHighlights={homepage?.trustHighlights || []} />

  <FeaturedWork fetchedCaseStudies={studies} />
  <ProcessSection processSteps={steps} />
  <ProductsSection webapps={webapps} />

  <section class="section-padding lab-founder" id="about">
    <div class="container studio-founder-panel">
      <div class="studio-founder-image">{founder && <Picture image={founder} alt={founder.alt || `${about?.founderName || 'Ernest'}, founder of Quadem Digital`} sizes={PORTRAIT_MEDIA_SIZES} size="medium" width={600} height={600} />}</div>
      <div>
        <h2>{founderTitle}</h2>
        {founderText.map((paragraph: string) => <p>{paragraph}</p>)}
        <a href="/about/" class="btn btn-ghost btn-pill">A little more about me <span aria-hidden="true"><StrokeIcon /></span></a>
      </div>
    </div>
  </section>

  <TestimonialsSection testimonials={testimonials} />
  <PricingSection pricingPlans={plans} calculatorServices={[]} whatsappNumber={settings?.whatsappNumber || ''} showCalculator={false} />
  <FAQSection faqs={faqs} />

  {latestPosts.length > 0 && <section class="section-padding lab-insights">
    <div class="container">
      <div class="section-header"><h2>Ideas worth sharing.</h2><p>Practical notes on websites, search and building a business online.</p></div>
      <div class="lab-insights-grid">{latestPosts.map((post: any, index: number) => <a href={`/blog/${post.slug}/`} class:list={['lab-article', {'lab-article-featured': index === 0}]}>
        {post.coverImage && <Picture image={post.coverImage} alt={post.coverImage.alt || post.title} sizes={SPLIT_MEDIA_SIZES} size="large" width={600} height={400} />}
        <div><span>{post.category?.title || 'From the studio'}</span><h3>{post.title}</h3>{post.excerpt && <p>{post.excerpt}</p>}<strong>Read the article <span aria-hidden="true"><StrokeIcon /></span></strong></div>
      </a>)}</div>
      <div class="studio-section-link"><a href="/blog/">Explore all insights <span aria-hidden="true"><StrokeIcon /></span></a></div>
    </div>
  </section>}

  <ContactSection homepage={homepage} settings={settings} services={cmsServices} />
</BaseLayout>
