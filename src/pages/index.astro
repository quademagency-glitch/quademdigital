---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";

const homepage = await sanityClient.fetch(`*[_type == "homepage"][0]`);
const fetchedServices = await sanityClient.fetch(`*[_type == "service"] | order(order asc)`);
const fetchedCaseStudies = await sanityClient.fetch(`*[_type == "caseStudy"] | order(order asc)`);

const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
const stats = await sanityClient.fetch(`*[_type == "stat"] | order(order asc)`);
const processSteps = await sanityClient.fetch(`*[_type == "processStep"] | order(stepNumber asc)`);
const pricingPlans = await sanityClient.fetch(`*[_type == "pricingPlan"] | order(order asc)`);
const testimonials = await sanityClient.fetch(`*[_type == "testimonial"] | order(order asc)`);
const faqs = await sanityClient.fetch(`*[_type == "faq"] | order(order asc)`);

const heroHeadline = homepage?.heroHeadline || "We ";
const heroTagline = homepage?.heroTagline || "Elevating brands with premium design and data-driven strategies.";
const heroServices = homepage?.heroServices || ["build websites", "grow brands", "create content", "run your ads", "design identities"];

// Fallbacks for homepage fields
const founderTitle = homepage?.founderTitle || "Hey, I'm the face behind Quadem Digital.";
const founderText = homepage?.founderText || [
    "I started this agency with one simple belief: great design and smart strategy shouldn't just look good—they should make you money.",
    "Unlike huge, bloated agencies where you're just another account number, Quadem operates as your personal digital growth partner. When you work with us, you get direct communication, rapid execution, and a team that genuinely cares about your bottom line.",
    "Whether you need a high-converting website, a fresh brand identity, or a marketing campaign that actually works, we've got you covered."
];
const newsletterHeading = homepage?.newsletterHeading || "Get weekly digital growth tips for free";
const newsletterSubheading = homepage?.newsletterSubheading || "Join our community of founders and creators building better brands.";

// Contact section fields
const contactHeading = homepage?.contactHeading || "Let's build something great";
const contactSubheading = homepage?.contactSubheading || "Fill out the form below or chat directly with us on WhatsApp to get started.";
const contactInfoTitle = homepage?.contactInfoTitle || "Get in Touch";
const contactInfoText = homepage?.contactInfoText || "We're ready to help you scale your business. Reach out today and let's start the conversation.";
const contactWhatsappButtonText = homepage?.contactWhatsappButtonText || "Chat on WhatsApp";
const contactSubmitButtonText = homepage?.contactSubmitButtonText || "Send Message";
const contactFormSuccessMessage = homepage?.contactFormSuccessMessage || "Thanks for reaching out! We'll be in touch shortly.";
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";
const contactEmail = siteSettings?.email || "hello@quademdigital.com";
const socialLinks = siteSettings?.socialLinks || {};

// Extract Founder Image if it exists
let founderImageUrl = null;
if (homepage?.founderImage?.asset?._ref) {
    founderImageUrl = `https://cdn.sanity.io/images/xectqauu/production/${homepage.founderImage.asset._ref.replace('image-', '').replace('-jpg', '.jpg').replace('-png', '.png').replace('-webp', '.webp').replace('-jpeg', '.jpeg')}?auto=format&fit=max&w=800&q=80`;
}
---
<BaseLayout title="Quadem Digital Enterprise | Full-Service Digital Agency" description="Quadem Digital Enterprise is a full-service digital agency offering web design, digital marketing, branding, video production, and SEO services." activePage="home">
    <!-- Section 2 — Hero -->
    <section class="hero" id="hero">
        <!-- Advanced Interchangeable Background -->
        <div class="hero-bg-container">
            <!-- Layer 0: Animated Gradient -->
            <div class="hero-animated-gradient"></div>
            <!-- Layer 1: Gradient Mesh -->
            <div class="bg-gradient-mesh active-bg"></div>
            
            <!-- Layer 2: Slideshow -->
            <div class="bg-slideshow">
                <div class="slide" style="background-image: url('/images/yuyu-irridiscense.jpg');"></div>
                <div class="slide" style="background-image: url('/images/yuyu-naya-ai.jpg');"></div>
            </div>
            
            <!-- Layer 3: Panning Grid -->
            <div class="bg-panning-grid">
                <div class="grid-track">
                    <!-- We will fill this with repeating images via CSS/JS -->
                </div>
            </div>
            
            <!-- Layer 4: Floating 3D Assets -->
            <img src="/images/quadem-prop-1.png" alt="" class="premium-shape shape-1">
            <img src="/images/quadem-prop-2.png" alt="" class="premium-shape shape-2">
            <img src="/images/quadem-prop-3.png" alt="" class="premium-shape shape-3">
            
            <!-- Overall Overlay to ensure text readability -->
            <div class="hero-overlay"></div>
            <div class="hero-noise"></div>
        </div>
        
        <div class="container hero-container">
            <h1 class="hero-title">
                {heroHeadline} <span class="typewriter text-gradient" id="typewriter" data-services={JSON.stringify(heroServices)}></span><span class="cursor text-gradient">|</span>
            </h1>
            <p class="hero-subtitle">{heroTagline}</p>
            <div class="hero-ctas">
                <a href="/contact" class="btn btn-primary btn-pill glow-effect">Book a Free Call</a>
                <a href="/projects" class="btn btn-ghost btn-pill">See Our Projects</a>
            </div>
        </div>
    </section>

    <!-- Section 3 — Social Proof Strip -->
    <section class="stats-strip" id="stats">
        <div class="container stats-container">
            {stats && stats.length > 0 ? (
                stats.map((stat: any, index: number) => (
                    <>
                        <div class="stat-item">
                            <h3 class="stat-number" data-target={stat.value}>0</h3>
                            <p class="stat-label">{stat.label}</p>
                        </div>
                        {index < stats.length - 1 && <div class="stat-divider"></div>}
                    </>
                ))
            ) : (
                <!-- Static Fallback -->
                <div class="stat-item">
                    <h3 class="stat-number" data-target="150">0</h3>
                    <p class="stat-label">Projects Delivered</p>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <h3 class="stat-number" data-target="98">0</h3>
                    <p class="stat-label">Happy Clients</p>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <h3 class="stat-number" data-target="5">0</h3>
                    <p class="stat-label">Services Offered</p>
                </div>
                <div class="stat-divider"></div>
                <div class="stat-item">
                    <h3 class="stat-number" data-target="7">0</h3>
                    <p class="stat-label">Years Active</p>
                </div>
            )}
        </div>
    </section>

    <!-- Trust Bar / Client Marquee -->
    <section class="trust-bar">
        <p class="section-label">Trusted by forward-thinking brands</p>
        <div class="marquee-track">
            {siteSettings?.clientLogos && siteSettings.clientLogos.length > 0 ? (
                <>
                    {siteSettings.clientLogos.map((logo: any) => (
                        <>
                            <span class="marquee-item-logo">
                                <img src={`https://cdn.sanity.io/images/xectqauu/production/${logo.asset._ref.replace('image-', '').replace('-jpg', '.jpg').replace('-png', '.png').replace('-webp', '.webp').replace('-jpeg', '.jpeg')}?h=40&auto=format`} alt="Client Logo" style="height: 40px; filter: grayscale(100%); opacity: 0.7; margin: 0 30px;" />
                            </span>
                            <span class="marquee-dot"></span>
                        </>
                    ))}
                    {siteSettings.clientLogos.map((logo: any) => (
                        <>
                            <span class="marquee-item-logo">
                                <img src={`https://cdn.sanity.io/images/xectqauu/production/${logo.asset._ref.replace('image-', '').replace('-jpg', '.jpg').replace('-png', '.png').replace('-webp', '.webp').replace('-jpeg', '.jpeg')}?h=40&auto=format`} alt="Client Logo" style="height: 40px; filter: grayscale(100%); opacity: 0.7; margin: 0 30px;" />
                            </span>
                            <span class="marquee-dot"></span>
                        </>
                    ))}
                </>
            ) : (
                <>
                    <span class="marquee-item">TechFlow Solutions</span><span class="marquee-dot"></span>
                    <span class="marquee-item">Nova Retail Group</span><span class="marquee-dot"></span>
                    <span class="marquee-item">Meridian Health</span><span class="marquee-dot"></span>
                    <span class="marquee-item">Atlas Ventures</span><span class="marquee-dot"></span>
                    <span class="marquee-item">TechFlow Solutions</span><span class="marquee-dot"></span>
                    <span class="marquee-item">Nova Retail Group</span><span class="marquee-dot"></span>
                    <span class="marquee-item">Meridian Health</span><span class="marquee-dot"></span>
                    <span class="marquee-item">Atlas Ventures</span><span class="marquee-dot"></span>
                </>
            )}
        </div>
    </section>

    <!-- Section 4 — Services -->
    <section class="services section-padding" id="services">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Our Services</span></h2>
                <p>Everything you need to scale your brand digitally, all in one place.</p>
            </div>
            
            <div class="services-grid">
                {fetchedServices && fetchedServices.length > 0 ? (
                    fetchedServices.map((service, index) => (
                        <div class={`service-card glow-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                            <div class="service-icon" set:html={service.iconSvg || '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg>'} />
                            <h3 class="service-title">{service.title}</h3>
                            <p class="service-desc">{service.description}</p>
                            {service.tags && service.tags.length > 0 && (
                                <div class="service-tags">
                                    {service.tags.map(tag => <span>{tag}</span>)}
                                </div>
                            )}
                        </div>
                    ))
                ) : (
                    <!-- Fallback to static if empty in CMS -->
                    <>
                        <div class="service-card glow-card animate-on-scroll slide-up delay-100">
                            <div class="service-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                            </div>
                            <h3 class="service-title">Web Design & Development</h3>
                            <p class="service-desc">Custom, responsive websites built to convert visitors into loyal customers.</p>
                            <div class="service-tags">
                                <span>Custom Websites</span>
                                <span>Landing Pages</span>
                                <span>E-commerce</span>
                            </div>
                        </div>
                        <div class="service-card glow-card animate-on-scroll slide-up delay-200">
                            <div class="service-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                            </div>
                            <h3 class="service-title">Digital Marketing & Social Media</h3>
                            <p class="service-desc">Engaging content and strategies to grow your audience and brand presence.</p>
                            <div class="service-tags">
                                <span>Strategy</span>
                                <span>Content Calendar</span>
                                <span>Page Management</span>
                            </div>
                        </div>
                        <div class="service-card glow-card animate-on-scroll slide-up delay-300">
                            <div class="service-icon">
                                <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                            </div>
                            <h3 class="service-title">Branding & Graphic Design</h3>
                            <p class="service-desc">Distinct visual identities that make your brand memorable and professional.</p>
                            <div class="service-tags">
                                <span>Logo Design</span>
                                <span>Brand Kit</span>
                                <span>Visual Identity</span>
                            </div>
                        </div>
                    </>
                )}
            </div>
        </div>
    </section>

    <!-- Section 5 — Case Studies -->
    <section class="work section-padding" id="work">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Featured Work</span></h2>
                <p>Real results for real businesses. See how we've helped our clients grow.</p>
            </div>
            
            <div class="work-grid">
                {fetchedCaseStudies && fetchedCaseStudies.length > 0 ? (
                    fetchedCaseStudies.map((study, index) => (
                        <div class={`work-card glow-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                            <a href={study.slug?.current ? `/projects/${study.slug.current}` : '#'} style="display: block; overflow: hidden; border-radius: 12px 12px 0 0;">
                                <div class="work-img">
                                    {study.coverImage ? (
                                        <img src={`https://cdn.sanity.io/images/xectqauu/production/${study.coverImage.asset._ref.replace('image-', '').replace('-jpg', '.jpg').replace('-png', '.png').replace('-webp', '.webp').replace('-jpeg', '.jpeg')}?auto=format&fit=max&w=800&q=80`} alt={study.title} loading="lazy" style="width:100%; height:100%; object-fit:cover;" />
                                    ) : (
                                        <img src="/images/case-study-1-mock.jpg" alt="Cover Image" loading="lazy" style="width:100%; height:100%; object-fit:cover;" />
                                    )}
                                </div>
                            </a>
                            <div class="work-content">
                                <span class="work-tag">{study.tag}</span>
                                <h3 class="work-title">{study.title}</h3>
                                <p class="work-desc">{study.description}</p>
                                <div class="work-result">
                                    <span class="result-metric">{study.resultMetric}</span>
                                    <span class="result-text">{study.resultText}</span>
                                </div>
                                <a href={study.slug?.current ? `/projects/${study.slug.current}` : '#'} class="work-link">Read Case Study →</a>
                            </div>
                        </div>
                    ))
                ) : (
                    <!-- Fallback to static if empty in CMS -->
                    <>
                        <div class="work-card glow-card animate-on-scroll slide-up delay-100">
                            <a href="/case-study-1" style="display: block; overflow: hidden; border-radius: 12px 12px 0 0;">
                                <div class="work-img">
                                    <img src="/images/case-study-1-mock.jpg" alt="Cover Image 1" loading="lazy" style="width:100%; height:100%; object-fit:cover;" />
                                </div>
                            </a>
                            <div class="work-content">
                                <span class="work-tag">E-commerce</span>
                                <h3 class="work-title">Revamping an Online Store for Higher Conversions</h3>
                                <p class="work-desc">We completely redesigned the user experience, leading to a massive spike in sales.</p>
                                <div class="work-result">
                                    <span class="result-metric">300%</span>
                                    <span class="result-text">Increase in website traffic</span>
                                </div>
                                <a href="/case-study-1" class="work-link">Read Case Study →</a>
                            </div>
                        </div>
                        <div class="work-card glow-card animate-on-scroll slide-up delay-200">
                            <a href="/case-study-2" style="display: block; overflow: hidden; border-radius: 12px 12px 0 0;">
                                <div class="work-img">
                                    <img src="/images/case-study-2-mock.jpg" alt="Cover Image 2" loading="lazy" style="width:100%; height:100%; object-fit:cover;" />
                                </div>
                            </a>
                            <div class="work-content">
                                <span class="work-tag">SaaS Startup</span>
                                <h3 class="work-title">Scaling User Acquisition with Targeted Ads</h3>
                                <p class="work-desc">Implemented a multi-channel ad strategy to bring in high-quality leads.</p>
                                <div class="work-result">
                                    <span class="result-metric">50%</span>
                                    <span class="result-text">Reduction in CPA</span>
                                </div>
                                <a href="/case-study-2" class="work-link">Read Case Study →</a>
                            </div>
                        </div>
                    </>
                )}
            </div>
            
            <div class="work-cta">
                <a href="/projects" class="btn btn-ghost btn-pill" style="margin-right: 16px;">View All Projects</a>
                <a href="/contact" class="btn btn-primary btn-pill glow-effect">Start Your Project</a>
            </div>
        </div>
    </section>

    <!-- Section 6 — How We Work (Process) -->
    <section class="process section-padding" id="process">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">How We Work</span></h2>
                <p>A proven, transparent process to take your project from idea to reality.</p>
            </div>
            
            <div class="process-timeline">
                <div class="timeline-line"></div>
                <div class="process-steps">
                    {processSteps && processSteps.length > 0 ? (
                        processSteps.map((step: any, index: number) => (
                            <div class={`process-step animate-on-scroll slide-up delay-${(index % 4 + 1) * 100}`}>
                                <div class="step-number">{step.stepNumber}</div>
                                <h3 class="step-title">{step.title}</h3>
                                <p class="step-desc">{step.description}</p>
                            </div>
                        ))
                    ) : (
                        <!-- Fallback Static Content -->
                        <div class="process-step animate-on-scroll slide-up delay-100">
                            <div class="step-number">1</div>
                            <h3 class="step-title">Discover</h3>
                            <p class="step-desc">We learn your business, goals, and target audience inside out.</p>
                        </div>
                        <div class="process-step animate-on-scroll slide-up delay-200">
                            <div class="step-number">2</div>
                            <h3 class="step-title">Strategy</h3>
                            <p class="step-desc">We build a tailored roadmap and design system for your project.</p>
                        </div>
                        <div class="process-step animate-on-scroll slide-up delay-300">
                            <div class="step-number">3</div>
                            <h3 class="step-title">Execute</h3>
                            <p class="step-desc">We design, build, and deliver your solution at the highest standard.</p>
                        </div>
                        <div class="process-step animate-on-scroll slide-up delay-400">
                            <div class="step-number">4</div>
                            <h3 class="step-title">Deliver</h3>
                            <p class="step-desc">You get results, training, reports, and ongoing growth support.</p>
                        </div>
                    )}
                </div>
            </div>
        </div>
    </section>

    <!-- Project Cost Calculator -->
    <section class="calculator section-padding" id="calculator" style="background: rgba(0, 174, 239, 0.02);">
        <div class="container">
            <div class="section-header text-center animate-on-scroll slide-up">
                <h2>Project Cost <span class="text-gradient">Calculator</span></h2>
                <p>Get an instant estimate for your project based on your specific needs.</p>
            </div>
            
            <div class="calculator-container animate-on-scroll slide-up delay-100" style="display: grid; grid-template-columns: 1fr 350px; gap: 40px; background: rgba(255,255,255,0.03); border: 1px solid var(--border-color); border-radius: 24px; padding: 40px; max-width: 1000px; margin: 0 auto;">
                <div class="calc-options">
                    <h3 style="margin-bottom: 20px;">1. Select Services</h3>
                    <div class="calc-grid" style="display: grid; grid-template-columns: repeat(auto-fit, minmax(250px, 1fr)); gap: 16px;">
                        <label class="calc-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                            <input type="checkbox" value="5000" data-ghs="57500" data-service="Web Design & Development" style="margin-right: 12px; transform: scale(1.2);">
                            <div style="display: flex; flex-direction: column;">
                                <span class="service-name" style="font-weight: 600;">Web Design & Development</span>
                                <span class="service-price dynamic-calc-label" data-usd="5000" data-ghs="57500" style="color: var(--text-muted); font-size: 0.9rem;">From $5k</span>
                            </div>
                        </label>
                        <label class="calc-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                            <input type="checkbox" value="3500" data-ghs="40000" data-service="Branding & Identity" style="margin-right: 12px; transform: scale(1.2);">
                            <div style="display: flex; flex-direction: column;">
                                <span class="service-name" style="font-weight: 600;">Branding & Identity</span>
                                <span class="service-price dynamic-calc-label" data-usd="3500" data-ghs="40000" style="color: var(--text-muted); font-size: 0.9rem;">From $3.5k</span>
                            </div>
                        </label>
                        <label class="calc-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                            <input type="checkbox" value="2500" data-ghs="28500" data-service="SEO & Content" style="margin-right: 12px; transform: scale(1.2);">
                            <div style="display: flex; flex-direction: column;">
                                <span class="service-name" style="font-weight: 600;">SEO & Content</span>
                                <span class="service-price dynamic-calc-label" data-usd="2500" data-ghs="28500" data-cycle=" / mo" style="color: var(--text-muted); font-size: 0.9rem;">From $2.5k / mo</span>
                            </div>
                        </label>
                        <label class="calc-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                            <input type="checkbox" value="4000" data-ghs="46000" data-service="Video Production" style="margin-right: 12px; transform: scale(1.2);">
                            <div style="display: flex; flex-direction: column;">
                                <span class="service-name" style="font-weight: 600;">Video Production</span>
                                <span class="service-price dynamic-calc-label" data-usd="4000" data-ghs="46000" style="color: var(--text-muted); font-size: 0.9rem;">From $4k</span>
                            </div>
                        </label>
                    </div>

                    <h3 style="margin: 40px 0 20px;">2. Project Timeline</h3>
                    <div class="calc-timeline" style="display: flex; gap: 20px; flex-wrap: wrap;">
                        <label class="calc-radio" style="display: flex; align-items: center; cursor: pointer;">
                            <input type="radio" name="timeline" value="1" checked style="margin-right: 8px;">
                            <span class="timeline-name">Standard (4-8 weeks)</span>
                        </label>
                        <label class="calc-radio" style="display: flex; align-items: center; cursor: pointer;">
                            <input type="radio" name="timeline" value="1.25" style="margin-right: 8px;">
                            <span class="timeline-name">Expedited (+25%)</span>
                        </label>
                    </div>
                </div>

                <div class="calc-summary glow-card" style="display: flex; flex-direction: column; justify-content: center;">
                    <h3 style="margin-bottom: 16px; font-size: 1.2rem; color: var(--text-muted);">Estimated Investment</h3>
                    <div class="calc-total" id="calcTotal" style="font-size: 3rem; font-weight: 700; color: var(--accent); margin-bottom: 16px;">$0</div>
                    <p style="color: var(--text-muted); font-size: 0.9rem; margin-bottom: 32px; line-height: 1.5;">This is a rough estimate. Final scope and pricing will be determined during discovery.</p>
                    <a href="/contact" class="btn btn-primary btn-pill glow-effect" style="width: 100%; text-align: center;">Book a Strategy Call</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 7 — Pricing / Packages -->
    <section class="pricing section-padding" id="pricing">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Transparent Pricing</span></h2>
                <p>Flexible packages designed to fit businesses at any stage of growth.</p>
            </div>
            
            <div class="pricing-grid">
                {pricingPlans && pricingPlans.length > 0 ? (
                    pricingPlans.map((plan: any, index: number) => (
                        <div class={`pricing-card ${plan.isPopular ? 'popular-tier' : ''} animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                            {plan.isPopular && <div class="popular-badge">Most Popular</div>}
                            <h3 class="tier-name">{plan.name}</h3>
                            <div class="tier-price dynamic-price" data-usd={plan.priceUSD || 0} data-ghs={plan.priceGHS || 0} data-cycle={plan.billingCycle || ''}>
                                ${plan.priceUSD || 0}{plan.billingCycle || ''}
                            </div>
                            <p class="tier-desc">{plan.description}</p>
                            <ul class="tier-features">
                                {plan.features && plan.features.map((feature: string) => (
                                    <li>{feature}</li>
                                ))}
                            </ul>
                            <a href="/contact" class={`btn ${plan.isPopular ? 'btn-primary glow-effect' : 'btn-ghost'} btn-pill tier-btn`}>{plan.buttonText || 'Get Started'}</a>
                        </div>
                    ))
                ) : (
                    <!-- Fallback Static Content -->
                    <div class="pricing-card animate-on-scroll slide-up delay-100">
                        <h3 class="tier-name">Starter</h3>
                        <div class="tier-price">Custom</div>
                        <p class="tier-desc">Perfect for small businesses needing a strong foundation.</p>
                        <ul class="tier-features">
                            <li>Single service focus</li>
                            <li>Basic branding & design</li>
                            <li>Standard 5-page website</li>
                            <li>1 month post-launch support</li>
                        </ul>
                        <a href="/contact" class="btn btn-ghost btn-pill tier-btn">Get Started</a>
                    </div>
                    
                    <div class="pricing-card popular-tier animate-on-scroll slide-up delay-200">
                        <div class="popular-badge">Most Popular</div>
                        <h3 class="tier-name">Growth</h3>
                        <div class="tier-price">Custom</div>
                        <p class="tier-desc">The ideal bundle for scaling your online presence quickly.</p>
                        <ul class="tier-features">
                            <li>2–3 services bundled</li>
                            <li>Advanced custom website</li>
                            <li>Complete brand identity kit</li>
                            <li>3 months SEO & Marketing</li>
                            <li>Priority support channel</li>
                        </ul>
                        <a href="/contact" class="btn btn-primary btn-pill tier-btn glow-effect">Book a Call</a>
                    </div>
                    
                    <div class="pricing-card animate-on-scroll slide-up delay-300">
                        <h3 class="tier-name">Premium</h3>
                        <div class="tier-price">Retainer</div>
                        <p class="tier-desc">Your dedicated, full-scale digital agency partner.</p>
                        <ul class="tier-features">
                            <li>All services included</li>
                            <li>Continuous ad management</li>
                            <li>Weekly content creation</li>
                            <li>Advanced analytics & reporting</li>
                            <li>Dedicated account manager</li>
                        </ul>
                        <a href="/contact" class="btn btn-ghost btn-pill tier-btn">Let's Talk</a>
                    </div>
                )}
            </div>
            
            <div class="pricing-footer">
                <p>Not sure which plan is right for you?</p>
                <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="whatsapp-link">Chat with us on WhatsApp →</a>
            </div>
        </div>
    </section>

    <!-- Section 8 — Testimonials -->
    <section class="testimonials section-padding" id="testimonials">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">What Clients Say</span></h2>
                <p>Don't just take our word for it. Here's what our partners think.</p>
            </div>
            
            <div class="testimonial-carousel">
                <div class="testimonial-track">
                {testimonials && testimonials.length > 0 ? (
                    testimonials.map((test: any) => (
                        <div class="testimonial-card" style="position: relative;">
                            {test.videoUrl && (
                                <button class="play-video-btn" data-video-url={test.videoUrl} aria-label="Play Testimonial Video" style="position: absolute; top: 20px; right: 20px; background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); color: var(--accent); padding: 8px 16px; border-radius: 50px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; transition: 0.3s; z-index: 10;">
                                    <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>
                                    Watch Video
                                </button>
                            )}
                            <div class="testimonial-stars">{"★".repeat(test.stars || 5)}</div>
                            <p class="testimonial-quote">"{test.quote}"</p>
                            <div class="testimonial-author">
                                <div class="author-avatar">
                                    {test.avatar && test.avatar.asset && test.avatar.asset._ref ? (
                                        <img src={`https://cdn.sanity.io/images/xectqauu/production/${test.avatar.asset._ref.replace('image-', '').replace('-jpg', '.jpg').replace('-png', '.png').replace('-webp', '.webp').replace('-jpeg', '.jpeg')}?auto=format&fit=max&w=200&q=80`} alt={test.authorName} loading="lazy" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                                    ) : (
                                        <img src="/images/avatar-mock.jpg" alt={test.authorName} loading="lazy" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/>
                                    )}
                                </div>
                                <div class="author-info">
                                    <h4 class="author-name">{test.authorName}</h4>
                                    <p class="author-role">{test.authorRole}</p>
                                </div>
                            </div>
                        </div>
                    ))
                ) : (
                    <!-- Fallback Static Content -->
                    <div class="testimonial-card">
                        <div class="testimonial-stars">★★★★★</div>
                        <p class="testimonial-quote">"Quadem completely transformed our digital presence. Since launching the new site, our inbound leads have doubled. Highly recommend!"</p>
                        <div class="testimonial-author">
                            <div class="author-avatar"><img src="/images/avatar-mock.jpg" alt="Author" loading="lazy" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;"/></div>
                            <div class="author-info">
                                <h4 class="author-name">Sarah Jenkins</h4>
                                <p class="author-role">CEO, TechFlow</p>
                            </div>
                        </div>
                    </div>
                )}
                </div>
                <!-- Carousel Controls -->
                <div class="carousel-controls">
                    <button class="carousel-btn prev" aria-label="Previous testimonial">←</button>
                    <div class="carousel-dots"></div>
                    <button class="carousel-btn next" aria-label="Next testimonial">→</button>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 9 — About / Founder Story -->
    <section class="about section-padding" id="about">
        <div class="container">
            <div class="about-grid">
                <div class="about-image-col animate-on-scroll slide-right">
                    <div class="about-image-wrapper glow-effect">
                        {founderImageUrl ? (
                            <img src={founderImageUrl} alt="Founder" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;"/>
                        ) : (
                            <img src="/images/founder-mock.jpg" alt="Founder" loading="lazy" style="width: 100%; height: 100%; object-fit: cover; border-radius: 12px;"/>
                        )}
                    </div>
                </div>
                <div class="about-content-col animate-on-scroll slide-left delay-200">
                    <h2 class="about-title"><span class="text-gradient">{founderTitle}</span></h2>
                    {founderText.map((p: string) => (
                        <p class="about-text">{p}</p>
                    ))}
                    <a href="/contact" class="btn btn-primary btn-pill glow-effect mt-4">Let's Work Together</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Section 10 — Newsletter / Community -->
    <section class="newsletter section-padding" id="newsletter">
        <div class="container newsletter-container">
            <div class="newsletter-content">
                <h2>{newsletterHeading}</h2>
                <p>{newsletterSubheading}</p>
            </div>
            <form class="newsletter-form" id="newsletterForm" action="https://formspree.io/f/mbderqwy">
                <input type="email" placeholder="Enter your email address" required class="newsletter-input">
                <button type="submit" class="btn btn-primary newsletter-btn glow-effect">Subscribe</button>
            </form>
            <p class="newsletter-microcopy">No spam. Unsubscribe anytime.</p>
        </div>
    </section>

    <!-- Section 10.5 — FAQ -->
    <section class="faq section-padding" id="faq">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Frequently Asked Questions</span></h2>
                <p>Got questions? We've got answers.</p>
            </div>
            <div class="faq-search-container animate-on-scroll slide-up delay-100" style="max-width: 600px; margin: 0 auto 40px;">
                <input type="text" id="faqSearchInput" placeholder="Search questions..." style="width: 100%; padding: 16px 24px; border-radius: 50px; border: 1px solid var(--border-color); background: rgba(0,0,0,0.2); color: var(--text-color); font-size: 1.1rem; outline: none; transition: 0.3s;" />
            </div>

            <div class="faq-list">
                {faqs && faqs.length > 0 ? (
                    faqs.map((faq: any) => (
                        <div class="faq-item">
                            <button class="faq-question">
                                <span>{faq.question}</span>
                                <span class="faq-icon">+</span>
                            </button>
                            <div class="faq-answer">
                                <p>{faq.answer}</p>
                            </div>
                        </div>
                    ))
                ) : (
                    <div class="faq-item">
                        <button class="faq-question">
                            <span>How long does it take to build a website?</span>
                            <span class="faq-icon">+</span>
                        </button>
                        <div class="faq-answer">
                            <p>Most websites take 2-4 weeks from kickoff to launch. Complex projects with custom features, e-commerce, or integrations may take 4-8 weeks. We always agree on a timeline before starting.</p>
                        </div>
                    </div>
                )}
            </div>
        </div>
    </section>

    <!-- Section 11 — Contact / Book a Call -->
    <section class="contact section-padding" id="contact">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">{contactHeading}</span></h2>
                <p>{contactSubheading}</p>
            </div>
            
            <div class="contact-grid">
                <div class="contact-info animate-on-scroll slide-right">
                    <h3 class="contact-subtitle">{contactInfoTitle}</h3>
                    <p class="contact-text">{contactInfoText}</p>
                    
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hi Quadem Digital! I'd like to discuss a project.")}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect mb-4 w-100">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        {contactWhatsappButtonText}
                    </a>
                    
                    <a href={`mailto:${contactEmail}`} class="contact-email">{contactEmail}</a>
                    
                    <div class="social-links">
                        <a href={socialLinks?.linkedin || '#'} aria-label="LinkedIn">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>
                        </a>
                        <a href={socialLinks?.instagram || '#'} aria-label="Instagram">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                        </a>
                        <a href={socialLinks?.twitter || '#'} aria-label="Twitter/X">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M23 3a10.9 10.9 0 0 1-3.14 1.53 4.48 4.48 0 0 0-7.86 3v1A10.66 10.66 0 0 1 3 4s-4 9 5 13a11.64 11.64 0 0 1-7 2c9 5 20 0 20-11.5a4.5 4.5 0 0 0-.08-.83A7.72 7.72 0 0 0 23 3z"></path></svg>
                        </a>
                    </div>
                </div>
                
                <div class="contact-form-container animate-on-scroll slide-left delay-200">
                    <form class="contact-form" id="contactForm" action="https://formspree.io/f/xgobwrdw">
                        <div class="form-group" id="formSuccess" style="display: none; background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); padding: 16px; border-radius: 8px; margin-bottom: 20px; color: var(--accent);">
                            {contactFormSuccessMessage}
                        </div>
                        <div class="form-group" id="formError" style="display: none; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 16px; border-radius: 8px; margin-bottom: 20px; color: #ef4444;">
                            Something went wrong. Please try again or use WhatsApp.
                        </div>
                        <div class="form-group">
                            <label for="name">Name</label>
                            <input type="text" id="name" name="name" required placeholder="John Doe">
                        </div>
                        <div class="form-group">
                            <label for="email">Email</label>
                            <input type="email" id="email" name="email" required placeholder="john@example.com">
                        </div>
                        <div class="form-group">
                            <label for="service">Service Interested In</label>
                            <select id="service" name="service" required>
                                <option value="" disabled selected>Select a service...</option>
                                <option value="web">Web Design & Development</option>
                                <option value="marketing">Digital Marketing</option>
                                <option value="branding">Branding & Design</option>
                                <option value="video">Video Production</option>
                                <option value="seo">SEO & Paid Ads</option>
                                <option value="other">Other / Custom Package</option>
                            </select>
                        </div>
                        <div class="form-group">
                            <label for="message">Message</label>
                            <textarea id="message" name="message" rows="4" required placeholder="Tell us about your project..."></textarea>
                        </div>
                        <button type="submit" class="btn btn-ghost btn-pill w-100" id="contactSubmitBtn">{contactSubmitButtonText}</button>
                    </form>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
