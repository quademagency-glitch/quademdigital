---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Revamping an Online Store for Higher Conversions | Quadem Digital" description="Case study detailing how we redesigned a user experience to drive a massive spike in sales." activePage="projects" navbarScrolled={true}>
    <section class="section-padding" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
        <div class="container">
            <span class="badge glow-effect mb-4" style="display: inline-block;">Coming Soon</span>
            <h1 style="margin-bottom: 24px;">Revamping an Online Store for Higher Conversions</h1>
            <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto 32px; line-height: 1.6;">
                We are currently writing this case study to share the exact strategies, design decisions, and technical implementations we used to achieve a 300% increase in website traffic and sales.
            </p>
            <a href="/projects" class="btn btn-primary btn-pill glow-effect">Back to Projects</a>
        </div>
    </section>
</BaseLayout>
