---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import WorkCard from '../components/WorkCard.astro';
import { resolveSeo } from '../lib/seo';
import { payloadFetch, payloadFetchGlobal } from '../lib/payload';
const studies = (await payloadFetch('caseStudies', { sort: 'order' }))
  .filter((study: any) => study.published === true && study.slug)
  .sort((a: any,b: any) => Number(a.projectType !== 'client') - Number(b.projectType !== 'client'));
const tags = [...new Set(studies.map((study: any) => study.tag).filter(Boolean))];
const projectsPage = await payloadFetchGlobal('projectsPage');
const pageTitle = projectsPage?.title || 'Selected Work';
const seo = resolveSeo(projectsPage, { title: `${pageTitle} | Quadem Digital`, description: projectsPage?.description || "Featured work from Quadem Digital Enterprise: a selection of web, design and marketing projects I've delivered for clients." });

---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="projects">
  <PageHero headline={projectsPage?.heading || pageTitle} eyebrow="Selected projects" variant="page" lede={projectsPage?.subheading || "Websites, identities and digital experiences. See what went into them, what is finished and what is still taking shape."} />
  <section class="section-padding studio-project-library">
    <div class="container">
      <div class="project-filters studio-project-filters" aria-label="Filter projects">
        <button class="filter-btn active" data-filter="all" aria-pressed="true">All work</button>
        {tags.map(tag => <button class="filter-btn" data-filter={tag} aria-pressed="false">{tag}</button>)}
      </div>
      {studies.length > 0 ? <div class="studio-work-stack" data-work-stack>{studies.map((study: any, index: number) => <WorkCard study={study} priority={index < 2} stacked />)}</div> : <p class="studio-empty">The project library is temporarily unavailable. <a href="/contact/">Ask Ernest for examples of recent work.</a></p>}
    </div>
  </section>
</BaseLayout>
