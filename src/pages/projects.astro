---
import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetch, payloadFetchGlobal, buildPayloadImageUrl } from "../lib/payload";

// Fetch case studies from CMS
const fetchedCaseStudies = await payloadFetch('caseStudies', { sort: 'order' });
const tags = [...new Set(fetchedCaseStudies.map((study: any) => study.tag).filter(Boolean))];
const projectsPage = await payloadFetchGlobal('projectsPage');

const pageTitle = projectsPage?.title || "All Projects";
const pageSubtitle = projectsPage?.subtitle || "An archive of select projects we have had the pleasure to work on.";
---
<BaseLayout title={`${pageTitle} | Quadem Digital`} description="Explore featured work from Quadem Digital Enterprise — a selection of web, design, and marketing projects we've delivered for our clients." activePage="projects" navbarScrolled={true}>
    <section class="projects-hero">
        <div class="container">
            <h1><span class="text-gradient">{pageTitle}</span></h1>
            <p class="hero-subtitle">{pageSubtitle}</p>
        </div>
    </section>

    <section class="work section-padding">
        <div class="container">
            <div class="project-filters" style="display: flex; gap: 12px; margin-bottom: 40px; flex-wrap: wrap; justify-content: center;">
                <button class="filter-btn active" data-filter="all" style="padding: 8px 24px; border-radius: 50px; border: 1px solid var(--border-color); background: rgba(0,174,239,0.1); color: var(--accent); cursor: pointer; transition: 0.3s;">All</button>
                {tags.map((tag: any) => (
                    <button class="filter-btn" data-filter={tag} style="padding: 8px 24px; border-radius: 50px; border: 1px solid var(--border-color); background: transparent; color: var(--text-color); cursor: pointer; transition: 0.3s;">{tag}</button>
                ))}
            </div>
            <div class="archive-grid">
                {fetchedCaseStudies && fetchedCaseStudies.length > 0 ? (
                    fetchedCaseStudies.map((study: any, index: number) => (
                        <div class={`work-card glow-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`} data-category={study.tag || 'uncategorized'}>
                            <a href={study.slug ? `/projects/${study.slug}` : '#'} style="display: block; overflow: hidden; border-radius: 12px 12px 0 0;">
                                <div class="work-img">
                                    {study.coverImage ? (
                                        <img src={buildPayloadImageUrl(study.coverImage)} alt={study.title} loading="lazy" style="width:100%; height:100%; object-fit:cover;" width="800" height="600" />
                                    ) : (
                                        <img src={`/images/case-study-${(index % 2) + 1}-mock.jpg`} alt={study.title || "Cover Image"} loading="lazy" style="width:100%; height:100%; object-fit:cover;" width="800" height="600" />
                                    )}
                                </div>
                            </a>
                            <div class="work-content">
                                <span class="work-tag">{study.tag}</span>
                                <h3 class="work-title">{study.title}</h3>
                                <p class="work-desc">{study.description}</p>
                                {study.resultMetric && (
                                    <div class="work-result">
                                        <span class="result-metric">{study.resultMetric}</span>
                                        <span class="result-text">{study.resultText}</span>
                                    </div>
                                )}
                                <a href={study.slug ? `/projects/${study.slug}` : '#'} class="work-link">Read Case Study →</a>
                            </div>
                        </div>
                    ))
                ) : (
                    <!-- Fallback to static placeholders -->
                    <>
                        <div class="work-card glow-card animate-on-scroll slide-up delay-100">
                            <a href="/projects/revamping-online-store/" style="display: block; overflow: hidden; border-radius: 12px 12px 0 0;">
                                <div class="work-img">
                                    <img src="/images/case-study-1-cover.webp" alt="Cover Image 1" loading="lazy" style="width:100%; height:100%; object-fit:cover;" width="800" height="600" />
                                </div>
                            </a>
                            <div class="work-content">
                                <span class="work-tag">E-commerce</span>
                                <h3 class="work-title">Revamping an Online Store for Higher Conversions</h3>
                                <p class="work-desc">We completely redesigned the user experience, leading to a massive spike in sales.</p>
                                <div class="work-result">
                                    <span class="result-metric">300%</span>
                                    <span class="result-text">Increase in website traffic</span>
                                </div>
                                <a href="/projects/revamping-online-store/" class="work-link">Read Case Study →</a>
                            </div>
                        </div>
                        
                        <div class="work-card glow-card animate-on-scroll slide-up delay-200">
                            <a href="/projects/scaling-user-acquisition/" style="display: block; overflow: hidden; border-radius: 12px 12px 0 0;">
                                <div class="work-img">
                                    <img src="/images/case-study-2-cover.webp" alt="Cover Image 2" loading="lazy" style="width:100%; height:100%; object-fit:cover;" width="800" height="600" />
                                </div>
                            </a>
                            <div class="work-content">
                                <span class="work-tag">SaaS Startup</span>
                                <h3 class="work-title">Scaling User Acquisition with Targeted Ads</h3>
                                <p class="work-desc">Implemented a multi-channel ad strategy to bring in high-quality leads.</p>
                                <div class="work-result">
                                    <span class="result-metric">50%</span>
                                    <span class="result-text">Reduction in CPA</span>
                                </div>
                                <a href="/projects/scaling-user-acquisition/" class="work-link">Read Case Study →</a>
                            </div>
                        </div>

                        <div class="work-card glow-card animate-on-scroll slide-up delay-300">
                            <a href="/projects/brand-identity-local-seo/" style="display: block; overflow: hidden; border-radius: 12px 12px 0 0;">
                                <div class="work-img">
                                    <img src="/images/case-study-1-cover.webp" alt="Cover Image 3" loading="lazy" style="width:100%; height:100%; object-fit:cover;" width="800" height="600" />
                                </div>
                            </a>
                            <div class="work-content">
                                <span class="work-tag">Local Business</span>
                                <h3 class="work-title">Complete Brand Identity & Local SEO</h3>
                                <p class="work-desc">Built a fresh brand from the ground up and dominated local search results.</p>
                                <div class="work-result">
                                    <span class="result-metric">#1</span>
                                    <span class="result-text">Ranking for core keywords</span>
                                </div>
                                <a href="/projects/brand-identity-local-seo/" class="work-link">Read Case Study →</a>
                            </div>
                        </div>
                    </>
                )}
            </div>
            
            <div class="work-cta" style="margin-top: 48px;">
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Start Your Project</a>
            </div>
        </div>
    </section>
</BaseLayout>
