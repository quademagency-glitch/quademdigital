---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch, payloadFetchGlobal, lexicalToHtml } from "../../lib/payload";
import { verifySession } from "../../lib/session";
import "../../styles/portal.css";

// Check authentication.
// verifySession returns the slug only if the cookie's signature is intact. It
// used to be read as plain text, so anyone could send `client_auth=<slug>` and
// open a client's portal without an access code.
const clientCookie = Astro.cookies.get("client_auth");
const verifiedSlug = verifySession(clientCookie?.value);
let clientData = null;
let isAuthenticated = false;

if (verifiedSlug) {
    const slug = verifiedSlug;
    const clients = await payloadFetch('clients', {
      'where[slug][equals]': slug,
      depth: '2'
    });
    clientData = clients[0];

    if (clientData) {
        isAuthenticated = true;
        
        // Fetch invoices for this client
        const invoices = await payloadFetch('invoices', {
            'where[client][equals]': clientData.id,
            sort: '-dateIssued'
        });
        clientData.invoices = invoices;
        clientData.onboardingGuideData = clientData.onboardingGuide;
    } else {
        // Invalid or expired cookie, delete it
        Astro.cookies.delete("client_auth", { path: '/' });
    }
}

// Fetch siteSettings for WhatsApp number
const siteSettings = await payloadFetchGlobal('siteSettings');
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";

// Format status strings
const statusMap: Record<string, string> = {
    'onboarding': 'Onboarding',
    'design': 'Design',
    'development': 'Development',
    'review': 'Review',
    'completed': 'Completed',
    'retainer': 'Retainer'
};

const statusColors: Record<string, string> = {
    'onboarding': '#f59e0b',
    'design': '#3b82f6',
    'development': '#8b5cf6',
    'review': '#eab308',
    'completed': '#10b981',
    'retainer': '#6366f1'
};

// Progress steps order
const progressSteps = ['onboarding', 'design', 'development', 'review', 'completed'];
const currentStepIndex = clientData ? progressSteps.indexOf(clientData.projectStatus) : 0;
const isRetainer = clientData?.projectStatus === 'retainer';

// Group deliverables by category
const categoryLabels: Record<string, string> = {
    'design': 'Design Files',
    'brand': 'Brand Assets',
    'documents': 'Documents',
    'videos': 'Videos',
    'other': 'Other'
};

const categoryIcons: Record<string, string> = {
    'design': '🎨',
    'brand': '✦',
    'documents': '📄',
    'videos': '🎬',
    'other': '📎'
};

function groupDeliverables(deliverables: any[]) {
    if (!deliverables || deliverables.length === 0) return {};
    const groups: Record<string, any[]> = {};
    for (const item of deliverables) {
        const cat = item.category || 'other';
        if (!groups[cat]) groups[cat] = [];
        groups[cat].push(item);
    }
    return groups;
}

const deliverableGroups = clientData ? groupDeliverables(clientData.deliverables) : {};

// Invoice status config
const invoiceStatusConfig: Record<string, { label: string; color: string; icon: string }> = {
    'paid': { label: 'Paid', color: '#10b981', icon: '✓' },
    'pending': { label: 'Pending', color: '#f59e0b', icon: '⏳' },
    'overdue': { label: 'Overdue', color: '#ef4444', icon: '!' },
};

// Format timeline dates
function formatDate(dateStr: string) {
    return new Date(dateStr).toLocaleDateString('en-US', { month: 'short', day: 'numeric', year: 'numeric' });
}
---
<BaseLayout title="Client Portal | Quadem Digital" description="Access your project files, invoices, and communication all in one secure place." navbarScrolled={true}>
    <Fragment slot="head">
        <meta name="robots" content="noindex, nofollow">
    </Fragment>    
    {!isAuthenticated ? (
        <!-- LOGIN VIEW -->
        <section class="portal-login-hero" style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding-top: 100px;">
            <div class="container" style="max-width: 500px; width: 100%;">
                <div class="contact-form-container" style="text-align: center; padding: 48px 32px;">
                    <div style="margin-bottom: 32px;">
                        <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" style="margin: 0 auto 16px;"><rect x="3" y="11" width="18" height="11" rx="2" ry="2"></rect><path d="M7 11V7a5 5 0 0 1 10 0v4"></path></svg>
                        <h1 style="font-size: 2rem; margin-bottom: 8px;">Client Portal</h1>
                        <p style="color: var(--text-muted); font-size: 0.95rem;">Enter your secure access code to view your project dashboard.</p>
                    </div>
                    
                    <form id="portalLoginForm" class="contact-form">
                        <div class="form-group" id="loginError" style="display: none; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 12px; border-radius: 8px; margin-bottom: 20px; color: #ef4444; font-size: 0.9rem;">
                            Invalid access code. Please try again.
                        </div>
                        <div class="form-group" style="text-align: left;">
                            <label for="accessCode">Access Code</label>
                            <input type="password" id="accessCode" required placeholder="Enter the access code from your welcome email" style="letter-spacing: 2px;">
                        </div>
                        <button type="submit" class="btn btn-primary btn-pill w-100 glow-effect" id="loginSubmitBtn">Secure Login</button>
                    </form>
                </div>
            </div>
        </section>
        
        <script>
            document.addEventListener('astro:page-load', () => {
                const loginForm = document.getElementById('portalLoginForm');
                if (!loginForm) return;
                
                loginForm.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const codeInput = document.getElementById('accessCode') as HTMLInputElement;
                    const errorBox = document.getElementById('loginError');
                    const submitBtn = document.getElementById('loginSubmitBtn');
                    
                    if (!codeInput.value) return;
                    
                    // Loading state
                    const originalText = submitBtn.textContent;
                    submitBtn.textContent = 'Verifying...';
                    submitBtn.style.opacity = '0.7';
                    submitBtn.style.pointerEvents = 'none';
                    errorBox.style.display = 'none';
                    
                    try {
                        const res = await fetch('/api/login/', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ accessCode: codeInput.value })
                        });
                        
                        if (res.ok) {
                            // Track successful login
                            if (window.trackEvent) window.trackEvent('portal_login_success');
                            window.location.reload();
                        } else {
                            if (window.trackEvent) window.trackEvent('portal_login_failed');
                            errorBox.style.display = 'block';
                            submitBtn.textContent = originalText;
                            submitBtn.style.opacity = '1';
                            submitBtn.style.pointerEvents = 'auto';
                            codeInput.value = '';
                        }
                    } catch (err) {
                        errorBox.textContent = 'A connection error occurred. Please try again.';
                        errorBox.style.display = 'block';
                        submitBtn.textContent = originalText;
                        submitBtn.style.opacity = '1';
                        submitBtn.style.pointerEvents = 'auto';
                    }
                });
            });
        </script>
    ) : (
        <!-- DASHBOARD VIEW -->
        <section class="portal-dashboard section-padding" style="padding-top: 150px; min-height: 100vh;">
            <div class="container" style="max-width: 960px;">
                
                <!-- Header -->
                <div class="portal-header">
                    <div>
                        <span class="portal-label">Client Dashboard</span>
                        <h1 class="portal-title">Welcome, {clientData.clientName}</h1>
                        {clientData.projectName && (
                            <p class="portal-project-name">{clientData.projectName}</p>
                        )}
                    </div>
                    <form action="/api/logout/" method="POST">
                        <button type="submit" class="btn btn-ghost btn-pill" style="padding: 8px 16px; font-size: 0.85rem;">Log Out</button>
                    </form>
                </div>

                <!-- Progress Stepper -->
                <div class="portal-card">
                    <h3 class="portal-card-title">Project Progress</h3>
                    {isRetainer ? (
                        <div class="portal-retainer-badge">
                            <span class="portal-retainer-dot"></span>
                            Maintenance / Retainer: Active
                        </div>
                    ) : (
                        <div class="progress-stepper">
                            {progressSteps.map((step, i) => (
                                <div class={`progress-step ${i <= currentStepIndex ? 'active' : ''} ${i === currentStepIndex ? 'current' : ''}`}>
                                    <div class="step-circle">
                                        {i < currentStepIndex ? (
                                            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                                        ) : (
                                            <span>{i + 1}</span>
                                        )}
                                    </div>
                                    {i < progressSteps.length - 1 && <div class="step-connector"></div>}
                                    <span class="step-label">{statusMap[step]}</span>
                                </div>
                            ))}
                        </div>
                    )}
                </div>

                <!-- Welcome Message -->
                {clientData.welcomeMessage && (
                    <div class="portal-card portal-card-accent">
                        <h3 class="portal-card-title">📣 Latest Update</h3>
                        <p class="portal-message">{clientData.welcomeMessage}</p>
                    </div>
                )}

                <!-- Onboarding Guide -->
                {clientData.onboardingGuideData && clientData.onboardingGuideData.content && (
                    <div class="portal-card">
                        <h3 class="portal-card-title" style="display: flex; align-items: center; justify-content: space-between;">
                            <span>📖 {clientData.onboardingGuideData.title || "Project Guide"}</span>
                        </h3>
                        {clientData.onboardingGuideData.description && (
                            <p style="color: var(--text-muted); margin-bottom: 24px; font-size: 0.95rem;">
                                {clientData.onboardingGuideData.description}
                            </p>
                        )}
                        <div class="portable-text-body portal-guide-content" style="background: var(--bg-inset); padding: 24px; border-radius: 12px; border: 1px solid var(--border-color);" set:html={lexicalToHtml(clientData.onboardingGuideData.content)} />
                    </div>
                )}

                <!-- Two Column Layout: Timeline + Invoices -->
                <div class="portal-grid-2col">
                    
                    <!-- Timeline -->
                    <div class="portal-card">
                        <h3 class="portal-card-title">Project Timeline</h3>
                        {clientData.timeline && clientData.timeline.length > 0 ? (
                            <div class="portal-timeline">
                                {clientData.timeline
                                    .sort((a: any, b: any) => new Date(b.date).getTime() - new Date(a.date).getTime())
                                    .map((event: any, i: number) => (
                                    <div class={`timeline-item ${i === 0 ? 'latest' : ''}`}>
                                        <div class="timeline-dot"></div>
                                        <div class="timeline-content">
                                            <span class="timeline-date">{formatDate(event.date)}</span>
                                            <h4 class="timeline-title">{event.title}</h4>
                                            {event.description && <p class="timeline-desc">{event.description}</p>}
                                        </div>
                                    </div>
                                ))}
                            </div>
                        ) : (
                            <p class="portal-empty">No timeline events yet.</p>
                        )}
                    </div>
                    
                    <!-- Invoices -->
                    <div class="portal-card">
                        <h3 class="portal-card-title">Invoices</h3>
                        {clientData.invoices && clientData.invoices.length > 0 ? (
                            <div class="portal-invoices">
                                {clientData.invoices.map((inv: any) => {
                                    const statusLower = inv.status ? inv.status.toLowerCase() : 'pending';
                                    const config = invoiceStatusConfig[statusLower] || invoiceStatusConfig['pending'];
                                    
                                    // Calculate total from items
                                    const subtotal = inv.items ? inv.items.reduce((acc: number, item: any) => acc + (item.rate * item.quantity), 0) : 0;
                                    const taxAmount = subtotal * ((inv.taxRate || 0) / 100);
                                    const total = subtotal + taxAmount;
                                    const currency = inv.currency || 'USD';
                                    
                                    

                                    return (
                                        <div class="invoice-item">
                                            <div class="invoice-main">
                                                <div class="invoice-info">
                                                    <span class="invoice-title">Invoice {inv.invoiceId}</span>
                                                    {inv.dueDate && <span class="invoice-due">Due: {formatDate(inv.dueDate)}</span>}
                                                </div>
                                                <div class="invoice-right">
                                                    <span class="invoice-amount">
                                                        {new Intl.NumberFormat('en-US', { style: 'currency', currency, minimumFractionDigits: 2, maximumFractionDigits: 2 }).format(total)}
                                                    </span>
                                                    <span class="invoice-status" style={`color: ${config.color}; border-color: ${config.color};`}>
                                                        {config.icon} {config.label}
                                                    </span>
                                                </div>
                                            </div>
                                            <a href={`/invoice/${inv.invoiceId}/?t=${inv.accessToken ?? ""}`} target="_blank" rel="noopener noreferrer" class="invoice-link">
                                                View Invoice →
                                            </a>
                                        </div>
                                    );
                                })}
                            </div>
                        ) : (
                            <p class="portal-empty">No invoices yet.</p>
                        )}
                    </div>
                </div>

                <!-- Deliverables -->
                <div class="portal-card">
                    <h3 class="portal-card-title">Deliverables & Assets</h3>
                    {Object.keys(deliverableGroups).length > 0 ? (
                        <div class="portal-deliverables">
                            {Object.entries(deliverableGroups).map(([category, items]: [string, any[]]) => (
                                <div class="deliverable-group">
                                    <div class="deliverable-category-header">
                                        <span class="deliverable-category-icon">{categoryIcons[category] || '📎'}</span>
                                        <span class="deliverable-category-label">{categoryLabels[category] || 'Other'}</span>
                                        <span class="deliverable-count">{items.length}</span>
                                    </div>
                                    <ul class="deliverable-list">
                                        {items.map((item: any) => (
                                            <li class="deliverable-item">
                                                <a href={item.url} target="_blank" rel="noopener noreferrer">
                                                    <span class="deliverable-title">{item.title}</span>
                                                    <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"></path><polyline points="15 3 21 3 21 9"></polyline><line x1="10" y1="14" x2="21" y2="3"></line></svg>
                                                </a>
                                            </li>
                                        ))}
                                    </ul>
                                </div>
                            ))}
                        </div>
                    ) : (
                        <p class="portal-empty">No deliverables have been posted yet.</p>
                    )}
                </div>

                <!-- Quick Contact -->
                <div class="portal-card portal-contact-card">
                    <div class="portal-contact-content">
                        <h3 class="portal-card-title" style="margin-bottom: 8px;">Need Help?</h3>
                        <p class="portal-contact-desc">Have questions about your project? Chat with us directly.</p>
                    </div>
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(`Hi Quadem Digital! I'm ${clientData.clientName} and I have a question about my project.`)}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill portal-whatsapp-btn">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor" style="margin-right: 8px;"><path d="M17.472 14.382c-.297-.149-1.758-.867-2.03-.967-.273-.099-.471-.148-.67.15-.197.297-.767.966-.94 1.164-.173.199-.347.223-.644.075-.297-.15-1.255-.463-2.39-1.475-.883-.788-1.48-1.761-1.653-2.059-.173-.297-.018-.458.13-.606.134-.133.298-.347.446-.52.149-.174.198-.298.298-.497.099-.198.05-.371-.025-.52-.075-.149-.669-1.612-.916-2.207-.242-.579-.487-.5-.669-.51-.173-.008-.371-.01-.57-.01-.198 0-.52.074-.792.372-.272.297-1.04 1.016-1.04 2.479 0 1.462 1.065 2.875 1.213 3.074.149.198 2.096 3.2 5.077 4.487.709.306 1.262.489 1.694.625.712.227 1.36.195 1.871.118.571-.085 1.758-.719 2.006-1.413.248-.694.248-1.289.173-1.413-.074-.124-.272-.198-.57-.347m-5.421 7.403h-.004a9.87 9.87 0 01-5.031-1.378l-.361-.214-3.741.982.998-3.648-.235-.374a9.86 9.86 0 01-1.51-5.26c.001-5.45 4.436-9.884 9.888-9.884 2.64 0 5.122 1.03 6.988 2.898a9.825 9.825 0 012.893 6.994c-.003 5.45-4.437 9.884-9.885 9.884m8.413-18.297A11.815 11.815 0 0012.05 0C5.495 0 .16 5.335.157 11.892c0 2.096.547 4.142 1.588 5.945L.057 24l6.305-1.654a11.882 11.882 0 005.683 1.448h.005c6.554 0 11.89-5.335 11.893-11.893a11.821 11.821 0 00-3.48-8.413z"/></svg>
                        Chat on WhatsApp
                    </a>
                </div>

            </div>
        </section>
        
        <script>
            document.addEventListener('astro:page-load', () => {
                if (window.trackEvent) {
                    window.trackEvent('portal_dashboard_viewed');
                }

                // NOTE: invoice amounts are deliberately NOT converted.
                // An invoice is a fixed-currency document — the client is
                // charged its currency through Paystack — so rendering it in
                // the viewer's local currency at a live FX rate showed a
                // number they could not actually pay, and one that changed
                // between viewing and paying.
            });
        </script>
    )}
</BaseLayout>
