---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { verifyAdminSession } from "../../lib/session";

// The cookie carries a signature now, not the literal word "authenticated".
// That string was forgeable with one line of curl, which made this whole page
// and the send endpoint behind it open to anyone.
const isAuthenticated = verifyAdminSession(Astro.cookies.get("admin_auth")?.value);
---
<BaseLayout title="Email Campaigns | Quadem Digital Admin" description="Compose and send email campaigns to your newsletter audience." navbarScrolled={true}>
    <Fragment slot="head">
        <meta name="robots" content="noindex, nofollow">
    </Fragment>
    {!isAuthenticated ? (
        <!-- LOGIN -->
        <section style="min-height: 80vh; display: flex; align-items: center; justify-content: center; padding-top: 100px;">
            <div class="container" style="max-width: 450px;">
                <div class="contact-form-container" style="text-align: center; padding: 48px 32px;">
                    <div style="margin-bottom: 32px;">
                        <span style="font-size: 48px; display: block; margin-bottom: 16px;">🔐</span>
                        <h1 style="font-size: 1.8rem; margin-bottom: 8px;">Admin Access</h1>
                        <p style="color: var(--text-muted); font-size: 0.9rem;">Enter the admin password to manage campaigns.</p>
                    </div>
                    <form id="adminLoginForm" class="contact-form">
                        <div id="adminLoginError" style="display: none; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 12px; border-radius: 8px; margin-bottom: 20px; color: #ef4444; font-size: 0.9rem;">
                            Incorrect password.
                        </div>
                        <div class="form-group" style="text-align: left;">
                            <label for="adminPassword">Password</label>
                            <input type="password" id="adminPassword" required placeholder="Enter admin password">
                        </div>
                        <button type="submit" class="btn btn-primary btn-pill w-100 glow-effect" id="adminLoginBtn">Login</button>
                    </form>
                </div>
            </div>
        </section>

        <script>
            document.addEventListener('astro:page-load', () => {
                const form = document.getElementById('adminLoginForm');
                if (!form) return;
                form.addEventListener('submit', async (e) => {
                    e.preventDefault();
                    const pw = (document.getElementById('adminPassword') as HTMLInputElement).value;
                    const res = await fetch('/api/admin-login/', {
                        method: 'POST',
                        headers: { 'Content-Type': 'application/json' },
                        body: JSON.stringify({ password: pw })
                    });
                    if (res.ok) {
                        window.location.reload();
                    } else {
                        document.getElementById('adminLoginError')!.style.display = 'block';
                    }
                });
            });
        </script>
    ) : (
        <!-- Quill Editor CSS & JS -->
        <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
        <script is:inline src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>

        <!-- CAMPAIGNS DASHBOARD -->
        <section class="portal-dashboard section-padding" style="padding-top: 150px; min-height: 100vh;">
            <div class="container" style="max-width: 800px;">

                <div class="portal-header">
                    <div>
                        <span class="portal-label">Admin Panel</span>
                        <h1 class="portal-title">Email Campaigns</h1>
                        <p class="portal-project-name">Compose and send broadcasts to all newsletter subscribers.</p>
                    </div>
                </div>

                <!-- Compose Form -->
                <div id="campaignForm" class="campaign-composer">
                    
                    <div class="portal-card">
                        <h3 class="portal-card-title">✍️ Compose Your Email</h3>
                        
                        <div class="campaign-field">
                            <label for="campSubject">Subject Line *</label>
                            <input type="text" id="campSubject" required placeholder="e.g. 5 Tips to Boost Your Website Traffic" class="campaign-input">
                        </div>

                        <div class="campaign-field">
                            <label for="campPreview">Preview Text <span class="field-optional">(optional)</span></label>
                            <input type="text" id="campPreview" placeholder="Short text shown next to subject in inbox" class="campaign-input" maxlength="90">
                        </div>

                        <div class="campaign-field">
                            <label>Email Body *</label>
                            <div id="quillEditor" style="min-height: 250px;"></div>
                        </div>
                    </div>

                    <!-- Optional Extras -->
                    <div class="portal-card">
                        <h3 class="portal-card-title">🎬 Media & CTA <span class="field-optional">(optional)</span></h3>

                        <div class="campaign-field">
                            <label for="campVideoUrl">Video URL (YouTube / Vimeo)</label>
                            <input type="url" id="campVideoUrl" placeholder="https://youtube.com/watch?v=..." class="campaign-input">
                        </div>

                        <div class="campaign-field">
                            <label for="campVideoFile">Video File Upload</label>
                            <input type="file" id="campVideoFile" accept="video/*" class="campaign-input campaign-file-input">
                            <div id="uploadStatus" style="display: none; margin-top: 8px; font-size: 0.85rem;"></div>
                            <p class="field-hint">Upload a video file. A download link will be included in the email.</p>
                        </div>

                        <div class="campaign-field-row">
                            <div class="campaign-field" style="flex: 1;">
                                <label for="campCtaText">Button Text</label>
                                <input type="text" id="campCtaText" placeholder="e.g. Book a Call" class="campaign-input">
                            </div>
                            <div class="campaign-field" style="flex: 1;">
                                <label for="campCtaUrl">Button URL</label>
                                <input type="url" id="campCtaUrl" placeholder="https://quademdigital.com/contact" class="campaign-input">
                            </div>
                        </div>
                    </div>

                    <!-- Preview & Send -->
                    <div class="campaign-actions-bar">
                        <button type="button" id="previewBtn" class="btn btn-ghost btn-pill">👁 Preview Email</button>
                        <button type="button" id="sendBtn" class="btn btn-primary btn-pill glow-effect">🚀 Send to All Subscribers</button>
                    </div>

                    <div id="campaignResult" style="display: none; margin-top: 20px; padding: 16px; border-radius: 12px; font-size: 0.95rem;"></div>
                </div>

                <!-- Preview Modal -->
                <div id="previewModal" class="campaign-modal" style="display: none;">
                    <div class="campaign-modal-content" style="max-width: 640px; max-height: 80vh; overflow-y: auto;">
                        <div style="display: flex; justify-content: space-between; align-items: center; margin-bottom: 20px;">
                            <h3 style="margin: 0;">Email Preview</h3>
                            <button id="closePreviewBtn" class="btn btn-ghost btn-pill" style="padding: 6px 14px; font-size: 0.85rem;">✕ Close</button>
                        </div>
                        <div id="previewContent" style="background: #0a0a12; border-radius: 8px; overflow: hidden;"></div>
                    </div>
                </div>

                <!-- Send Confirmation Modal -->
                <div id="sendModal" class="campaign-modal" style="display: none;">
                    <div class="campaign-modal-content">
                        <h3 style="margin-top: 0;">🚀 Send Campaign?</h3>
                        <p style="color: var(--text-muted);">This will broadcast the email to <strong>all newsletter subscribers</strong>. This action cannot be undone.</p>
                        <p style="color: var(--text-muted); font-size: 0.9rem;"><strong>Subject:</strong> <span id="confirmSubject"></span></p>
                        <div id="sendResult" style="display: none; margin: 16px 0; padding: 12px; border-radius: 8px; font-size: 0.9rem;"></div>
                        <div style="display: flex; gap: 12px; justify-content: flex-end; margin-top: 24px;">
                            <button class="btn btn-ghost btn-pill" id="cancelSendBtn">Cancel</button>
                            <button class="btn btn-primary btn-pill glow-effect" id="confirmSendBtn">Yes, Send Now</button>
                        </div>
                    </div>
                </div>

            </div>
        </section>

        <style>
            /* Quill dark theme overrides */
            .ql-toolbar.ql-snow {
                background: var(--field-bg) !important;
                border-color: var(--border-color) !important;
                border-radius: 10px 10px 0 0 !important;
            }
            .ql-container.ql-snow {
                background: var(--field-bg) !important;
                border-color: var(--border-color) !important;
                border-radius: 0 0 10px 10px !important;
                font-size: 0.95rem !important;
                color: var(--text-primary) !important;
            }
            .ql-editor {
                min-height: 200px !important;
                line-height: 1.7 !important;
                color: #ddd !important;
            }
            .ql-editor.ql-blank::before {
                color: var(--text-subtle) !important;
                font-style: normal !important;
            }
            .ql-snow .ql-stroke {
                stroke: #999 !important;
            }
            .ql-snow .ql-fill, .ql-snow .ql-stroke.ql-fill {
                fill: #999 !important;
            }
            .ql-snow .ql-picker-label {
                color: #999 !important;
            }
            .ql-snow .ql-picker-options {
                background: var(--bg-card) !important;
                border-color: var(--border-color) !important;
            }
            .ql-snow .ql-picker-item {
                color: #ddd !important;
            }
            .ql-snow .ql-picker-item:hover {
                color: var(--accent-text) !important;
            }
            .ql-snow .ql-active .ql-stroke {
                stroke: var(--accent) !important;
            }
            .ql-snow .ql-active .ql-fill {
                fill: var(--accent) !important;
            }
            .ql-snow .ql-active {
                color: var(--accent-text) !important;
            }
            .ql-snow button:hover .ql-stroke {
                stroke: var(--accent) !important;
            }
            .ql-snow button:hover .ql-fill {
                fill: var(--accent) !important;
            }
            .ql-tooltip {
                background: var(--bg-card) !important;
                border-color: var(--border-color) !important;
                color: #ddd !important;
                box-shadow: 0 4px 20px rgba(0,0,0,0.4) !important;
            }
            .ql-tooltip input[type="text"] {
                background: var(--field-bg) !important;
                border-color: var(--border-color) !important;
                color: #ddd !important;
            }
            .ql-tooltip a {
                color: var(--accent-text) !important;
            }
            .ql-editor a {
                color: var(--accent-text) !important;
            }
        </style>

        <script is:inline>
            document.addEventListener('astro:page-load', () => {
                const editorEl = document.getElementById('quillEditor');
                if (!editorEl || editorEl.classList.contains('ql-initialized')) return;
                editorEl.classList.add('ql-initialized');

                // Custom image handler
                function imageHandler() {
                    const input = document.createElement('input');
                    input.setAttribute('type', 'file');
                    input.setAttribute('accept', 'image/*');
                    input.click();

                    input.onchange = async () => {
                        const file = input.files[0];
                        if (!file) return;

                        // Show uploading indicator
                        const range = quill.getSelection(true);
                        quill.insertText(range.index, 'Uploading image...', { italic: true, color: '#999' });

                        try {
                            const formData = new FormData();
                            formData.append('file', file);

                            const res = await fetch('/api/upload-file/', {
                                method: 'POST',
                                body: formData
                            });
                            const data = await res.json();

                            // Remove placeholder
                            quill.deleteText(range.index, 'Uploading image...'.length);

                            if (res.ok && data.url) {
                                quill.insertEmbed(range.index, 'image', data.url);
                                quill.setSelection(range.index + 1);
                            } else {
                                alert('Image upload failed: ' + (data.error || 'Unknown error'));
                            }
                        } catch (err) {
                            quill.deleteText(range.index, 'Uploading image...'.length);
                            alert('Image upload failed. Please try again.');
                        }
                    };
                }

                // Initialize Quill
                const quill = new Quill('#quillEditor', {
                    theme: 'snow',
                    placeholder: 'Write your email content here...',
                    modules: {
                        toolbar: {
                            container: [
                                [{ 'header': [1, 2, 3, false] }],
                                ['bold', 'italic', 'underline', 'strike'],
                                [{ 'list': 'ordered' }, { 'list': 'bullet' }],
                                ['link', 'image'],
                                ['blockquote'],
                                ['clean']
                            ],
                            handlers: {
                                image: imageHandler
                            }
                        }
                    }
                });

                // Build preview HTML
                function buildPreviewHtml() {
                    const body = quill.root.innerHTML;
                    const videoUrl = document.getElementById('campVideoUrl')?.value || '';
                    const ctaText = document.getElementById('campCtaText')?.value || '';
                    const ctaUrl = document.getElementById('campCtaUrl')?.value || '';

                    let videoHtml = '';
                    if (videoUrl) {
                        const ytMatch = videoUrl.match(/(?:youtube\.com\/watch\?v=|youtu\.be\/|youtube\.com\/embed\/)([a-zA-Z0-9_-]+)/);
                        const thumb = ytMatch ? 'https://img.youtube.com/vi/' + ytMatch[1] + '/maxresdefault.jpg' : null;
                        videoHtml = '<div style="text-align:center;margin:24px 0;">' + (thumb ? '<img src="' + thumb + '" style="max-width:100%;border-radius:8px;" />' : '') + '<p style="margin-top:12px;"><a href="' + videoUrl + '" style="color:#00AEEF;font-weight:600;">▶ Watch Video</a></p></div>';
                    }

                    let ctaHtml = '';
                    if (ctaText && ctaUrl) {
                        ctaHtml = '<div style="text-align:center;margin:32px 0;"><a href="' + ctaUrl + '" style="display:inline-block;padding:16px 40px;background:#00AEEF;color:#000;font-weight:700;font-size:16px;border-radius:50px;text-decoration:none;">' + ctaText + '</a></div>';
                    }

                    return '<div style="background:linear-gradient(135deg,#050814,#0f1129);padding:40px 30px;text-align:center;">' +
                        '<img src="https://quademdigital.com/images/logo.webp" alt="Quadem Digital" width="140" />' +
                        '</div>' +
                        '<div style="padding:40px 30px;color:#ddd;font-family:Arial,sans-serif;">' +
                        body + videoHtml + ctaHtml +
                        '</div>' +
                        '<div style="padding:20px;text-align:center;border-top:1px solid #1a1a2e;background:#050814;">' +
                        '<p style="color:#666;font-size:12px;margin:0;">Quadem Digital Enterprise · <a href="#" style="color:#00AEEF;">Unsubscribe</a></p>' +
                        '</div>';
                }

                // Preview
                document.getElementById('previewBtn')?.addEventListener('click', () => {
                    document.getElementById('previewContent').innerHTML = buildPreviewHtml();
                    document.getElementById('previewModal').style.display = 'flex';
                });
                document.getElementById('closePreviewBtn')?.addEventListener('click', () => {
                    document.getElementById('previewModal').style.display = 'none';
                });
                document.getElementById('previewModal')?.addEventListener('click', (e) => {
                    if (e.target.id === 'previewModal') e.target.style.display = 'none';
                });

                // Send flow
                const sendModal = document.getElementById('sendModal');
                const confirmSendBtn = document.getElementById('confirmSendBtn');
                const sendResult = document.getElementById('sendResult');
                const campaignResult = document.getElementById('campaignResult');

                document.getElementById('sendBtn')?.addEventListener('click', () => {
                    const subject = document.getElementById('campSubject').value;
                    const body = quill.root.innerHTML;

                    if (!subject.trim()) { alert('Subject is required'); return; }
                    if (!body.trim() || body === '<p><br></p>') { alert('Email body is required'); return; }

                    document.getElementById('confirmSubject').textContent = subject;
                    sendResult.style.display = 'none';
                    confirmSendBtn.disabled = false;
                    confirmSendBtn.textContent = 'Yes, Send Now';
                    sendModal.style.display = 'flex';
                });

                document.getElementById('cancelSendBtn')?.addEventListener('click', () => sendModal.style.display = 'none');
                sendModal?.addEventListener('click', (e) => { if (e.target === sendModal) sendModal.style.display = 'none'; });

                confirmSendBtn?.addEventListener('click', async () => {
                    confirmSendBtn.disabled = true;
                    confirmSendBtn.textContent = 'Sending...';

                    const subject = document.getElementById('campSubject').value;
                    const previewText = document.getElementById('campPreview').value;
                    const htmlBody = quill.root.innerHTML;
                    const videoUrl = document.getElementById('campVideoUrl').value;
                    const ctaText = document.getElementById('campCtaText').value;
                    const ctaUrl = document.getElementById('campCtaUrl').value;
                    const videoFileInput = document.getElementById('campVideoFile');

                    let videoFileUrl = '';

                    // Upload video file if selected
                    if (videoFileInput.files && videoFileInput.files.length > 0) {
                        confirmSendBtn.textContent = 'Uploading video...';
                        try {
                            const formData = new FormData();
                            formData.append('file', videoFileInput.files[0]);

                            const uploadRes = await fetch('/api/upload-file/', { method: 'POST', body: formData });
                            const uploadData = await uploadRes.json();

                            if (uploadRes.ok && uploadData.url) {
                                videoFileUrl = uploadData.url;
                                const us = document.getElementById('uploadStatus');
                                if (us) { us.style.display = 'block'; us.style.color = '#10b981'; us.innerHTML = '✅ Uploaded: ' + uploadData.filename; }
                            } else {
                                throw new Error(uploadData.error || 'Upload failed');
                            }
                        } catch (uploadErr) {
                            sendResult.style.display = 'block';
                            sendResult.style.background = 'rgba(239, 68, 68, 0.1)';
                            sendResult.style.border = '1px solid #ef4444';
                            sendResult.style.color = '#ef4444';
                            sendResult.innerHTML = '❌ Video upload failed: ' + uploadErr.message;
                            confirmSendBtn.disabled = false;
                            confirmSendBtn.textContent = 'Yes, Send Now';
                            return;
                        }
                    }

                    confirmSendBtn.textContent = 'Sending campaign...';

                    try {
                        const res = await fetch('/api/send-campaign/', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ subject, previewText, htmlBody, videoUrl, videoFileUrl, ctaText, ctaUrl })
                        });
                        const data = await res.json();

                        if (res.ok) {
                            sendModal.style.display = 'none';
                            campaignResult.style.display = 'block';
                            campaignResult.style.background = 'rgba(16, 185, 129, 0.1)';
                            campaignResult.style.border = '1px solid #10b981';
                            campaignResult.style.color = '#10b981';
                            campaignResult.innerHTML = '✅ <strong>Campaign sent successfully!</strong> Your email is being delivered to all subscribers.';

                            // Reset
                            document.getElementById('campSubject').value = '';
                            document.getElementById('campPreview').value = '';
                            quill.setContents([]);
                            document.getElementById('campVideoUrl').value = '';
                            document.getElementById('campVideoFile').value = '';
                            var us = document.getElementById('uploadStatus'); if(us) us.style.display = 'none';
                            document.getElementById('campCtaText').value = '';
                            document.getElementById('campCtaUrl').value = '';
                        } else {
                            sendResult.style.display = 'block';
                            sendResult.style.background = 'rgba(239, 68, 68, 0.1)';
                            sendResult.style.border = '1px solid #ef4444';
                            sendResult.style.color = '#ef4444';
                            sendResult.innerHTML = '❌ Error: ' + (data.error || 'Unknown error');
                            confirmSendBtn.disabled = false;
                            confirmSendBtn.textContent = 'Yes, Send Now';
                        }
                    } catch (err) {
                        sendResult.style.display = 'block';
                        sendResult.style.background = 'rgba(239, 68, 68, 0.1)';
                        sendResult.style.border = '1px solid #ef4444';
                        sendResult.style.color = '#ef4444';
                        sendResult.innerHTML = '❌ Network error. Please try again.';
                        confirmSendBtn.disabled = false;
                        confirmSendBtn.textContent = 'Yes, Send Now';
                    }
                });
            });
        </script>
    )}
</BaseLayout>
