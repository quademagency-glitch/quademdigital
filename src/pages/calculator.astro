---
/*
  /calculator/ — the standalone estimator.

  WHAT THIS PAGE USED TO BE, AND WHY IT IS NOW SEVEN LINES OF MARKUP

  It was a second, independently written calculator built from the same three
  CMS records as the homepage one, and it disagreed with it on every point that
  mattered to a buyer:

    · It never asked what country the visitor was in. It had none of the three
      markers initDynamicPricing looks for, so the lookup did not run at all and
      a visitor in Accra was shown $3,000 for the website that every other page
      on the site had just quoted them at GH₵ 2,500. Its manual USD/GHS toggle
      defaulted to USD and had to be found and pressed.
    · It added a one-off build to a monthly retainer and printed one number.
    · It answered a bare "$4,500" where the homepage answered "from $4,500",
      against a site where every price is a starting point.
    · It wrote "GH₵2,500" without the space the rest of the site writes.
    · Its hero asked for no bottom padding with `pb-0 pt-32`, two utility
      classes that are not defined in any of the six stylesheets, so both
      sections kept their default 100px and the page opened with a 200px hole
      between the heading and the first service.

  None of that was a bug in the arithmetic. It was a second implementation that
  nobody was maintaining, on the page a visitor uses immediately before
  enquiring. The calculator itself now lives in one place, shared with the
  homepage, and this page is its hero and its enquiry form.
*/
import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetch } from "../lib/payload";
import ProjectCalculator from "../components/ProjectCalculator.astro";
import NewsletterOptIn from "../components/forms/NewsletterOptIn.astro";

const services = await payloadFetch('calculatorServices', { sort: 'order' });
---

<BaseLayout
    title="Project Quote Calculator | Quadem Digital"
    description="Estimate the cost of your digital project instantly. Select the services you need and get a clear picture of your investment."
    activePage="calculator"
    navbarScrolled={true}
>
    <section class="calculator-hero section-padding">
        <div class="container">
            <h1><span class="text-gradient">Project Cost Estimator</span></h1>
            <p class="hero-subtitle">Select the services you need to build your ideal digital solution. Get an instant, transparent estimate of your investment.</p>
        </div>
    </section>

    <ProjectCalculator
        services={services || []}
        heading="What do you need?"
        subtitle="Tick what applies. One-off work and monthly work are totalled separately, because they are not the same kind of money."
    />

    <section class="section-padding calc-enquiry">
        <div class="container">
            <div class="calc-enquiry-card">
                <h2>Want it quoted properly?</h2>
                <p>
                    The estimate above is a starting point. Send me the shape of the
                    project and I will come back with a real number and what it
                    includes, usually the same day.
                </p>
                <form action="/api/submit-form/" method="POST" id="quoteForm" class="calc-enquiry-form">
                    <div class="form-group">
                        <label for="quoteName">Your name</label>
                        <input type="text" id="quoteName" name="name" required autocomplete="name" placeholder="Jane Doe" />
                    </div>
                    <div class="form-group">
                        <label for="quoteEmail">Email address</label>
                        <input type="email" id="quoteEmail" name="email" required autocomplete="email" placeholder="jane@example.com" />
                    </div>
                    <div class="form-group form-group-wide">
                        <label for="quoteMessage">What are you trying to do?</label>
                        <textarea id="quoteMessage" name="message" rows="4" placeholder="A sentence or two is plenty."></textarea>
                    </div>
                    <input type="hidden" name="source" value="calculator" />
                    <div class="form-group form-group-wide">
                        <NewsletterOptIn />
                    </div>
                    <div class="form-group form-group-wide">
                        <button type="submit" class="btn btn-primary btn-pill glow-effect w-100">Send it over</button>
                    </div>
                </form>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .calculator-hero {
        /*
          The heading and the thing it introduces belong together.

          section-padding is 100px top and bottom, and the calculator below
          brings its own 100px, so a full 200px of empty page sat between
          "Project Cost Estimator" and the first service. The page previously
          tried to cancel it with `pb-0 pt-32`, two classes that are not defined
          in any stylesheet and therefore did nothing at all. Halving the bottom
          here and letting the calculator's own top padding carry the rest is
          the version that works.
        */
        padding-bottom: 0;
    }
    .calculator-hero h1 {
        margin-bottom: 16px;
    }
    .calculator-hero .hero-subtitle {
        max-width: 60ch;
        margin: 0;
    }

    .calc-enquiry-card {
        max-width: 760px;
        margin: 0 auto;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-md);
        padding: 40px;
        box-shadow: var(--shadow-sm);
    }
    .calc-enquiry-card h2 {
        margin-bottom: 12px;
        font-size: clamp(1.4rem, 3vw, 1.9rem);
    }
    .calc-enquiry-card > p {
        color: var(--text-muted);
        max-width: 56ch;
        margin-bottom: 28px;
    }

    /*
      Two columns for the short fields, one for everything else.

      Laid out with grid and a gap rather than per-field margins, so the message
      box and the button cannot end up with doubled or collapsed spacing against
      the pair above them.
    */
    .calc-enquiry-form {
        display: grid;
        grid-template-columns: 1fr;
        gap: 20px;
    }
    @media (min-width: 620px) {
        .calc-enquiry-form { grid-template-columns: 1fr 1fr; }
        .form-group-wide { grid-column: 1 / -1; }
    }
    .calc-enquiry-form label {
        display: block;
        margin-bottom: 8px;
        font-weight: 500;
        font-size: 0.95rem;
    }
    .calc-enquiry-form input,
    .calc-enquiry-form textarea {
        width: 100%;
        padding: 12px 16px;
        background: var(--field-bg);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        color: var(--field-text);
        font: inherit;
    }
    .calc-enquiry-form input:focus-visible,
    .calc-enquiry-form textarea:focus-visible {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    @media (max-width: 560px) {
        .calc-enquiry-card { padding: 28px 20px; }
    }
</style>
