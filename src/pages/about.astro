---
import StrokeIcon from '../components/StrokeIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHero from '../components/PageHero.astro';
import { payloadFetchGlobal } from '../lib/payload';
import { resolveSeo } from '../lib/seo';
import { BOOKING_PATH } from '../lib/booking';
const about = await payloadFetchGlobal('about');
/*
  Rewritten 19 October 2026. The page used to be built around the founder
  ("Hi, I'm Ernest", "Meet the founder", "Based in Ghana", his portrait). Ernest
  wants the site to sell the results clients get, not founder-led working or
  where Quadem is, so it now leads with what we do for clients and names him
  once, as a fact, in "Who we are". The copy lives in the about global.
*/
const pageTitle = about?.title || 'About Quadem Digital';
const headline = about?.headline || 'We help businesses win more customers online.';
const subheadline = about?.subheadline || 'Websites, WhatsApp assistants, AI video, search and ads, each built to bring in enquiries and sales, and measured every month.';
const bio = (about?.bio || '').split(/\n+/).filter(Boolean);
const values = about?.coreValues || [];
const seo = resolveSeo(about, { title: `${pageTitle} | Quadem Digital`, description: 'Quadem Digital builds websites, AI video, search and ads that bring businesses more enquiries and sales. How we work and what we value.' });
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="about">
  <PageHero variant="page" eyebrow={pageTitle} headline={headline} lede={subheadline} primaryCta={{ label: 'See our work', href: '/projects/' }} />
  <section class="lab-about-impact section-padding">
    <div class="container">
      <div class="section-header"><h2>Built around results.</h2><p>Every project starts with the result you want and ends with a report on whether we got there.</p></div>
      <div class="lab-impact-grid">
        <div class="lab-impact-promise"><svg aria-hidden="true" width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><circle cx="24" cy="32" r="20"/><circle cx="40" cy="32" r="20"/></svg>{about?.mission && <><h3>Our mission</h3><span>{about.mission}</span></>}{about?.vision && <><h3>Our vision</h3><span>{about.vision}</span></>}</div>
        <div class="lab-impact-fact"><strong>Fixed</strong><span>Price agreed before we start</span></div>
        <div class="lab-impact-fact"><strong>Weekly</strong><span>Progress you can see</span></div>
        <div class="lab-impact-fact"><strong>Monthly</strong><span>Results reports</span></div>
        <div class="lab-impact-fact"><strong>Yours</strong><span>Website ownership & handover</span></div>
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container">
      <div class="section-header"><h2>What we value.</h2><p>The way we work on every project.</p></div>
      <div class="studio-expect-grid">
        {values.map((value: any, index: number) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{value.title}</h3><p>{value.description}</p></article>)}
      </div>
    </div>
  </section>
  {bio.length > 0 && <section class="section-padding about-who" id="who-we-are">
    <div class="container about-who-inner">
      <h2>Who we are</h2>
      {bio.map((paragraph: string) => <p>{paragraph}</p>)}
      <div class="studio-actions"><a href={BOOKING_PATH} class="btn btn-primary btn-pill">Let's talk about your project <StrokeIcon /></a></div>
    </div>
  </section>}
  <style>
    .about-who-inner { max-width: 760px; text-align: center; }
    .about-who-inner p { font-size: 1.15rem; line-height: 1.6; color: var(--text-muted); }
    .about-who-inner .studio-actions { justify-content: center; margin-top: 24px; }
  </style>
</BaseLayout>
