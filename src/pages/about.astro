---
// About, in the new style (owner, 26-27 Oct 2026: About, the services overview
// and Contact after the work pages). A reading page: normal scrolling, the
// service pages' promise at the top and their giant section titles. The words
// are the about global's (rewritten 19 October 2026 to lead with what we do
// for clients rather than with the founder, who is named once, as a fact, in
// "Who we are"); the four facts and the section headings are the page's own,
// as before.
import BaseLayout from '../layouts/BaseLayout.astro';
import { payloadFetchGlobal } from '../lib/payload';
import { resolveSeo } from '../lib/seo';
import { BOOKING_PATH } from '../lib/booking';
import '../styles/service.css';
import '../styles/pages-d.css';

const about = await payloadFetchGlobal('about');
const pageTitle = about?.title || 'About Quadem Digital';
const headline = about?.headline || 'We help businesses win more customers online.';
const subheadline = about?.subheadline || 'Websites, WhatsApp assistants, AI video, search and ads, each built to bring in enquiries and sales, and measured every month.';
const bio = (about?.bio || '').split(/\n+/).filter(Boolean);
const values = about?.coreValues || [];
const FACTS = [
  { value: 'Fixed', label: 'Price agreed before we start' },
  { value: 'Weekly', label: 'Progress you can see' },
  { value: 'Monthly', label: 'Results reports' },
  { value: 'Yours', label: 'Website ownership & handover' },
];
const ARROW = '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>';
const pad = (n: number) => String(n).padStart(2, '0');
const seo = resolveSeo(about, { title: `${pageTitle} | Quadem Digital`, description: 'Quadem Digital builds websites, AI video, search and ads that bring businesses more enquiries and sales. How we work and what we value.' });
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="about" headerDark scaleUp>
  <div class="dsv dpg">
    <section class="d-scope d-dark dsv-hero" aria-labelledby="dab-title">
      <div class="dsv-glow" aria-hidden="true"></div>
      <div class="dsv-hero-in">
        <div class="dsv-copy">
          <p class="dsv-lab">{pageTitle}</p>
          <h1 class="dsv-h1" id="dab-title">{headline}</h1>
          <p class="dsv-lead">{subheadline}</p>
          <div class="dsv-ctas">
            <a class="d-btn d-btn-primary dsv-btn" href="/projects/" data-track="about_work" data-loc="about-hero">See our work <svg class="dsv-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} /></a>
            <a class="dsv-more" href={BOOKING_PATH} data-track="book_call" data-loc="about-hero">Let's talk about your project</a>
          </div>
        </div>
        <ul class="dsv-visual dpg-facts" aria-label="How every project runs">
          {FACTS.map((fact) => <li><b>{fact.value}</b><span>{fact.label}</span></li>)}
        </ul>
      </div>
    </section>

    {(about?.mission || about?.vision) && (
      <section class="d-scope d-light dpg-block" aria-labelledby="dab-results">
        <div class="d-wrap">
          <div class="d-bigtitle is-static" aria-hidden="true">
            <span class="d-bigtitle-word">Built around results</span>
            <span class="d-bigtitle-sub"><span class="d-bigtitle-label">Our mission · Our vision</span></span>
          </div>
          <h2 class="dsv-sr" id="dab-results">Built around results.</h2>
          <p class="dsv-text">Every project starts with the result you want and ends with a report on whether we got there.</p>
          <div class="dpg-pair">
            {about?.mission && <article class="dpg-card"><p class="dsv-lab">Our mission</p><p class="dpg-quote">{about.mission}</p></article>}
            {about?.vision && <article class="dpg-card"><p class="dsv-lab">Our vision</p><p class="dpg-quote">{about.vision}</p></article>}
          </div>
        </div>
      </section>
    )}

    {values.length > 0 && (
      <section class="d-scope d-light dpg-block dpg-alt" aria-labelledby="dab-values">
        <div class="d-wrap">
          <div class="d-bigtitle is-static" aria-hidden="true">
            <span class="d-bigtitle-word">What we value</span>
            <span class="d-bigtitle-sub"><span class="d-bigtitle-label">The way we work on every project</span></span>
          </div>
          <h2 class="dsv-sr" id="dab-values">What we value.</h2>
          <ol class="dpg-cards">
            {values.map((value: any, index: number) => <li class="dpg-card"><span class="dpg-num">{pad(index + 1)}</span><h3>{value.title}</h3><p>{value.description}</p></li>)}
          </ol>
        </div>
      </section>
    )}

    <section class="d-scope d-dark dsv-flat dsv-enquire" id="who-we-are" data-your-move aria-labelledby="dab-who">
      <div class="d-wrap">
        <div class="d-bigtitle is-static" aria-hidden="true">
          <span class="d-bigtitle-word">Who we are</span>
          <span class="d-bigtitle-sub"><span class="d-bigtitle-label">Quadem Digital</span></span>
        </div>
        <h2 class="dsv-sr" id="dab-who">Who we are</h2>
        <div class="dpg-bio">{bio.map((paragraph: string) => <p>{paragraph}</p>)}</div>
        <div class="dsv-ctas">
          <a class="d-btn d-btn-primary dsv-btn" href={BOOKING_PATH} data-track="book_call" data-loc="about-who">Let's talk about your project <svg class="dsv-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} /></a>
        </div>
      </div>
    </section>
  </div>
</BaseLayout>
