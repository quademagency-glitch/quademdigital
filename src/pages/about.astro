---
import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetchGlobal, buildPayloadImageUrl } from "../lib/payload";

const aboutData = await payloadFetchGlobal("about");

const pageTitle = aboutData?.title || "About Me";
const headline = aboutData?.headline || "Hey, I'm the face behind Quadem Digital.";
const bioRaw = aboutData?.bio || "I started this agency with one simple belief: great design and smart strategy shouldn't just look good—they should make you money.\n\nUnlike huge, bloated agencies where you're just another account number, Quadem operates as your personal digital growth partner. When you work with us, you get direct communication, rapid execution, and a team that genuinely cares about your bottom line.\n\nWhether you need a high-converting website, a fresh brand identity, or a marketing campaign that actually works, we've got you covered.";
const bioParagraphs = bioRaw.split('\n').filter((p: string) => p.trim() !== '');
const mission = aboutData?.mission || "Our mission is to empower brands with digital solutions that drive real, measurable growth.";
const vision = aboutData?.vision || "We envision a digital landscape where every business, regardless of size, can compete at the highest level through premium design and strategy.";
const values = aboutData?.coreValues || [
  { title: "Results Driven", description: "We focus on metrics that matter." },
  { title: "Transparency", description: "No hidden fees, no jargon, just clear communication." },
  { title: "Premium Quality", description: "We don't settle for 'good enough'." }
];
const imageUrl = aboutData?.founderImage ? buildPayloadImageUrl(aboutData.founderImage) : null;
---
<BaseLayout title={`${pageTitle} | Quadem Digital`} description="Learn more about the founder of Quadem Digital Enterprise and our core values." activePage="about" navbarScrolled={true}>
    <fragment slot="head">
        <style>
            .values-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: 2rem;
                margin-top: 3rem;
            }
            .value-card {
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--border-color);
                padding: 2rem;
                border-radius: 12px;
                transition: all 0.3s ease;
            }
            .value-card:hover {
                border-color: var(--accent);
                transform: translateY(-5px);
                box-shadow: 0 10px 30px rgba(0, 174, 239, 0.1);
            }

            @media (max-width: 480px) {
                .values-grid {
                    grid-template-columns: 1fr;
                    gap: 1.2rem;
                }

                .value-card {
                    padding: 1.5rem;
                }

                .about-title {
                    font-size: 1.5rem;
                }
            }
        </style>
    </fragment>

    <section class="about-hero">
        <div class="container">
            <h1><span class="text-gradient">{pageTitle}</span></h1>
            <p class="hero-subtitle">The vision and values driving Quadem Digital.</p>
        </div>
    </section>

    <!-- About Content -->
    <section class="section-padding">
        <div class="container">
            <div class="about-grid">
                <div class="about-image-col animate-on-scroll slide-right">
                    <div class="about-image-glass-container">
                        <div class="glow-blob"></div>
                        <div class="about-image-wrapper arched-frame glow-effect">
                            {imageUrl ? (
                                <img src={imageUrl} alt="Founder Image" loading="lazy" width="600" height="800" />
                            ) : (
                                <img src="/images/founder-mock.jpg" alt="Founder Image" loading="lazy" width="600" height="800" />
                            )}
                        </div>
                    </div>
                </div>
                <div class="about-content-col animate-on-scroll slide-left delay-200">
                    <h2 class="about-title"><span class="text-gradient">{headline}</span></h2>
                    {bioParagraphs.map((paragraph: string) => (
                        <p class="about-text">{paragraph}</p>
                    ))}
                    <a href="/contact" class="btn btn-primary btn-pill glow-effect mt-4">Let's Work Together</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Mission & Vision -->
    <section class="section-padding">
        <div class="container">
            <div class="values-grid" style="margin-top: 0;">
                <div class="value-card animate-on-scroll slide-up" style="background: rgba(0, 174, 239, 0.05); border-color: rgba(0, 174, 239, 0.2);">
                    <h3 style="color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-heading);">Our Mission</h3>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">{mission}</p>
                </div>
                <div class="value-card animate-on-scroll slide-up delay-200" style="background: rgba(0, 174, 239, 0.05); border-color: rgba(0, 174, 239, 0.2);">
                    <h3 style="color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-heading);">Our Vision</h3>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">{vision}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values -->
    <section class="section-padding" style="background: rgba(0, 174, 239, 0.02);">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Our Core Values</span></h2>
                <p>The principles that guide everything we do.</p>
            </div>
            <div class="values-grid">
                {values.map((value: any, index: number) => (
                    <div class={`value-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <h3 style="color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-heading);">{value.title}</h3>
                        <p style="color: var(--text-muted);">{value.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>
</BaseLayout>
