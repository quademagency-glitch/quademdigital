---
import { sanityClient } from "sanity:client";

const aboutData = await sanityClient.fetch(`*[_type == "about"][0]`);
const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);

const pageTitle = aboutData?.title || "About Me";
const headline = aboutData?.headline || "Hey, I'm the face behind Quadem Digital.";
const bioRaw = aboutData?.bio || "I started this agency with one simple belief: great design and smart strategy shouldn't just look good—they should make you money.\n\nUnlike huge, bloated agencies where you're just another account number, Quadem operates as your personal digital growth partner. When you work with us, you get direct communication, rapid execution, and a team that genuinely cares about your bottom line.\n\nWhether you need a high-converting website, a fresh brand identity, or a marketing campaign that actually works, we've got you covered.";
const bioParagraphs = bioRaw.split('\n').filter((p: string) => p.trim() !== '');
const mission = aboutData?.mission || "Our mission is to empower brands with digital solutions that drive real, measurable growth.";
const vision = aboutData?.vision || "We envision a digital landscape where every business, regardless of size, can compete at the highest level through premium design and strategy.";
const values = aboutData?.coreValues || [
  { title: "Results Driven", description: "We focus on metrics that matter." },
  { title: "Transparency", description: "No hidden fees, no jargon, just clear communication." },
  { title: "Premium Quality", description: "We don't settle for 'good enough'." }
];
const coverImageRef = aboutData?.founderImage?.asset?._ref;
let imageUrl = null;
if (coverImageRef) {
  imageUrl = `https://cdn.sanity.io/images/xectqauu/production/${coverImageRef.replace('image-', '').replace('-jpg', '.jpg').replace('-png', '.png')}?auto=format&fit=max&w=800&q=80`;
}
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle} | Quadem Digital</title>
    <meta name="description" content="Learn more about the founder of Quadem Digital Enterprise and our core values.">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
    <style>
        .about-hero {
            padding-top: 150px;
            padding-bottom: 80px;
            text-align: center;
            background: radial-gradient(circle at top, rgba(0, 174, 239, 0.1), transparent 50%);
        }
        .values-grid {
            display: grid;
            grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
            gap: 2rem;
            margin-top: 3rem;
        }
        .value-card {
            background: rgba(255, 255, 255, 0.02);
            border: 1px solid var(--border-color);
            padding: 2rem;
            border-radius: 12px;
            transition: all 0.3s ease;
        }
        .value-card:hover {
            border-color: var(--accent);
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(0, 174, 239, 0.1);
        }
    </style>
</head>
<body>
    <header class="navbar scrolled" id="navbar">
        <div class="container navbar-container">
            <a href="/" class="logo active-logo">
                <img src="/images/logo.png" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
            </a>
            
            <nav class="nav-links">
                <a href="/services">Services</a>
                <a href="/projects">Projects</a>
                <a href="/about" style="color: var(--accent);">About</a>
                <a href="/#contact">Contact</a>
            </nav>
            
            <div class="nav-cta">
                <a href="/#contact" class="btn btn-primary btn-pill">Book a Call</a>
            </div>
            
            <button class="mobile-menu-btn" aria-label="Toggle menu">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>

    <div class="mobile-menu-drawer">
        <nav class="mobile-nav-links">
            <a href="/services">Services</a>
            <a href="/projects">Projects</a>
            <a href="/about" style="color: var(--accent);">About</a>
            <a href="/#contact">Contact</a>
            <a href="/#contact" class="btn btn-primary btn-pill mt-4">Book a Call</a>
        </nav>
    </div>

    <section class="about-hero">
        <div class="container">
            <h1><span class="text-gradient">{pageTitle}</span></h1>
            <p class="hero-subtitle">The vision and values driving Quadem Digital.</p>
        </div>
    </section>

    <!-- About Content -->
    <section class="section-padding">
        <div class="container">
            <div class="about-grid">
                <div class="about-image-col animate-on-scroll slide-right">
                    <div class="about-image-wrapper glow-effect" style="height: 100%;">
                        {imageUrl ? (
                            <img src={imageUrl} alt="Founder Image" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:12px;" />
                        ) : (
                            <img src="/images/founder-mock.jpg" alt="Founder Image" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:12px;" />
                        )}
                    </div>
                </div>
                <div class="about-content-col animate-on-scroll slide-left delay-200">
                    <h2 class="about-title"><span class="text-gradient">{headline}</span></h2>
                    {bioParagraphs.map((paragraph: string) => (
                        <p class="about-text">{paragraph}</p>
                    ))}
                    <a href="/#contact" class="btn btn-primary btn-pill glow-effect mt-4">Let's Work Together</a>
                </div>
            </div>
        </div>
    </section>

    <!-- Mission & Vision -->
    <section class="section-padding">
        <div class="container">
            <div class="values-grid" style="margin-top: 0;">
                <div class="value-card animate-on-scroll slide-up" style="background: rgba(0, 174, 239, 0.05); border-color: rgba(0, 174, 239, 0.2);">
                    <h3 style="color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-heading);">Our Mission</h3>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">{mission}</p>
                </div>
                <div class="value-card animate-on-scroll slide-up delay-200" style="background: rgba(0, 174, 239, 0.05); border-color: rgba(0, 174, 239, 0.2);">
                    <h3 style="color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-heading);">Our Vision</h3>
                    <p style="color: var(--text-muted); font-size: 1.1rem; line-height: 1.6;">{vision}</p>
                </div>
            </div>
        </div>
    </section>

    <!-- Core Values -->
    <section class="section-padding" style="background: rgba(0, 174, 239, 0.02);">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2><span class="text-gradient">Our Core Values</span></h2>
                <p>The principles that guide everything we do.</p>
            </div>
            <div class="values-grid">
                {values.map((value: any, index: number) => (
                    <div class={`value-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <h3 style="color: var(--text-primary); margin-bottom: 12px; font-family: var(--font-heading);">{value.title}</h3>
                        <p style="color: var(--text-muted);">{value.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <footer class="footer" style="margin-top: 40px; border-top: 1px solid var(--border-color);">
        <div class="container footer-container">
            <div class="footer-col">
                <a href="/" class="logo footer-logo active-logo">
                    <img src="/images/logo.png" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                    <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
                </a>
                <p class="footer-tagline">{siteSettings?.footerTagline || "Elevating brands with premium design and data-driven strategies."}</p>
            </div>
            
            <div class="footer-col">
                <h4>Quick Links</h4>
                <nav class="footer-nav">
                    <a href="/services">Services</a>
                    <a href="/projects">Projects</a>
                    <a href="/about">About</a>
                    <a href="/#contact">Contact</a>
                </nav>
            </div>
            
            <div class="footer-col footer-bottom">
                <p class="copyright">&copy; 2026 Quadem Digital Enterprise. All rights reserved.</p>
                <a href="#" class="back-to-top">Back to top ↑</a>
            </div>
        </div>
    </footer>

    <script is:inline src="/js/main.js"></script>
</body>
</html>
