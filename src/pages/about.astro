---
import { PORTRAIT_MEDIA_SIZES } from "../lib/mediaPresentation";
import StrokeIcon from '../components/StrokeIcon.astro';
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import PageHero from '../components/PageHero.astro';
import { payloadFetchGlobal } from '../lib/payload';
import { resolveSeo } from '../lib/seo';
import { BOOKING_PATH } from '../lib/booking';
const about = await payloadFetchGlobal('about');
const founder = about?.founderImage;
const pageTitle = about?.title || 'About Quadem Digital';
const founderName = about?.founderName || 'Ernest';
const headline = about?.headline || "Hi, I'm Ernest, the person behind Quadem Digital.";
const subheadline = about?.subheadline || 'Work directly with the person building your project.';
const bio = (about?.bio || '').split(/\n+/).filter(Boolean);
const values = about?.coreValues || [];
const seo = resolveSeo(about, { title: `${pageTitle} | Quadem Digital`, description: 'Learn more about the founder of Quadem Digital Enterprise, my story, and the core values that drive the work I do for every client.' });
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="about">
  <PageHero variant="page" eyebrow="The studio" headline={pageTitle} lede={subheadline} primaryCta={{ label: 'Meet the founder', href: '#founder' }} />
  <section class="lab-about-impact section-padding">
    <div class="container">
      <div class="section-header"><h2>A personal commitment.</h2><p>A small studio, with a clear way of working and a direct connection to the person building your project.</p></div>
      <div class="lab-impact-grid">
        <div class="lab-impact-promise"><svg aria-hidden="true" width="64" height="64" viewBox="0 0 64 64" fill="none" stroke="currentColor" stroke-width="2"><circle cx="24" cy="32" r="20"/><circle cx="40" cy="32" r="20"/></svg>{about?.mission && <><h3>Our mission</h3><span>{about.mission}</span></>}{about?.vision && <><h3>Our vision</h3><span>{about.vision}</span></>}</div>
        <div class="lab-impact-fact"><strong>1</strong><span>Direct point of contact</span></div>
        <div class="lab-impact-fact"><strong>Accra</strong><span>Based in Ghana</span></div>
        <div class="lab-impact-fact"><strong>Worldwide</strong><span>Working remotely</span></div>
        <div class="lab-impact-fact"><strong>Yours</strong><span>Website ownership & handover</span></div>
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container studio-founder-panel" id="founder">
      <div class="studio-founder-image">{founder && <Picture image={founder} alt={founder.alt || `${founderName}, founder of Quadem Digital`} sizes={PORTRAIT_MEDIA_SIZES} size="medium" width={600} height={600} priority />}</div>
      <div>
        <p class="studio-label">{founderName} · Founder</p>
        <h2>{headline}</h2>
        {bio.map((paragraph: string) => <p>{paragraph}</p>)}
        <div class="studio-actions"><a href={BOOKING_PATH} class="btn btn-primary btn-pill">Let's talk about your project <StrokeIcon /></a></div>
      </div>
    </div>
  </section>
  <section class="section-padding">
    <div class="container">
      <div class="section-header"><h2>What you can expect.</h2><p>A practical way of working, with room for your feedback and a clear next step.</p></div>
      <div class="studio-expect-grid">
        {values.map((value: any, index: number) => <article><span>{String(index + 1).padStart(2, '0')}</span><h3>{value.title}</h3><p>{value.description}</p></article>)}
      </div>
    </div>
  </section>
</BaseLayout>
