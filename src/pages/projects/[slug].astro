---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch, buildPayloadImageUrl, lexicalToHtml, getPayloadImageSize, getPayloadImageSrcset } from "../../lib/payload";

// Server-rendered for instant updates
const { slug } = Astro.params;
const caseStudies = await payloadFetch('caseStudies', {
  'where[slug][equals]': slug,
  depth: '1'
});
const study = caseStudies[0];

function getEmbedUrl(url: string) {
    if (!url) return null;
    const ytMatch = url.match(/^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
    if (ytMatch && ytMatch[2].length === 11) {
        return `https://www.youtube.com/embed/${ytMatch[2]}?rel=0`;
    }
    const vmMatch = url.match(/(?:www\.|player\.)?vimeo.com\/(?:channels\/(?:\w+\/)?|groups\/(?:[^\/]*)\/videos\/|album\/(?:\d+)\/video\/|video\/|)(\d+)(?:[a-zA-Z0-9_\-]+)?/i);
    if (vmMatch) {
        return `https://player.vimeo.com/video/${vmMatch[1]}`;
    }
    return null;
}

if (!study) {
  return Astro.redirect('/projects/');
}

const coverUrl = study.coverImage ? buildPayloadImageUrl(study.coverImage) : null;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": study.title,
    "image": coverUrl ? [coverUrl] : [],
    "author": {
        "@type": "Organization",
        "name": "Quadem Digital Enterprise"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Quadem Digital Enterprise",
        "logo": {
            "@type": "ImageObject",
            "url": "https://quademdigital.com/images/logo.webp"
        }
    },
    "description": study.description || ""
};
---
<BaseLayout title={`${study.title} | Quadem Digital`} description={study.description || ""} activePage="projects" navbarScrolled={true} ogImage={coverUrl || undefined} jsonLd={jsonLd}>
    <section class="case-study-hero">
        <div class="container">
            {study.tag && <span class="work-tag" style="color: var(--accent-text); font-weight: 500; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 16px;">{study.tag}</span>}
            <h1>{study.title}</h1>
            <p class="hero-subtitle">{study.description}</p>
        </div>
    </section>

    <div class="container case-study-content section-padding">
        {study.coverImage && (
            <div class="case-study-image" style="margin-bottom: 40px;">
                <img src={getPayloadImageSize(study.coverImage, 'large') || buildPayloadImageUrl(study.coverImage)} alt={study.title} style="width:100%; border-radius:12px;" width="1200" height="600" fetchpriority="high" loading="eager" />
            </div>
        )}
        
        {study.body ? (
            <div class="portable-text-body" set:html={lexicalToHtml(study.body)} />
        ) : (
            <div class="text-block-content" style="color: var(--text-muted); text-align: center; padding: 40px;">
                <p>Detailed case study content coming soon.</p>
            </div>
        )}

        {study.resultMetric && study.resultText && (
            <div class="work-result" style="margin-top: 40px; padding: 24px; background: rgba(0,174,239,0.05); border-radius: 12px; border: 1px solid rgba(0,174,239,0.2);">
                <span class="result-metric" style="font-size: 2.5rem; color: var(--accent-text); font-weight: 700; display: block; margin-bottom: 8px;">{study.resultMetric}</span>
                <span class="result-text" style="font-size: 1.1rem;">{study.resultText}</span>
            </div>
        )}

        {/* --- Image Gallery Section --- */}
        {study.imageGallery && study.imageGallery.length > 0 && (
            <div class="case-study-gallery" style="margin-top: 60px;">
                <h3 style="margin-bottom: 24px; font-size: 1.8rem;">Project Gallery</h3>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 20px;">
                    {study.imageGallery.map((imgItem: any) => (
                        <div class="gallery-img-wrapper" style="border-radius: 12px; overflow: hidden; background: var(--bg-hover); aspect-ratio: 4/3;">
                            {imgItem.image && (
                                    <img
                                        src={getPayloadImageSize(imgItem.image, 'medium')}
                                        srcset={getPayloadImageSrcset(imgItem.image) || undefined}
                                        sizes="(max-width: 640px) 100vw, 400px"
                                        alt={imgItem.image.alt || `${study.title} project image`}
                                        style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.5s ease;"
                                        class="hover-zoom"
                                        loading="lazy"
                                        decoding="async"
                                        width="800"
                                        height="600"
                                    />
                            )}
                        </div>
                    ))}
                </div>
            </div>
        )}

        {/* --- Video Gallery Section --- */}
        {study.videoGallery && study.videoGallery.length > 0 && (
            <div class="case-study-videos" style="margin-top: 60px;">
                <h3 style="margin-bottom: 24px; font-size: 1.8rem;">Media & Video</h3>
                <div style="display: flex; flex-direction: column; gap: 40px;">
                    {study.videoGallery.map((video: any) => (
                        <div class="video-container" style="border-radius: 16px; overflow: hidden; background: #000; box-shadow: 0 10px 30px rgba(0,0,0,0.5);">
                            {video.title && <div style="padding: 16px 20px; background: var(--bg-hover); border-bottom: 1px solid var(--border-color);"><h4 style="margin:0; font-size: 1.1rem;">{video.title}</h4></div>}
                            <div style="position: relative; padding-bottom: 56.25%; height: 0; overflow: hidden;">
                                {video.videoUrl && getEmbedUrl(video.videoUrl) ? (
                                    <iframe 
                                        src={getEmbedUrl(video.videoUrl)} 
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; border: 0;" 
                                        allowfullscreen 
                                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                    </iframe>
                                ) : video.videoFile?.url ? (
                                    <video 
                                        controls 
                                        style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; outline: none;"
                                        preload="metadata">
                                        <source src={video.videoFile.url} type="video/mp4" />
                                        Your browser does not support the video tag.
                                    </video>
                                ) : (
                                    <div style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; display: flex; align-items: center; justify-content: center; background: #111; color: #666;">
                                        Invalid video source
                                    </div>
                                )}
                            </div>
                        </div>
                    ))}
                </div>
            </div>
        )}

        <div style="text-align: center; margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-color);">
            <a href="/projects/" class="btn btn-ghost btn-pill">← Back to Projects</a>
        </div>
    </div>
</BaseLayout>

<style>
    .hover-zoom:hover {
        transform: scale(1.05);
    }
</style>
