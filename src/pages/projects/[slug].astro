---
import DBackdrop from "../../components/homeD/DBackdrop.astro";
import { SPLIT_MEDIA_SIZES } from "../../lib/mediaPresentation";
import BaseLayout from "../../layouts/BaseLayout.astro";
import GlobalLayout from "../../layouts/GlobalLayout.astro";
import { payloadFetch, buildPayloadImageUrl, lexicalToHtml, getPayloadImageSize, getPayloadImageSrcset, resolveVideo } from "../../lib/payload";
import Video from "../../components/Video.astro";
import Picture from "../../components/Picture.astro";
import MetricsComparison from "../../components/MetricsComparison.astro";
import { resolveSeo } from "../../lib/seo";
import "../../styles/service.css";
import "../../styles/work-pages.css";

// Server-rendered for instant updates
const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const caseStudies = await payloadFetch('caseStudies', {
  'where[slug][equals]': slug,
  depth: '1'
});
const study = caseStudies[0];

function getEmbedUrl(url: string) {
    if (!url) return null;
    const ytMatch = url.match(/^.*(youtu.be\/|v\/|u\/\w\/|embed\/|watch\?v=|&v=)([^#&?]*).*/);
    if (ytMatch && ytMatch[2].length === 11) {
        return `https://www.youtube.com/embed/${ytMatch[2]}?rel=0`;
    }
    const vmMatch = url.match(/(?:www\.|player\.)?vimeo.com\/(?:channels\/(?:\w+\/)?|groups\/(?:[^\/]*)\/videos\/|album\/(?:\d+)\/video\/|video\/|)(\d+)(?:[a-zA-Z0-9_\-]+)?/i);
    if (vmMatch) {
        return `https://player.vimeo.com/video/${vmMatch[1]}`;
    }
    return null;
}

if (!study) {
  return Astro.redirect('/projects/');
}

/*
  An unpublished case study stays reachable by URL and is kept out of search.

  Deliberately not a 404. CaseStudies has no drafts, so there is no preview
  path for it, and 404ing the slug would mean the person who asked for the page
  cannot review the page. Instead it is unlisted: absent from the projects grid,
  absent from the sitemap, and carrying noindex. Someone with the link sees it,
  a search engine does not, and a visitor who lands on it is told plainly that
  it is not finished.
*/
const isUnpublished = study.published !== true;

const coverUrl = study.coverImage ? buildPayloadImageUrl(study.coverImage) : null;

/*
  The two projects either side of this one, in the same order the projects grid
  uses. A write-up that ends in a single "back" link sends the reader out of the
  work; one that ends in the next project keeps them in it.

  Unpublished entries are excluded, so the pager can never leak a draft, and a
  draft being previewed simply has no neighbours: indexOf returns -1 and the
  whole block is skipped.
*/
const published = (await payloadFetch('caseStudies', { sort: 'order', depth: '1' }))
    .filter((s: any) => s.published === true && s.slug);
const position = published.findIndex((s: any) => s.slug === study.slug);
const previous = position > 0 ? published[position - 1] : null;
const next = position > -1 && position < published.length - 1 ? published[position + 1] : null;

const gallery = (study.imageGallery || []).filter((item: any) => item?.image);
const videos = study.videoGallery || [];
/*
  The new style (owner, 26 Oct 2026: the work pages after the service pages).
  The project's kind and status as chips in the promise, and its measured
  result first under it: the result field, and for a project measured before
  and after (Omek's phone test) the four headline numbers, labelled as on the
  home page. Only fields that exist on the document are shown.
*/
const kind = study.projectType === 'concept' ? 'Concept project' : study.projectType === 'self' ? 'Internal project' : 'Client project';
const inProgress = /in.progress|in progress/i.test(`${study.status || ''} ${study.resultText || ''}`);
const HEADLINE: Record<string, string> = {
    'Performance score': 'Score',
    'Time until anything appears': 'First thing on screen',
    'Time until the main picture loads': 'Main picture',
    'Time until the page looks finished': 'Page looks finished',
};
const ORDER = Object.keys(HEADLINE);
const headline = (Array.isArray(study.metrics) ? study.metrics : [])
    .filter((m: any) => /mobile/i.test(String(m.section || '')) && HEADLINE[m.label] && m.before && m.after)
    .sort((a: any, b: any) => ORDER.indexOf(a.label) - ORDER.indexOf(b.label));
const showResult = !!study.resultMetric || headline.length > 0;
const ARROW = '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>';

/*
  Where the reader came from, and therefore where they should be sent next.

  /global is a separate funnel: its own chrome, no /offers, no WhatsApp float,
  no exit popup, prices in dollars, and a booking widget at the bottom. Its work
  cards used to link straight here, which dropped an international prospect onto
  the Ghana site. The Start a conversation button then sent them to /contact/,
  which is the Ghana contact page with the price calculator on it. Roughly a
  thousand cold emails point at /global, so that was the campaign leaking into
  the wrong site at its most interested moment.

  A query string is what carries the context, because the page is edge cached
  and a cookie would be read after the cached HTML had already been served. Query
  strings are part of the Vercel cache key, so /projects/x/ and
  /projects/x/?from=global are cached separately and neither can be served in
  place of the other.

  The canonical URL is built from the pathname in both layouts, so the two
  variants collapse to one address for search engines and there is no duplicate
  page to index.
*/
const fromGlobal = Astro.url.searchParams.get('from') === 'global';
const Layout = fromGlobal ? GlobalLayout : BaseLayout;
/** Keeps the marker on every link that stays inside the case studies. */
const keepContext = (href: string) => (fromGlobal ? `${href}?from=global` : href);
const primaryCta = fromGlobal ? '/global/#book' : '/contact/';
const primaryCtaLabel = fromGlobal ? 'Book a 15-minute call' : 'Start a conversation';
const backHref = fromGlobal ? '/global/#work' : '/projects/';
const backLabel = fromGlobal ? 'Back to the work' : 'Back to all projects';

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "Article",
    "headline": study.title,
    "image": coverUrl ? [coverUrl] : [],
    "author": {
        "@type": "Organization",
        "name": "Quadem Digital Enterprise"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Quadem Digital Enterprise",
        "logo": {
            "@type": "ImageObject",
            "url": "https://quademdigital.com/images/logo.webp"
        }
    },
    "description": study.description || ""
};
const seo = resolveSeo(study, {
  title: `${study.title} | Quadem Digital`,
  description: study.description || "",
  image: coverUrl || undefined,
});
---
<Layout
    title={seo.title}
    description={seo.description}
    ogImage={seo.ogImage}
    jsonLd={jsonLd}
    headerDark
    scaleUp
    {...(fromGlobal ? {} : { activePage: "projects", noindex: isUnpublished })}
>
    <div class="dcs-progress" id="csProgress" aria-hidden="true"></div>

    {isUnpublished && (
        <div class="dcs-draft">
            <strong>Not published.</strong> This case study is still being checked, so it is
            hidden from the projects page and from search. Tick "Published" in the CMS when it is ready.
        </div>
    )}

    <div class="dsv dcs">
        <section class="d-scope d-dark dsv-hero" aria-labelledby="dcs-title">
          <DBackdrop kind="wall" />
            <div class="dsv-glow" aria-hidden="true"></div>
            <div class:list={['dsv-hero-in', { 'dsv-hero-solo': !study.coverImage }]}>
                <div class="dsv-copy">
                    {study.tag && <p class="dsv-lab">{study.tag}</p>}
                    <h1 class="dsv-h1" id="dcs-title">{study.title}</h1>
                    {study.description && <p class="dsv-lead">{study.description}</p>}
                    <ul class="dcs-chips">
                        <li class:list={{ 'is-client': study.projectType === 'client' }}>{kind}</li>
                        {inProgress && <li class="is-progress">In progress</li>}
                    </ul>
                    <div class="dsv-ctas">
                        <a href={primaryCta} class="d-btn d-btn-primary dsv-btn" data-track="book_call" data-loc="case-study-hero">{fromGlobal ? 'Book a call' : 'Start a project'} <svg class="dsv-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} /></a>
                        <a href={backHref} class="dsv-more">All work</a>
                    </div>
                </div>
                {study.coverImage && (
                    <div class="dsv-visual">
                        <figure class="dcs-cover">
                            <Picture
                                image={study.coverImage}
                                alt={study.coverImage.alt || study.title}
                                sizes={SPLIT_MEDIA_SIZES}
                                size="large"
                                width={1200}
                                height={750}
                                priority
                            />
                        </figure>
                    </div>
                )}
            </div>
        </section>

        <article class="d-scope d-light dcs-main">
            {showResult && (
                <section class="dcs-result dcs-wide" aria-label="The result">
                    {study.resultMetric && <p class="dcs-result-big">{study.resultMetric}</p>}
                    {study.resultText && (
                        <p class="dcs-result-text"><span class="dcs-result-label">Where it stands</span>{study.resultText}</p>
                    )}
                    {headline.length > 0 && (
                        <ul class="dcs-ba">
                            {headline.map((m: any) => <li><s>{m.before}</s> <b>{m.after}</b><small>{HEADLINE[m.label]}</small></li>)}
                        </ul>
                    )}
                    {headline.length > 0 && study.metricsBeforeLabel && study.metricsAfterLabel && (
                        <p class="dcs-result-note">Google PageSpeed phone test, {study.metricsBeforeLabel} and {study.metricsAfterLabel}</p>
                    )}
                </section>
            )}

            <div class="dcs-col">
                {study.body ? (
                    <div class="dcs-body" set:html={lexicalToHtml(study.body)} />
                ) : (
                    <p class="dcs-empty">The write-up for this project has not been added yet.</p>
                )}
            </div>

            <div class="dcs-wide">
                {Array.isArray(study.metrics) && study.metrics.length > 0 && (
                    <div class="dcs-block">
                        <MetricsComparison
                            title={study.metricsTitle}
                            beforeLabel={study.metricsBeforeLabel}
                            afterLabel={study.metricsAfterLabel}
                            source={study.metricsSource}
                            metrics={study.metrics}
                        />
                    </div>
                )}

                {gallery.length > 0 && (
                    <section class="dcs-block" aria-labelledby="cs-gallery-heading">
                        <div class="dcs-block-head">
                            <h2 id="cs-gallery-heading">From the project</h2>
                            <span class="dcs-block-note">{gallery.length} {gallery.length === 1 ? 'image' : 'images'}</span>
                        </div>
                        <div class="dcs-gallery" id="csGallery">
                            {gallery.map((item: any, i: number) => (
                                <button
                                    type="button"
                                    class="cs-shot"
                                    data-full={buildPayloadImageUrl(item.image)}
                                    data-index={i}
                                    aria-label={`Enlarge image ${i + 1} of ${gallery.length}`}
                                >
                                    <Picture
                                        image={item.image}
                                        sizes={gallery.length % 2 === 1 && i === 0 ? '(max-width: 1100px) 92vw, 1100px' : '(max-width: 900px) 92vw, 550px'}
                                        alt={item.image.alt || `${study.title}, image ${i + 1}`}
                                        size="medium"
                                    />
                                </button>
                            ))}
                        </div>
                    </section>
                )}

                {videos.length > 0 && (
                    <section class="dcs-block" aria-labelledby="cs-video-heading">
                        <div class="dcs-block-head">
                            <h2 id="cs-video-heading">Watch it</h2>
                            <span class="dcs-block-note">{videos.length} {videos.length === 1 ? 'clip' : 'clips'}</span>
                        </div>
                        <div class="dcs-videos">
                            {videos.map((video: any) => (
                                <div class="dcs-video">
                                    {video.title && <h3 class="dcs-video-title">{video.title}</h3>}
                                    <div class="dcs-video-frame">
                                        {video.videoUrl && getEmbedUrl(video.videoUrl) ? (
                                            <iframe
                                                src={getEmbedUrl(video.videoUrl)}
                                                title={video.title || study.title}
                                                allowfullscreen
                                                allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture">
                                            </iframe>
                                        ) : video.videoFile?.url ? (
                                            <Video
                                                video={resolveVideo(video.videoFile)}
                                                mode="player"
                                                label={video.title || study.title}
                                            />
                                        ) : (
                                            <p class="dcs-empty">This clip has no playable source yet.</p>
                                        )}
                                    </div>
                                </div>
                            ))}
                        </div>
                    </section>
                )}
            </div>
        </article>

        <section class="d-scope d-dark dsv-flat dsv-enquire" data-your-move aria-labelledby="cs-cta-heading">
          <DBackdrop kind="wall" />
            <div class="d-wrap">
                <div class="d-bigtitle is-static" aria-hidden="true">
                    <span class="d-bigtitle-word">Your move</span>
                    <span class="d-bigtitle-sub"><span class="d-bigtitle-label">{primaryCtaLabel}</span></span>
                </div>
                <h2 class="dsv-h2" id="cs-cta-heading">Want the same thing done properly?</h2>
                <p class="dsv-text">Tell us what you are building and what is in your way. We will tell you what it takes, in plain numbers, before you commit to anything.</p>
                <div class="dsv-ctas">
                    <a href={primaryCta} class="d-btn d-btn-primary dsv-btn" data-track="book_call" data-loc="case-study-footer">{primaryCtaLabel} <svg class="dsv-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} /></a>
                </div>
            </div>
        </section>

        <nav class="d-scope d-light dcs-more" aria-label="More projects">
            {(previous || next) && (
                <div class="dcs-pager">
                    {previous && (
                        <a class="dcs-pager-link" href={keepContext(`/projects/${previous.slug}/`)}>
                            <span class="dcs-pager-thumb">
                                {previous.coverImage && <img src={getPayloadImageSize(previous.coverImage, 'thumbnail') || buildPayloadImageUrl(previous.coverImage)} alt="" loading="lazy" decoding="async" width="240" height="150" />}
                            </span>
                            <span>
                                <span class="dcs-pager-dir">Previous project</span>
                                <span class="dcs-pager-title">{previous.title}</span>
                            </span>
                        </a>
                    )}
                    {next && (
                        <a class="dcs-pager-link is-next" href={keepContext(`/projects/${next.slug}/`)}>
                            <span class="dcs-pager-thumb">
                                {next.coverImage && <img src={getPayloadImageSize(next.coverImage, 'thumbnail') || buildPayloadImageUrl(next.coverImage)} alt="" loading="lazy" decoding="async" width="240" height="150" />}
                            </span>
                            <span>
                                <span class="dcs-pager-dir">Next project</span>
                                <span class="dcs-pager-title">{next.title}</span>
                            </span>
                        </a>
                    )}
                </div>
            )}
            <p class="dcs-back"><a href={backHref}>{backLabel}</a></p>
        </nav>
    </div>

    {gallery.length > 0 && (
        <dialog class="dcs-lightbox" id="csLightbox" aria-label="Project image">
            <img id="csLightboxImg" src="" alt="" />
            <div class="dcs-lightbox-bar">
                <button type="button" class="cs-lightbox-btn" data-lightbox="prev" aria-label="Previous image">&#8592;</button>
                <span class="cs-lightbox-count" id="csLightboxCount"></span>
                <button type="button" class="cs-lightbox-btn" data-lightbox="next" aria-label="Next image">&#8594;</button>
                <a class="cs-lightbox-original" id="csLightboxOriginal" href={buildPayloadImageUrl(gallery[0].image)} target="_blank" rel="noopener noreferrer">Open full-size image ↗</a>
                <button type="button" class="cs-lightbox-btn" data-lightbox="close" aria-label="Close">&#10005;</button>
            </div>
        </dialog>
    )}
</Layout>

<script>
    /*
      Two small behaviours, both of which degrade to nothing without JavaScript:
      the reading progress line, and the gallery lightbox.

      Written as a named init and re-run on astro:page-load because this site
      uses view transitions, so a module that only runs on first parse stops
      working the moment someone clicks through from the projects grid.
    */
    let scrollBound = false;

    function initCaseStudy() {
        /*
          The progress line reads the bar element fresh on every frame rather
          than closing over it. A view transition swaps the whole document, so
          a captured reference would point at a detached node, and adding a new
          window listener per navigation would leak one per click.
        */
        if (!scrollBound) {
            scrollBound = true;
            let ticking = false;
            const paint = () => {
                ticking = false;
                const bar = document.getElementById('csProgress');
                if (!bar) return;
                const scrollable = document.documentElement.scrollHeight - window.innerHeight;
                const ratio = scrollable > 0 ? Math.min(1, Math.max(0, window.scrollY / scrollable)) : 0;
                bar.style.transform = `scaleX(${ratio})`;
            };
            const onScroll = () => {
                if (ticking) return;
                ticking = true;
                requestAnimationFrame(paint);
            };
            window.addEventListener('scroll', onScroll, { passive: true });
            window.addEventListener('resize', onScroll, { passive: true });
        }
        requestAnimationFrame(() => {
            const bar = document.getElementById('csProgress');
            if (bar) bar.style.transform = 'scaleX(0)';
        });

        const dialog = document.getElementById('csLightbox') as HTMLDialogElement | null;
        const grid = document.getElementById('csGallery');
        if (!dialog || !grid || typeof dialog.showModal !== 'function') return;

        const image = document.getElementById('csLightboxImg') as HTMLImageElement | null;
        const count = document.getElementById('csLightboxCount');
        const original = document.getElementById('csLightboxOriginal') as HTMLAnchorElement | null;
        const shots = Array.from(grid.querySelectorAll<HTMLButtonElement>('.cs-shot'));
        if (!image || shots.length === 0) return;

        let current = 0;

        const show = (index: number) => {
            current = (index + shots.length) % shots.length;
            const shot = shots[current];
            const thumb = shot.querySelector('img');
            image.src = shot.dataset.full || thumb?.currentSrc || thumb?.src || '';
            if (original) original.href = image.src;
            image.alt = thumb?.alt || '';
            if (count) count.textContent = `${current + 1} / ${shots.length}`;
        };

        shots.forEach((shot, index) => {
            shot.addEventListener('click', () => {
                show(index);
                dialog.showModal();
            });
        });

        dialog.addEventListener('click', (event) => {
            // A <dialog> fills the viewport for hit testing, so a click that
            // lands on the element itself rather than on its children is a
            // click on the backdrop.
            if (event.target === dialog) dialog.close();
        });

        dialog.addEventListener('keydown', (event) => {
            if (event.key === 'ArrowRight') { event.preventDefault(); show(current + 1); }
            if (event.key === 'ArrowLeft') { event.preventDefault(); show(current - 1); }
        });

        dialog.querySelectorAll<HTMLButtonElement>('[data-lightbox]').forEach((button) => {
            button.addEventListener('click', () => {
                const action = button.dataset.lightbox;
                if (action === 'close') dialog.close();
                if (action === 'next') show(current + 1);
                if (action === 'prev') show(current - 1);
            });
        });

        // Put focus back where it came from, which the browser does not do for
        // a dialog opened from a button that then scrolled out of view.
        dialog.addEventListener('close', () => {
            shots[current]?.focus();
        });
    }

    initCaseStudy();
    document.addEventListener('astro:page-load', initCaseStudy);
</script>
