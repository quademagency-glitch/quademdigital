---
import BaseLayout from "../../layouts/BaseLayout.astro";

export const prerender = true;

export function getStaticPaths() {
  return [
    {
      params: { slug: 'free-seo-audit' },
      props: {
        title: 'Free Technical SEO & Website Performance Audit',
        description: 'Is your website underperforming? We\'re offering a completely free, no-obligation audit of your website\'s SEO, speed, and user experience. We\'ll provide you with a custom roadmap to increase your traffic and conversions.',
        image: '/images/offers/seo_audit_offer.png',
        cta: 'Claim Free Audit',
        ctaLink: '/contact?subject=Free%20SEO%20Audit'
      }
    },
    {
      params: { slug: 'web-dev-discount' },
      props: {
        title: 'Get 15% Off Your First Custom Web Project',
        description: 'Ready to elevate your digital presence? Partner with Quadem Digital Enterprise and get 15% off your first custom web development or app design project. Valid for new clients only. Let\'s build something amazing together!',
        image: '/images/offers/web_dev_offer.png',
        cta: 'Claim Your 15% Discount',
        ctaLink: '/contact?subject=15%25%20Off%20Web%20Dev'
      }
    },
    {
      params: { slug: 'social-media-bonus' },
      props: {
        title: '1 Month Free Social Media Management',
        description: 'Launch your new website with a bang! Book a complete Web Design package with us this month and receive 1 month of dedicated Social Media Management absolutely free to help drive immediate traffic to your new site.',
        image: '/images/offers/social_media_offer.png',
        cta: 'Claim Free Month',
        ctaLink: '/contact?subject=Free%20Social%20Media%20Month'
      }
    }
  ];
}

const { title, description, image, cta, ctaLink } = Astro.props;
---

<BaseLayout title={`${title} | Special Offer | Quadem Digital`} description={description} activePage="offers" navbarScrolled={true}>
    <fragment slot="head">
        <style>
            .offer-hero {
                padding-top: 140px;
                padding-bottom: 60px;
                text-align: center;
                background: radial-gradient(circle at center, rgba(0, 174, 239, 0.05) 0%, transparent 60%);
            }
            .offer-card {
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 3rem;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 4rem;
                align-items: center;
                backdrop-filter: blur(10px);
                margin-bottom: 4rem;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            }
            .offer-image-container {
                position: relative;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 0 30px rgba(0, 174, 239, 0.15);
            }
            .offer-image {
                width: 100%;
                height: auto;
                display: block;
                border-radius: 12px;
                transition: transform 0.5s ease;
            }
            .offer-image-container:hover .offer-image {
                transform: scale(1.03);
            }
            .offer-content h2 {
                font-family: var(--font-heading);
                font-size: 2.2rem;
                margin-bottom: 1.5rem;
                line-height: 1.2;
            }
            .offer-content p {
                font-size: 1.15rem;
                color: var(--text-muted);
                line-height: 1.7;
                margin-bottom: 2.5rem;
            }
            .offer-features {
                margin-bottom: 2.5rem;
                list-style: none;
                padding: 0;
            }
            .offer-features li {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 12px;
                color: var(--text-secondary);
            }
            .feature-icon {
                color: var(--accent);
                background: rgba(0, 174, 239, 0.1);
                padding: 6px;
                border-radius: 50%;
                display: inline-flex;
            }
            @media (max-width: 900px) {
                .offer-card {
                    grid-template-columns: 1fr;
                    padding: 2rem;
                    gap: 2rem;
                }
                .offer-hero {
                    padding-top: 120px;
                }
                .offer-content h2 {
                    font-size: 1.8rem;
                }
            }
        </style>
    </fragment>

    <section class="offer-hero">
        <div class="container">
            <span class="badge glow-effect mb-4" style="display: inline-block;">Limited Time Offer</span>
            <h1><span class="text-gradient">Exclusive Promotion</span></h1>
        </div>
    </section>

    <section class="section-padding" style="padding-top: 0;">
        <div class="container">
            <div class="offer-card animate-on-scroll slide-up">
                <div class="offer-image-container">
                    <img src={image} alt={title} class="offer-image" />
                    <div class="glow-blob" style="top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.5;"></div>
                </div>
                <div class="offer-content">
                    <h2>{title}</h2>
                    <p>{description}</p>
                    
                    <ul class="offer-features">
                        <li>
                            <span class="feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </span>
                            Zero Commitment Required
                        </li>
                        <li>
                            <span class="feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </span>
                            Premium Agency Quality
                        </li>
                        <li>
                            <span class="feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </span>
                            Direct Founder Communication
                        </li>
                    </ul>

                    <a href={ctaLink} class="btn btn-primary btn-pill glow-effect" style="width: 100%; justify-content: center; padding: 1.2rem; font-size: 1.1rem;">
                        {cta}
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </a>
                </div>
            </div>
        </div>
    </section>
</BaseLayout>
