---
import Honeypot from '../../components/forms/Honeypot.astro';
import BaseLayout from "../../layouts/BaseLayout.astro";
import { isOfferLive } from "../../lib/offers";
import { payloadFetch, buildPayloadImageUrl } from "../../lib/payload";
import { resolveSeo } from "../../lib/seo";
import NewsletterOptIn from "../../components/forms/NewsletterOptIn.astro";
import DCheckup from "../../components/offers/DCheckup.astro";

/*
  Server-rendered, like every other CMS-driven route on this site.

  These two pages were the exception: `prerender = true` baked them at build
  time, so a new offer, or a price change on an existing one, needed a deploy
  before anyone could see it. That is also why the build warned on every run
  that `Astro.request.headers` is unavailable here, which is what BaseLayout
  reads to decide the visitor's theme.
*/
const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const offers = await payloadFetch('offers', {
  'where[slug][equals]': slug,
  depth: '1',
});
const offer = offers[0];

/*
  An expired offer is gone, not merely delisted.

  Filtering it off /offers alone would leave the page reachable from an email
  sent three months ago, still badged "Limited Time Offer" and still taking
  claims for a discount that has ended. See src/lib/offers.ts.
*/
if (!offer || !isOfferLive(offer)) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const isLocalImage = !offer.image;
const imageBase = `/images/offers/${offer.slug.replace(/-/g, '_')}_offer`;

/*
  Per-slug wording written before the CMS had SEO fields. It stays as the
  fallback: resolveSeo prefers whatever an editor has typed into the document.
*/
let seoDescription = offer.description;
let seoTitle = offer.title;
if (offer.slug === 'free-seo-audit') {
  seoDescription = "A free check of your website's speed, how it works on phones and how you show up on Google, with a short list of what to fix first. No obligation.";
  seoTitle = "Free Website Check-up";
} else if (offer.slug === 'social-media-bonus') {
  seoDescription = "Book an eligible website package and choose a scoped month of launch support on one social platform. Deliverables are agreed in your proposal.";
} else if (offer.slug === 'web-dev-discount') {
  seoDescription = "Get 15% off your first custom web development or app design project with Quadem Digital. New clients only. Let's build something great together.";
  seoTitle = "15% Off Your First Custom Web Project";
}

const seo = resolveSeo(offer, {
  title: `${seoTitle} | Quadem Digital`,
  description: seoDescription,
});

const title = seoTitle;
const onPageTitle = offer.title;
const onPageDescription = offer.description;
const image = isLocalImage ? `${imageBase}.webp` : buildPayloadImageUrl(offer.image);
const webpImage = isLocalImage ? `${imageBase}.webp` : null;
const cta = offer.cta || 'Claim Offer';
// The free check-up, where every "Free check-up" button lands, has the new
// page (26 Oct 2026); the two Ghana offers keep this layout for now.
const isCheckup = offer.slug === 'free-seo-audit';

---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="offers" navbarScrolled={!isCheckup} headerDark={isCheckup} scaleUp={isCheckup}>
    <Fragment slot="head">
        <style>
            .offer-hero {
                padding-top: 140px;
                padding-bottom: 60px;
                text-align: center;
                background: radial-gradient(circle at center, rgba(0, 174, 239, 0.05) 0%, transparent 60%);
            }
            .offer-card {
                background: var(--bg-inset);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 3rem;
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 4rem;
                align-items: center;
                backdrop-filter: blur(10px);
                margin-bottom: 4rem;
                box-shadow: 0 10px 40px rgba(0, 0, 0, 0.2);
            }
            .offer-image-container {
                position: relative;
                border-radius: 12px;
                overflow: hidden;
                box-shadow: 0 0 30px rgba(0, 174, 239, 0.15);
            }
            .offer-image {
                width: 100%;
                height: auto;
                display: block;
                border-radius: 12px;
                transition: transform 0.5s ease;
            }
            .offer-image-container:hover .offer-image {
                transform: scale(1.03);
            }
            .offer-content h2 {
                font-family: var(--font-heading);
                font-size: 2.2rem;
                margin-bottom: 1.5rem;
                line-height: 1.2;
            }
            .offer-content p {
                font-size: 1.15rem;
                color: var(--text-muted);
                line-height: 1.7;
                margin-bottom: 2.5rem;
            }
            .offer-features {
                margin-bottom: 2.5rem;
                list-style: none;
                padding: 0;
            }
            .offer-features li {
                display: flex;
                align-items: center;
                gap: 12px;
                margin-bottom: 12px;
                color: var(--text-secondary);
            }
            .feature-icon {
                color: var(--accent-text);
                background: rgba(0, 174, 239, 0.1);
                padding: 6px;
                border-radius: 50%;
                display: inline-flex;
            }
            
            /* Form Styles */
            .offer-form-section {
                max-width: 700px;
                margin: 0 auto 6rem auto;
                background: var(--bg-inset);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                padding: 3rem;
                backdrop-filter: blur(10px);
            }
            .offer-form-section h3 {
                text-align: center;
                font-size: 2rem;
                margin-bottom: 2rem;
                font-family: var(--font-heading);
            }
            
            @media (max-width: 900px) {
                .offer-card {
                    grid-template-columns: 1fr;
                    padding: 2rem;
                    gap: 2rem;
                }
                .offer-hero {
                    padding-top: 120px;
                }
                .offer-content h2 {
                    font-size: 1.8rem;
                }
                .offer-form-section {
                    padding: 2rem;
                }
            }
        </style>
    </Fragment>
  {isCheckup ? (
    <DCheckup offer={offer} />
  ) : (
  <Fragment>

    <section class="offer-hero">
        <div class="container">
            <span class="badge glow-effect mb-4" style="display: inline-block;">{offer.expiresAt ? 'Limited Time Offer' : 'Current Offer'}</span>
            <h1><span class="text-gradient">Exclusive Promotion</span></h1>
        </div>
    </section>

    <section class="section-padding" style="padding-top: 0;">
        <div class="container">
            <div class="offer-card animate-on-scroll slide-up">
                <div class="offer-image-container">
                    <picture>
                        {webpImage && <source srcset={webpImage} type="image/webp" />}
                        <img src={image} alt={title} class="offer-image" width="1024" height="1024" loading="lazy" />
                    </picture>
                    <div class="glow-blob" style="top: 50%; left: 50%; transform: translate(-50%, -50%); opacity: 0.5;"></div>
                </div>
                <div class="offer-content">
                    <h2>{onPageTitle}</h2>
                    <p>{onPageDescription}</p>
                    
                    <ul class="offer-features">
                        <li>
                            <span class="feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </span>
                            Scope agreed before work starts
                        </li>
                        <li>
                            <span class="feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </span>
                            Price confirmed in writing
                        </li>
                        <li>
                            <span class="feature-icon">
                                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="20 6 9 17 4 12"></polyline></svg>
                            </span>
                            One point of contact from start to finish
                        </li>
                    </ul>

                    <a href="#claim-form" class="btn btn-primary btn-pill glow-effect" style="width: 100%; justify-content: center; padding: 1.2rem; font-size: 1.1rem;">
                        {cta}
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-left: 8px;"><line x1="12" y1="5" x2="12" y2="19"></line><polyline points="19 12 12 19 5 12"></polyline></svg>
                    </a>
                </div>
            </div>
            
            <div id="claim-form" class="offer-form-section animate-on-scroll slide-up delay-200">
                <h3>Claim Your Offer</h3>
                
                <div id="formSuccessMessage" style="display: none; background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); padding: 2rem; border-radius: 12px; text-align: center; color: white;">
                    <svg width="48" height="48" viewBox="0 0 24 24" fill="none" stroke="var(--accent)" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-bottom: 1rem;"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"></path><polyline points="22 4 12 14.01 9 11.01"></polyline></svg>
                    <h4 style="font-size: 1.5rem; margin-bottom: 0.5rem; font-family: var(--font-heading);">Success!</h4>
                    <p style="color: var(--text-muted); margin: 0;">Thanks for claiming this offer. We'll be in touch shortly to get started.</p>
                </div>
                
                <div id="formErrorMessage" style="display: none; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 1rem; border-radius: 8px; margin-bottom: 1.5rem; color: #ef4444; text-align: center;">
                    Something went wrong. Please try again.
                </div>

                {/* method="post": if the script ever fails again, a native
                    submit must not put the visitor's details in the address. */}
                <form id="offerContactForm" method="post">
                    <input type="hidden" id="offerSource" value="lead-magnet" />
                    <input type="hidden" id="offerMagnetRequested" value={title} />
                    <Honeypot />
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div class="form-group">
                            <label for="offerName">Name *</label>
                            <input type="text" id="offerName" name="name" required placeholder="John Doe">
                        </div>
                        <div class="form-group">
                            <label for="offerEmail">Email *</label>
                            <input type="email" id="offerEmail" name="email" required placeholder="john@company.com">
                        </div>
                    </div>
                    
                    <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;">
                        <div class="form-group">
                            <label for="offerPhone">Phone Number</label>
                            <input type="tel" id="offerPhone" name="phone" placeholder="+1 (555) 000-0000">
                        </div>
                        <div class="form-group">
                            <label for="offerCompany">Company Name</label>
                            <input type="text" id="offerCompany" name="company" placeholder="Acme Corp">
                        </div>
                    </div>
                    
                    <div class="form-group">
                        <label for="offerDetails">Website URL or Project Details</label>
                        <textarea id="offerDetails" rows="3" placeholder="Tell us a bit about your current situation..."></textarea>
                    </div>
                    
                    <NewsletterOptIn variant="card" />
                    
                    <button type="submit" id="submitBtn" class="btn btn-primary btn-pill glow-effect w-100" style="justify-content: center; padding: 1rem; margin-top: 1rem; font-size: 1.1rem;">
                        Submit & Claim
                    </button>
                </form>
            </div>
        </div>
    </section>
    
  </Fragment>
  )}
    <script>
        // The form's sending code is shared with the check-up page
        // (src/scripts/offer-form.js), wired on first run and on every
        // astro:page-load, once per form.
        import { initOfferForm } from '../../scripts/offer-form.js';
        initOfferForm();
        document.addEventListener('astro:page-load', initOfferForm);
    </script>
</BaseLayout>
