---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch } from "../../lib/payload";

export const prerender = true;

const offers = await payloadFetch('offers', { depth: '1' });
---
<BaseLayout title="Special Offers | Quadem Digital" description="Exclusive limited-time offers and promotions from Quadem Digital Enterprise. Save on web design, SEO, social media, and more." activePage="offers" navbarScrolled={true}>
    <fragment slot="head">
        <style>
            .offers-hero {
                padding-top: 140px;
                padding-bottom: 60px;
                text-align: center;
                background: radial-gradient(circle at center, rgba(0, 174, 239, 0.05) 0%, transparent 60%);
            }
            .offers-hero .hero-subtitle {
                max-width: 600px;
                margin: 0 auto;
                color: var(--text-muted);
                font-size: 1.15rem;
                line-height: 1.7;
            }
            .offers-grid {
                display: grid;
                grid-template-columns: repeat(auto-fill, minmax(360px, 1fr));
                gap: 2rem;
            }
            .offer-card-link {
                text-decoration: none;
                color: inherit;
                display: block;
            }
            .offer-listing-card {
                background: rgba(255, 255, 255, 0.02);
                border: 1px solid var(--border-color);
                border-radius: 20px;
                overflow: hidden;
                transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
                backdrop-filter: blur(10px);
            }
            .offer-listing-card:hover {
                transform: translateY(-6px);
                box-shadow: 0 16px 48px rgba(0, 174, 239, 0.12);
                border-color: rgba(0, 174, 239, 0.3);
            }
            .offer-listing-image {
                position: relative;
                aspect-ratio: 1 / 1;
                overflow: hidden;
                background: #0d0d14;
            }
            .offer-listing-image img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                transition: transform 0.5s ease;
            }
            .offer-listing-card:hover .offer-listing-image img {
                transform: scale(1.05);
            }
            .offer-listing-badge {
                position: absolute;
                top: 16px;
                left: 16px;
                background: rgba(0, 174, 239, 0.9);
                color: #fff;
                font-size: 0.75rem;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 0.08em;
                padding: 6px 14px;
                border-radius: 50px;
                backdrop-filter: blur(8px);
            }
            .offer-listing-body {
                padding: 1.75rem;
            }
            .offer-listing-body h3 {
                font-family: var(--font-heading);
                font-size: 1.35rem;
                margin-bottom: 0.75rem;
                line-height: 1.3;
                color: var(--text-primary);
            }
            .offer-listing-body p {
                font-size: 0.95rem;
                color: var(--text-muted);
                line-height: 1.65;
                margin-bottom: 1.5rem;
                display: -webkit-box;
                -webkit-line-clamp: 3;
                -webkit-box-orient: vertical;
                overflow: hidden;
            }
            .offer-listing-cta {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                color: var(--accent);
                font-weight: 600;
                font-size: 0.95rem;
                transition: gap 0.3s ease;
            }
            .offer-listing-card:hover .offer-listing-cta {
                gap: 12px;
            }
            .bs-offer-banner {
                display: block;
                text-decoration: none;
                color: inherit;
                position: relative;
                overflow: hidden;
                border: 1px solid var(--border-color);
                border-radius: 24px;
                padding: 2.5rem;
                margin-bottom: 3rem;
                background:
                    radial-gradient(circle at 12% 20%, rgba(124, 92, 255, 0.14) 0%, transparent 45%),
                    radial-gradient(circle at 90% 90%, rgba(249, 115, 22, 0.12) 0%, transparent 45%),
                    rgba(255, 255, 255, 0.02);
                transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
            }
            .bs-offer-banner:hover {
                transform: translateY(-4px);
                box-shadow: 0 20px 60px -30px rgba(124, 92, 255, 0.6);
                border-color: rgba(124, 92, 255, 0.4);
            }
            .bs-offer-banner-body { max-width: 640px; }
            .bs-offer-banner-badge {
                display: inline-block;
                font-size: 0.72rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                font-weight: 700;
                color: #a78bfa;
                border: 1px solid var(--border-color);
                border-radius: 999px;
                padding: 5px 14px;
                margin-bottom: 1rem;
            }
            .bs-offer-banner h2 {
                font-family: var(--font-heading);
                font-size: clamp(1.5rem, 3vw, 2.1rem);
                margin-bottom: 0.6rem;
                background: linear-gradient(90deg, #7c5cff, #f97316);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .bs-offer-banner p {
                color: var(--text-muted);
                line-height: 1.65;
                margin-bottom: 1.4rem;
            }
            .bs-offer-banner-cta {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-weight: 700;
                color: var(--text-primary);
                transition: gap 0.3s ease;
            }
            .bs-offer-banner:hover .bs-offer-banner-cta { gap: 12px; }
            .empty-state {
                text-align: center;
                padding: 80px 20px;
            }
            .empty-state h2 {
                margin-bottom: 16px;
                color: var(--text-primary);
            }
            .empty-state p {
                color: var(--text-muted);
                max-width: 500px;
                margin: 0 auto 32px;
                line-height: 1.6;
            }

            @media (max-width: 480px) {
                .offers-grid {
                    grid-template-columns: 1fr;
                }
                .offers-hero {
                    padding-top: 120px;
                }
            }
        </style>
    </fragment>

    <section class="offers-hero">
        <div class="container">
            <span class="badge glow-effect mb-4" style="display: inline-block;">Limited Time</span>
            <h1><span class="text-gradient">Special Offers</span></h1>
            <p class="hero-subtitle">Exclusive promotions to help you launch, grow, and dominate your digital presence.</p>
        </div>
    </section>

    <section class="section-padding" style="padding-top: 0;">
        <div class="container">
            <a href="/brand-studio/" class="bs-offer-banner animate-on-scroll slide-up">
                <div class="bs-offer-banner-body">
                    <span class="bs-offer-banner-badge">New · On Subscription</span>
                    <h2>Quadem Brand Studio</h2>
                    <p>Your brand's content team on a fixed monthly fee. Premium posts, reels and ad creatives produced and published every month, with no shoots and no one to hire. From GHS 1,800/mo.</p>
                    <span class="bs-offer-banner-cta">Explore Brand Studio
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </span>
                </div>
            </a>

            {offers && offers.length > 0 ? (
                <div class="offers-grid">
                    {offers.map((offer: any, index: number) => {
                        const imageBase = `/images/offers/${offer.slug.replace(/-/g, '_')}_offer`;
                        return (
                            <a href={`/offers/${offer.slug}/`} class={`offer-card-link animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                                <article class="offer-listing-card">
                                    <div class="offer-listing-image">
                                        <picture>
                                            <source srcset={`${imageBase}.webp`} type="image/webp" />
                                            <img src={`${imageBase}.webp`} alt={offer.title} width="600" height="600" loading="lazy" />
                                        </picture>
                                        <span class="offer-listing-badge">Limited Offer</span>
                                    </div>
                                    <div class="offer-listing-body">
                                        <h3>{offer.title}</h3>
                                        <p>{offer.description}</p>
                                        <span class="offer-listing-cta">
                                            {offer.cta || 'Claim Offer'}
                                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                                        </span>
                                    </div>
                                </article>
                            </a>
                        );
                    })}
                </div>
            ) : (
                <div class="empty-state">
                    <h2>Coming Soon</h2>
                    <p>We're preparing some exciting offers for you. Check back soon or get in touch to learn about our current promotions.</p>
                    <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Contact Us</a>
                </div>
            )}
        </div>
    </section>
</BaseLayout>
