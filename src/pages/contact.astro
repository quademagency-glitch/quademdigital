---
import { PORTRAIT_MEDIA_SIZES } from "../lib/mediaPresentation";
import SocialLinks from '../components/SocialLinks.astro';
import BaseLayout from "../layouts/BaseLayout.astro";
import PageHero from "../components/PageHero.astro";
import { payloadFetch, payloadFetchGlobal, getMediaByFilename } from "../lib/payload";
import Picture from "../components/Picture.astro";
import { resolveSeo } from "../lib/seo";
import { getBookingUrl } from "../lib/booking";
import BudgetBands from "../components/forms/BudgetBands.astro";
import NewsletterOptIn from "../components/forms/NewsletterOptIn.astro";

const siteSettings = await payloadFetchGlobal('siteSettings');
const contactPage = await payloadFetchGlobal('contactPage');
/*
  The same resolver every other booking button uses. This page was the only one
  whose link worked, because its CMS field happened to be right and the hardcoded
  fallback beneath it, which is what /global and the price calculator both used,
  pointed at an account that does not exist.
*/
const bookingUrl = await getBookingUrl();

/*
  The "what do you need help with?" boxes come from the services collection
  rather than being written into this page.

  They used to be four hardcoded values: Web Design, Digital Marketing, Branding
  and SEO. The collection has held five services for months, so AI Video & Reels
  was missing: the service with its own promo section on the homepage, its own
  page, and top billing on the international page could not be asked for on the
  form that takes enquiries. Anyone wanting it had to pick a box that was wrong
  or type it into the message.

  Reading the collection means adding a service in the admin puts it on this form
  too, which is the only way the two stay in step. servicesInterested is free
  text on the lead, not an enum, so the labels can change without a migration.
*/
const contactServices = await payloadFetch('services', { sort: 'order' });

/*
  Arriving from a service page with ?enquiry=<slug>.

  The Fieldwork page's only call to action reads "Tell me about your last five
  customers", and it pointed here, at a wizard whose first screen asks "What do
  you need help with?" and whose message box says "Tell me more about your
  goals...". The button made a specific promise and the page it landed on had
  nowhere to keep it.

  So the service is treated as already answered: its box is ticked, step one is
  skipped, and the question the button asked is the heading of the screen they
  land on. Anything with a slug in the collection works, and Fieldwork gets its
  own wording because its question is a real one rather than a form field.

  Read on the server rather than in the browser. The query string is part of the
  edge cache key, so /contact/?enquiry=fieldwork caches separately from
  /contact/ and cannot be served to the wrong visitor. Geo cannot be done this
  way, which is why that is JavaScript and this is not.
*/
const enquiry = (Astro.url.searchParams.get('enquiry') || '').trim().toLowerCase();
const enquiryService = contactServices.find((s: any) => s.slug === enquiry) || null;
const isFieldwork = enquiry === 'fieldwork';
const preselected = enquiryService?.title || (isFieldwork ? 'Fieldwork' : null);

// Skip the service picker only when we actually know the answer.
const startStep = preselected ? 2 : 1;

const stepTwoHeading = isFieldwork
    ? 'Tell me about your last five customers'
    : 'Who should I reply to?';

const messageLabel = isFieldwork ? 'Your last five customers' : 'Project Details';

const messagePlaceholder = isFieldwork
    ? 'What they do, roughly how big they are, and what made them worth having. Rough notes are fine, and if two of them are nothing like each other, say that as well.'
    : 'Tell me more about your goals...';

/*
  Carry the service even when there is no box to tick.

  Skipping step one means the answer has to come from somewhere, and normally it
  comes from that step's pre-ticked checkbox. Fieldwork only gets a checkbox once
  cms/scripts/seed-services.mjs has run, and between deploying and running it
  every enquiry from that page would arrive with no service recorded at all.

  Exclusive with the checkbox on purpose. Rendering both would put the value into
  services[] twice, and the lead would read "Fieldwork, Fieldwork".
*/
const needsHiddenService = Boolean(preselected) && !enquiryService;

// Contact page fields with fallbacks
const heroHeading = contactPage?.heroHeading || "Get in Touch";
const heroSubtitle = contactPage?.heroSubtitle || "Let's build something great together.";

/*
  His face, on the page where somebody decides whether to write to him. Side
  mode, not cover: the portrait is 857px wide and asking it to fill a screen is
  a 1.7x stretch that shows.
*/
const heroMedia = await getMediaByFilename("founder-portrait.webp");
const contactSubtitle = contactPage?.contactSubtitle || "Get in Touch";
const contactText = contactPage?.contactText || "I'm ready to help you scale your business. Reach out today and let's start the conversation.";
const whatsappButtonText = contactPage?.whatsappButtonText || "Chat on WhatsApp";
const whatsappMessage = contactPage?.whatsappMessage || "Hi Quadem Digital! I'd like to discuss a project.";
const formSuccessMessage = contactPage?.formSuccessMessage || "Thanks for reaching out! I'll be in touch shortly.";
const submitButtonText = contactPage?.submitButtonText || "Send Message";
const failed = Astro.url.searchParams.get('error') === '1';
const submitted = !failed && Astro.url.searchParams.get('sent') === '1';
const returnTo = `${Astro.url.pathname}${Astro.url.search}#contactForm`;

// Site settings
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";
// hello@ hard-bounced on 2026-06-05 and is not a mailbox. See src/lib/mailFrom.ts.
const contactEmail = siteSettings?.email || "ernest@quademdigital.com";
const socialLinks = siteSettings?.socialLinks || [];

const seo = resolveSeo(contactPage, {
  title: "Get in Touch | Quadem Digital",
  description: "Get in touch with Quadem Digital Enterprise to discuss your web, design, or marketing project. Let's build something great together.",
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="contact" navbarScrolled={true}>
    <Fragment slot="head">
        <style>
            @media (max-width: 480px) {
                .services-grid {
                    grid-template-columns: 1fr !important;
                    gap: 10px !important;
                }

                .wizard-checkbox,
                .wizard-radio {
                    padding: 12px !important;
                    font-size: 14px;
                }

                .wizard-progress {
                    margin-bottom: 24px !important;
                }

                .step-indicator {
                    width: 28px !important;
                    height: 28px !important;
                    font-size: 12px;
                }

                .wizard-step h3 {
                    font-size: 1.1rem;
                }

                .calendly-inline-widget {
                    min-width: 280px !important;
                    height: 500px !important;
                }

                .calendly-or-divider {
                    font-size: 0.9rem;
                }
            }

            @media (max-width: 768px) {
                .contact-grid {
                    gap: 32px;
                }

                .calendly-inline-widget {
                    height: 580px !important;
                }
            }

            /*
              The wizard's step numbers.

              These were inline styles, and main.js rewrote them on every step
              with '#1a1a24' and rgba(255,255,255,0.5) hardcoded in the script,
              so in light mode steps 2 and 3 were near-white text on a light
              circle: the numbers simply were not there. The theme guard could
              not see it twice over, because it does not read .js and because
              its white rule fires below 0.5 alpha and this sat exactly on it.

              Tokens here, one class toggled there.
            */
            .step-indicator {
                width: 32px;
                height: 32px;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                z-index: 1;
                font-weight: bold;
                transition: 0.3s;
                background: var(--bg-card);
                border: 1px solid var(--border-strong);
                color: var(--text-subtle);
            }

            .step-indicator.active {
                background: var(--accent);
                border: none;
                /* Dark text on an accent fill, the same choice .btn-primary
                   makes. White on this blue reaches only 2.2:1. */
                color: #000; /* theme-exempt */
            }
        </style>
    </Fragment>

    <PageHero variant="page" eyebrow="Start a conversation" headline={heroHeading} lede={heroSubtitle} id={contactPage?.showBookingSection === false ? 'book' : undefined} />
    <section class="contact section-padding lab-contact" id="contact">
        <div class="container">
            <div class="contact-grid">
                <div class="contact-info animate-on-scroll slide-right">
                    {heroMedia && <div class="lab-contact-portrait"><Picture image={heroMedia} alt="Ernest Avorwlanu, founder of Quadem Digital" sizes={PORTRAIT_MEDIA_SIZES} width={857} height={1200} size="large" priority /></div>}
                    <h3 class="contact-subtitle">{contactSubtitle}</h3>
                    <p class="contact-text">{contactText}</p>
                    
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect mb-4 w-100">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        {whatsappButtonText}
                    </a>
                    
                    <a href={`mailto:${contactEmail}`} class="contact-email">{contactEmail}</a>
                    
                    {socialLinks.length > 0 && (
                        <SocialLinks links={socialLinks} />
                    )}
                </div>
                
                <div class="contact-form-container animate-on-scroll slide-left delay-200">
                    <form class="contact-form wizard-form" id="contactForm" action="/api/submit-form/" method="POST" data-start-step={String(startStep)}>
                        {needsHiddenService && (
                            <input type="hidden" name="services[]" value={preselected} />
                        )}
                        <input type="hidden" name="source" value="contact-form">
                        <input type="hidden" name="returnTo" value={returnTo}>
                        <div class="form-group" id="formSuccess" role="status" style={`${submitted ? '' : 'display: none;'} background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); padding: 16px; border-radius: 8px; margin-bottom: 20px; color: var(--accent-text);`}>
                            {formSuccessMessage}
                        </div>
                        <div class="form-group" id="formError" role="alert" style={`${failed ? '' : 'display: none;'} background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 16px; border-radius: 8px; margin-bottom: 20px; color: #ef4444;`}>
                            Something went wrong. Please try again or use WhatsApp.
                        </div>

                        <!-- Wizard Progress -->
                        <div class="wizard-progress" style="display: flex; justify-content: space-between; margin-bottom: 30px; position: relative;">
                            <div class="progress-line" style="position: absolute; top: 50%; left: 0; width: 100%; height: 2px; background: var(--border-color); z-index: 0; transform: translateY(-50%);">
                                <div class="progress-fill" id="wizardProgressFill" style="width: 0%; height: 100%; background: var(--accent); transition: 0.3s ease;"></div>
                            </div>
                            <div class="step-indicator active" data-step="1">1</div>
                            <div class={`step-indicator${startStep >= 2 ? ' active' : ''}`} data-step="2">2</div>
                            <div class="step-indicator" data-step="3">3</div>
                        </div>

                        <!-- Step 1: Services -->
                        <div class={`wizard-step${startStep === 1 ? ' active' : ''}`} id="wizardStep1">
                            <h3 style="margin-bottom: 16px;">What do you need help with?</h3>
                            <div class="services-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px;">
                                {contactServices.map((service: any) => (
                                    <label class="wizard-checkbox" style="display: flex; align-items: center; padding: 16px; background: var(--bg-inset); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                        <input type="checkbox" name="services[]" value={service.title} checked={service.title === preselected} style="margin-right: 12px; transform: scale(1.2);">
                                        <span>{service.title}</span>
                                    </label>
                                ))}
                                {/* Always last, and always present. Someone whose need is not
                                    on the list is the enquiry most worth catching, not least. */}
                                <label class="wizard-checkbox" style="display: flex; align-items: center; padding: 16px; background: var(--bg-inset); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="checkbox" name="services[]" value="Something else" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>Something else</span>
                                </label>
                            </div>
                            <button type="button" class="btn btn-primary btn-pill w-100 wizard-next-btn">Next Step</button>
                        </div>

                        <!-- Step 2: Who you are -->
                        <div class={`wizard-step${startStep === 2 ? ' active' : ''}`} id="wizardStep2">
                            <h3 style="margin-bottom: 16px;">{stepTwoHeading}</h3>
                            <div class="form-group">
                                <label for="contactName">Name</label>
                                <input type="text" id="contactName" name="name" required placeholder="Your name" autocomplete="name">
                            </div>
                            <div class="form-group">
                                <label for="contactEmail">Email</label>
                                <input type="email" id="contactEmail" name="email" required placeholder="you@company.com" autocomplete="email">
                            </div>
                            <div class="form-group">
                                <label for="contactMessage">{messageLabel}</label>
                                <textarea id="contactMessage" name="message" rows={isFieldwork ? 7 : 4} required placeholder={messagePlaceholder}></textarea>
                            </div>
                            <div style="display: flex; gap: 12px;">
                                <button type="button" class="btn btn-ghost btn-pill wizard-prev-btn" style="flex: 1;">Back</button>
                                <button type="button" class="btn btn-primary btn-pill glow-effect wizard-next-btn" style="flex: 2;">Next Step</button>
                            </div>
                        </div>
                        <!-- Step 3: Budget (optional; the lead is already captured by now) -->
                        <div class="wizard-step" id="wizardStep3">
                            <h3 style="margin-bottom: 16px;">Roughly what is the budget?</h3>
                            {/*
                                Shared with every service page, deliberately.

                                This page used to ask the question in dollars only,
                                on brackets nothing else on the site used: under
                                $2,000 / $2k-5k / $5k-10k / $10k+, against the
                                service pages' under $1,500 / $1.5k-3k / $3k-6k /
                                $6k+. So the same lead answered a different question
                                depending on where they landed, a visitor in Accra
                                who had just read GH₵ 2,500 was asked to pick a
                                dollar bracket, and the top band promised a $10,000
                                tier that does not exist. One component now, and
                                scripts/check-markets.mjs fails the build if a
                                budget question is ever hand-rolled again.
                            */}
                            <BudgetBands hint="An honest range saves us both a call. Nothing here is binding." />
                            <NewsletterOptIn variant="card" />
                            <div style="display: flex; gap: 12px; margin-top: 16px;">
                                <button type="button" class="btn btn-ghost btn-pill wizard-prev-btn" style="flex: 1;">Back</button>
                                <button type="submit" class="btn btn-primary btn-pill glow-effect" id="contactSubmitBtn" style="flex: 2;">{submitButtonText}</button>
                            </div>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Calendly Booking Section -->
    {(contactPage?.showBookingSection !== false) && (
        <section class="calendly-section section-padding" id="book" style="scroll-margin-top: 100px;">
            <div class="container">
                <div class="calendly-or-divider">{contactPage?.bookingDividerText || 'Or book a call directly'}</div>
                <div class="section-header animate-on-scroll slide-up" style="margin-bottom: 32px;">
                    <h2><span class="text-gradient">{contactPage?.bookingHeading || 'Book a free 15-minute call'}</span></h2>
                    <p>{contactPage?.bookingSubtitle || 'Pick a time that works for you. No commitment, just a conversation about your goals.'}</p>
                    <p><a href={bookingUrl} target="_blank" rel="noopener noreferrer" data-track="calendly_click" data-loc="booking-fallback">Open the booking calendar in a new tab</a></p>
                </div>
                <div class="calendly-embed animate-on-scroll slide-up delay-200">
                    <!-- Calendly inline widget -->
                    <div 
                        class="calendly-inline-widget" 
                        data-url={`${bookingUrl}?hide_gdpr_banner=1&background_color=0d0d14&text_color=e8e8e8&primary_color=00aeef`}
                        style="min-width: 320px; height: 700px;"
                    ></div>
                    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
                </div>
            </div>
        </section>
    )}
</BaseLayout>
