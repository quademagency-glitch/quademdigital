---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";

const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);
const contactPage = await sanityClient.fetch(`*[_type == "contactPage"][0]`);

// Contact page fields with fallbacks
const heroHeading = contactPage?.heroHeading || "Contact Us";
const heroSubtitle = contactPage?.heroSubtitle || "Let's build something great together.";
const contactSubtitle = contactPage?.contactSubtitle || "Get in Touch";
const contactText = contactPage?.contactText || "We're ready to help you scale your business. Reach out today and let's start the conversation.";
const whatsappButtonText = contactPage?.whatsappButtonText || "Chat on WhatsApp";
const whatsappMessage = contactPage?.whatsappMessage || "Hi Quadem Digital! I'd like to discuss a project.";
const formSuccessMessage = contactPage?.formSuccessMessage || "Thanks for reaching out! We'll be in touch shortly.";
const submitButtonText = contactPage?.submitButtonText || "Send Message";

// Site settings
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";
const contactEmail = siteSettings?.email || "hello@quademdigital.com";
const socialLinks = siteSettings?.socialLinks || {};
---
<BaseLayout title="Contact Us | Quadem Digital" description="Get in touch with Quadem Digital Enterprise. Let's build something great together." activePage="contact" navbarScrolled={true}>
    <section class="contact-hero">
        <div class="container">
            <h1><span class="text-gradient">{heroHeading}</span></h1>
            <p class="hero-subtitle">{heroSubtitle}</p>
        </div>
    </section>

    <section class="contact section-padding" id="contact" style="padding-top: 0;">
        <div class="container">
            <div class="contact-grid">
                <div class="contact-info animate-on-scroll slide-right">
                    <h3 class="contact-subtitle">{contactSubtitle}</h3>
                    <p class="contact-text">{contactText}</p>
                    
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect mb-4 w-100">
                        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px;"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                        {whatsappButtonText}
                    </a>
                    
                    <a href={`mailto:${contactEmail}`} class="contact-email">{contactEmail}</a>
                    
                    <div class="social-links">
                        {[
                            { key: 'linkedin', label: 'LinkedIn', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M16 8a6 6 0 0 1 6 6v7h-4v-7a2 2 0 0 0-2-2 2 2 0 0 0-2 2v7h-4v-7a6 6 0 0 1 6-6z"></path><rect x="2" y="9" width="4" height="12"></rect><circle cx="4" cy="4" r="2"></circle></svg>' },
                            { key: 'instagram', label: 'Instagram', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>' },
                            { key: 'twitter', label: 'Twitter/X', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M18.244 2.25h3.308l-7.227 8.26 8.502 11.24H16.17l-5.214-6.817L4.99 21.75H1.68l7.73-8.835L1.254 2.25H8.08l4.713 6.231zm-1.161 17.52h1.833L7.084 4.126H5.117z"/></svg>' },
                            { key: 'facebook', label: 'Facebook', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>' },
                            { key: 'youtube', label: 'YouTube', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M22.54 6.42a2.78 2.78 0 0 0-1.94-2C18.88 4 12 4 12 4s-6.88 0-8.6.46a2.78 2.78 0 0 0-1.94 2A29 29 0 0 0 1 11.75a29 29 0 0 0 .46 5.33A2.78 2.78 0 0 0 3.4 19.1c1.72.46 8.6.46 8.6.46s6.88 0 8.6-.46a2.78 2.78 0 0 0 1.94-2 29 29 0 0 0 .46-5.25 29 29 0 0 0-.46-5.43z"></path><polygon points="9.75 15.02 15.5 11.75 9.75 8.48 9.75 15.02"></polygon></svg>' },
                            { key: 'tiktok', label: 'TikTok', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M19.59 6.69a4.83 4.83 0 0 1-3.77-4.25V2h-3.45v13.67a2.89 2.89 0 0 1-2.88 2.5 2.89 2.89 0 0 1 0-5.78 2.92 2.92 0 0 1 .88.13V9.4a6.84 6.84 0 0 0-1-.05A6.33 6.33 0 0 0 3 15.57 6.33 6.33 0 0 0 9.37 22a6.33 6.33 0 0 0 6.38-6.22V9.4a8.16 8.16 0 0 0 3.84.96V7.04a4.85 4.85 0 0 1-1-.35z"/></svg>' },
                            { key: 'github', label: 'GitHub', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 0 0-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0 0 20 4.77 5.07 5.07 0 0 0 19.91 1S18.73.65 16 2.48a13.38 13.38 0 0 0-7 0C6.27.65 5.09 1 5.09 1A5.07 5.07 0 0 0 5 4.77a5.44 5.44 0 0 0-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 0 0 9 18.13V22"></path></svg>' },
                            { key: 'behance', label: 'Behance', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M22 7h-7V5h7v2zm1.726 10c-.442 1.297-2.029 3-5.101 3-3.074 0-5.564-1.729-5.564-5.675 0-3.91 2.325-5.92 5.466-5.92 3.082 0 4.964 1.782 5.375 4.426.078.506.109 1.188.095 2.14H15.97c.13 3.211 3.483 3.312 4.588 2.029h3.168zm-7.686-4h4.965c-.105-1.547-1.136-2.219-2.477-2.219-1.466 0-2.277.768-2.488 2.219zm-9.574 6.988H0V5.021h6.953c5.476.081 5.58 5.444 2.72 6.906 3.461 1.26 3.577 6.053-2.207 7.061zM2.87 9.364h3.394c2.114 0 2.351-2.674.218-2.674H2.87v2.674zm0 7.376h3.953c2.631 0 2.323-3.17-.147-3.17H2.87v3.17z"/></svg>' },
                            { key: 'dribbble', label: 'Dribbble', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle><path d="M8.56 2.75c4.37 6.03 6.02 9.42 8.03 17.72m2.54-15.38c-3.72 4.35-8.94 5.66-16.88 5.85m19.5 1.9c-3.5-.93-6.63-.82-8.94 0-2.58.92-5.01 2.86-7.44 6.32"></path></svg>' },
                            { key: 'threads', label: 'Threads', icon: '<svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor"><path d="M12.186 24h-.007C5.461 23.956.057 18.525 0 11.729.057 4.934 5.461-.502 12.186 0c3.393.253 6.394 1.927 8.449 4.712l-2.645 1.846c-1.471-1.994-3.637-3.208-5.804-3.384C8.273 2.908 4.943 6.783 4.9 11.729c.043 4.944 3.373 8.819 7.286 9.096 2.39.177 4.705-.923 6.213-2.956.727-1.173 1.072-2.512 1.072-3.848 0-.666-.088-1.318-.258-1.944-.41-1.526-1.316-2.783-2.543-3.584-1.268-.826-2.71-1.146-4.092-.936l-.236-2.846c2.056-.309 4.159.117 5.98 1.26 1.756 1.1 3.068 2.795 3.678 4.826.246.883.373 1.8.373 2.724 0 1.867-.51 3.692-1.478 5.247C18.842 22.145 15.686 24 12.186 24z"/></svg>' },
                        ].filter(s => socialLinks?.[s.key]).map(s => (
                            <a href={socialLinks[s.key]} target="_blank" rel="noopener noreferrer" aria-label={s.label}>
                                <Fragment set:html={s.icon} />
                            </a>
                        ))}
                    </div>
                </div>
                
                <div class="contact-form-container animate-on-scroll slide-left delay-200">
                    <form class="contact-form wizard-form" id="contactForm" action="https://formspree.io/f/xgobwrdw" method="POST">
                        <div class="form-group" id="formSuccess" style="display: none; background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); padding: 16px; border-radius: 8px; margin-bottom: 20px; color: var(--accent);">
                            {formSuccessMessage}
                        </div>
                        <div class="form-group" id="formError" style="display: none; background: rgba(239, 68, 68, 0.1); border: 1px solid #ef4444; padding: 16px; border-radius: 8px; margin-bottom: 20px; color: #ef4444;">
                            Something went wrong. Please try again or use WhatsApp.
                        </div>

                        <!-- Wizard Progress -->
                        <div class="wizard-progress" style="display: flex; justify-content: space-between; margin-bottom: 30px; position: relative;">
                            <div class="progress-line" style="position: absolute; top: 50%; left: 0; width: 100%; height: 2px; background: rgba(255,255,255,0.1); z-index: 0; transform: translateY(-50%);">
                                <div class="progress-fill" id="wizardProgressFill" style="width: 0%; height: 100%; background: var(--accent); transition: 0.3s ease;"></div>
                            </div>
                            <div class="step-indicator active" data-step="1" style="width: 32px; height: 32px; border-radius: 50%; background: var(--accent); color: white; display: flex; align-items: center; justify-content: center; z-index: 1; font-weight: bold; transition: 0.3s;">1</div>
                            <div class="step-indicator" data-step="2" style="width: 32px; height: 32px; border-radius: 50%; background: #1a1a24; border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.5); display: flex; align-items: center; justify-content: center; z-index: 1; font-weight: bold; transition: 0.3s;">2</div>
                            <div class="step-indicator" data-step="3" style="width: 32px; height: 32px; border-radius: 50%; background: #1a1a24; border: 1px solid rgba(255,255,255,0.2); color: rgba(255,255,255,0.5); display: flex; align-items: center; justify-content: center; z-index: 1; font-weight: bold; transition: 0.3s;">3</div>
                        </div>

                        <!-- Step 1: Services -->
                        <div class="wizard-step active" id="wizardStep1">
                            <h3 style="margin-bottom: 16px;">What do you need help with?</h3>
                            <div class="services-grid" style="display: grid; grid-template-columns: 1fr 1fr; gap: 12px; margin-bottom: 24px;">
                                <label class="wizard-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="checkbox" name="services[]" value="Web Design" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>Web Design</span>
                                </label>
                                <label class="wizard-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="checkbox" name="services[]" value="Digital Marketing" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>Digital Marketing</span>
                                </label>
                                <label class="wizard-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="checkbox" name="services[]" value="Branding" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>Branding</span>
                                </label>
                                <label class="wizard-checkbox" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="checkbox" name="services[]" value="SEO" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>SEO & Ads</span>
                                </label>
                            </div>
                            <button type="button" class="btn btn-primary btn-pill w-100 wizard-next-btn">Next Step</button>
                        </div>

                        <!-- Step 2: Budget -->
                        <div class="wizard-step" id="wizardStep2" style="display: none;">
                            <h3 style="margin-bottom: 16px;">What is your estimated budget?</h3>
                            <div class="budget-grid" style="display: grid; grid-template-columns: 1fr; gap: 12px; margin-bottom: 24px;">
                                <label class="wizard-radio" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="radio" name="budget" value="< $2,000" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>Under $2,000</span>
                                </label>
                                <label class="wizard-radio" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="radio" name="budget" value="$2k - $5k" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>$2,000 - $5,000</span>
                                </label>
                                <label class="wizard-radio" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="radio" name="budget" value="$5k - $10k" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>$5,000 - $10,000</span>
                                </label>
                                <label class="wizard-radio" style="display: flex; align-items: center; padding: 16px; background: rgba(0,0,0,0.2); border: 1px solid var(--border-color); border-radius: 12px; cursor: pointer; transition: 0.3s;">
                                    <input type="radio" name="budget" value="$10k+" style="margin-right: 12px; transform: scale(1.2);">
                                    <span>$10,000+</span>
                                </label>
                            </div>
                            <div style="display: flex; gap: 12px;">
                                <button type="button" class="btn btn-ghost btn-pill wizard-prev-btn" style="flex: 1;">Back</button>
                                <button type="button" class="btn btn-primary btn-pill wizard-next-btn" style="flex: 2;">Next Step</button>
                            </div>
                        </div>

                        <!-- Step 3: Details -->
                        <div class="wizard-step" id="wizardStep3" style="display: none;">
                            <h3 style="margin-bottom: 16px;">Final Details</h3>
                            <div class="form-group">
                                <label for="name">Name</label>
                                <input type="text" id="name" name="name" required placeholder="John Doe">
                            </div>
                            <div class="form-group">
                                <label for="email">Email</label>
                                <input type="email" id="email" name="email" required placeholder="john@example.com">
                            </div>
                            <div class="form-group">
                                <label for="message">Project Details</label>
                                <textarea id="message" name="message" rows="4" required placeholder="Tell us more about your goals..."></textarea>
                            </div>
                            <div style="display: flex; gap: 12px;">
                                <button type="button" class="btn btn-ghost btn-pill wizard-prev-btn" style="flex: 1;">Back</button>
                                <button type="submit" class="btn btn-primary btn-pill glow-effect" id="contactSubmitBtn" style="flex: 2;">{submitButtonText}</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </section>

    <!-- Calendly Booking Section -->
    {(contactPage?.showBookingSection !== false) && (
        <section class="calendly-section section-padding">
            <div class="container">
                <div class="calendly-or-divider">{contactPage?.bookingDividerText || 'Or book a call directly'}</div>
                <div class="section-header animate-on-scroll slide-up" style="margin-bottom: 32px;">
                    <h2><span class="text-gradient">{contactPage?.bookingHeading || 'Schedule a Free Strategy Call'}</span></h2>
                    <p>{contactPage?.bookingSubtitle || 'Pick a time that works for you. No commitment, just a conversation about your goals.'}</p>
                </div>
                <div class="calendly-embed animate-on-scroll slide-up delay-200">
                    <!-- Calendly inline widget -->
                    <div 
                        class="calendly-inline-widget" 
                        data-url={`${contactPage?.calendlyUrl || 'https://calendly.com/quadem-agency/free-strategy-call'}?hide_gdpr_banner=1&background_color=0d0d14&text_color=e8e8e8&primary_color=00aeef`}
                        style="min-width: 320px; height: 700px;"
                    ></div>
                    <script is:inline src="https://assets.calendly.com/assets/external/widget.js" async></script>
                </div>
            </div>
        </section>
    )}
</BaseLayout>
