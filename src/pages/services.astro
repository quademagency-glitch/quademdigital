---
import { sanityClient } from "sanity:client";
import { PortableText } from '@portabletext/react';

const servicesPage = await sanityClient.fetch(`*[_type == "servicesPage"][0]`);
const services = await sanityClient.fetch(`*[_type == "service"] | order(order asc)`);
const siteSettings = await sanityClient.fetch(`*[_type == "siteSettings"][0]`);

const pageTitle = servicesPage?.title || "Our Services";
const pageSubtitle = servicesPage?.subtitle || "Comprehensive digital solutions to scale your business and dominate your market.";
---
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{pageTitle} | Quadem Digital</title>
    <meta name="description" content={pageSubtitle}>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500&family=Space+Grotesk:wght@500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/css/style.css">
    <link rel="stylesheet" href="/css/animations.css">
    <style>
        .services-hero {
            padding-top: 150px;
            padding-bottom: 80px;
            text-align: center;
            background: radial-gradient(circle at top, rgba(0, 174, 239, 0.1), transparent 50%);
        }
        .service-detail {
            border-bottom: 1px solid var(--border-color);
        }
        .service-detail:last-child {
            border-bottom: none;
        }
        .service-detail ul {
            list-style: none;
            padding-left: 0;
            margin-top: 20px;
            margin-bottom: 20px;
        }
        .service-detail ul li {
            position: relative;
            padding-left: 24px;
            margin-bottom: 12px;
            color: var(--text-muted);
        }
        .service-detail ul li::before {
            content: "✓";
            position: absolute;
            left: 0;
            color: var(--accent);
            font-weight: bold;
        }
        .service-detail ul li strong {
            color: var(--text-primary);
        }
        .img-placeholder {
            width: 100%;
            height: 100%;
            display: flex;
            align-items: center;
            justify-content: center;
            background-color: #1a1a24;
            color: var(--text-muted);
            font-family: var(--font-heading);
            font-size: 1.5rem;
            min-height: 400px;
        }
    </style>
</head>
<body>
    <header class="navbar scrolled" id="navbar">
        <div class="container navbar-container">
            <a href="/" class="logo active-logo">
                <img src="/images/logo.png" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
            </a>
            
            <nav class="nav-links">
                <a href="/services" style="color: var(--accent);">Services</a>
                <a href="/projects">Projects</a>
                <a href="/about">About</a>
                <a href="index.html#process">Process</a>
                <a href="index.html#testimonials">Testimonials</a>
                <a href="index.html#contact">Contact</a>
            </nav>
            
            <div class="nav-cta">
                <a href="index.html#contact" class="btn btn-primary btn-pill">Book a Call</a>
            </div>
            
            <button class="mobile-menu-btn" aria-label="Toggle menu">
                <span class="bar"></span>
                <span class="bar"></span>
                <span class="bar"></span>
            </button>
        </div>
    </header>

    <!-- Mobile Menu Drawer -->
    <div class="mobile-menu-drawer">
        <nav class="mobile-nav-links">
            <a href="/services" style="color: var(--accent);">Services</a>
            <a href="/projects">Projects</a>
            <a href="/about">About</a>
            <a href="index.html#process">Process</a>
            <a href="index.html#testimonials">Testimonials</a>
            <a href="index.html#contact">Contact</a>
            <a href="index.html#contact" class="btn btn-primary btn-pill mt-4">Book a Call</a>
        </nav>
    </div>

    <section class="services-hero">
        <div class="container">
            <h1><span class="text-gradient">{pageTitle}</span></h1>
            <p class="hero-subtitle">{pageSubtitle}</p>
        </div>
    </section>

    <!-- Services List -->
    {services && services.length > 0 ? (
        services.map((service: any, index: number) => {
            const isReversed = index % 2 !== 0;
            return (
                <section class="service-detail section-padding">
                    <div class="container">
                        <div class={`about-grid ${isReversed ? 'flex-row-reverse' : ''}`} style={isReversed ? 'flex-direction: row-reverse;' : ''}>
                            <div class={`about-image-col animate-on-scroll ${isReversed ? 'slide-left' : 'slide-right'}`}>
                                <div class="about-image-wrapper glow-effect" style="height: 100%;">
                                    <div class="img-placeholder" style="border-radius: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16px;">
                                        <div set:html={service.iconSvg || '<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg>'} />
                                        <span>{service.title}</span>
                                    </div>
                                </div>
                            </div>
                            <div class={`about-content-col animate-on-scroll ${isReversed ? 'slide-right' : 'slide-left'} delay-200`}>
                                <h2 class="about-title"><span class="text-gradient">{service.title}</span></h2>
                                <p class="about-text">{service.description}</p>
                                {service.tags && service.tags.length > 0 && (
                                    <>
                                        <p class="about-text" style="margin-top: 24px; font-weight: 500; color: var(--text-primary);">Highlights:</p>
                                        <ul>
                                            {service.tags.map((tag: string) => (
                                                <li><strong>{tag}</strong></li>
                                            ))}
                                        </ul>
                                    </>
                                )}
                                <a href="index.html#contact" class="btn btn-primary btn-pill glow-effect mt-4">Start Your Project</a>
                            </div>
                        </div>
                    </div>
                </section>
            );
        })
    ) : (
        <!-- Fallback if empty -->
        <section class="service-detail section-padding">
            <div class="container">
                <div class="about-grid">
                    <div class="about-image-col animate-on-scroll slide-right">
                        <div class="about-image-wrapper glow-effect" style="height: 100%;">
                            <div class="img-placeholder" style="border-radius: 12px;">Web Design</div>
                        </div>
                    </div>
                    <div class="about-content-col animate-on-scroll slide-left delay-200">
                        <h2 class="about-title"><span class="text-gradient">Web Design & Development</span></h2>
                        <p class="about-text">We build custom, high-performance websites tailored to your unique brand identity.</p>
                        <a href="index.html#contact" class="btn btn-primary btn-pill glow-effect mt-4">Start Your Web Project</a>
                    </div>
                </div>
            </div>
        </section>
    )}

    <!-- Footer CTA -->
    <section class="section-padding" style="text-align: center; background: rgba(0, 174, 239, 0.05); border-top: 1px solid var(--border-color);">
        <div class="container">
            <h2 style="margin-bottom: 24px;">Ready to elevate your business?</h2>
            <a href="index.html#contact" class="btn btn-primary btn-pill glow-effect" style="padding: 16px 40px; font-size: 1.1rem;">Let's Talk Strategy</a>
        </div>
    </section>

    <footer class="footer">
        <div class="container footer-container">
            <div class="footer-col">
                <a href="/" class="logo footer-logo active-logo">
                    <img src="/images/logo.png" alt="Quadem Digital Enterprise Logo" onerror="this.style.display='none'">
                    <span class="logo-text">Quadem <span class="logo-highlight">Digital</span></span>
                </a>
                <p class="footer-tagline">{siteSettings?.footerTagline || "Elevating brands with premium design and data-driven strategies."}</p>
            </div>
            
            <div class="footer-col">
                <h4>Quick Links</h4>
                <nav class="footer-nav">
                    <a href="/services">Services</a>
                    <a href="/projects">Projects</a>
                    <a href="index.html#process">Process</a>
                    <a href="index.html#contact">Contact</a>
                </nav>
            </div>
            
            <div class="footer-col footer-bottom">
                <p class="copyright">&copy; 2026 Quadem Digital Enterprise. All rights reserved.</p>
                <a href="#" class="back-to-top">Back to top ↑</a>
            </div>
        </div>
    </footer>

    <script is:inline src="/js/main.js"></script>
</body>
</html>
