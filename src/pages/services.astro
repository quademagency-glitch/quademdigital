---
// The services overview, in the new style (owner, 26-27 Oct 2026: About, the
// services overview and Contact after the work pages). It sells, so it is a
// scroll story like the service pages: the promise, then one service per
// step (one-off projects first, then monthly plans, numbered 01 to 06 across
// both), each with its own picture turning over into the panel as on web
// design's The build, its description, what it covers, its starting price on
// the price tag and the way to its page; then the free check-up.
//
// Words: the servicesPage global and each service's own record; prices from
// the same records the service pages render (src/lib/servicePrices.ts).
import { serviceVisuals, serviceVisualFor } from '../lib/serviceVisuals';
import { BOOKING_PATH } from '../lib/booking';
import BaseLayout from '../layouts/BaseLayout.astro';
import Picture from '../components/Picture.astro';
import { payloadFetch, payloadFetchGlobal } from '../lib/payload';
import { resolveSeo } from '../lib/seo';
import { getEntryPrices } from '../lib/servicePrices';
import { isRetiredService, serviceStage, SERVICE_STAGES } from '../lib/publicSettings.js';
import '../styles/service.css';
import '../styles/pages-d.css';

const servicesPage = await payloadFetchGlobal('servicesPage');
const allServices = await payloadFetch('services', { sort: 'order', depth: '1' });
/* Retired services keep their CMS row but are not sold (branding, from
   19 October 2026), so they are not listed. */
const services = (allServices || []).filter((service: any) => !isRetiredService(service.slug));
/* One-off projects, then monthly plans, as on the home page's prices. */
const ordered = SERVICE_STAGES.flatMap((stage) => services
  .filter((service: any) => serviceStage(service.slug) === stage.key)
  .map((service: any) => ({ service, stage })));
const entryPrices = await getEntryPrices();

/* Each service's own page; the three hand-built pages keep their addresses. */
const pageOf = (slug: string) => (/web/.test(slug) ? '/services/web-design/' : /video/.test(slug) ? '/services/video-production/' : /seo|ads/.test(slug) ? '/services/seo/' : `/services/${slug}/`);
const pictureOf = (service: any) => serviceVisualFor(service.slug) || (service.featuredImage && typeof service.featuredImage === 'object' ? service.featuredImage : null);

const pageTitle = servicesPage?.title || 'Services';
// The global defines `subheading`; `subtitle` is a legacy column (cms/CLAUDE.md).
const pageSubtitle = servicesPage?.subheading || servicesPage?.subtitle || 'Websites, AI video, search and ads that bring businesses more enquiries and sales.';
const heroMedia = serviceVisuals.web;
const LAST = Math.max(0, ordered.length - 1);
const pad = (n: number) => String(n).padStart(2, '0');
const ICON = {
  arrow: '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>',
  tick: '<path d="M5 12.5 10 17 19 7"></path>',
};
const seo = resolveSeo(servicesPage, {
  title: `${pageTitle} | Quadem Digital`,
  description: servicesPage?.description || 'Websites, WhatsApp assistants, AI video, SEO, performance marketing and lead lists that bring in enquiries and sales, with clear scope and fixed prices.',
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="services" headerDark scaleUp>
  <div class="dsv dso">
    <section class="d-scope d-dark dsv-hero" data-d-page aria-labelledby="dso-title">
      <div class="dsv-glow" aria-hidden="true"></div>
      <div class="dsv-hero-in">
        <div class="dsv-copy">
          <p class="dsv-lab">What we do</p>
          <h1 class="dsv-h1" id="dso-title">{servicesPage?.heading || pageTitle}</h1>
          <p class="dsv-lead">{pageSubtitle}</p>
          <p class="dsv-lead dso-lead2">Turn more of the people who find you into customers. We start with what is holding your business back, then build and run the pieces that fix it.</p>
          <div class="dsv-ctas">
            {ordered.length > 0 && <a class="d-btn d-btn-primary dsv-btn" href="/services/#services-list" data-goto="services-list" data-goto-step="0" data-track="services_hero_cta" data-loc="services-hero">Explore the services <svg class="dsv-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.arrow} /></a>}
            <a class="dsv-more" href={BOOKING_PATH} data-track="book_call" data-loc="services-hero">Discuss your project</a>
          </div>
        </div>
        {heroMedia && (
          <div class="dsv-visual">
            <figure>
              <Picture image={heroMedia} alt={heroMedia.alt || ''} sizes="(max-width: 900px) 90vw, 600px" size="medium" loading="eager" />
              {(heroMedia.caption || heroMedia.credit) && <figcaption>{[heroMedia.caption, heroMedia.credit].filter(Boolean).join(' · ')}</figcaption>}
            </figure>
          </div>
        )}
      </div>
    </section>

    {ordered.length > 0 && (
      <section id="services-list" class="d-story d-scope d-dark dsv-story dsv-what dso-story" data-story data-steps={String(LAST)} data-seg="0.8" data-active="0" aria-label="What we do">
        <div class="d-track">
          <div class="d-stage">
            <div class="d-bigtitle" aria-hidden="true">
              <span class="d-bigtitle-word">What we do</span>
              <span class="d-bigtitle-sub"><span class="d-bigtitle-label">{ordered.length === 6 ? 'Six services' : `${ordered.length} services`}</span><span class="d-pagetitle-count" data-story-count>{`01 / ${pad(ordered.length)}`}</span></span>
            </div>
            <div class="dsv-in">
              <div class="dsv-chs">
                {ordered.map(({ service, stage }, k) => {
                  const slug = service.slug;
                  const price = entryPrices[slug];
                  return (
                    <div class:list={['dsv-ch', { on: k === 0 }]} data-step={k} data-step-aria="hide" aria-hidden={k === 0 ? 'false' : 'true'}>
                      <p class="dsv-lab">{pad(k + 1)} · {stage.title}</p>
                      <h2 class="dsv-h2">{service.title}</h2>
                      {service.description && <p class="dsv-text">{service.description}</p>}
                      {service.tags && service.tags.length > 0 && (
                        <ul class="dso-tags">{service.tags.slice(0, 4).map((t: any) => <li><span class="dsv-tick"><svg viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.tick} /></span>{t.tag}</li>)}</ul>
                      )}
                      {(price?.usd || price?.ghs) && (
                        <p class="dso-from">
                          {/* Both lists ship and the browser reveals one (pricing.js). */}
                          <span data-market="international">Starts at <span data-price data-base="USD" data-amount={price?.usd ?? undefined}>${(price?.usd ?? 0).toLocaleString('en-US')}</span></span>
                          <span data-market="africa" hidden>Starts at <span data-price data-base="GHS" data-amount={price?.ghs ?? undefined}>GH₵ {(price?.ghs ?? 0).toLocaleString('en-US')}</span></span>
                        </p>
                      )}
                      <div class="dso-acts">
                        <a class="d-btn d-btn-primary dsv-btn" href={pageOf(slug)} data-track="services_cover" data-loc={`services-${slug}`}>See what it covers <svg class="dsv-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.arrow} /></a>
                        <a class="dsv-more" href={BOOKING_PATH} data-track="book_call" data-loc={`services-${slug}`}>Book a call</a>
                      </div>
                    </div>
                  );
                })}
              </div>
              <div class="dsv-panel">
                <div class="dsv-works">
                  {ordered.map(({ service }, k) => {
                    const picture = pictureOf(service);
                    const label = picture ? [picture.caption, picture.credit].filter(Boolean).join(' · ') : '';
                    return (
                      <figure class:list={['dsv-work', { on: k === 0 }]} data-step={k} data-step-aria="hide" aria-hidden={k === 0 ? 'false' : 'true'}>
                        <div class="dsv-wstage" aria-hidden="true">
                          {picture
                            ? <span class="dsv-wf is-main is-land is-alone"><Picture image={picture} alt="" sizes="(max-width: 900px) 80vw, 440px" size="medium" /></span>
                            : <span class="dsv-icon on"><span class="dsv-num">{pad(k + 1)}</span></span>}
                        </div>
                        {label && <figcaption class="dso-cap">{label}</figcaption>}
                      </figure>
                    );
                  })}
                </div>
                <ol class="dsv-index" aria-hidden="true">
                  {ordered.map(({ service }, k) => <li class:list={{ on: k === 0 }} data-step={k}><span>{pad(k + 1)}</span>{service.title}</li>)}
                </ol>
              </div>
            </div>
          </div>
        </div>
      </section>
    )}

    <section class="d-scope d-dark dsv-flat dsv-enquire" data-d-page data-your-move aria-labelledby="dso-cta">
      <div class="d-wrap">
        <div class="d-bigtitle is-static" aria-hidden="true">
          <span class="d-bigtitle-word">Your move</span>
          <span class="d-bigtitle-sub"><span class="d-bigtitle-label">Start with a free check-up</span></span>
        </div>
        <h2 class="dsv-h2" id="dso-cta">Ready for more customers?</h2>
        <div class="dsv-ctas">
          <a class="d-btn d-btn-primary dsv-btn" href="/offers/free-seo-audit/" data-track="services_checkup" data-loc="services-footer">Get a free website check-up <svg class="dsv-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.arrow} /></a>
          <a class="dsv-more" href="/calculator/" data-track="services_quote" data-loc="services-footer">Get a Quote</a>
        </div>
      </div>
    </section>
    <div class="d-wipe" aria-hidden="true"></div>
  </div>
</BaseLayout>
<script>
  import { initStories } from '../scripts/d-story.js';
  initStories(document);
  document.addEventListener('astro:page-load', () => initStories(document));
</script>
