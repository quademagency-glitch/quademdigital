---
import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetch, payloadFetchGlobal, buildPayloadImageUrl, getPayloadImageSize, getPayloadImageSrcset } from "../lib/payload";
import { Image } from 'astro:assets';

import imgWebDesign from '../images/service-web-design.webp';
import imgBranding from '../images/service-branding.webp';
import imgVideo from '../images/service-video.webp';
import imgSeo from '../images/service-seo.webp';
import imgDigitalMarketing from '../images/service-digital-marketing.webp';

const servicesPage = await payloadFetchGlobal('servicesPage');
const services = await payloadFetch('services', { sort: 'order' });

const pageTitle = servicesPage?.title || "Our Services";
const pageSubtitle = servicesPage?.subtitle || "Comprehensive digital solutions to scale your business and dominate your market.";
---
<BaseLayout title={`${pageTitle} | Quadem Digital`} description="Web design, SEO, branding and video from one team, built to scale your business and grow your share of the market. Explore what we do." activePage="services" navbarScrolled={true}>
    <fragment slot="head">
        <style>
            .service-detail {
                border-bottom: 1px solid var(--border-color);
            }
            .service-detail:last-child {
                border-bottom: none;
            }
            .service-detail ul {
                list-style: none;
                padding-left: 0;
                margin-top: 20px;
                margin-bottom: 20px;
            }
            .service-detail ul li {
                position: relative;
                padding-left: 24px;
                margin-bottom: 12px;
                color: var(--text-muted);
            }
            .service-detail ul li::before {
                content: "✓";
                position: absolute;
                left: 0;
                color: var(--accent-text);
                font-weight: bold;
            }
            .service-detail ul li strong {
                color: var(--text-primary);
            }
            .img-placeholder {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: var(--bg-card);
                color: var(--text-muted);
                font-family: var(--font-heading);
                font-size: 1.5rem;
                min-height: 400px;
            }
            .bs-svc-banner {
                display: block;
                text-decoration: none;
                color: inherit;
                border: 1px solid var(--border-color);
                border-radius: 24px;
                padding: 2.75rem;
                background:
                    radial-gradient(circle at 10% 15%, rgba(124, 92, 255, 0.16) 0%, transparent 46%),
                    radial-gradient(circle at 92% 88%, rgba(249, 115, 22, 0.13) 0%, transparent 46%),
                    rgba(255, 255, 255, 0.02);
                transition: transform 0.35s ease, box-shadow 0.35s ease, border-color 0.35s ease;
            }
            .bs-svc-banner:hover {
                transform: translateY(-4px);
                box-shadow: 0 24px 70px -34px rgba(124, 92, 255, 0.65);
                border-color: rgba(124, 92, 255, 0.4);
            }
            .bs-svc-text { max-width: 680px; }
            .bs-svc-badge {
                display: inline-block;
                font-size: 0.72rem;
                letter-spacing: 0.08em;
                text-transform: uppercase;
                font-weight: 700;
                color: #a78bfa;
                border: 1px solid var(--border-color);
                border-radius: 999px;
                padding: 5px 14px;
                margin-bottom: 1rem;
            }
            .bs-svc-banner h2 {
                font-family: var(--font-heading);
                font-size: clamp(1.6rem, 3vw, 2.3rem);
                line-height: 1.1;
                margin-bottom: 0.7rem;
            }
            .bs-svc-grad {
                background: linear-gradient(90deg, #7c5cff, #f97316);
                -webkit-background-clip: text;
                background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .bs-svc-banner p {
                color: var(--text-muted);
                line-height: 1.65;
                margin-bottom: 1.4rem;
            }
            .bs-svc-cta {
                display: inline-flex;
                align-items: center;
                gap: 8px;
                font-weight: 700;
                color: var(--text-primary);
                transition: gap 0.3s ease;
            }
            .bs-svc-banner:hover .bs-svc-cta { gap: 12px; }
        </style>
    </fragment>

    <section class="services-hero">
        <div class="container">
            <h1><span class="text-gradient">{pageTitle}</span></h1>
            <p class="hero-subtitle">{pageSubtitle}</p>
        </div>
    </section>

    <!-- Services List -->
    {services && services.length > 0 ? (
        services.map((service: any, index: number) => {
            const isReversed = index % 2 !== 0;
            const slug = service.slug || (service.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
            
            let dedicatedLink = `/services/${slug}/`;
            let localImageModule = null;
            let cmsImageDoc = service.featuredImage || null;

            if (!cmsImageDoc) {
                if (slug.includes('web')) {
                    localImageModule = imgWebDesign;
                    dedicatedLink = '/services/web-design/';
                } else if (slug.includes('brand') || slug.includes('graphic')) {
                    localImageModule = imgBranding;
                    dedicatedLink = '/services/brand-identity/';
                } else if (slug.includes('video')) {
                    localImageModule = imgVideo;
                    dedicatedLink = '/services/video-production/';
                } else if (slug.includes('seo') || slug.includes('ads')) {
                    localImageModule = imgSeo;
                    dedicatedLink = '/services/seo/';
                } else if (slug.includes('market') || slug.includes('social')) {
                    localImageModule = imgDigitalMarketing;
                    dedicatedLink = '/services/seo/'; // Routing digital marketing to SEO & Content page as it covers marketing
                }
            } else {
                // If it has a featured image from Payload, we should still ensure the dedicated link maps correctly
                if (slug.includes('web')) dedicatedLink = '/services/web-design/';
                else if (slug.includes('brand') || slug.includes('graphic')) dedicatedLink = '/services/brand-identity/';
                else if (slug.includes('video')) dedicatedLink = '/services/video-production/';
                else if (slug.includes('seo') || slug.includes('ads') || slug.includes('market')) dedicatedLink = '/services/seo/';
            }

            return (
                <section id={slug} class="service-detail section-padding">
                    <div class="container">
                        <div class={`about-grid ${isReversed ? 'flex-row-reverse' : ''}`} style={isReversed ? 'flex-direction: row-reverse;' : ''}>
                            <div class={`about-image-col animate-on-scroll ${isReversed ? 'slide-left' : 'slide-right'}`}>
                                <div class="about-image-wrapper glow-effect" style="height: 100%;">
                                    {cmsImageDoc ? (
                                        <img src={getPayloadImageSize(cmsImageDoc, 'medium') || buildPayloadImageUrl(cmsImageDoc)} srcset={getPayloadImageSrcset(cmsImageDoc) || undefined} sizes="(max-width: 640px) 45vw, 600px" alt={service.title} loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} style="width:100%; height:100%; object-fit:cover; border-radius:12px;" />
                                    ) : localImageModule ? (
                                        <Image src={localImageModule} alt={service.title} widths={[300, 600]} sizes="(max-width: 640px) 45vw, 600px" loading={index === 0 ? "eager" : "lazy"} fetchpriority={index === 0 ? "high" : "auto"} style="width:100%; height:100%; object-fit:cover; border-radius:12px;" />
                                    ) : (
                                        <div class="img-placeholder" style="border-radius: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16px;">
                                            <div set:html={service.iconSvg || '<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg>'} />
                                            <span>{service.title}</span>
                                        </div>
                                    )}
                                </div>
                            </div>
                            <div class={`about-content-col animate-on-scroll ${isReversed ? 'slide-right' : 'slide-left'} delay-200`}>
                                <h2 class="about-title"><span class="text-gradient">{service.title}</span></h2>
                                <p class="about-text">{service.description}</p>
                                {service.tags && service.tags.length > 0 && (
                                    <>
                                        <p class="about-text" style="margin-top: 24px; font-weight: 500; color: var(--text-primary);">Highlights:</p>
                                        <ul>
                                            {service.tags.map((t: any) => (
                                                <li><strong>{t.tag}</strong></li>
                                            ))}
                                        </ul>
                                    </>
                                )}
                                <div style="display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; align-items: center;">
                                    <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Start Your Project</a>
                                    <a href={dedicatedLink} class="btn btn-ghost btn-pill">Learn More →</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            );
        })
    ) : (
        <!-- Fallback if empty -->
        <section id="web-design-development" class="service-detail section-padding">
            <div class="container">
                <div class="about-grid">
                    <div class="about-image-col animate-on-scroll slide-right">
                        <div class="about-image-wrapper glow-effect" style="height: 100%;">
                            <Image src={imgWebDesign} alt="Web Design" widths={[300, 600, 800]} sizes="(max-width: 640px) 45vw, 600px" loading="eager" fetchpriority="high" style="width:100%; height:100%; object-fit:cover; border-radius:12px;" />
                        </div>
                    </div>
                    <div class="about-content-col animate-on-scroll slide-left delay-200">
                        <h2 class="about-title"><span class="text-gradient">Web Design & Development</span></h2>
                        <p class="about-text">We build custom, high-performance websites tailored to your unique brand identity.</p>
                        <a href="/contact/" class="btn btn-primary btn-pill glow-effect mt-4">Start Your Web Project</a>
                    </div>
                </div>
            </div>
        </section>
    )}

    <!-- Brand Studio feature -->
    <section class="section-padding">
        <div class="container">
            <a href="/brand-studio/" class="bs-svc-banner animate-on-scroll slide-up">
                <div class="bs-svc-text">
                    <span class="bs-svc-badge">New · On Subscription</span>
                    <h2>An ongoing <span class="bs-svc-grad">content team,</span> not a one-off project.</h2>
                    <p>The services above are one-time builds. Brand Studio keeps things moving with premium posts, reels and ad creatives produced and published for you every month, with no shoots to run and no one to hire. From GHS 1,800/mo.</p>
                    <span class="bs-svc-cta">Explore Brand Studio
                        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"></line><polyline points="12 5 19 12 12 19"></polyline></svg>
                    </span>
                </div>
            </a>
        </div>
    </section>

    <!-- Footer CTA -->
    <section class="section-padding" style="text-align: center; background: rgba(0, 174, 239, 0.05); border-top: 1px solid var(--border-color);">
        <div class="container">
            <h2 style="margin-bottom: 24px;">Ready to grow your business?</h2>
            <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect" style="padding: 16px 40px; font-size: 1.1rem;">Let's Talk Strategy</a>
                <a href="/calculator/" class="btn btn-ghost btn-pill" style="padding: 16px 40px; font-size: 1.1rem; background: var(--bg-hover);">Get a Quote</a>
            </div>
        </div>
    </section>
</BaseLayout>
