---
import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetch, payloadFetchGlobal, buildPayloadImageUrl } from "../lib/payload";

const servicesPage = await payloadFetchGlobal('servicesPage');
const services = await payloadFetch('services', { sort: 'order' });

const pageTitle = servicesPage?.title || "Our Services";
const pageSubtitle = servicesPage?.subtitle || "Comprehensive digital solutions to scale your business and dominate your market.";
---
<BaseLayout title={`${pageTitle} | Quadem Digital`} description="Comprehensive digital solutions — web design, SEO, branding, and video — to scale your business and dominate your market. Explore our services." activePage="services" navbarScrolled={true}>
    <fragment slot="head">
        <style>
            .service-detail {
                border-bottom: 1px solid var(--border-color);
            }
            .service-detail:last-child {
                border-bottom: none;
            }
            .service-detail ul {
                list-style: none;
                padding-left: 0;
                margin-top: 20px;
                margin-bottom: 20px;
            }
            .service-detail ul li {
                position: relative;
                padding-left: 24px;
                margin-bottom: 12px;
                color: var(--text-muted);
            }
            .service-detail ul li::before {
                content: "✓";
                position: absolute;
                left: 0;
                color: var(--accent);
                font-weight: bold;
            }
            .service-detail ul li strong {
                color: var(--text-primary);
            }
            .img-placeholder {
                width: 100%;
                height: 100%;
                display: flex;
                align-items: center;
                justify-content: center;
                background-color: #1a1a24;
                color: var(--text-muted);
                font-family: var(--font-heading);
                font-size: 1.5rem;
                min-height: 400px;
            }
        </style>
    </fragment>

    <section class="services-hero">
        <div class="container">
            <h1><span class="text-gradient">{pageTitle}</span></h1>
            <p class="hero-subtitle">{pageSubtitle}</p>
        </div>
    </section>

    <!-- Services List -->
    {services && services.length > 0 ? (
        services.map((service: any, index: number) => {
            const isReversed = index % 2 !== 0;
            const slug = service.slug || (service.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
            
            let dedicatedLink = `/services/${slug}/`;
            let localImage = service.featuredImage ? buildPayloadImageUrl(service.featuredImage) : null;

            if (!localImage) {
                if (slug.includes('web')) {
                    localImage = '/images/service-web-design.webp';
                    dedicatedLink = '/services/web-design/';
                } else if (slug.includes('brand') || slug.includes('graphic')) {
                    localImage = '/images/service-branding.webp';
                    dedicatedLink = '/services/brand-identity/';
                } else if (slug.includes('video')) {
                    localImage = '/images/service-video.webp';
                    dedicatedLink = '/services/video-production/';
                } else if (slug.includes('seo') || slug.includes('ads')) {
                    localImage = '/images/service-seo.webp';
                    dedicatedLink = '/services/seo/';
                } else if (slug.includes('market') || slug.includes('social')) {
                    localImage = '/images/service-digital-marketing.webp';
                    dedicatedLink = '/services/seo/'; // Routing digital marketing to SEO & Content page as it covers marketing
                }
            } else {
                // If it has a featured image from Payload, we should still ensure the dedicated link maps correctly
                if (slug.includes('web')) dedicatedLink = '/services/web-design/';
                else if (slug.includes('brand') || slug.includes('graphic')) dedicatedLink = '/services/brand-identity/';
                else if (slug.includes('video')) dedicatedLink = '/services/video-production/';
                else if (slug.includes('seo') || slug.includes('ads') || slug.includes('market')) dedicatedLink = '/services/seo/';
            }

            return (
                <section id={slug} class="service-detail section-padding">
                    <div class="container">
                        <div class={`about-grid ${isReversed ? 'flex-row-reverse' : ''}`} style={isReversed ? 'flex-direction: row-reverse;' : ''}>
                            <div class={`about-image-col animate-on-scroll ${isReversed ? 'slide-left' : 'slide-right'}`}>
                                <div class="about-image-wrapper glow-effect" style="height: 100%;">
                                    {localImage ? (
                                        <img src={localImage} alt={service.title} loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:12px;" />
                                    ) : (
                                        <div class="img-placeholder" style="border-radius: 12px; display: flex; flex-direction: column; justify-content: center; align-items: center; gap: 16px;">
                                            <div set:html={service.iconSvg || '<svg width="64" height="64" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg>'} />
                                            <span>{service.title}</span>
                                        </div>
                                    )}
                                </div>
                            </div>
                            <div class={`about-content-col animate-on-scroll ${isReversed ? 'slide-right' : 'slide-left'} delay-200`}>
                                <h2 class="about-title"><span class="text-gradient">{service.title}</span></h2>
                                <p class="about-text">{service.description}</p>
                                {service.tags && service.tags.length > 0 && (
                                    <>
                                        <p class="about-text" style="margin-top: 24px; font-weight: 500; color: var(--text-primary);">Highlights:</p>
                                        <ul>
                                            {service.tags.map((t: any) => (
                                                <li><strong>{t.tag}</strong></li>
                                            ))}
                                        </ul>
                                    </>
                                )}
                                <div style="display: flex; gap: 12px; margin-top: 24px; flex-wrap: wrap; align-items: center;">
                                    <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Start Your Project</a>
                                    <a href={dedicatedLink} class="btn btn-ghost btn-pill">Learn More →</a>
                                </div>
                            </div>
                        </div>
                    </div>
                </section>
            );
        })
    ) : (
        <!-- Fallback if empty -->
        <section id="web-design-development" class="service-detail section-padding">
            <div class="container">
                <div class="about-grid">
                    <div class="about-image-col animate-on-scroll slide-right">
                        <div class="about-image-wrapper glow-effect" style="height: 100%;">
                            <img src="/images/service-web-design.webp" alt="Web Design" loading="lazy" style="width:100%; height:100%; object-fit:cover; border-radius:12px;" width="800" height="600" />
                        </div>
                    </div>
                    <div class="about-content-col animate-on-scroll slide-left delay-200">
                        <h2 class="about-title"><span class="text-gradient">Web Design & Development</span></h2>
                        <p class="about-text">We build custom, high-performance websites tailored to your unique brand identity.</p>
                        <a href="/contact/" class="btn btn-primary btn-pill glow-effect mt-4">Start Your Web Project</a>
                    </div>
                </div>
            </div>
        </section>
    )}

    <!-- Footer CTA -->
    <section class="section-padding" style="text-align: center; background: rgba(0, 174, 239, 0.05); border-top: 1px solid var(--border-color);">
        <div class="container">
            <h2 style="margin-bottom: 24px;">Ready to elevate your business?</h2>
            <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect" style="padding: 16px 40px; font-size: 1.1rem;">Let's Talk Strategy</a>
                <a href="/calculator/" class="btn btn-ghost btn-pill" style="padding: 16px 40px; font-size: 1.1rem; background: rgba(255,255,255,0.05);">Get a Quote</a>
            </div>
        </div>
    </section>
</BaseLayout>
