---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "June 27, 2026";
---
<BaseLayout title="Privacy Policy | Quadem Digital" description="Read how Quadem Digital Enterprise collects, uses, and protects your personal information." navbarScrolled={true}>
    <section class="page-hero">
        <div class="container">
            <h1><span class="text-gradient">Privacy Policy</span></h1>
            <p class="hero-subtitle">Last updated: {lastUpdated}</p>
        </div>
    </section>

    <section class="section-padding">
        <div class="blog-post-content">
            <p>
                Quadem Digital Enterprise ("Quadem," "we," "us," or "our") respects your privacy.
                This Privacy Policy explains what information we collect through
                quademdigital.com, why we collect it, and how we use, store, and protect it.
            </p>

            <h2>Information We Collect</h2>
            <p>We collect information in the following ways:</p>
            <ul>
                <li><strong>Information you provide:</strong> name, email address, phone number, and project details when you submit a contact form, request a quote, book a call, or subscribe to our newsletter.</li>
                <li><strong>Automatically collected information:</strong> IP address, browser type, device information, pages visited, and referral source, collected through analytics and tracking tools such as Google Tag Manager, Ahrefs Analytics, and Metricool.</li>
                <li><strong>Client portal data:</strong> project files, invoices, and communications shared through our client portal if you are an active client.</li>
            </ul>

            <h2>How We Use Your Information</h2>
            <ul>
                <li>To respond to inquiries and provide quotes for our services.</li>
                <li>To deliver and manage projects for our clients.</li>
                <li>To send newsletters, offers, or updates you've opted into (you can unsubscribe at any time).</li>
                <li>To analyze website traffic and improve our content and services.</li>
                <li>To communicate with you via email or WhatsApp regarding your project or inquiry.</li>
            </ul>

            <h2>Sharing of Information</h2>
            <p>
                We do not sell your personal information. We may share information with trusted
                third-party service providers who help us operate our business, such as form
                processing (Formspree), email delivery (Resend), analytics providers, and hosting
                providers (Vercel). These providers are only permitted to use your data to perform
                services on our behalf.
            </p>

            <h2>Cookies and Tracking</h2>
            <p>
                We use cookies and similar tracking technologies to understand how visitors use our
                site and to improve performance. You can disable cookies through your browser
                settings, though some site features may not function properly as a result.
            </p>

            <h2>Data Retention</h2>
            <p>
                We retain personal information for as long as necessary to fulfill the purposes
                outlined in this policy, including any legal, accounting, or reporting requirements.
            </p>

            <h2>Your Rights</h2>
            <p>
                You may request access to, correction of, or deletion of your personal information
                at any time by contacting us at <a href="mailto:hello@quademdigital.com">hello@quademdigital.com</a>.
            </p>

            <h2>Changes to This Policy</h2>
            <p>
                We may update this Privacy Policy from time to time. Any changes will be posted on
                this page with an updated "Last updated" date.
            </p>

            <h2>Contact Us</h2>
            <p>
                If you have questions about this Privacy Policy, contact us at
                <a href="mailto:hello@quademdigital.com">hello@quademdigital.com</a>.
            </p>
        </div>
    </section>
</BaseLayout>
