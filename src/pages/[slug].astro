---
import BaseLayout from "../layouts/BaseLayout.astro";
import PageBlocks from "../components/blocks/PageBlocks.astro";
import { payloadFetch } from "../lib/payload";
import { resolveSeo } from "../lib/seo";

const { slug } = Astro.params;

if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

/*
  depth 2, not 1. Images and video sit one level inside the block arrays
  (a feature's icon, a gallery item's image, a testimonial's avatar), so at
  depth 1 every one of them comes back as a bare id and renders as nothing.
*/
const pages = await payloadFetch('pages', {
  'where[slug][equals]': slug,
  depth: '2',
});
const page = pages[0];

if (!page) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const blocks = page.pageBuilder ?? [];

const seo = resolveSeo(page, {
  title: `${page.title} | Quadem Digital`,
  description: page.seoDescription || "",
});

/*
  The page's own title only becomes an h1 when no block provides one. A hero
  block is the usual first block and already renders the h1, so printing this
  as well would give the page two.
*/
const hasHero = blocks.some((b: any) => b?.blockType === 'heroSection');
---

<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} navbarScrolled={true}>
  {!hasHero && (
    <section class="page-hero">
      <div class="container">
        <h1><span class="text-gradient">{page.title}</span></h1>
      </div>
    </section>
  )}

  <PageBlocks blocks={blocks} />

  {blocks.length === 0 && (
    <section class="section-padding">
      <div class="container" style="text-align: center;">
        <p>This page has no content yet.</p>
      </div>
    </section>
  )}
</BaseLayout>
