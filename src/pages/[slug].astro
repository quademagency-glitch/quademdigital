---
import BaseLayout from "../layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";

// Server-rendered for instant Sanity updates
const { slug } = Astro.params;
const page = await sanityClient.fetch(
  `*[_type == "page" && slug.current == $slug][0]`,
  { slug }
);

if (!page) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
---
<BaseLayout title={`${page.title} | Quadem Digital`} description={page.seoDescription || ""} navbarScrolled={true}>
    <fragment slot="head">
        <style>
            .text-block-section {
                max-width: 800px;
                margin: 0 auto;
            }
            .text-block-section h2 {
                margin-bottom: 24px;
                color: var(--text-primary);
            }
            .text-block-content {
                color: var(--text-muted);
                line-height: 1.8;
                font-size: 1.1rem;
            }
        </style>
    </fragment>

    <!-- Dynamic Page Builder Renderer -->
    {page.pageBuilder && page.pageBuilder.length > 0 ? (
        page.pageBuilder.map((block: any) => {
            
            // 1. Hero Section
            if (block._type === 'heroSection') {
                return (
                    <section class="page-hero">
                        <div class="container">
                            <h1><span class="text-gradient">{block.heading || page.title}</span></h1>
                            {block.subheading && <p class="hero-subtitle">{block.subheading}</p>}
                        </div>
                    </section>
                );
            }
            
            // 2. Text Block
            if (block._type === 'textBlock') {
                return (
                    <section class="section-padding">
                        <div class="container text-block-section">
                            {block.heading && <h2>{block.heading}</h2>}
                            {block.content && (
                                <div class="text-block-content">
                                    <PortableText value={block.content} />
                                </div>
                            )}
                        </div>
                    </section>
                );
            }

            // 3. Contact Form Section
            if (block._type === 'contactFormSection') {
                return (
                    <section class="contact section-padding" id="contact">
                        <div class="container">
                            <div class="section-header animate-on-scroll slide-up">
                                <h2><span class="text-gradient">{block.heading || "Let's build something great"}</span></h2>
                                <p>{block.subheading || "Fill out the form below or chat directly with us on WhatsApp to get started."}</p>
                            </div>
                            <div class="contact-grid">
                                <div class="contact-info animate-on-scroll slide-right">
                                    <h3 class="contact-subtitle">Get in Touch</h3>
                                    <p class="contact-text">We're ready to help you scale your business. Reach out today and let's start the conversation.</p>
                                    <a href="https://wa.me/1234567890?text=Hi%20Quadem%20Digital!%20I'd%20like%20to%20discuss%20a%20project." target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect mb-4 w-100">
                                        Chat on WhatsApp
                                    </a>
                                    <a href="mailto:hello@quademdigital.com" class="contact-email">hello@quademdigital.com</a>
                                </div>
                                <div class="contact-form-container animate-on-scroll slide-left delay-200">
                                    <form class="contact-form" id="contactForm" action="https://formspree.io/f/xgobwrdw">
                                        <div class="form-group" id="formSuccess" style="display: none; background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); padding: 16px; border-radius: 8px; margin-bottom: 20px; color: var(--accent);">
                                            Thanks for reaching out! We'll be in touch shortly.
                                        </div>
                                        <div class="form-group">
                                            <label for="name">Name</label>
                                            <input type="text" id="name" name="name" required placeholder="John Doe">
                                        </div>
                                        <div class="form-group">
                                            <label for="email">Email</label>
                                            <input type="email" id="email" name="email" required placeholder="john@example.com">
                                        </div>
                                        <div class="form-group">
                                            <label for="message">Message</label>
                                            <textarea id="message" name="message" rows="4" required placeholder="Tell us about your project..."></textarea>
                                        </div>
                                        <button type="submit" class="btn btn-ghost btn-pill w-100">Send Message</button>
                                    </form>
                                </div>
                            </div>
                        </div>
                    </section>
                );
            }
            
            return null;
        })
    ) : (
        // Fallback if no blocks are defined
        <section class="page-hero">
            <div class="container">
                <h1><span class="text-gradient">{page.title}</span></h1>
                <p class="hero-subtitle">Page content coming soon.</p>
            </div>
        </section>
    )}
</BaseLayout>
