---
import BaseLayout from "../layouts/BaseLayout.astro";

const lastUpdated = "June 27, 2026";
---
<BaseLayout title="Terms of Service | Quadem Digital" description="Read the terms and conditions for using Quadem Digital Enterprise's website and services, including your rights and responsibilities." navbarScrolled={true}>
    <section class="page-hero">
        <div class="container">
            <h1><span class="text-gradient">Terms of Service</span></h1>
            <p class="hero-subtitle">Last updated: {lastUpdated}</p>
        </div>
    </section>

    <section class="section-padding">
        <div class="blog-post-content">
            <p>
                These Terms of Service ("Terms") govern your use of quademdigital.com and any
                services provided by Quadem Digital Enterprise ("Quadem," "we," "us," or "our").
                By accessing our website or engaging our services, you agree to these Terms.
            </p>

            <h2>Our Services</h2>
            <p>
                Quadem provides digital services including web design and development, digital
                marketing, branding and graphic design, video production, and SEO. The specific
                scope, deliverables, timeline, and fees for any project are agreed upon separately
                with each client, typically via a proposal or contract.
            </p>

            <h2>Use of Our Website</h2>
            <p>
                You agree to use quademdigital.com only for lawful purposes. You may not attempt to
                gain unauthorized access to any part of the site, interfere with its operation, or
                use it to transmit harmful or malicious code.
            </p>

            <h2>Quotes and Estimates</h2>
            <p>
                Tools such as our project quote calculator provide estimates for general planning
                purposes only. Final pricing is confirmed in a formal proposal or invoice issued by
                our team.
            </p>

            <h2>Payments and Refunds</h2>
            <p>
                Payment terms, including deposits, milestones, and final balances, are defined in
                each client's project agreement or invoice. Refund eligibility, if any, is also
                specified in that agreement unless otherwise required by applicable law.
            </p>

            <h2>Intellectual Property</h2>
            <p>
                All content on quademdigital.com, including text, graphics, logos, and code, is the
                property of Quadem Digital Enterprise unless otherwise noted, and may not be
                reproduced without permission. Ownership of deliverables created for a client
                transfers as specified in that client's project agreement, typically upon full
                payment.
            </p>

            <h2>Third-Party Links and Services</h2>
            <p>
                Our site may link to third-party services, including QuadERP (quaderp.app) and
                partner tools. We are not responsible for the content, policies, or practices of
                third-party websites or services.
            </p>

            <h2>Limitation of Liability</h2>
            <p>
                Quadem Digital Enterprise is not liable for any indirect, incidental, or
                consequential damages arising from your use of our website or services, to the
                fullest extent permitted by law.
            </p>

            <h2>Changes to These Terms</h2>
            <p>
                We may revise these Terms from time to time. Continued use of our website after
                changes are posted constitutes acceptance of the updated Terms.
            </p>

            <h2>Contact Us</h2>
            <p>
                If you have questions about these Terms, contact us at
                <a href="mailto:hello@quademdigital.com">hello@quademdigital.com</a>.
            </p>
        </div>
    </section>
</BaseLayout>
