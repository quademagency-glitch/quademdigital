---
// Web design, in the new style (owner, 26 Oct 2026: the six service pages share
// one layout, src/components/service/SvcPage.astro). The words are still the
// webDesignPage global's; web-design.snapshot.json is that global as it stood
// on 26 Oct 2026, used only when the CMS cannot be reached. The proof is the
// case studies shown under web design.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SvcPage from "../../components/service/SvcPage.astro";
import SvcProjects from "../../components/service/SvcProjects.astro";
import Picture from "../../components/Picture.astro";
import { payloadFetch, payloadFetchGlobal } from "../../lib/payload";
import { resolveSeo } from "../../lib/seo";
import { fromPageGlobal, type SvcWorks } from "../../lib/services/svcPage";
import { newestSite, shortResult } from "../../lib/latestWork";
import snapshot from "../../lib/services/web-design.snapshot.json";

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "";
const live = await payloadFetchGlobal("webDesignPage");
const pageData = live?.hero ? live : snapshot;
const page = fromPageGlobal(pageData, { key: 'web-design', whatWord: 'The build' });

// Real work beside each kind of website in The build (owner, 26 Oct 2026: "can
// we flop some works when we select what we build"). Matched to the CMS item
// by its title, so a renamed item simply shows no work. The first row is the
// newest website, by itself; Quajo Speaks, not SAN Collection, if there is none
// (owner, same day). Covers are the case studies' own; QuadERP's pictures show
// demo figures and say so.
const studies = await payloadFetch('caseStudies', { depth: '1', limit: '100' });
const cover = (slug: string) => {
    const doc = (studies || []).find((s: any) => s?.slug === slug && s?.published !== false);
    return doc?.coverImage && typeof doc.coverImage === 'object' && doc.coverImage.url ? doc.coverImage : null;
};
const erpLanding = { src: '/images/quaderp/landing-clean-960.webp', srcset: '/images/quaderp/landing-clean-640.webp 640w, /images/quaderp/landing-clean-960.webp 960w, /images/quaderp/landing-clean-1440.webp 1440w', width: 1440, height: 900 };
const site = newestSite(studies);
const tannorAdmin = (studies || []).find((s: any) => s?.slug === 'tannor-freight' && s?.published !== false)
    ?.imageGallery?.find((row: any) => /admin-service-page/.test(row?.image?.filename || ''))?.image;
const WORKS: [RegExp, SvcWorks][] = [
    [/business/i, site
        ? { frames: [{ media: site.coverImage }], name: site.title, tag: site.projectType === 'client' ? 'Client' : 'Internal project', fact: [site.resultMetric, shortResult(site.resultText)].filter(Boolean).join(' · '), href: `/projects/${site.slug}/` }
        : { frames: [{ media: cover('quajo-speaks') }], name: 'Quajo Speaks', tag: 'Internal project', fact: '90 on a phone, 100 for SEO', href: '/projects/quajo-speaks/' }],
    [/shop/i, { frames: [{ media: cover('omek-storefront') }, { file: { src: '/images/omek-storefront-phone.webp', width: 780, height: 1245 }, shape: 'tall' }], name: 'Omek Storefront', tag: 'Client', fact: '300+ products live', href: '/projects/omek-storefront/' }],
    [/one-page|landing/i, { frames: [{ file: erpLanding, demo: true }], name: 'QuadERP', tag: 'Our product', fact: '100/100 for SEO', href: '/projects/quaderp-landing/' }],
    [/app|dashboard/i, tannorAdmin ? { frames: [{ media: tannorAdmin }], name: 'Tannor Freight admin', tag: 'Client', fact: "Run by Tannor's own team", href: '/projects/tannor-freight/' } : { frames: [{ media: cover('quadbrand') }, { file: { src: '/images/quaderp-dashboard.webp', width: 1024, height: 1024 }, shape: 'sq', demo: true }], name: 'QuadBrand and QuadERP', tag: 'Our products', href: '/projects/quadbrand/', linkLabel: 'See QuadBrand' }],
];
if (page.what) {
    for (const item of page.what.items) {
        const hit = WORKS.find(([re]) => re.test(item.title));
        if (!hit) continue;
        const works = { ...hit[1], frames: hit[1].frames.filter((f) => f.media || f.file) };
        if (works.frames.length) item.works = works;
    }
}
const media = live?.hero?.media && typeof live.hero.media === 'object' && live.hero.media.url ? live.hero.media : null;

// The questions are on the page; this tells Google they are an FAQ.
const jsonLd = page.faq ? {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: page.faq.items.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
} : undefined;

const seo = resolveSeo(pageData, {
  title: "Professional Web Design Services | Quadem Digital",
  description: "Custom, responsive websites built to turn visitors into customers. Fast, mobile-friendly and designed around your brand and business goals.",
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="services" headerDark scaleUp jsonLd={jsonLd}>
    <SvcPage page={page} enquirySlug="web-design-development" returnTo="/services/web-design/" whatsappHref={whatsappNumber ? `https://wa.me/${whatsappNumber}` : undefined}>
        {media && (
            <figure slot="visual">
                <Picture image={media} alt={media.alt || ''} sizes="(max-width: 900px) 90vw, 600px" size="medium" loading="eager" />
                {(media.caption || media.credit) && <figcaption>{[media.caption, media.credit].filter(Boolean).join(' · ')}</figcaption>}
            </figure>
        )}
        <SvcProjects slot="proof" service="web-design" />
    </SvcPage>
</BaseLayout>
