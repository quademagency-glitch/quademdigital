---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceProjects from "../../components/ServiceProjects.astro";
import { payloadFetchGlobal, getPayloadImageSize, getPayloadImageSrcset } from "../../lib/payload";
import PortfolioTile from "../../components/PortfolioTile.astro";
import { resolveSeo } from "../../lib/seo";

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";

const pageData = await payloadFetchGlobal("webDesignPage") || {};

const hero = pageData.hero || {};
const servicesSection = pageData.servicesSection || {};
const processSection = pageData.processSection || {};
const pricingSection = pageData.pricingSection || {};
const faqSection = pageData.faqSection || {};
const portfolioGallery = pageData.portfolioGallery || {};
const showreel = pageData.showreel || {};

// 'card' (480px), not 'large'. This backdrop is blurred 8px as well as sitting
// under a 70 to 95% dark overlay, and the blur destroys detail far faster than
// the downscale does. Measured: rendering it from the 480px file instead of the
// 1200px one moves not one pixel in the hero by a visible amount, at either
// screen size, and saves 41KB. The three unblurred service heroes cannot go
// this small, which is why they sit at 'medium'.
const heroMediaUrl = hero.media ? getPayloadImageSize(hero.media, 'card') : null;
const heroBgImage = heroMediaUrl || '/images/service-web-design.webp';

// Fallback service types
const serviceTypes = servicesSection.services?.length ? servicesSection.services : [
    {
        title: 'Corporate Websites',
        description: 'Professional sites that showcase your brand, services, and credibility.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="3" width="20" height="14" rx="2" ry="2"/></svg>'
    },
    {
        title: 'E‑Commerce',
        description: 'Shopify‑ready or custom stores that convert traffic into sales.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 4s-.7 2.1-2 3.4c1.6 10-9.4 17.3-18 11.6 2.2.1 4.4-.6 6-2C3 15.5.5 9.6 3 5c2.2 2.6 5.6 4.1 9 4-.9-4.2 4-6.6 7-3.8 1.1 0 3-1.2 3-1.2z"/></svg>'
    },
    {
        title: 'Landing Pages',
        description: 'High‑impact single pages for campaigns, launches, and lead capture.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"/><rect x="1" y="5" width="15" height="14" rx="2" ry="2"/></svg>'
    },
    {
        title: 'Web Apps & Dashboards',
        description: 'Custom interactive applications built on modern stacks.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M23 19a2 2 0 0 1-2 2H3a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h4l2-3h6l2 3h4a2 2 0 0 1 2 2z"/><circle cx="12" cy="13" r="4"/></svg>'
    }
];

// Fallback process steps
const processSteps = processSection.steps?.length ? processSection.steps : [
    { number: '01', title: 'Discovery & Strategy', description: 'I define goals, target audience, and site architecture.' },
    { number: '02', title: 'Design & Wireframes', description: 'Mockups, UI design, and responsive prototypes.' },
    { number: '03', title: 'Development', description: 'Clean, performant code built on Astro, React, or vanilla HTML/CSS.' },
    { number: '04', title: 'Launch & Optimization', description: 'Testing, SEO, performance tuning, and handover.' }
];

// Fallback pricing
const pricingTiers = pricingSection.plans?.length ? pricingSection.plans : [
    {
        name: 'Landing Page',
        price: 'GH₵ 2,500',
        period: 'starting at',
        description: 'Perfect for campaigns, lead generation, and new product launches.',
        isPopular: false,
        features: [{feature: 'High-converting single page'}, {feature: 'Custom premium design'}, {feature: 'Mobile responsive'}, {feature: 'Contact form integration'}, {feature: 'Basic SEO setup'}, {feature: 'Social media links'}, {feature: '1 week delivery'}]
    },
    {
        name: 'Corporate Site',
        price: 'GH₵ 5,000',
        period: 'starting at',
        description: 'Ideal for growing businesses needing a complete online presence.',
        isPopular: true,
        features: [{feature: 'Up to 5 custom pages'}, {feature: 'Content Management System (CMS)'}, {feature: 'Blog integration'}, {feature: 'Advanced SEO optimization'}, {feature: 'Google Analytics setup'}, {feature: 'Performance tuning'}, {feature: '3 weeks delivery'}, {feature: '30 days free support'}]
    },
    {
        name: 'E-Commerce',
        price: 'Custom',
        period: 'per project',
        description: 'Full-scale online stores or complex web applications.',
        isPopular: false,
        features: [{feature: 'Unlimited products'}, {feature: 'Secure payment gateway integration'}, {feature: 'Inventory management'}, {feature: 'User accounts & dashboards'}, {feature: 'Custom app functionality'}, {feature: 'Advanced analytics'}, {feature: 'I manage it, start to finish'}, {feature: 'Ongoing maintenance options'}]
    }
];

// Fallback FAQs
const faqs = faqSection.faqs?.length ? faqSection.faqs : [
    { question: 'How long does it take to build a website?', answer: 'A standard corporate website typically takes 3 to 4 weeks from discovery to launch. Landing pages can be delivered in a week, while complex e-commerce or custom web apps may take 6 to 12 weeks depending on scope.' },
    { question: 'What platforms do you build on?', answer: 'I choose the best stack for your needs. For blazing-fast content sites, I use Astro or Next.js. For e-commerce, I utilize Shopify or custom solutions. For easy content management, I can integrate WordPress or modern headless CMS solutions like Payload CMS.' },
    { question: 'Do I need to provide the content?', answer: 'That is up to you. If you have text and images, I will use them. If not, I can write the copy and design the visuals for your brand for an additional fee.' },
    { question: 'Will my website be mobile-friendly?', answer: 'Absolutely. Every website I build is 100% responsive, meaning it will look and function beautifully on smartphones, tablets, and desktop computers.' },
    { question: 'Do you provide ongoing support after launch?', answer: 'Yes. All my packages include a 30-day bug-fix guarantee. Beyond that, I offer monthly maintenance packages for security updates, backups, and minor content changes to keep your site running smoothly.' }
];

// The questions and answers are already on the page. This tells Google they are
// an FAQ, which is what makes them eligible for the expandable block under the
// search result. Same shape the video page already uses.
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f: any) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
};

const seo = resolveSeo(pageData, {
  title: "Professional Web Design Services | Quadem Digital",
  description: "Custom, responsive websites built to turn visitors into customers. Fast, mobile-friendly and designed around your brand and business goals.",
});
---

<BaseLayout
    title={seo.title}
    description={seo.description}
    ogImage={seo.ogImage}
    activePage="services"
    navbarScrolled={true}
    jsonLd={jsonLd}
>
    <Fragment slot="head">
        <style>
            /* ===== WEB DESIGN HERO ===== */
            .wd-hero {
                position: relative;
                min-height: 85vh;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 120px 20px 80px;
                overflow: hidden;
            }
            .wd-hero-bg {
                position: absolute;
                /* Over-fill, because the blur below would otherwise feather the
                   edges and show the page behind. .wd-hero clips the overflow. */
                inset: -30px;
                background-image: url('/images/service-web-design.webp');
                background-size: cover;
                background-position: center;
                /* The artwork is four real client sites, so it carries their
                   real headlines and nav labels. Unblurred, "Professional Web
                   Design" landed on top of a client's "Stop Losing Money to
                   Theft" and a flash-sale banner: two sets of type fighting.
                   Blurring keeps the impression of real shipped work while
                   making none of its text readable. */
                filter: blur(8px);
                /* Was z-index: -2. .wd-hero is position:relative with z-index:
                   auto and so creates no stacking context: a negative-z child
                   escapes to the root context and paints behind the body's
                   opaque rgb(5,8,20) background, so this image never rendered
                   at all. Stay at 0, under .wd-hero-content at 1. */
                z-index: 0;
            }
            .wd-hero-bg::after {
                content: '';
                position: absolute;
                inset: 0;
                /* The artwork here is four real client sites, so it is much
                   brighter than the other service heroes. Heavier radial than
                   the video page uses, or the white screenshots pull the eye
                   off the headline. */
                background:
                    linear-gradient(180deg,
                        rgba(5, 8, 20, 0.92) 0%,
                        rgba(5, 8, 20, 0.12) 26%,
                        rgba(5, 8, 20, 0.12) 70%,
                        rgba(5, 8, 20, 0.94) 100%
                    ),
                    radial-gradient(ellipse 86% 66% at 50% 48%,
                        rgba(5, 8, 20, 0.90) 0%,
                        rgba(5, 8, 20, 0.82) 45%,
                        rgba(5, 8, 20, 0.55) 100%
                    );
                z-index: 1;
            }
            .wd-hero-content {
                max-width: 800px;
                position: relative;
                z-index: 1;
            }
            .wd-badge {
                display: inline-block;
                padding: 6px 20px;
                border-radius: 50px;
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 2px;
                color: var(--accent-text);
                border: 1px solid rgba(0, 174, 239, 0.3);
                background: rgba(0, 174, 239, 0.08);
                margin-bottom: 24px;
            }
            .wd-hero h1 {
                /* 36px floor was a desktop size a clamp can never drop
                   below, so the headline stayed oversized on a phone. 5vw
                   takes over above ~560px: tablet and desktop are unchanged. */
                font-size: clamp(28px, 5vw, 64px);
                margin-bottom: 24px;
                line-height: 1.1;
            }
            .wd-hero .hero-subtitle {
                font-size: 18px;
                color: var(--text-muted);
                max-width: 600px;
                margin: 0 auto 40px;
                line-height: 1.6;
            }
            .wd-hero-ctas {
                display: flex;
                gap: 16px;
                justify-content: center;
                flex-wrap: wrap;
            }

            /* ===== SERVICE TYPES GRID ===== */
            .wd-types {
                background: var(--bg-surface);
                border-top: 1px solid var(--border-color);
                border-bottom: 1px solid var(--border-color);
            }
            .wd-types-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: 24px;
            }
            .wd-type-card {
                background: var(--bg-inset);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 40px 28px;
                text-align: center;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }
            .wd-type-card:hover {
                border-color: rgba(0, 174, 239, 0.4);
                transform: translateY(-6px);
                box-shadow: 0 20px 40px rgba(0, 174, 239, 0.08);
            }
            .wd-type-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background: linear-gradient(90deg, transparent, var(--accent), transparent);
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .wd-type-card:hover::before {
                opacity: 1;
            }
            .wd-type-icon {
                width: 64px;
                height: 64px;
                margin: 0 auto 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(0, 174, 239, 0.1);
                border-radius: 16px;
                color: var(--accent-text);
            }
            .wd-type-card h3 {
                font-size: 20px;
                margin-bottom: 12px;
            }
            .wd-type-card p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.6;
            }

            /* ===== SHOWREEL ===== */
            .wd-showreel {
                position: relative;
                overflow: hidden;
            }
            .wd-showreel-container {
                max-width: 900px;
                margin: 0 auto;
            }
            .wd-player {
                position: relative;
                aspect-ratio: 16/9;
                background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-card) 50%, var(--bg-surface) 100%);
                border-radius: 16px;
                border: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 20px;
                overflow: hidden;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
            }
            .wd-player::before {
                content: '';
                position: absolute;
                inset: -1px;
                border-radius: 17px;
                padding: 1px;
                background: linear-gradient(135deg, rgba(0, 174, 239, 0.3), transparent 40%, transparent 60%, rgba(0, 174, 239, 0.3));
                -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                pointer-events: none;
            }
            .wd-play-btn {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                background: rgba(0, 174, 239, 0.15);
                border: 2px solid var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--accent-text);
                transition: all 0.3s ease;
                cursor: default;
            }
            .wd-play-btn svg {
                margin-left: 4px;
            }
            .wd-player-label {
                font-family: var(--font-heading);
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 3px;
                color: var(--text-muted);
            }
            .wd-coming-soon {
                font-size: 12px;
                color: var(--text-subtle);
                font-style: italic;
            }

            /* ===== PROCESS ===== */
            .wd-process {
                background: var(--bg-surface);
                border-top: 1px solid var(--border-color);
                border-bottom: 1px solid var(--border-color);
            }
            .wd-process-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 32px;
                position: relative;
            }
            .wd-step {
                text-align: center;
                position: relative;
            }
            .wd-step-number {
                width: 56px;
                height: 56px;
                background: var(--bg-page);
                border: 2px solid var(--accent);
                color: var(--accent-text);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-family: var(--font-heading);
                font-weight: 700;
                margin: 0 auto 20px;
                box-shadow: 0 0 20px rgba(0, 174, 239, 0.15);
            }
            .wd-step h3 {
                font-size: 18px;
                margin-bottom: 8px;
            }
            .wd-step p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.5;
            }
            @media (min-width: 992px) {
                .wd-step:not(:last-child)::after {
                    content: '';
                    position: absolute;
                    top: 28px;
                    right: -16px;
                    width: 32px;
                    height: 2px;
                    background: repeating-linear-gradient(to right, transparent, transparent 3px, var(--accent) 3px, var(--accent) 8px);
                    opacity: 0.3;
                }
            }

            /* ===== PRICING ===== */
            .wd-pricing-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                gap: 32px;
                align-items: stretch;
            }
            @media (min-width: 992px) {
                .wd-pricing-grid {
                    grid-template-columns: repeat(3, 1fr);
                }
            }
            .wd-pricing-card {
                background: var(--bg-surface);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 48px 32px;
                text-align: center;
                transition: all 0.3s ease;
                box-shadow: var(--shadow-sm);
                display: flex;
                flex-direction: column;
            }
            .wd-pricing-card:hover {
                transform: translateY(-5px);
                border-color: var(--border-strong);
                box-shadow: var(--shadow-md);
            }
            .wd-pricing-card.wd-popular {
                background: var(--bg-card);
                border-color: var(--accent);
                transform: scale(1.05);
                position: relative;
                padding: 64px 32px;
                z-index: 2;
                box-shadow: var(--shadow-glow);
            }
            .wd-pricing-card.wd-popular:hover {
                transform: scale(1.05) translateY(-5px);
            }
            .wd-popular-badge {
                position: absolute;
                top: 0;
                left: 50%;
                transform: translate(-50%, -50%);
                background: var(--accent);
                color: #000;  /* theme-exempt: dark text on an accent-filled control; must not invert */
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 6px 16px;
                border-radius: 50px;
            }
            .wd-tier-name {
                font-size: 24px;
                margin-bottom: 16px;
            }
            .wd-tier-price {
                font-size: 40px;
                font-family: var(--font-heading);
                font-weight: 700;
                color: var(--text-primary);
                margin-bottom: 8px;
            }
            .wd-tier-cycle {
                font-size: 14px;
                color: var(--text-muted);
                margin-bottom: 24px;
            }
            .wd-tier-desc {
                font-size: 14px;
                color: var(--text-muted);
                margin-bottom: 32px;
                min-height: 42px;
            }
            .wd-tier-features {
                list-style: none;
                margin-bottom: 40px;
                text-align: left;
                flex-grow: 1;
            }
            .wd-tier-features li {
                font-size: 15px;
                margin-bottom: 14px;
                padding-left: 28px;
                position: relative;
                color: var(--text-muted);
            }
            .wd-tier-features li::before {
                content: '✓';
                position: absolute;
                left: 0;
                color: var(--accent-text);
                font-weight: bold;
            }

            /* ===== FAQ ===== */
            .wd-faq-list {
                max-width: 800px;
                margin: 0 auto;
            }
            .wd-faq-item {
                border-bottom: 1px solid var(--border-color);
            }
            .wd-faq-question {
                width: 100%;
                background: transparent;
                border: none;
                color: var(--text-primary);
                font-family: var(--font-heading);
                font-size: 18px;
                font-weight: 600;
                padding: 24px 40px 24px 0;
                text-align: left;
                cursor: pointer;
                position: relative;
                transition: color 0.2s ease;
            }
            .wd-faq-question:hover {
                color: var(--accent-text);
            }
            .wd-faq-question::after {
                content: '+';
                position: absolute;
                right: 0;
                top: 50%;
                transform: translateY(-50%);
                font-size: 24px;
                color: var(--accent-text);
                transition: transform 0.3s ease;
            }
            .wd-faq-item.active .wd-faq-question::after {
                content: '−';
                transform: translateY(-50%) rotate(0deg);
            }
            .wd-faq-answer {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s ease, padding 0.3s ease;
                padding: 0;
            }
            .wd-faq-item.active .wd-faq-answer {
                max-height: 300px;
                padding-bottom: 24px;
            }
            .wd-faq-answer p {
                font-size: 15px;
                line-height: 1.7;
                color: var(--text-muted);
            }

            /* ===== CTA ===== */
            .wd-cta {
                background: rgba(0, 174, 239, 0.03);
                border-top: 1px solid var(--border-color);
            }
            .wd-cta-inner {
                max-width: 700px;
                margin: 0 auto;
                text-align: center;
            }
            .wd-cta-inner h2 {
                margin-bottom: 16px;
            }
            .wd-cta-inner p {
                color: var(--text-muted);
                margin-bottom: 32px;
                font-size: 17px;
            }
            .wd-cta-buttons {
                display: flex;
                gap: 16px;
                justify-content: center;
                flex-wrap: wrap;
            }

            @media (max-width: 768px) {
                .wd-hero {
                    min-height: 70vh;
                    padding: 100px 20px 60px;
                }

                /* A 1200px wide image drawn into a 375px box is already
                   downscaled more than 3x, which is what made the client
                   headlines in the artwork unreadable in the first place. The
                   desktop blur on top of that scaling was doing the same job
                   twice and turned the picture into grey noise. */
                .wd-hero-bg {
                    filter: blur(5px);
                    inset: -20px;
                }

                /* The headline runs full-bleed on a phone, so the desktop
                   ellipse would leave the first and last word of each line
                   over bare artwork. Widen it and lift the floor.

                   The radial used to peak at 0.90 over the 0.2 floor of the
                   linear below it, which composites to roughly 92% black
                   across the middle of the image: the artwork was there, paid
                   for in bytes, and invisible. Pulled back so the work behind
                   the words actually reads as work, while the headline still
                   sits on a dark enough field. */
                .wd-hero-bg::after {
                    background:
                        linear-gradient(180deg,
                            rgba(5, 8, 20, 0.92) 0%,
                            rgba(5, 8, 20, 0.2) 26%,
                            rgba(5, 8, 20, 0.2) 68%,
                            rgba(5, 8, 20, 0.94) 100%
                        ),
                        radial-gradient(ellipse 130% 60% at 50% 48%,
                            rgba(5, 8, 20, 0.80) 0%,
                            rgba(5, 8, 20, 0.70) 55%,
                            rgba(5, 8, 20, 0.50) 100%
                        );
                }
                .wd-pricing-card.wd-popular {
                    transform: scale(1);
                    padding: 48px 32px;
                }
                .wd-pricing-card.wd-popular:hover {
                    transform: translateY(-5px);
                }
            }
        </style>
    </Fragment>

    <!-- ===== HERO ===== -->
    <section class="wd-hero">
        <div class="wd-hero-bg" style={`background-image: url('${heroBgImage}');`}></div>
        <div class="container wd-hero-content animate-on-scroll slide-up">
            <div class="wd-badge">🖥️ Web Design</div>
            <h1><span class="text-gradient">Professional Web Design</span></h1>
            <p class="hero-subtitle">Custom, responsive websites built to convert visitors into loyal customers and grow your business.</p>
            <div class="wd-hero-ctas">
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Get a Free Quote</a>
                <a href="#wd-pricing" class="btn btn-ghost btn-pill">View Pricing ↓</a>
            </div>
        </div>
    </section>

    <!-- ===== SERVICE TYPES ===== -->
    <section class="wd-types section-padding">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{servicesSection.heading || 'What I Build'}</span></h2>
                <p>{servicesSection.subtitle || 'From custom corporate sites to e‑commerce platforms, I craft digital experiences that work.'}</p>
            </div>
            <div class="wd-types-grid">
                {serviceTypes.map((type: any, i: number) => (
                    <div class={`wd-type-card animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="wd-type-icon" set:html={type.iconSvg || '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>'} />
                        <h3>{type.title}</h3>
                        <p>{type.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    {/* ===== PORTFOLIO: real projects, from the CMS ===== */}
    <ServiceProjects
        service="web-design"
        heading="Websites I've built"
        subtitle="Live work, not mockups. Open any project to see what I did and how it turned out."
    />

    <!-- ===== SHOWREEL ===== -->
    {/* Only once there's an actual reel to play: an empty "Coming Soon" player
        on a portfolio section costs more trust than it buys. */}
    {showreel?.videoUrl && !showreel?.isComingSoon && (
        <section class="wd-showreel section-padding" id="wd-showreel">
            <div class="container">
                <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                    <h2><span class="text-gradient">{showreel.heading || 'Showreel'}</span></h2>
                    <p>{showreel.subtitle}</p>
                </div>
                <div class="wd-showreel-container animate-on-scroll slide-up delay-100">
                    <iframe
                        src={showreel.videoUrl}
                        title={showreel.heading || 'Web design showreel'}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        style="width: 100%; aspect-ratio: 16/9; border: 0; border-radius: 16px;"
                    ></iframe>
                </div>
            </div>
        </section>
    )}

    <!-- ===== PORTFOLIO GALLERY ===== -->
    {portfolioGallery?.images && portfolioGallery.images.length > 0 && (
        <section class="section-padding" style="background: rgba(0, 174, 239, 0.02);">
            <div class="container">
                <div class="section-header animate-on-scroll slide-up" style="text-align: center; margin-bottom: 40px;">
                    <h2><span class="text-gradient">{portfolioGallery.heading || 'Work Gallery'}</span></h2>
                    <p>{portfolioGallery.subtitle}</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
                    {portfolioGallery.images.map((item: any, i: number) => (
                        <PortfolioTile media={item.image} index={i} />
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- ===== PROCESS ===== -->
    <section class="wd-process section-padding">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{processSection.heading || 'My Design Process'}</span></h2>
                <p>{processSection.subtitle || 'A streamlined workflow that takes your project from idea to launch.'}</p>
            </div>
            <div class="wd-process-grid">
                {processSteps.map((step: any, i: number) => (
                    <div class={`wd-step animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="wd-step-number">{step.number || String(i + 1).padStart(2, '0')}</div>
                        <h3>{step.title}</h3>
                        <p>{step.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="section-padding" id="wd-pricing">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{pricingSection.heading || 'Web Design Pricing'}</span></h2>
                <p>{pricingSection.subtitle || 'Transparent pricing for websites of any scale. All prices are starting points.'}</p>
            </div>

            <div class="wd-pricing-grid">
                {pricingTiers.map((tier: any, i: number) => (
                    <div class={`wd-pricing-card ${tier.isPopular ? 'wd-popular' : ''} animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        {tier.isPopular && <div class="wd-popular-badge">Most Popular</div>}
                        <h3 class="wd-tier-name">{tier.name}</h3>
                        <div class="wd-tier-price">{tier.price}</div>
                        <div class="wd-tier-cycle">{tier.period}</div>
                        <p class="wd-tier-desc">{tier.description}</p>
                        <ul class="wd-tier-features">
                            {tier.features?.map((f: any) => (
                                <li>{f.feature}</li>
                            ))}
                        </ul>
                        <a href="/contact/" class={`btn ${tier.isPopular ? 'btn-primary glow-effect' : 'btn-ghost'} btn-pill tier-btn`}>
                            {tier.isPopular ? 'Book a Call' : 'Get Started'}
                        </a>
                    </div>
                ))}
            </div>

            <div style="text-align: center; margin-top: 32px;">
                <p style="color: var(--text-muted); font-size: 14px;">{pricingSection.note || '* Prices are starting points. Final pricing depends on project scope, pages, and complexity.'}</p>
            </div>
        </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section-padding" style="background: var(--bg-surface); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);" id="wd-faq">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{faqSection.heading || 'Frequently Asked Questions'}</span></h2>
                <p>{faqSection.subtitle || 'Everything you need to know about my web design process.'}</p>
            </div>

            <div class="wd-faq-list">
                {faqs.map((faq: any) => (
                    <div class="wd-faq-item">
                        <button class="wd-faq-question">{faq.question}</button>
                        <div class="wd-faq-answer">
                            <p>{faq.answer}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- RELATED CASE STUDY -->
    <section class="section-padding" style="padding-top: 0;">
        <div class="container" style="text-align: center;">
            <div style="background: var(--bg-inset); border: 1px solid var(--bg-hover); border-radius: 16px; padding: 40px; max-width: 800px; margin: 0 auto;">
                <h3 style="margin-bottom: 16px;">See My Web Design in Action</h3>
                <p style="color: rgba(255,255,255,0.7); margin-bottom: 24px;">Take a look at how I built modern platforms that increased sales and brand trust.</p>
                <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
                    <a href="/projects/next-gen-ecommerce/" class="btn btn-ghost btn-pill">Read Next-Gen E-commerce →</a>
                    <a href="/projects/revamping-online-store/" class="btn btn-ghost btn-pill">Read Online Store Revamp →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="wd-cta section-padding">
        <div class="container">
            <div class="wd-cta-inner animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">Ready to launch your website?</span></h2>
                <p>Book a free web design consultation and let's talk through your project. No commitment, just a conversation about your goals.</p>
                <div class="wd-cta-buttons">
                    <a href="/offers/web-dev-discount/" class="btn btn-primary btn-pill glow-effect">Get Web Dev Discount</a>
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hi Quadem! I'm interested in your web design services.")}`} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-pill">💬 Chat on WhatsApp</a>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Accordion Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.wd-faq-question').forEach(btn => {
                btn.addEventListener('click', () => {
                    const item = btn.parentElement;
                    const isActive = item.classList.contains('active');
                    // Close all
                    document.querySelectorAll('.wd-faq-item').forEach(i => i.classList.remove('active'));
                    // Toggle current
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });
        });
        
        document.addEventListener('astro:after-swap', () => {
            document.querySelectorAll('.wd-faq-question').forEach(btn => {
                btn.addEventListener('click', () => {
                    const item = btn.parentElement;
                    const isActive = item.classList.contains('active');
                    document.querySelectorAll('.wd-faq-item').forEach(i => i.classList.remove('active'));
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });
        });
    </script>
</BaseLayout>

<style>
    /*
       The zoom on hover used to be an onmouseover attribute writing
       style.transform directly on the <img>. That stopped being reachable when
       the image moved inside a <picture>, and it never belonged in an
       attribute: a hover effect is a stylesheet's job, it does not need
       JavaScript to run before it works, and as CSS it can be turned off for
       anyone who has asked for less motion.
    */
    .q-gallery-tile :global(img) {
        transition: transform 0.3s ease;
    }

    .q-gallery-tile:hover :global(img) {
        transform: scale(1.05);
    }

    @media (prefers-reduced-motion: reduce) {
        .q-gallery-tile :global(img) {
            transition: none;
        }

        .q-gallery-tile:hover :global(img) {
            transform: none;
        }
    }
</style>
