---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceProjects from "../../components/ServiceProjects.astro";
import { payloadFetch, lexicalToHtml, buildPayloadImageUrl, resolveHeroMedia, getPayloadImageSrcset, getPayloadImageSize, resolveVideo } from "../../lib/payload";
import Video from "../../components/Video.astro";
import Picture from "../../components/Picture.astro";
import { resolveSeo } from "../../lib/seo";
import "../../styles/prose.css";

// Server-rendered for instant updates
const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const services = await payloadFetch('services', {
  'where[slug][equals]': slug,
  depth: '1'
});
const service = services[0];

if (!service) {
  return Astro.redirect('/services');
}

const heroMedia = resolveHeroMedia(service);
const heroMediaUrl = heroMedia ? buildPayloadImageUrl(heroMedia) : null;
const heroMediaIsVideo = heroMedia?.mimeType?.startsWith('video');
const heroVideo = resolveVideo(heroMedia);

/*
  The preload has to name the file the <img> below actually chooses, and the
  <img> chooses from a srcset. Pointing it at buildPayloadImageUrl, the full
  size original, meant a phone downloaded that 50KB file at high priority and
  then painted the 12KB 480w version instead: four times the bytes for nothing.

  imagesrcset and imagesizes are what let a preload match a responsive image.
  href is the same 800w file the <img> falls back to, so a browser without that
  support still lands on a file the page uses. All three values are shared with
  the <img> so they cannot drift apart again.
*/
const heroMediaSrc = heroMedia ? (getPayloadImageSize(heroMedia, 'medium') || heroMediaUrl) : null;
const heroMediaSrcset = heroMedia ? getPayloadImageSrcset(heroMedia) : null;
const HERO_MEDIA_SIZES = "(max-width: 640px) 100vw, 800px";

// These pages are driven by the Services collection, whose slugs differ from
// the showUnderServices option values used by the four hand-built service
// landing pages. Map them so a project ticked once appears on both.
const SERVICE_KEY_BY_SLUG: Record<string, string> = {
    'web-design-development': 'web-design',
    'seo-paid-ads': 'seo',
    'branding-graphic-design': 'brand-identity',
    'video-production': 'video-production',
    'digital-marketing-social-media': 'digital-marketing',
};
const serviceKey = SERVICE_KEY_BY_SLUG[service.slug];
const seo = resolveSeo(service, {
  title: `${service.title} | Quadem Digital`,
  description: service.description || "",
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="services" navbarScrolled={true}>
    <Fragment slot="head">
        {heroMediaSrc && !heroMediaIsVideo && (
            <link
                rel="preload"
                as="image"
                href={heroMediaSrc}
                imagesrcset={heroMediaSrcset || undefined}
                imagesizes={heroMediaSrcset ? HERO_MEDIA_SIZES : undefined}
            />
        )}
    </Fragment>
    <section class="service-detail-hero">
        <div class={`container service-detail-hero-grid ${heroMediaUrl ? 'has-media' : ''}`} style={!heroMediaUrl ? 'text-align: center;' : undefined}>
            <div class="service-detail-hero-content">
                {service.iconSvg && (
                    <div class="service-icon-large" style="margin-bottom: 24px; display: inline-block; width: 64px; height: 64px; color: var(--accent-text);" set:html={service.iconSvg} />
                )}
                <h1><span class="text-gradient">{service.title}</span></h1>
                <p class="hero-subtitle" style="margin: 20px auto; max-width: 600px;">{service.description}</p>
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect mt-4">Start Your Project</a>
            </div>

            {heroMediaUrl && (
                <div class="service-detail-hero-media">
                    <div class="service-mockup-wrapper">
                        {heroMediaIsVideo ? (
                            <Video video={heroVideo} mode="background" class="service-mockup-media" />
                        ) : (
                            <Picture image={heroMedia} alt={service.title} sizes={HERO_MEDIA_SIZES} size="medium" width={heroMedia?.width ?? undefined} height={heroMedia?.height ?? undefined} class="service-mockup-media" priority />
                        )}
                    </div>
                </div>
            )}
        </div>
    </section>

    <section class="section-padding">
        <div class="container text-block-section">
            {service.body ? (
                <div class="portable-text-body prose" set:html={lexicalToHtml(service.body)} />
            ) : (
                /*
                  No body yet. This used to say "Detailed service content coming
                  soon", which was live on two services that the services grid,
                  the homepage and the contact form all sell. A visitor who
                  clicked through to read about a service was told to come back
                  later. Say something true and useful instead, and point at the
                  one thing that does answer the question.
                */
                <div class="prose" style="text-align: center;">
                    <p>
                        There is no write-up on this page yet. The quickest way to find out
                        whether this is the right fit is to ask me directly, and I will tell you
                        what it involves and what it costs before you commit to anything.
                    </p>
                    <p>
                        <a href="/contact/">Tell me what you need</a>
                    </p>
                </div>
            )}
        </div>
    </section>

    {serviceKey && <ServiceProjects service={serviceKey} />}

    <section class="section-padding" style="background: rgba(0, 174, 239, 0.02);">
        <div class="container">
            <div class="service-cta-section animate-on-scroll slide-up text-center" style="text-align: center;">
                <h2 style="margin-bottom: 16px;"><span class="text-gradient">Ready to grow your brand?</span></h2>
                <p style="margin-bottom: 32px; color: var(--text-muted);">Book a free strategy call and let's discuss how I can help.</p>
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Book a Free Call</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .service-detail-hero-grid.has-media {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 3rem;
        align-items: center;
        text-align: left;
    }

    .service-detail-hero-media {
        position: relative;
        width: 100%;
        height: 420px;
        perspective: 1200px;
    }

    .service-mockup-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 24px;
        overflow: hidden;
        background: var(--bg-inset);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid var(--border-color);
        box-shadow: -20px 30px 60px -15px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        transform: rotateY(-12deg) rotateX(8deg) rotateZ(8deg) scale(1.03);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
        transform-origin: right center;
        animation: serviceMockupFloat 8s ease-in-out infinite;
    }

    .service-mockup-wrapper:hover {
        transform: translateY(-5px) rotateY(-5deg) rotateX(3deg) rotateZ(3deg) scale(1.06) !important;
        box-shadow: -10px 40px 80px -10px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        animation-play-state: paused;
    }

    @keyframes serviceMockupFloat {
        0%, 100% { transform: translateY(0) rotateY(-12deg) rotateX(8deg) rotateZ(8deg) scale(1.03); }
        50% { transform: translateY(-16px) rotateY(-9deg) rotateX(10deg) rotateZ(10deg) scale(1.03); }
    }

    .service-mockup-media {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    @media (max-width: 992px) {
        .service-detail-hero-grid.has-media {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 2rem;
        }

        .service-detail-hero-media {
            height: 320px;
        }

        .service-mockup-wrapper {
            transform: none;
            animation: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .service-mockup-wrapper {
            animation: none;
        }
    }
</style>
