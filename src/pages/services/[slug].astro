---
import { serviceVisualFor } from '../../lib/serviceVisuals';
import BaseLayout from "../../layouts/BaseLayout.astro";
import PageHero from "../../components/PageHero.astro";
import ServiceProjects from "../../components/ServiceProjects.astro";
import { payloadFetch, lexicalToHtml, resolveHeroMedia, resolveVideo } from "../../lib/payload";
import Video from "../../components/Video.astro";
import { resolveSeo } from "../../lib/seo";
import ServiceEnquiryForm from "../../components/forms/ServiceEnquiryForm.astro";
import ServicePricing from "../../components/ServicePricing.astro";
import "../../styles/prose.css";

// Server-rendered for instant updates
const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}

const services = await payloadFetch('services', {
  'where[slug][equals]': slug,
  depth: '1'
});
const service = services[0];

if (!service) {
  return Astro.redirect('/services');
}

const originalHeroMedia = resolveHeroMedia(service);
const heroMedia = originalHeroMedia?.mimeType?.startsWith('video') ? originalHeroMedia : serviceVisualFor(service.slug) || originalHeroMedia;
const heroMediaIsVideo = heroMedia?.mimeType?.startsWith('video');
const heroVideo = resolveVideo(heroMedia);
const heroProps = {
  headline: service.title,
  eyebrow: 'What I can do for you',
  lede: service.description,
  primaryCta: { label: 'Start Your Project', href: '/contact/' },
  media: heroMedia && !heroMediaIsVideo ? { image: heroMedia, alt: heroMedia.alt || service.title } : null,
  mediaAspectRatio: heroMedia?.width && heroMedia?.height ? heroMedia.width / heroMedia.height : undefined,
};

// These pages are driven by the Services collection, whose slugs differ from
// the showUnderServices option values used by the four hand-built service
// landing pages. Map them so a project ticked once appears on both.
const SERVICE_KEY_BY_SLUG: Record<string, string> = {
    'web-design-development': 'web-design',
    'seo-paid-ads': 'seo',
    'branding-graphic-design': 'brand-identity',
    'video-production': 'video-production',
    'digital-marketing-social-media': 'digital-marketing',
};
const serviceKey = SERVICE_KEY_BY_SLUG[service.slug];
const seo = resolveSeo(service, {
  title: `${service.title} | Quadem Digital`,
  description: service.description || "",
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="services" navbarScrolled={true}>
    {heroMediaIsVideo ? (
      <PageHero {...heroProps}>
        <Video slot="media" video={heroVideo} mode="background" />
      </PageHero>
    ) : <PageHero {...heroProps} />}

    <section class="section-padding" id={slug === 'ai-automation' ? 'intake-workflow' : undefined}>
        <div class="container text-block-section">
            {service.body ? (
                <div class="portable-text-body prose" set:html={lexicalToHtml(service.body)} />
            ) : (
                /*
                  No body yet. This used to say "Detailed service content coming
                  soon", which was live on two services that the services grid,
                  the homepage and the contact form all sell. A visitor who
                  clicked through to read about a service was told to come back
                  later. Say something true and useful instead, and point at the
                  one thing that does answer the question.
                */
                <div class="prose" style="text-align: center;">
                    <p>
                        There is no write-up on this page yet. The quickest way to find out
                        whether this is the right fit is to ask me directly, and I will tell you
                        what it involves and what it costs before you commit to anything.
                    </p>
                    <p>
                        <a href="/contact/">Tell me what you need</a>
                    </p>
                </div>
            )}
        </div>
    </section>

    {/*
        Prices, for the services that keep them in the collection rather than in
        a global of their own. Renders nothing when a service has no tiers, so
        this is safe on every service whether or not it has been priced yet.

        It sits above the projects and the form on purpose: somebody deciding
        whether to enquire wants the number before the gallery, and burying it
        under the work is how two services ended up with no visible price for
        weeks without anyone noticing.
    */}
    <ServicePricing pricing={service.pricingSection} serviceTitle={service.title} />

    {serviceKey && <ServiceProjects service={serviceKey} />}

    {/*
        The enquiry goes here rather than behind a link to /contact/. Somebody
        who has read this far has already answered the contact page's first
        question by being on this page, and sending them off to answer it again
        is where a lot of them stop.
    */}
    <ServiceEnquiryForm service={service} returnTo={`/services/${service.slug}/`} />

    <section class="section-padding" style="background: rgba(0, 174, 239, 0.02);">
        <div class="container">
            <div class="service-cta-section animate-on-scroll slide-up text-center" style="text-align: center;">
                <h2 style="margin-bottom: 16px;"><span class="text-gradient">Would rather talk it through?</span></h2>
                <p style="margin-bottom: 32px; color: var(--text-muted);">Book a free call instead. No commitment, just a conversation about what you are trying to do.</p>
                <a href="/contact/" class="btn btn-ghost btn-pill">Book a free call</a>
            </div>
        </div>
    </section>
</BaseLayout>
