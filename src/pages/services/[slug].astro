---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch, lexicalToHtml, buildPayloadImageUrl, resolveHeroMedia, getPayloadImageSrcset, getPayloadImageSize } from "../../lib/payload";

// Server-rendered for instant updates
const { slug } = Astro.params;
const services = await payloadFetch('services', {
  'where[slug][equals]': slug,
  depth: '1'
});
const service = services[0];

if (!service) {
  return Astro.redirect('/services');
}

const heroMedia = resolveHeroMedia(service);
const heroMediaUrl = heroMedia ? buildPayloadImageUrl(heroMedia) : null;
const heroMediaIsVideo = heroMedia?.mimeType?.startsWith('video');
---
<BaseLayout title={`${service.title} | Quadem Digital`} description={service.description || ""} activePage="services" navbarScrolled={true}>
    <fragment slot="head">
        {heroMediaUrl && !heroMediaIsVideo && (
            <link rel="preload" as="image" href={heroMediaUrl} />
        )}
    </fragment>
    <section class="service-detail-hero">
        <div class={`container service-detail-hero-grid ${heroMediaUrl ? 'has-media' : ''}`} style={!heroMediaUrl ? 'text-align: center;' : undefined}>
            <div class="service-detail-hero-content">
                {service.iconSvg && (
                    <div class="service-icon-large" style="margin-bottom: 24px; display: inline-block; width: 64px; height: 64px; color: var(--accent);" set:html={service.iconSvg} />
                )}
                <h1><span class="text-gradient">{service.title}</span></h1>
                <p class="hero-subtitle" style="margin: 20px auto; max-width: 600px;">{service.description}</p>
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect mt-4">Start Your Project</a>
            </div>

            {heroMediaUrl && (
                <div class="service-detail-hero-media">
                    <div class="service-mockup-wrapper">
                        {heroMediaIsVideo ? (
                            <video src={heroMediaUrl} autoplay loop muted playsinline class="service-mockup-media"></video>
                        ) : (
                            <img src={getPayloadImageSize(heroMedia, 'medium') || heroMediaUrl} srcset={getPayloadImageSrcset(heroMedia) || undefined} sizes="(max-width: 640px) 100vw, 800px" alt={service.title} class="service-mockup-media" loading="eager" fetchpriority="high" />
                        )}
                    </div>
                </div>
            )}
        </div>
    </section>

    <section class="section-padding">
        <div class="container text-block-section">
            {service.body ? (
                <div class="portable-text-body" set:html={lexicalToHtml(service.body)} />
            ) : (
                <div class="text-block-content" style="text-align: center; color: var(--text-muted); padding: 40px;">
                    <p>Detailed service content coming soon.</p>
                </div>
            )}
        </div>
    </section>

    <section class="section-padding" style="background: rgba(0, 174, 239, 0.02);">
        <div class="container">
            <div class="service-cta-section animate-on-scroll slide-up text-center" style="text-align: center;">
                <h2 style="margin-bottom: 16px;"><span class="text-gradient">Ready to grow your brand?</span></h2>
                <p style="margin-bottom: 32px; color: var(--text-muted);">Book a free strategy call and let's discuss how we can help.</p>
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Book a Free Call</a>
            </div>
        </div>
    </section>
</BaseLayout>

<style>
    .service-detail-hero-grid.has-media {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 3rem;
        align-items: center;
        text-align: left;
    }

    .service-detail-hero-media {
        position: relative;
        width: 100%;
        height: 420px;
        perspective: 1200px;
    }

    .service-mockup-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 24px;
        overflow: hidden;
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: -20px 30px 60px -15px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        transform: rotateY(-12deg) rotateX(8deg) rotateZ(8deg) scale(1.03);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
        transform-origin: right center;
        animation: serviceMockupFloat 8s ease-in-out infinite;
    }

    .service-mockup-wrapper:hover {
        transform: translateY(-5px) rotateY(-5deg) rotateX(3deg) rotateZ(3deg) scale(1.06) !important;
        box-shadow: -10px 40px 80px -10px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        animation-play-state: paused;
    }

    @keyframes serviceMockupFloat {
        0%, 100% { transform: translateY(0) rotateY(-12deg) rotateX(8deg) rotateZ(8deg) scale(1.03); }
        50% { transform: translateY(-16px) rotateY(-9deg) rotateX(10deg) rotateZ(10deg) scale(1.03); }
    }

    .service-mockup-media {
        width: 100%;
        height: 100%;
        object-fit: contain;
    }

    @media (max-width: 992px) {
        .service-detail-hero-grid.has-media {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 2rem;
        }

        .service-detail-hero-media {
            height: 320px;
        }

        .service-mockup-wrapper {
            transform: none;
            animation: none;
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .service-mockup-wrapper {
            animation: none;
        }
    }
</style>
