---
// The service pages driven by the Services collection (AI automation, Growth &
// Performance Marketing), in the new style (26 Oct 2026): the CMS body is split
// at its own h2 headings into the shared layout's parts by fromServiceBody()
// (src/lib/services/svcPage.ts), so the words are still edited in the CMS.
import { serviceVisualFor } from '../../lib/serviceVisuals';
import BaseLayout from "../../layouts/BaseLayout.astro";
import SvcPage from "../../components/service/SvcPage.astro";
import SvcVisual from "../../components/service/SvcVisual.astro";
import { payloadFetch, payloadFetchGlobal, resolveHeroMedia } from "../../lib/payload";
import { resolveSeo } from "../../lib/seo";
import { isRetiredService } from "../../lib/publicSettings.js";
import { fromServiceBody } from "../../lib/services/svcPage";

// Server-rendered for instant updates
const { slug } = Astro.params;
if (!slug) {
  return new Response(null, { status: 404, statusText: 'Not Found' });
}
/* /services/brand-identity/ was a hand-built page until branding was retired
   on 19 October 2026. With the page deleted the address reaches this template,
   and the redirects people actually hit come from the CMS, not the fallback list
   in src/lib/redirects.ts, so it is answered here: one permanent hop to web
   design rather than a temporary one to the services list. */
if (slug === 'brand-identity') {
  return Astro.redirect('/services/web-design/', 301);
}

const services = await payloadFetch('services', {
  'where[slug][equals]': slug,
  depth: '1'
});
const service = services[0];

if (!service) {
  return Astro.redirect('/services');
}
// A retired service keeps its CMS row (see RETIRED_SERVICE_SLUGS) but no page.
if (isRetiredService(service.slug)) {
  return Astro.redirect('/services/web-design/', 301);
}

// The giant word over each part, per service; the small label under it is
// the CMS heading itself.
const WORDS: Record<string, { what: string; extra?: string }> = {
  'ai-automation': { what: 'The assistant', extra: 'The guardrails' },
  'digital-marketing-social-media': { what: 'The campaign' },
};
const words = WORDS[service.slug] || { what: 'What you get' };
const page = fromServiceBody(service, { key: service.slug, whatWord: words.what, extraWord: words.extra });

const cmsMedia = resolveHeroMedia(service);
const media = cmsMedia && !cmsMedia.mimeType?.startsWith('video') ? cmsMedia : serviceVisualFor(service.slug);

// The proof's own number, when its words name one ("in 64 seconds").
const proofText = page.proof?.paragraphs.join(' ') || '';
const proofFigure = proofText.match(/\b(\d+(?:\.\d+)?)\s*(seconds|minutes|leads|%)\b/i);

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "";
const jsonLd = page.faq ? {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: page.faq.items.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
} : undefined;
const seo = resolveSeo(service, {
  title: `${service.title} | Quadem Digital`,
  description: service.description || "",
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="services" headerDark jsonLd={jsonLd}>
    <SvcPage page={page} service={service} returnTo={`/services/${service.slug}/`} whatsappHref={whatsappNumber ? `https://wa.me/${whatsappNumber}` : undefined}>
        {media && <div slot="visual"><SvcVisual media={media} /></div>}
        {page.proof && proofFigure && (
            <div slot="proof" class="dsv-proof-figure">
                <p class="dsv-big"><strong>{proofFigure[1]}</strong> {proofFigure[2]}</p>
                <div class="dsv-proof-words">{page.proof.paragraphs.map((p) => <p>{p}</p>)}</div>
            </div>
        )}
    </SvcPage>
</BaseLayout>
