---
// AI video and reels, in the new style (owner, 26 Oct 2026: the six service
// pages share one layout, src/components/service/SvcPage.astro). Words: the
// videoProductionPage global (video-production.snapshot.json is that global on
// 26 Oct 2026, used only when the CMS cannot be reached). The proof is the
// work itself: the showreel and the gallery, every frame made with AI.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SvcPage from "../../components/service/SvcPage.astro";
import SvcVisual from "../../components/service/SvcVisual.astro";
import Video from "../../components/Video.astro";
import ReelShowcase from "../../components/ReelShowcase.astro";
import { serviceVisuals } from '../../lib/serviceVisuals';
import { payloadFetchGlobal, resolveVideo } from "../../lib/payload";
import { resolveSeo } from "../../lib/seo";
import { fromPageGlobal } from "../../lib/services/svcPage";
import snapshot from "../../lib/services/video-production.snapshot.json";

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "";
const live = await payloadFetchGlobal("videoProductionPage");
const pageData = live?.hero ? live : snapshot;
const page = fromPageGlobal(pageData, { key: 'video-production', whatWord: 'The reel' });
const showreel = live?.showreel || {};
const showreelVideo = resolveVideo(showreel.videoFile);
const showreelRatio = showreelVideo?.width && showreelVideo?.height ? `${showreelVideo.width} / ${showreelVideo.height}` : '9 / 16';
const gallery = live?.portfolioGallery || {};
const hasGallery = Array.isArray(gallery.images) && gallery.images.length > 0;

const jsonLd = page.faq ? {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: page.faq.items.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
} : undefined;
const seo = resolveSeo(pageData, {
  title: "AI Video and Reels | Quadem Digital",
  description: "Reels, ads and product videos made with AI. No shoot day, no crew, your brand on screen.",
});
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="services" headerDark jsonLd={jsonLd}>
    <SvcPage page={page} enquirySlug="video-production" returnTo="/services/video-production/" whatsappHref={whatsappNumber ? `https://wa.me/${whatsappNumber}` : undefined}>
        <div slot="visual"><SvcVisual media={serviceVisuals.content} /></div>
        {(showreelVideo || hasGallery) && (
            <div slot="proof" class="dsv-video-proof">
                {showreelVideo && !showreel.isComingSoon && (
                    <div class="dsv-reel">
                        <p class="dsv-reel-head">{showreel.heading || 'Recent videos'}</p>
                        {showreel.subtitle && <p>{showreel.subtitle}</p>}
                        <Video video={showreelVideo} mode="player" label={showreel.heading || 'Showreel'} style={`width: 100%; aspect-ratio: ${showreelRatio}; border-radius: 16px;`} />
                    </div>
                )}
                {hasGallery && <ReelShowcase items={gallery.images} heading={gallery.heading || 'Work gallery'} subtitle={gallery.subtitle} />}
            </div>
        )}
    </SvcPage>
</BaseLayout>
