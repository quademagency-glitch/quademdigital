---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceProjects from "../../components/ServiceProjects.astro";
import { payloadFetchGlobal, getPayloadImageSize, getPayloadImageSrcset } from "../../lib/payload";

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";

const pageData = await payloadFetchGlobal("videoProductionPage") || {};

const hero = pageData.hero || {};
const servicesSection = pageData.servicesSection || {};
const processSection = pageData.processSection || {};
const pricingSection = pageData.pricingSection || {};
const faqSection = pageData.faqSection || {};
const portfolioGallery = pageData.portfolioGallery || {};
const showreel = pageData.showreel || {};

// 'large' (1200px), not the original — full-bleed background under a heavy
// dark overlay, so the extra detail never reaches the viewer.
const heroMediaUrl = hero.media ? getPayloadImageSize(hero.media, 'large') : null;
const heroBgImage = heroMediaUrl || '/images/service-video.webp';

// Fallback service types
const serviceTypes = servicesSection.services?.length ? servicesSection.services : [
    {
        title: 'Reels & TikToks',
        description: 'Vertical video cut for Instagram, TikTok and YouTube Shorts. Captions burned in, the hook in the first second, sized right for every feed.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="5" y="2" width="14" height="20" rx="2" ry="2"></rect><line x1="12" y1="18" x2="12.01" y2="18"></line></svg>'
    },
    {
        title: 'Video Ads',
        description: 'Short ads for Meta and TikTok, delivered as three or four different hooks so you can test which one brings sales at the lowest cost.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polygon points="23 7 16 12 23 17 23 7"></polygon><rect x="1" y="5" width="15" height="14" rx="2" ry="2"></rect></svg>'
    },
    {
        title: 'Product Videos',
        description: 'Send us photos of what you sell. We turn them into motion, so your product moves on screen instead of sitting still in a feed.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 16V8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16z"></path><polyline points="3.27 6.96 12 12.01 20.73 6.96"></polyline><line x1="12" y1="22.08" x2="12" y2="12"></line></svg>'
    },
    {
        title: 'AI Presenter Videos',
        description: 'A voice and a face on screen without anyone filming. Licensed AI presenters, or your own likeness with your written permission.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path><circle cx="12" cy="7" r="4"></circle></svg>'
    }
];

// Fallback process steps
const processSteps = processSection.steps?.length ? processSection.steps : [
    { number: '01', title: 'Brand kit', description: 'You send your logo, colours, product photos and the offer you want pushed. We set it up once and reuse it on every video after that.' },
    { number: '02', title: 'Script & hooks', description: 'We write the script and two or three opening hooks, and you approve them before anything is made. This is the stage where changes are cheap.' },
    { number: '03', title: 'We generate & edit', description: 'We generate the visuals and voiceover with AI, then edit by hand: pacing, captions, your logo, your colours, licensed music.' },
    { number: '04', title: 'You approve & post', description: 'You review, we fix what you flag, then you get the files sized for every platform. Nothing publishes without your yes.' }
];

// Fallback pricing. One one-off pack to try it, then the three monthly plans
// carried over from Brand Studio when that page was folded into this one.
const pricingTiers = pricingSection.plans?.length ? pricingSection.plans : [
    {
        name: 'Reel Pack',
        price: 'GH₵ 1,500',
        period: 'one-off · 3 reels',
        description: 'Try it once. Three reels made with AI, no subscription and no commitment.',
        isPopular: false,
        features: [{feature: '3 AI reels (up to 30 seconds each)'}, {feature: 'Script and 2 hook options per reel'}, {feature: 'Burned-in captions, your logo and your colours'}, {feature: 'AI voiceover or licensed music'}, {feature: '2 revision rounds'}, {feature: 'Sized for Reels, TikTok and Shorts (9:16, 1:1, 16:9)'}, {feature: 'Delivered in about 5 working days'}]
    },
    {
        name: 'Starter',
        price: 'GH₵ 1,800',
        period: 'per month',
        description: 'Stay consistent on one platform without doing it yourself.',
        isPopular: false,
        features: [{feature: '4 short-form videos (reels) / month'}, {feature: '12 branded posts / month'}, {feature: '1 platform of your choice'}, {feature: 'Monthly content calendar'}]
    },
    {
        name: 'Growth',
        price: 'GH₵ 3,500',
        period: 'per month',
        description: 'Content that keeps posting and ads that bring in sales.',
        isPopular: true,
        features: [{feature: '6 short-form videos (reels) / month'}, {feature: '20 branded posts / month'}, {feature: '8 ad creatives for testing'}, {feature: '2 to 3 platforms, cross-posted'}, {feature: 'Monthly performance report'}]
    },
    {
        name: 'Scale',
        price: 'GH₵ 8,000',
        period: 'per month',
        description: 'Full coverage across every platform for brands growing fast.',
        isPopular: false,
        features: [{feature: '10 short-form videos (reels) / month'}, {feature: '30 branded posts / month'}, {feature: '12 ad creatives + paid-ad creative'}, {feature: 'All platforms covered'}, {feature: 'Advanced analytics & reporting'}]
    }
];

// The card component only knows `isPopular`. Sniffing `period` tells the
// one-off pack apart from the monthly plans without adding a CMS field, which
// would mean a new Postgres column and a migration for one boolean. Keep
// `period` starting with "one-off" on that plan and nothing else.
const isOneOff = (period: string = '') => period.toLowerCase().startsWith('one-off');
// Returns null rather than defaulting to "Monthly", so a plan whose period the
// CMS hasn't been updated to match ("per project", "starting at") shows no
// kicker instead of a wrong one.
const billingKicker = (period: string = '') => {
    if (isOneOff(period)) return 'One-off';
    if (period.toLowerCase().includes('month')) return 'Monthly';
    return null;
};

// Fallback FAQs
const faqs = faqSection.faqs?.length ? faqSection.faqs : [
    { question: 'Do you film anything?', answer: 'No. There is no shoot, no camera, no crew and no location to book. Everything is made with AI tools and edited by hand. That is exactly why it costs a fraction of a shoot and lands in days instead of weeks.' },
    { question: 'Will it look fake?', answer: 'Some AI video does. Ours does not go out until it looks right. We keep shots short, we use your real product photos wherever the product is on screen, and we cut anything that reads as odd. If a scene still looks wrong to you, we replace it. You see everything before it publishes.' },
    { question: 'Do you use my actual products and branding?', answer: 'Yes. Send your logo, colours, fonts and product photos once and we build every video from them. Your product appears as your product, not a generic stand-in. If you have no photos yet we can generate product-accurate visuals, but real photos always come out better.' },
    { question: 'Can you put me, or my staff, in the videos?', answer: 'Only with written permission. If you want your own face or voice used, you sign a short consent form and send us the reference material. Otherwise we use licensed AI presenters that are cleared for commercial use. We never use anybody\'s likeness without their say-so.' },
    { question: 'How many revisions do I get, and how fast is it?', answer: 'Two revision rounds on every video, one at the script stage and one on the final cut. A one-off pack of three reels takes about five working days. Monthly plans run to a calendar you approve at the start of the month, so you always know what is coming and when.' },
    { question: 'Who owns the videos, and can I run them as paid ads?', answer: 'You do, once the invoice is paid. Full commercial rights, ads included. The music and any AI presenters are licensed for commercial use, so nothing gets pulled for a rights claim later.' }
];

// FAQ structured data for rich results. This moved here from the Brand Studio
// page when that was retired — without it the site loses the FAQ rich result.
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f: any) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
};
---
<BaseLayout
    title="AI Video & Reels for Ghanaian Brands | Quadem Digital"
    description="Short-form video made with AI, with no camera crew and no shoot day. Reels, ads and product videos for your brand from GHS 1,500, or 4 to 10 reels every month."
    activePage="services"
    navbarScrolled={true}
    jsonLd={jsonLd}
>
    <Fragment slot="head">
        <style>
            /* ===== VIDEO HERO ===== */
            .vp-hero {
                position: relative;
                min-height: 85vh;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 120px 20px 80px;
                overflow: hidden;
            }

            .vp-hero-bg {
                position: absolute;
                inset: 0;
                background-size: cover;
                background-position: center;
                z-index: -2;
            }

            .vp-hero-bg::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg,
                    rgba(5, 8, 20, 0.85) 0%,
                    rgba(5, 8, 20, 0.7) 50%,
                    rgba(5, 8, 20, 0.95) 100%
                );
                z-index: -1;
            }

            .vp-hero-content {
                max-width: 800px;
                position: relative;
                z-index: 1;
            }

            .vp-badge {
                display: inline-block;
                padding: 6px 20px;
                border-radius: 50px;
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 2px;
                color: var(--accent-text);
                border: 1px solid rgba(0, 174, 239, 0.3);
                background: rgba(0, 174, 239, 0.08);
                margin-bottom: 24px;
            }

            .vp-hero h1 {
                font-size: clamp(36px, 5vw, 64px);
                margin-bottom: 24px;
                line-height: 1.1;
            }

            .vp-hero .hero-subtitle {
                font-size: 18px;
                color: var(--text-muted);
                max-width: 600px;
                margin: 0 auto 40px;
                line-height: 1.6;
            }

            .vp-hero-ctas {
                display: flex;
                gap: 16px;
                justify-content: center;
                flex-wrap: wrap;
            }

            /* ===== SERVICE TYPES GRID ===== */
            .vp-types {
                background: var(--bg-surface);
                border-top: 1px solid var(--border-color);
                border-bottom: 1px solid var(--border-color);
            }

            .vp-types-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: 24px;
            }

            .vp-type-card {
                background: var(--bg-inset);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 40px 28px;
                text-align: center;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }

            .vp-type-card:hover {
                border-color: rgba(0, 174, 239, 0.4);
                transform: translateY(-6px);
                box-shadow: 0 20px 40px rgba(0, 174, 239, 0.08);
            }

            .vp-type-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background: linear-gradient(90deg, transparent, var(--accent), transparent);
                opacity: 0;
                transition: opacity 0.3s ease;
            }

            .vp-type-card:hover::before {
                opacity: 1;
            }

            .vp-type-icon {
                width: 64px;
                height: 64px;
                margin: 0 auto 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(0, 174, 239, 0.1);
                border-radius: 16px;
                color: var(--accent-text);
            }

            .vp-type-card h3 {
                font-size: 20px;
                margin-bottom: 12px;
            }

            .vp-type-card p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.6;
            }

            /* ===== SHOWREEL ===== */
            .vp-showreel {
                position: relative;
                overflow: hidden;
            }

            .vp-showreel-container {
                max-width: 900px;
                margin: 0 auto;
            }

            .vp-player {
                position: relative;
                aspect-ratio: 16/9;
                background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-card) 50%, var(--bg-surface) 100%);
                border-radius: 16px;
                border: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 20px;
                overflow: hidden;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
            }

            .vp-player::before {
                content: '';
                position: absolute;
                inset: -1px;
                border-radius: 17px;
                padding: 1px;
                background: linear-gradient(135deg, rgba(0, 174, 239, 0.3), transparent 40%, transparent 60%, rgba(0, 174, 239, 0.3));
                -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                pointer-events: none;
            }

            .vp-play-btn {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                background: rgba(0, 174, 239, 0.15);
                border: 2px solid var(--accent);
                display: flex;
                align-items: center;
                justify-content: center;
                color: var(--accent-text);
                transition: all 0.3s ease;
                cursor: default;
            }

            .vp-play-btn svg {
                margin-left: 4px;
            }

            .vp-player-label {
                font-family: var(--font-heading);
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 3px;
                color: var(--text-muted);
            }

            .vp-coming-soon {
                font-size: 12px;
                color: var(--text-subtle);
                font-style: italic;
            }

            /* ===== PROCESS ===== */
            .vp-process {
                background: var(--bg-surface);
                border-top: 1px solid var(--border-color);
                border-bottom: 1px solid var(--border-color);
            }

            .vp-process-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 32px;
                position: relative;
            }

            .vp-step {
                text-align: center;
                position: relative;
            }

            .vp-step-number {
                width: 56px;
                height: 56px;
                background: var(--bg-page);
                border: 2px solid var(--accent);
                color: var(--accent-text);
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-family: var(--font-heading);
                font-weight: 700;
                margin: 0 auto 20px;
                box-shadow: 0 0 20px rgba(0, 174, 239, 0.15);
            }

            .vp-step h3 {
                font-size: 18px;
                margin-bottom: 8px;
            }

            .vp-step p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.5;
            }

            /* Connecting line between steps */
            @media (min-width: 992px) {
                .vp-step:not(:last-child)::after {
                    content: '';
                    position: absolute;
                    top: 28px;
                    right: -16px;
                    width: 32px;
                    height: 2px;
                    background: repeating-linear-gradient(to right, transparent, transparent 3px, var(--accent) 3px, var(--accent) 8px);
                    opacity: 0.3;
                }
            }

            /* ===== PRICING ===== */
            /* Four tiers now, not three: one one-off pack plus three monthly
               plans. The old repeat(3, 1fr) at 992px orphaned the fourth card
               onto a row of its own at every desktop width. */
            .vp-pricing-grid {
                display: grid;
                grid-template-columns: 1fr;
                gap: 24px;
                align-items: stretch;
            }

            /* Two up first, so the monthly plans stay comparable side by side
               before there is room for all four. */
            @media (min-width: 720px) {
                .vp-pricing-grid {
                    grid-template-columns: repeat(2, 1fr);
                }
            }

            /* Four across only above 1100px. Below that, four columns inside
               the 1200px container squeeze each feature line to two or three
               words. */
            @media (min-width: 1100px) {
                .vp-pricing-grid {
                    grid-template-columns: repeat(4, 1fr);
                    gap: 20px;
                }
            }

            .vp-pricing-card {
                background: var(--bg-surface);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 48px 32px;
                text-align: center;
                transition: all 0.3s ease;
                box-shadow: var(--shadow-sm);
                display: flex;
                flex-direction: column;
            }

            .vp-pricing-card:hover {
                transform: translateY(-5px);
                border-color: var(--border-strong);
                box-shadow: var(--shadow-md);
            }

            .vp-pricing-card.vp-popular {
                background: var(--bg-card);
                border-color: var(--accent);
                transform: scale(1.05);
                position: relative;
                padding: 64px 32px;
                z-index: 2;
                box-shadow: var(--shadow-glow);
            }

            .vp-pricing-card.vp-popular:hover {
                transform: scale(1.05) translateY(-5px);
            }

            .vp-popular-badge {
                position: absolute;
                top: 0;
                left: 50%;
                transform: translate(-50%, -50%);
                background: var(--accent);
                color: #000;  /* theme-exempt: dark text on an accent-filled control; must not invert */
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 6px 16px;
                border-radius: 50px;
            }

            .vp-tier-name {
                font-size: 24px;
                margin-bottom: 16px;
            }

            .vp-tier-price {
                font-size: 40px;
                font-family: var(--font-heading);
                font-weight: 700;
                color: var(--text-primary);
                margin-bottom: 8px;
            }

            .vp-tier-cycle {
                font-size: 14px;
                color: var(--text-muted);
                margin-bottom: 24px;
            }

            .vp-tier-desc {
                font-size: 14px;
                color: var(--text-muted);
                margin-bottom: 32px;
                min-height: 42px;
            }

            .vp-tier-features {
                list-style: none;
                margin-bottom: 40px;
                text-align: left;
                flex-grow: 1;
            }

            .vp-tier-features li {
                font-size: 15px;
                margin-bottom: 14px;
                padding-left: 28px;
                position: relative;
                color: var(--text-muted);
            }

            .vp-tier-features li::before {
                content: '✓';
                position: absolute;
                left: 0;
                color: var(--accent-text);
                font-weight: bold;
            }

            /* A dashed edge and a sunken surface stop the one-off pack reading
               as "the cheap monthly plan" beside GH₵ 1,800/mo. */
            .vp-pricing-card.vp-oneoff {
                border-style: dashed;
                background: var(--bg-inset);
            }

            .vp-billing-kicker {
                align-self: center;
                font-size: 11px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                color: var(--text-muted);
                border: 1px solid var(--border-color);
                border-radius: 50px;
                padding: 4px 12px;
                margin-bottom: 12px;
            }

            .vp-pricing-card.vp-oneoff .vp-billing-kicker {
                color: var(--accent-text);
                border-color: rgba(0, 174, 239, 0.35);  /* theme-exempt: accent tint, reads on both surfaces */
            }

            /* At 4-up each card is ~265px wide. The 3-up padding and price size
               no longer fit, and the popular card's scale() would eat the gap
               now that it has neighbours on both sides. */
            @media (min-width: 1100px) {
                .vp-pricing-card {
                    padding: 40px 22px;
                }

                .vp-pricing-card.vp-popular {
                    padding: 52px 22px;
                    transform: none;
                }

                .vp-pricing-card.vp-popular:hover {
                    transform: translateY(-5px);
                }

                .vp-tier-price {
                    font-size: 32px;
                }

                .vp-tier-features li {
                    font-size: 14px;
                }
            }

            /* ===== FAQ ===== */
            .vp-faq-list {
                max-width: 800px;
                margin: 0 auto;
            }

            .vp-faq-item {
                border-bottom: 1px solid var(--border-color);
            }

            .vp-faq-question {
                width: 100%;
                background: transparent;
                border: none;
                color: var(--text-primary);
                font-family: var(--font-heading);
                font-size: 18px;
                font-weight: 600;
                padding: 24px 40px 24px 0;
                text-align: left;
                cursor: pointer;
                position: relative;
                transition: color 0.2s ease;
            }

            .vp-faq-question:hover {
                color: var(--accent-text);
            }

            .vp-faq-question::after {
                content: '+';
                position: absolute;
                right: 0;
                top: 50%;
                transform: translateY(-50%);
                font-size: 24px;
                color: var(--accent-text);
                transition: transform 0.3s ease;
            }

            .vp-faq-item.active .vp-faq-question::after {
                content: '−';
                transform: translateY(-50%) rotate(0deg);
            }

            .vp-faq-answer {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s ease, padding 0.3s ease;
                padding: 0;
            }

            .vp-faq-item.active .vp-faq-answer {
                max-height: 300px;
                padding-bottom: 24px;
            }

            .vp-faq-answer p {
                font-size: 15px;
                line-height: 1.7;
                color: var(--text-muted);
            }

            /* ===== CTA ===== */
            .vp-cta {
                background: rgba(0, 174, 239, 0.03);
                border-top: 1px solid var(--border-color);
            }

            .vp-cta-inner {
                max-width: 700px;
                margin: 0 auto;
                text-align: center;
            }

            .vp-cta-inner h2 {
                margin-bottom: 16px;
            }

            .vp-cta-inner p {
                color: var(--text-muted);
                margin-bottom: 32px;
                font-size: 17px;
            }

            .vp-cta-buttons {
                display: flex;
                gap: 16px;
                justify-content: center;
                flex-wrap: wrap;
            }

            /* ===== RESPONSIVE ===== */
            @media (max-width: 768px) {
                .vp-hero {
                    min-height: 70vh;
                    padding: 100px 20px 60px;
                }

                .vp-pricing-card.vp-popular {
                    transform: scale(1);
                    padding: 48px 32px;
                }

                .vp-pricing-card.vp-popular:hover {
                    transform: translateY(-5px);
                }
            }
        </style>
    </Fragment>

    <!-- ===== HERO ===== -->
    <section class="vp-hero">
        <div class="vp-hero-bg" style={`background-image: url('${heroBgImage}');`}></div>
        <div class="vp-hero-content animate-on-scroll slide-up">
            <div class="vp-badge">✨ AI Video & Reels</div>
            <h1><span class="text-gradient">AI Video &amp; Reels that keep your brand posting, with no shoot day</span></h1>
            <p class="hero-subtitle">Every reel is built with AI from your logo, your products and your offer. No camera, no crew, nothing for you to organise. You approve the script, we deliver video you can post the same week.</p>
            <div class="vp-hero-ctas">
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Get a Free Quote</a>
                <a href="#vp-pricing" class="btn btn-ghost btn-pill">View Pricing ↓</a>
            </div>
        </div>
    </section>

    <!-- ===== SERVICE TYPES ===== -->
    <section class="vp-types section-padding">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{servicesSection.heading || 'What we make'}</span></h2>
                <p>{servicesSection.subtitle || 'Short-form video for the places your customers actually scroll.'}</p>
            </div>

            <div class="vp-types-grid">
                {serviceTypes.map((type: any, i: number) => (
                    <div class={`vp-type-card animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="vp-type-icon" set:html={type.iconSvg || '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>'} />
                        <h3>{type.title}</h3>
                        <p>{type.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== PORTFOLIO — real projects, from the CMS ===== -->
    <ServiceProjects
        service="video-production"
        heading="Video work we've delivered"
        subtitle="Real projects we've made and shipped. Open any one to see the result."
        accentGradient="linear-gradient(90deg, #ffab00, #ff8c00)"
    />

    <!-- ===== SHOWREEL ===== -->
    {/* Only once there's an actual reel to play — an empty "Coming Soon" player
        on a page selling video costs more trust than it buys. */}
    {showreel?.videoUrl && !showreel?.isComingSoon && (
        <section class="vp-showreel section-padding">
            <div class="container">
                <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                    <h2><span class="text-gradient">{showreel.heading || 'Our Showreel'}</span></h2>
                    <p>{showreel.subtitle}</p>
                </div>

                <div class="vp-showreel-container animate-on-scroll slide-up delay-100">
                    <iframe
                        src={showreel.videoUrl}
                        title={showreel.heading || 'Showreel'}
                        loading="lazy"
                        allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture"
                        allowfullscreen
                        style="width: 100%; aspect-ratio: 16/9; border: 0; border-radius: 16px;"
                    ></iframe>
                </div>
            </div>
        </section>
    )}

    <!-- ===== PORTFOLIO GALLERY ===== -->
    {portfolioGallery?.images && portfolioGallery.images.length > 0 && (
        <section class="section-padding" style="background: rgba(255, 171, 0, 0.02);">
            <div class="container">
                <div class="section-header animate-on-scroll slide-up" style="text-align: center; margin-bottom: 40px;">
                    <h2><span class="text-gradient" style="background: linear-gradient(90deg, #ffab00, #ff8c00); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{portfolioGallery.heading || 'Our Work Gallery'}</span></h2>
                    <p>{portfolioGallery.subtitle}</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
                    {portfolioGallery.images.map((item: any, i: number) => {
                        const imgUrl = item.image ? getPayloadImageSize(item.image, 'medium') : null;
                        if (!imgUrl) return null;
                        return (
                            <div class={`animate-on-scroll slide-up delay-${(i % 4 + 1) * 100}`} style="border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; background: #111;">
                                <img src={imgUrl} srcset={getPayloadImageSrcset(item.image) || undefined} sizes="(max-width: 640px) 100vw, 400px" width="800" height="600" alt={item.image?.alt || 'Portfolio item'} style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" loading="lazy" decoding="async" />
                            </div>
                        );
                    })}
                </div>
            </div>
        </section>
    )}

    <!-- ===== PROCESS ===== -->
    <section class="vp-process section-padding">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{processSection.heading || 'How it works'}</span></h2>
                <p>{processSection.subtitle || 'Four steps, no shoot day, and nothing goes out without your sign-off.'}</p>
            </div>

            <div class="vp-process-grid">
                {processSteps.map((step: any, i: number) => (
                    <div class={`vp-step animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="vp-step-number">{step.number || String(i + 1).padStart(2, '0')}</div>
                        <h3>{step.title}</h3>
                        <p>{step.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="section-padding" id="vp-pricing">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{pricingSection.heading || 'AI Video & Reels pricing'}</span></h2>
                <p>{pricingSection.subtitle || 'One batch to try it, or a monthly plan that keeps you posting. Prices in Ghana Cedis, MoMo and bank transfer accepted.'}</p>
            </div>

            <div class="vp-pricing-grid">
                {pricingTiers.map((tier: any, i: number) => (
                    <div class={`vp-pricing-card ${tier.isPopular ? 'vp-popular' : ''} ${isOneOff(tier.period) ? 'vp-oneoff' : ''} animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        {tier.isPopular && <div class="vp-popular-badge">Most Popular</div>}
                        {billingKicker(tier.period) && <span class="vp-billing-kicker">{billingKicker(tier.period)}</span>}
                        <h3 class="vp-tier-name">{tier.name}</h3>
                        <div class="vp-tier-price">{tier.price}</div>
                        <div class="vp-tier-cycle">{tier.period}</div>
                        <p class="vp-tier-desc">{tier.description}</p>
                        <ul class="vp-tier-features">
                            {tier.features?.map((f: any) => (
                                <li>{f.feature}</li>
                            ))}
                        </ul>
                        <a href="/contact/" class={`btn ${tier.isPopular ? 'btn-primary glow-effect' : 'btn-ghost'} btn-pill tier-btn`}>
                            {tier.isPopular ? 'Book a Call' : 'Get Started'}
                        </a>
                    </div>
                ))}
            </div>

            <div style="text-align: center; margin-top: 32px;">
                <p style="color: var(--text-muted); font-size: 14px;">{pricingSection.note || '* One-off packs are billed up front. Monthly plans are billed monthly and you can cancel anytime. Add-ons: paid-ad management (10 to 15% of ad spend) and one-off launch campaigns.'}</p>
            </div>
        </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section-padding" style="background: var(--bg-surface); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{faqSection.heading || 'Frequently Asked Questions'}</span></h2>
                <p>{faqSection.subtitle || 'The questions people actually ask before buying AI video.'}</p>
            </div>

            <div class="vp-faq-list">
                {faqs.map((faq: any) => (
                    <div class="vp-faq-item">
                        <button class="vp-faq-question">{faq.question}</button>
                        <div class="vp-faq-answer">
                            <p>{faq.answer}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- RELATED OFFER -->
    <section class="section-padding" style="padding-top: 0;">
        <div class="container" style="text-align: center;">
            <div style="background: var(--bg-inset); border: 1px solid var(--bg-hover); border-radius: 16px; padding: 40px; max-width: 800px; margin: 0 auto;">
                <h3 style="margin-bottom: 16px;">Get them posted, not just delivered</h3>
                <p style="color: var(--text-muted); margin-bottom: 24px;">Pair your reels with our social media bonus and we schedule and push them across your platforms too.</p>
                <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
                    <a href="/offers/social-media-bonus/" class="btn btn-primary btn-pill glow-effect">Claim Social Media Bonus</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="vp-cta section-padding">
        <div class="container">
            <div class="vp-cta-inner animate-on-scroll slide-up">
                <h2><span class="text-gradient">Ready to stop going quiet?</span></h2>
                <p>Book a free 15-minute call. We'll show you exactly what your first three reels would look like, before you pay anything.</p>
                <div class="vp-cta-buttons">
                    <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Book a Free Consultation</a>
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hi Quadem! I'm interested in your AI Video & Reels service. Can we chat?")}`} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-pill">
                        💬 Chat on WhatsApp
                    </a>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Accordion Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.vp-faq-question').forEach(btn => {
                btn.addEventListener('click', () => {
                    const item = btn.parentElement;
                    const isActive = item.classList.contains('active');
                    // Close all
                    document.querySelectorAll('.vp-faq-item').forEach(i => i.classList.remove('active'));
                    // Toggle current
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });
        });
    </script>
</BaseLayout>
