---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ServiceProjects from "../../components/ServiceProjects.astro";
import { payloadFetchGlobal, getPayloadImageSize, getPayloadImageSrcset } from "../../lib/payload";
import PortfolioTile from "../../components/PortfolioTile.astro";
import { resolveSeo } from "../../lib/seo";

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";

const pageData = await payloadFetchGlobal("seoPage") || {};

const hero = pageData.hero || {};
const servicesSection = pageData.servicesSection || {};
const processSection = pageData.processSection || {};
const pricingSection = pageData.pricingSection || {};
const faqSection = pageData.faqSection || {};
const portfolioGallery = pageData.portfolioGallery || {};
const ctaSection = pageData.ctaSection || {};

// 'medium' (800px), not 'large'. This is a full-bleed background under a heavy
// dark overlay, so most of the detail never reaches the viewer. Measured rather
// than assumed: rendering this hero from the 800px file instead of the 1200px
// one moves 0.2 to 1.1% of pixels by more than 1 part in 85, which is not
// visible, and saves roughly 17KB on every visit.
const heroMediaUrl = hero.media ? getPayloadImageSize(hero.media, 'medium') : null;
const heroBgImage = heroMediaUrl ? `url('${heroMediaUrl}')` : `linear-gradient(135deg, #0a0f25 0%, #0d1a15 100%)`;

// Fallback service types
const serviceTypes = servicesSection.services?.length ? servicesSection.services : [
    {
        title: 'Technical SEO',
        description: 'I make sure search engines can crawl and index your website properly. A fast, error-free site is the foundation of good rankings.',
        iconSvg: '⚙️',
        features: ['Site Speed & Core Web Vitals', 'Mobile Optimization', 'Crawl Error Resolution', 'Schema Markup & Structured Data'].map((feature) => ({ feature }))
    },
    {
        title: 'On-Page SEO',
        description: "I optimize your site's structure, copy, and meta tags to perfectly align with high-intent search queries from your customers.",
        iconSvg: '📄',
        features: ['Deep Keyword Research', 'Meta Title & Description Tuning', 'Content Readability & UX', 'Internal Linking Strategy'].map((feature) => ({ feature }))
    },
    {
        title: 'Local & Off-Page',
        description: 'I build your site\'s authority and prominence across the web so you dominate local "near me" searches and industry queries.',
        iconSvg: '🌍',
        features: ['Google Business Profile Setup', 'Local Directory Citations', 'High-Authority Backlink Building', 'Digital PR & Outreach'].map((feature) => ({ feature }))
    },
    {
        title: 'Content Marketing',
        description: "I create valuable, keyword-rich content that answers your customers' questions and establishes your brand as an industry authority.",
        iconSvg: '✍️',
        features: ['Blog Post Creation', 'Lead Magnets & Whitepapers', 'Copywriting for Landing Pages', 'Content Refreshing'].map((feature) => ({ feature }))
    }
];

// Fallback process steps
const processSteps = processSection.steps?.length ? processSection.steps : [
    { number: '1', title: 'Audit & Strategy', description: 'I dig into your current rankings, competitor gaps and technical health, then build a custom roadmap.' },
    { number: '2', title: 'Technical Fixes', description: 'I repair broken links, improve load times, and ensure search engines can properly read your site.' },
    { number: '3', title: 'Content Deployment', description: 'I deploy keyword-optimized service pages, blog posts, and on-page tweaks to capture high-intent traffic.' },
    { number: '4', title: 'Authority & Reporting', description: 'I build backlinks and provide transparent monthly reports tracking your ranking improvements and ROI.' }
];

// Fallback pricing
const pricingTiers = pricingSection.plans?.length ? pricingSection.plans : [
    {
        name: 'Local SEO',
        price: 'GH₵ 1,500',
        period: '/mo',
        description: 'Perfect for local brick-and-mortar businesses wanting to dominate Google Maps and local searches.',
        isPopular: false,
        features: [{feature: 'Comprehensive Initial Audit'}, {feature: 'Google Business Profile Optimization'}, {feature: '15 Local Directory Citations/mo'}, {feature: 'Basic On-Page SEO (Up to 5 pages)'}, {feature: 'Monthly Keyword Tracking Report'}]
    },
    {
        name: 'Growth SEO',
        price: 'GH₵ 3,500',
        period: '/mo',
        description: 'Comprehensive strategy for growing brands aiming to capture national search traffic and leads.',
        isPopular: true,
        features: [{feature: 'Everything in Local SEO'}, {feature: 'Advanced Technical Fixes'}, {feature: '4x SEO Blog Posts per month'}, {feature: 'Foundational Link Building'}, {feature: 'Competitor Content Gap Analysis'}, {feature: 'Quarterly Strategy Sessions'}]
    },
    {
        name: 'Enterprise',
        price: 'Custom',
        period: '/mo',
        description: 'For large e-commerce stores, news portals, or massive sites requiring highly technical interventions.',
        isPopular: false,
        features: [{feature: 'Custom Crawl Budget Optimization'}, {feature: 'Programmatic SEO Buildout'}, {feature: 'High-Tier Digital PR Backlinks'}, {feature: 'E-commerce Taxonomy Mapping'}, {feature: 'Direct Line to Me, Not a Queue'}]
    }
];

// Fallback FAQs
const faqs = faqSection.faqs?.length ? faqSection.faqs : [
    { question: 'How long does SEO take to see results?', answer: 'Unlike paid ads (PPC), SEO is a long-term strategy. Typically, it takes 3 to 6 months to start seeing significant movement in rankings and organic traffic, depending on your industry\'s competitiveness and your website\'s current history. The results, however, are highly sustainable.' },
    { question: 'Do you guarantee #1 rankings on Google?', answer: 'No ethical SEO agency can guarantee a #1 spot on Google, as Google\'s algorithms constantly change. However, I guarantee that I will implement proven, white-hat strategies that have consistently improved search visibility, traffic, and leads for my clients.' },
    { question: 'Is content creation included in the retainers?', answer: 'Yes. The Growth SEO tier includes four keyword-optimized blog posts a month, written by me. On the Local SEO tier I optimize the content you already have but do not write ongoing posts.' },
    { question: 'What\'s the difference between Local and Growth SEO?', answer: 'Local SEO is designed for businesses serving a specific geographic area (e.g., a plumber in Accra) and focuses heavily on Google Maps and local directories. Growth SEO is for businesses looking to attract a national or global audience through broader keyword targeting, aggressive content marketing, and backlink building.' }
];

// The questions and answers are already on the page. This tells Google they are
// an FAQ, which is what makes them eligible for the expandable block under the
// search result. Same shape the video page already uses.
const jsonLd = {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: faqs.map((f: any) => ({
        "@type": "Question",
        name: f.question,
        acceptedAnswer: { "@type": "Answer", text: f.answer },
    })),
};

const seo = resolveSeo(pageData, {
  title: "SEO & Content Marketing Services | Quadem Digital",
  description: "SEO and paid ad strategies that put your brand in front of the right people and bring in targeted, high-intent traffic that converts.",
});
---

<BaseLayout
    title={seo.title}
    description={seo.description}
    ogImage={seo.ogImage}
    activePage="services"
    navbarScrolled={true}
    jsonLd={jsonLd}
>
    <Fragment slot="head">
        <style>
            /* ===== SEO HERO ===== */
            .seo-hero {
                position: relative;
                min-height: 85vh;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 120px 20px 80px;
                overflow: hidden;
            }

            .seo-hero-bg {
                position: absolute;
                inset: 0;
                background: linear-gradient(135deg, #0a0f25 0%, #0d1a15 100%);  /* theme-exempt: brand hero, dark in both themes */
                /* Was z-index: -2. .seo-hero is position:relative with z-index:
                   auto and so creates no stacking context: a negative-z child
                   escapes to the root context and paints behind the body's
                   opaque rgb(5,8,20) background, so the hero image never
                   rendered at all. */
                z-index: 0;
            }

            .seo-hero-bg::after {
                content: "";
                position: absolute;
                inset: 0;
                /* Keeps this page's green accent wash, but now over a scrim:
                   a radial pool behind the headline, plus a linear that only
                   darkens the navbar strip and the seam below. Without it the
                   newly-visible artwork would sit straight under the type. */
                background:
                    radial-gradient(circle at center, rgba(46, 204, 113, 0.15) 0%, transparent 60%),
                    linear-gradient(180deg,
                        rgba(5, 8, 20, 0.92) 0%,
                        rgba(5, 8, 20, 0) 24%,
                        rgba(5, 8, 20, 0) 70%,
                        rgba(5, 8, 20, 0.94) 100%
                    ),
                    radial-gradient(ellipse 70% 62% at 50% 48%,
                        rgba(5, 8, 20, 0.82) 0%,
                        rgba(5, 8, 20, 0.68) 45%,
                        rgba(5, 8, 20, 0.30) 100%
                    );
                z-index: 1;
            }

            /* This page had no breakpoint at all, so a phone was getting the
               desktop 70% ellipse while the headline ran the full width,
               the outer words sat over bare artwork. */
            @media (max-width: 768px) {
                .seo-hero-bg::after {
                    background:
                        radial-gradient(circle at center, rgba(46, 204, 113, 0.15) 0%, transparent 60%),
                        linear-gradient(180deg,
                            rgba(5, 8, 20, 0.92) 0%,
                            rgba(5, 8, 20, 0.25) 26%,
                            rgba(5, 8, 20, 0.25) 68%,
                            rgba(5, 8, 20, 0.94) 100%
                        ),
                        /* Was 0.88 at the centre, over the 0.25 floor of the
                           linear above: roughly 91% black across the middle of
                           the image, which left the artwork downloaded but not
                           visible. This page's photo is already a dark scene,
                           so it does not need much help to keep white type
                           readable. */
                        radial-gradient(ellipse 130% 60% at 50% 48%,
                            rgba(5, 8, 20, 0.74) 0%,
                            rgba(5, 8, 20, 0.64) 55%,
                            rgba(5, 8, 20, 0.44) 100%
                        );
                }
            }

            .seo-hero-content {
                max-width: 900px;
                /* position:relative is required, not cosmetic: z-index has no
                   effect on a static element, so with .seo-hero-bg raised to 0
                   (a positioned child, painted after in-flow content) the
                   background would render straight over this text. */
                position: relative;
                z-index: 2;
                animation: fadeUp 1s ease forwards;
            }

            .seo-badge {
                display: inline-block;
                padding: 8px 16px;
                border-radius: 50px;
                background: rgba(46, 204, 113, 0.1);
                border: 1px solid rgba(46, 204, 113, 0.2);
                color: #2ecc71;
                font-weight: 600;
                font-size: 0.9rem;
                margin-bottom: 24px;
                letter-spacing: 1px;
                text-transform: uppercase;
            }

            .seo-hero-title {
                /* The floor was 3rem, which is 48px: a desktop size that a
                   clamp can never fall below, so on a 375px screen "Be Found
                   When They Search" ran to three lines and pushed the Free SEO
                   Audit button off the bottom of the viewport. 1.75rem lets it
                   scale down; 6vw takes over above ~470px, so nothing about
                   tablet or desktop changes. */
                font-size: clamp(1.75rem, 6vw, 5.5rem);
                font-weight: 800;
                line-height: 1.1;
                margin-bottom: 24px;
                color: #fff;
            }

            .seo-hero-title .text-gradient {
                background: linear-gradient(90deg, #2ecc71, #27ae60);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }

            /* Was an inline style on the div. Inline styles cannot be
               overridden from a stylesheet, so the shared rule that stacks
               these buttons on a phone could never reach it. */
            .seo-hero-ctas {
                display: flex;
                gap: 16px;
                justify-content: center;
                flex-wrap: wrap;
            }

            .seo-hero-desc {
                font-size: clamp(1.1rem, 2vw, 1.3rem);
                color: rgba(255, 255, 255, 0.7);
                margin-bottom: 40px;
                line-height: 1.6;
                max-width: 700px;
                margin-left: auto;
                margin-right: auto;
            }

            /* Light mode: the brand green is legible on the dark hero but not on a
               light ground, so darken it wherever it is used as text. The hero
               keeps the bright green because it is pinned dark above. */
            :root[data-theme="light"] .metric-number,
            :root[data-theme="light"] .seo-check,
            :root[data-theme="light"] .seo-price-amount {
                color: #17703c;
            }

            /* ===== METRICS ===== */
            .seo-metrics {
                padding: 60px 0;
                background: var(--bg-inset);
                border-top: 1px solid var(--bg-hover);
                border-bottom: 1px solid var(--bg-hover);
            }

            .metrics-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(200px, 1fr));
                gap: 40px;
                text-align: center;
            }

            .metric-number {
                font-size: 3rem;
                font-weight: 800;
                color: #2ecc71;
                margin-bottom: 8px;
            }

            .metric-label {
                font-size: 1rem;
                color: var(--text-muted);
                text-transform: uppercase;
                letter-spacing: 1px;
            }

            /* ===== SERVICES OVERVIEW ===== */
            .seo-services-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                gap: 30px;
                margin-top: 60px;
            }

            .seo-service-card {
                background: var(--bg-inset);
                border: 1px solid var(--bg-hover);
                border-radius: 16px;
                padding: 40px;
                transition: transform 0.3s ease, border-color 0.3s ease;
            }

            .seo-service-card:hover {
                transform: translateY(-5px);
                border-color: rgba(46, 204, 113, 0.3);
                background: rgba(46, 204, 113, 0.02);
            }

            .seo-service-icon {
                font-size: 2.5rem;
                margin-bottom: 24px;
            }

            .seo-service-title {
                font-size: 1.5rem;
                font-weight: 700;
                margin-bottom: 16px;
                color: #fff;
            }

            .seo-service-desc {
                color: rgba(255, 255, 255, 0.6);
                line-height: 1.6;
                margin-bottom: 24px;
            }

            .seo-service-list {
                list-style: none;
                padding: 0;
            }

            .seo-service-list li {
                color: rgba(255, 255, 255, 0.8);
                margin-bottom: 12px;
                display: flex;
                align-items: center;
                gap: 12px;
            }

            .seo-service-list li::before {
                content: "→";
                color: #2ecc71;
                font-weight: bold;
            }

            /* ===== PROCESS ===== */
            .seo-process-timeline {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(250px, 1fr));
                gap: 30px;
                margin-top: 60px;
            }

            .seo-process-step {
                position: relative;
                padding: 30px;
                background: var(--bg-inset);
                border-radius: 12px;
                border-left: 4px solid #2ecc71;
            }

            .seo-step-num {
                font-size: 3rem;
                font-weight: 900;
                color: rgba(46, 204, 113, 0.15);
                position: absolute;
                top: 10px;
                right: 20px;
                line-height: 1;
            }

            /* ===== PRICING ===== */
            .seo-pricing-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(320px, 1fr));
                gap: 30px;
                margin-top: 60px;
            }

            .seo-pricing-card {
                background: var(--bg-inset);
                border: 1px solid var(--bg-hover);
                border-radius: 24px;
                padding: 40px;
                display: flex;
                flex-direction: column;
                position: relative;
                overflow: hidden;
            }

            .seo-pricing-card.popular {
                background: linear-gradient(180deg, rgba(46, 204, 113, 0.05) 0%, var(--bg-inset) 100%);
                border-color: rgba(46, 204, 113, 0.3);
            }

            .seo-popular-badge {
                position: absolute;
                top: 0;
                left: 50%;
                transform: translateX(-50%);
                background: #2ecc71;
                color: #000;  /* theme-exempt: dark text on an accent-filled control; must not invert */
                padding: 6px 20px;
                border-bottom-left-radius: 12px;
                border-bottom-right-radius: 12px;
                font-size: 0.85rem;
                font-weight: 700;
            }

            .seo-tier-name {
                font-size: 1.5rem;
                font-weight: 700;
                margin-bottom: 12px;
                margin-top: 20px;
            }

            .seo-tier-price {
                font-size: 3rem;
                font-weight: 800;
                color: #2ecc71;
                margin-bottom: 8px;
            }

            .seo-tier-period {
                font-size: 1rem;
                color: rgba(255, 255, 255, 0.5);
                font-weight: 400;
            }

            .seo-tier-desc {
                color: rgba(255, 255, 255, 0.6);
                margin-bottom: 30px;
                line-height: 1.5;
            }

            .seo-tier-features {
                list-style: none;
                padding: 0;
                margin-bottom: 40px;
                flex: 1;
            }

            .seo-tier-features li {
                display: flex;
                align-items: flex-start;
                gap: 12px;
                margin-bottom: 16px;
                color: rgba(255, 255, 255, 0.8);
            }

            .seo-tier-features li svg {
                flex-shrink: 0;
                width: 20px;
                height: 20px;
                color: #2ecc71;
                margin-top: 2px;
            }

            /* ===== FAQ ===== */
            .seo-faq-container {
                max-width: 800px;
                margin: 60px auto 0;
            }

            .seo-faq-item {
                background: var(--bg-inset);
                border: 1px solid var(--bg-hover);
                border-radius: 12px;
                margin-bottom: 16px;
                overflow: hidden;
            }

            .seo-faq-question {
                width: 100%;
                background: none;
                border: none;
                padding: 24px;
                display: flex;
                justify-content: space-between;
                align-items: center;
                color: #fff;
                font-size: 1.1rem;
                font-weight: 600;
                cursor: pointer;
                text-align: left;
            }

            .seo-faq-icon {
                font-size: 1.5rem;
                color: #2ecc71;
                transition: transform 0.3s ease;
            }

            .seo-faq-answer {
                padding: 0 24px;
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.3s ease, padding 0.3s ease;
                color: rgba(255, 255, 255, 0.7);
                line-height: 1.6;
            }

            .seo-faq-item.active .seo-faq-answer {
                padding: 0 24px 24px;
                max-height: 300px;
            }

            .seo-faq-item.active .seo-faq-icon {
                transform: rotate(45deg);
            }

            /* Animations */
            @keyframes fadeUp {
                from { opacity: 0; transform: translateY(30px); }
                to { opacity: 1; transform: translateY(0); }
            }
        </style>
    </Fragment>

    <!-- HERO SECTION -->
    <section class="seo-hero">
        <div class="seo-hero-bg" style={`background: ${heroBgImage}; background-size: cover; background-position: center;`}></div>
        <div class="container">
            <div class="seo-hero-content">
                <span class="seo-badge">{hero.badge || 'SEO & Content Marketing'}</span>
                {/*
                  The headline used to gradient only its last word, which meant
                  it could not come from a plain text field without inventing a
                  marker for where the gradient starts. The whole line is
                  gradiented now, the way the other three service heroes already
                  do it, so the CMS field is just the words.
                */}
                <h1 class="seo-hero-title"><span class="text-gradient">{hero.headline || 'Be Found When They Search'}</span></h1>
                <p class="seo-hero-desc">{hero.subtitle || "I don't just chase vanity metrics. I build data-driven SEO and content strategies that increase your visibility, drive qualified traffic, and generate real revenue."}</p>
                <div class="seo-hero-ctas">
                    <a href={`https://wa.me/${whatsappNumber}?text=Hi, I'm interested in an SEO Audit.`} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect" style="background: #2ecc71; border-color: #2ecc71; color: #000;">{hero.primaryCtaText || 'Get a Free SEO Audit'}</a>
                    <a href="#pricing" class="btn btn-ghost btn-pill">{hero.secondaryCtaText || 'View Pricing'}</a>
                </div>
            </div>
        </div>
    </section>

    {/* ===== PORTFOLIO: real projects, from the CMS ===== */}
    <ServiceProjects
        service="seo"
        heading="Search work I've delivered"
        subtitle="Projects where I've done the search and visibility work. Open any one to see what was involved."
        accentGradient="linear-gradient(90deg, #2ecc71, #27ae60)"
    />

    <!-- ===== PORTFOLIO GALLERY ===== -->
    {portfolioGallery?.images && portfolioGallery.images.length > 0 && (
        <section class="section-padding" style="background: rgba(46, 204, 113, 0.02);">
            <div class="container">
                <div class="section-header animate-on-scroll slide-up" style="text-align: center; margin-bottom: 40px;">
                    <h2><span class="text-gradient" style="background: linear-gradient(90deg, #2ecc71, #27ae60); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{portfolioGallery.heading || 'Work Gallery'}</span></h2>
                    <p>{portfolioGallery.subtitle}</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
                    {portfolioGallery.images.map((item: any, i: number) => (
                        <PortfolioTile media={item.image} index={i} />
                    ))}
                </div>
            </div>
        </section>
    )}

    <!-- METRICS STRIP -->
    <section class="seo-metrics">
        <div class="container">
            <div class="metrics-grid">
                <div>
                    <div class="metric-number">93%</div>
                    <div class="metric-label">Online Experiences Begin With Search</div>
                </div>
                <div>
                    <div class="metric-number">75%</div>
                    <div class="metric-label">Never Scroll Past Page One</div>
                </div>
                <div>
                    <div class="metric-number">3x</div>
                    <div class="metric-label">Higher Close Rate Than Outbound</div>
                </div>
            </div>
        </div>
    </section>

    <!-- SERVICES OVERVIEW -->
    <section class="section-padding">
        <div class="container">
            <div class="section-header text-center animate-on-scroll slide-up">
                <h2>{servicesSection.heading || <Fragment>My <span class="text-gradient" style="background: linear-gradient(90deg, #2ecc71, #27ae60); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">SEO Arsenal</span></Fragment>}</h2>
                <p>{servicesSection.subtitle || 'Comprehensive search marketing to dominate every stage of the funnel.'}</p>
            </div>

            <div class="seo-services-grid">
                {serviceTypes.map((type: any, i: number) => (
                    <div class={`seo-service-card animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="seo-service-icon" set:html={type.iconSvg || '⚙️'} />
                        <h3 class="seo-service-title">{type.title}</h3>
                        <p class="seo-service-desc">{type.description}</p>
                        {type.features?.length > 0 && (
                            <ul class="seo-service-list">
                                {type.features.map((f: any) => <li>{f.feature}</li>)}
                            </ul>
                        )}
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- PROCESS -->
    <section class="section-padding" style="background: rgba(46, 204, 113, 0.02);">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up">
                <h2>{processSection.heading || <Fragment>The Ranking <span class="text-gradient" style="background: linear-gradient(90deg, #2ecc71, #27ae60); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">Process</span></Fragment>}</h2>
                <p>{processSection.subtitle || 'How I move your site up the search results.'}</p>
            </div>

            <div class="seo-process-timeline">
                {processSteps.map((step: any, i: number) => (
                    <div class={`seo-process-step animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="seo-step-num">{step.number || (i + 1)}</div>
                        <h3 style="font-size: 1.25rem; margin-bottom: 12px;">{step.title}</h3>
                        <p style="color: rgba(255,255,255,0.7); line-height: 1.5; font-size: 0.95rem;">{step.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- PRICING -->
    <section class="section-padding" id="pricing">
        <div class="container">
            <div class="section-header text-center animate-on-scroll slide-up">
