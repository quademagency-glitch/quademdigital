    <!-- RELATED CASE STUDY -->
    <section class="section-padding" style="padding-top: 0;">
        <div class="container" style="text-align: center;">
            <div style="background: var(--bg-inset); border: 1px solid var(--bg-hover); border-radius: 16px; padding: 40px; max-width: 800px; margin: 0 auto;">
                <h3 style="margin-bottom: 16px;">See My SEO Results in Action</h3>
                <p style="color: rgba(255,255,255,0.7); margin-bottom: 24px;">Discover how I helped a local brand scale their user acquisition through targeted local SEO and brand identity optimization.</p>
                <a href="/projects/brand-identity-local-seo/" class="btn btn-ghost btn-pill">Read the Case Study →</a>
            </div>
        </div>
    </section>

    <script>
        // FAQ Accordion Logic
        document.addEventListener('astro:page-load', () => {
            const faqItems = document.querySelectorAll('.seo-faq-item');
            
            faqItems.forEach(item => {
                const button = item.querySelector('.seo-faq-question');
                button?.addEventListener('click', () => {
                    const isActive = item.classList.contains('active');
                    
                    // Close all others
                    faqItems.forEach(otherItem => {
                        otherItem.classList.remove('active');
                    });
                    
                    // Toggle current
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });
        });
    </script>
</BaseLayout>

<style>
    /*
       The zoom on hover used to be an onmouseover attribute writing
       style.transform directly on the <img>. That stopped being reachable when
       the image moved inside a <picture>, and it never belonged in an
       attribute: a hover effect is a stylesheet's job, it does not need
       JavaScript to run before it works, and as CSS it can be turned off for
       anyone who has asked for less motion.
    */
    .q-gallery-tile :global(img) {
        transition: transform 0.3s ease;
    }

    .q-gallery-tile:hover :global(img) {
        transform: scale(1.05);
    }

    @media (prefers-reduced-motion: reduce) {
        .q-gallery-tile :global(img) {
            transition: none;
        }

        .q-gallery-tile:hover :global(img) {
            transform: none;
        }
    }
</style>
