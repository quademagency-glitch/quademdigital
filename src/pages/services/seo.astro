---
// SEO, in the new style (owner, 26 Oct 2026: the six service pages share one
// layout, src/components/service/SvcPage.astro). Words: the seoPage global
// (seo.snapshot.json is that global on 26 Oct 2026, used only when the CMS
// cannot be reached). The hero button promises a free website check-up, so it
// goes to the check-up page. Price buttons keep their WhatsApp messages. The
// proof is our own published research, labelled as research, not client
// results.
import BaseLayout from "../../layouts/BaseLayout.astro";
import SvcPage from "../../components/service/SvcPage.astro";
import SvcVisual from "../../components/service/SvcVisual.astro";
import { serviceVisuals } from '../../lib/serviceVisuals';
import { payloadFetchGlobal } from "../../lib/payload";
import { resolveSeo } from "../../lib/seo";
import { fromPageGlobal } from "../../lib/services/svcPage";
import snapshot from "../../lib/services/seo.snapshot.json";

const siteSettings = await payloadFetchGlobal("siteSettings");
const whatsappNumber = siteSettings?.whatsappNumber || "";
const live = await payloadFetchGlobal("seoPage");
const pageData = live?.hero ? live : snapshot;
const page = fromPageGlobal(pageData, { key: 'seo', whatWord: 'The groundwork', primaryHref: '/offers/free-seo-audit/' });
const research = pageData.portfolioGallery || {};

const jsonLd = page.faq ? {
    "@context": "https://schema.org",
    "@type": "FAQPage",
    mainEntity: page.faq.items.map((f) => ({ "@type": "Question", name: f.question, acceptedAnswer: { "@type": "Answer", text: f.answer } })),
} : undefined;
const seo = resolveSeo(pageData, {
  title: "SEO That Gets You Found | Quadem Digital",
  description: "Show up on Google when customers search for what you sell.",
});
const priceCtaHref = (tier: any) => {
    const priced = /\d/.test(String(tier.priceUsd ?? tier.price ?? ''));
    const text = priced
        ? `Hello, I would like to start the ${tier.name} retainer.`
        : `Hello, I would like a quote for ${tier.name} SEO.`;
    return `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(text)}`;
};
---
<BaseLayout title={seo.title} description={seo.description} ogImage={seo.ogImage} activePage="services" headerDark scaleUp jsonLd={jsonLd}>
    <SvcPage page={page} enquirySlug="seo-paid-ads" returnTo="/services/seo/" whatsappHref={whatsappNumber ? `https://wa.me/${whatsappNumber}` : undefined}
        priceCtaHref={whatsappNumber ? priceCtaHref : undefined} priceCtaLabel={whatsappNumber ? 'Ask on WhatsApp' : undefined} priceCtaExternal={!!whatsappNumber}>
        <div slot="visual"><SvcVisual media={serviceVisuals.search} /></div>
        <div slot="proof" class="dsv-research">
            {research.subtitle && <p class="dsv-research-lead">{research.subtitle}</p>}
            <ul class="dsv-research-cards">
                <li>
                    <span class="dsv-lab">Published research</span>
                    <b>See how we investigate search performance</b>
                    <p>Read our analysis of three UK skin clinics, with 26 months of search data, the method and its limits. This is independent research, not a client results claim.</p>
                    <a class="dsv-more" href="/blog/uk-aesthetics-search/">Read the search analysis</a>
                </li>
                <li>
                    <span class="dsv-lab">Published research</span>
                    <b>3,928 small business websites, checked</b>
                    <p>We opened every business we found on Google Maps across the UK, the Gulf and the US, and checked eight things about each homepage.</p>
                    <a class="dsv-more" href="/blog/small-business-website-crawl-2026/">Read the crawl study</a>
                </li>
            </ul>
        </div>
    </SvcPage>
</BaseLayout>
