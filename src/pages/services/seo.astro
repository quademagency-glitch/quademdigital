                <p style="color: rgba(255,255,255,0.7); font-size: 1.1rem; max-width: 600px; margin: 0 auto 30px; line-height: 1.6;">{ctaSection.subtitle || "Let's run a comprehensive audit on your website and discover exactly what it takes to get you to page one."}</p>
                <a href="/offers/free-seo-audit/" class="btn btn-primary btn-pill glow-effect" style="font-size: 1.1rem; padding: 16px 32px; background: #2ecc71; border-color: #2ecc71; color: #000;">{ctaSection.primaryButtonText || 'Request Your Free Audit'}</a>
            </div>
