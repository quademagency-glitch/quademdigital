---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetchGlobal, buildPayloadImageUrl } from "../../lib/payload";

const siteSettings = await payloadFetchGlobal('siteSettings');
const whatsappNumber = siteSettings?.whatsappNumber || "1234567890";

const pageData = await payloadFetchGlobal("brandIdentityPage") || {};

const hero = pageData.hero || {};
const servicesSection = pageData.servicesSection || {};
const processSection = pageData.processSection || {};
const pricingSection = pageData.pricingSection || {};
const faqSection = pageData.faqSection || {};
const portfolioGallery = pageData.portfolioGallery || {};

const heroMediaUrl = hero.media ? buildPayloadImageUrl(hero.media) : null;
const heroBgImage = heroMediaUrl || '/images/service-branding.webp';

// Fallback service types
const serviceTypes = servicesSection.services?.length ? servicesSection.services : [
    {
        title: 'Logo Design',
        description: 'Custom logos that capture your brand essence and values perfectly.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M12 2L2 7l10 5 10-5-10-5z"/></svg>'
    },
    {
        title: 'Brand Kit',
        description: 'Complete visual guidelines including color palettes and typography rules.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"/></svg>'
    },
    {
        title: 'Visual Identity',
        description: 'Consistent design language across all physical and digital touchpoints.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="3" y="3" width="18" height="18" rx="2"/></svg>'
    },
    {
        title: 'Graphic Design',
        description: 'Pitch decks, marketing materials, social media templates, and business cards.',
        iconSvg: '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/><path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/></svg>'
    }
];

// Fallback process steps
const processSteps = processSection.steps?.length ? processSection.steps : [
    { number: '01', title: 'Discovery & Strategy', description: "Research, mood boards, and defining your brand's unique positioning." },
    { number: '02', title: 'Concept Development', description: 'Sketching out initial logo ideas, drafts, and establishing visual directions.' },
    { number: '03', title: 'Design & Refinement', description: 'Finalizing the logo, curating color palettes, and selecting typography.' },
    { number: '04', title: 'Delivery & Guidelines', description: 'Handing over all vector files alongside a comprehensive brand guideline document.' }
];

// Fallback pricing
const pricingTiers = pricingSection.plans?.length ? pricingSection.plans : [
    {
        name: 'Logo Design',
        price: 'GH₵ 1,000',
        period: 'starting at',
        description: 'Perfect for startups or new businesses needing a fresh face.',
        isPopular: false,
        features: [{feature: '3 custom logo concepts'}, {feature: '3 revision rounds'}, {feature: 'Primary & secondary logos'}, {feature: 'High-res PNGs and JPGs'}, {feature: 'Vector files (SVG, EPS, AI)'}, {feature: 'Logo usage guide'}, {feature: '1 week delivery'}]
    },
    {
        name: 'Brand Kit',
        price: 'GH₵ 2,500',
        period: 'starting at',
        description: 'Everything you need for a consistent and professional brand.',
        isPopular: true,
        features: [{feature: '5 custom logo concepts'}, {feature: 'Unlimited revisions'}, {feature: 'Color palette selection'}, {feature: 'Typography pairing'}, {feature: 'Comprehensive Brand Guidelines PDF'}, {feature: 'Social media profile assets'}, {feature: 'Business card design'}, {feature: 'All vector & raster files'}, {feature: '2 weeks delivery'}]
    },
    {
        name: 'Full Visual Identity',
        price: 'Custom',
        period: 'per project',
        description: 'A complete design overhaul across all physical and digital mediums.',
        isPopular: false,
        features: [{feature: 'Everything in Brand Kit'}, {feature: 'Custom iconography set'}, {feature: 'Letterhead & envelope design'}, {feature: 'Email signature design'}, {feature: 'Presentation (Pitch Deck) template'}, {feature: 'Social media post templates'}, {feature: 'Brand strategy consultation'}, {feature: 'Dedicated art director'}]
    }
];

// Fallback FAQs
const faqs = faqSection.faqs?.length ? faqSection.faqs : [
    { question: 'What is a Brand Kit?', answer: 'A Brand Kit is a digital package that contains your company\'s core visual assets. It typically includes your primary and secondary logos, a defined color palette with HEX/RGB codes, typography pairings, and a rulebook (Brand Guidelines) on how to use these assets correctly to maintain consistency.' },
    { question: 'Why do I need more than just a logo?', answer: 'A logo is just one piece of your brand\'s identity. To build trust and recognition, your brand needs to look consistent across your website, social media, printed materials, and emails. A full brand identity ensures that whether a customer sees an Instagram post or a business card, they instantly recognize your company.' },
    { question: 'Will I own the rights to the designs?', answer: 'Yes. Once the project is completed and final payment is made, you will have full ownership and copyright of the final logo and all associated brand assets.' },
    { question: 'What if I don\'t like any of the initial concepts?', answer: 'Before we start designing, we go through a rigorous discovery and mood-boarding phase to align on the visual direction. In the rare case that the initial concepts miss the mark, we will revisit the drawing board and provide new concepts based on your detailed feedback.' },
    { question: 'Do you offer printing services?', answer: 'We primarily operate as a digital design agency and provide print-ready digital files (PDF, EPS, AI). However, we can coordinate with our trusted local printing partners to handle the printing of your business cards, letterheads, and merchandise upon request.' }
];
---

<BaseLayout
    title="Professional Brand Identity & Graphic Design Services | Quadem Digital"
    description="Distinct visual identities: logos, brand systems and graphic design that keep your brand memorable and consistent across every touchpoint."
    activePage="services"
    navbarScrolled={true}>
    <fragment slot="head">
        <style>
            /* ===== BRAND IDENTITY HERO ===== */
            .bp-hero {
                position: relative;
                min-height: 85vh;
                display: flex;
                align-items: center;
                justify-content: center;
                text-align: center;
                padding: 120px 20px 80px;
                overflow: hidden;
            }
            .bp-hero-bg {
                position: absolute;
                inset: 0;
                background-size: cover;
                background-position: center;
                z-index: -2;
            }
            .bp-hero-bg::after {
                content: '';
                position: absolute;
                inset: 0;
                background: linear-gradient(180deg,
                    rgba(5, 8, 20, 0.85) 0%,
                    rgba(5, 8, 20, 0.7) 50%,
                    rgba(5, 8, 20, 0.95) 100%
                );
                z-index: -1;
            }
            .bp-hero-content {
                max-width: 800px;
                position: relative;
                z-index: 1;
            }
            .bp-badge {
                display: inline-block;
                padding: 6px 20px;
                border-radius: 50px;
                font-size: 12px;
                font-weight: 600;
                text-transform: uppercase;
                letter-spacing: 2px;
                color: #9b59b6;
                border: 1px solid rgba(155, 89, 182, 0.3);
                background: rgba(155, 89, 182, 0.08);
                margin-bottom: 24px;
            }
            .bp-hero h1 {
                font-size: clamp(36px, 5vw, 64px);
                margin-bottom: 24px;
                line-height: 1.1;
            }
            .bp-hero .text-gradient {
                background: linear-gradient(90deg, #9b59b6, #3498db);
                -webkit-background-clip: text;
                -webkit-text-fill-color: transparent;
            }
            .bp-hero .hero-subtitle {
                font-size: 18px;
                color: var(--text-muted);
                max-width: 600px;
                margin: 0 auto 40px;
                line-height: 1.6;
            }
            .bp-hero-ctas {
                display: flex;
                gap: 16px;
                justify-content: center;
                flex-wrap: wrap;
            }

            /* ===== SERVICE TYPES GRID ===== */
            .bp-types {
                background: var(--bg-surface);
                border-top: 1px solid var(--border-color);
                border-bottom: 1px solid var(--border-color);
            }
            .bp-types-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(260px, 1fr));
                gap: 24px;
            }
            .bp-type-card {
                background: rgba(0, 0, 0, 0.2);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 40px 28px;
                text-align: center;
                transition: all 0.3s ease;
                position: relative;
                overflow: hidden;
            }
            .bp-type-card:hover {
                border-color: rgba(155, 89, 182, 0.4);
                transform: translateY(-6px);
                box-shadow: 0 20px 40px rgba(155, 89, 182, 0.08);
            }
            .bp-type-card::before {
                content: '';
                position: absolute;
                top: 0;
                left: 0;
                width: 100%;
                height: 3px;
                background: linear-gradient(90deg, transparent, #9b59b6, transparent);
                opacity: 0;
                transition: opacity 0.3s ease;
            }
            .bp-type-card:hover::before {
                opacity: 1;
            }
            .bp-type-icon {
                width: 64px;
                height: 64px;
                margin: 0 auto 20px;
                display: flex;
                align-items: center;
                justify-content: center;
                background: rgba(155, 89, 182, 0.1);
                border-radius: 16px;
                color: #9b59b6;
            }
            .bp-type-card h3 {
                font-size: 20px;
                margin-bottom: 12px;
            }
            .bp-type-card p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.6;
            }

            /* ===== SHOWREEL ===== */
            .bp-showreel {
                position: relative;
                overflow: hidden;
            }
            .bp-showreel-container {
                max-width: 900px;
                margin: 0 auto;
            }
            .bp-player {
                position: relative;
                aspect-ratio: 16/9;
                background: linear-gradient(135deg, #150f24 0%, #1a1a2e 50%, #150f24 100%);
                border-radius: 16px;
                border: 1px solid var(--border-color);
                display: flex;
                align-items: center;
                justify-content: center;
                flex-direction: column;
                gap: 20px;
                overflow: hidden;
                box-shadow: 0 30px 60px rgba(0, 0, 0, 0.5);
            }
            .bp-player::before {
                content: '';
                position: absolute;
                inset: -1px;
                border-radius: 17px;
                padding: 1px;
                background: linear-gradient(135deg, rgba(155, 89, 182, 0.3), transparent 40%, transparent 60%, rgba(155, 89, 182, 0.3));
                -webkit-mask: linear-gradient(#fff 0 0) content-box, linear-gradient(#fff 0 0);
                -webkit-mask-composite: xor;
                mask-composite: exclude;
                pointer-events: none;
            }
            .bp-play-btn {
                width: 80px;
                height: 80px;
                border-radius: 50%;
                background: rgba(155, 89, 182, 0.15);
                border: 2px solid #9b59b6;
                display: flex;
                align-items: center;
                justify-content: center;
                color: #9b59b6;
                transition: all 0.3s ease;
                cursor: default;
            }
            .bp-play-btn svg {
                margin-left: 4px;
            }
            .bp-player-label {
                font-family: var(--font-heading);
                font-size: 14px;
                text-transform: uppercase;
                letter-spacing: 3px;
                color: var(--text-muted);
            }
            .bp-coming-soon {
                font-size: 12px;
                color: rgba(255, 255, 255, 0.3);
                font-style: italic;
            }

            /* ===== PROCESS ===== */
            .bp-process {
                background: var(--bg-surface);
                border-top: 1px solid var(--border-color);
                border-bottom: 1px solid var(--border-color);
            }
            .bp-process-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
                gap: 32px;
                position: relative;
            }
            .bp-step {
                text-align: center;
                position: relative;
            }
            .bp-step-number {
                width: 56px;
                height: 56px;
                background: var(--bg-page);
                border: 2px solid #9b59b6;
                color: #9b59b6;
                border-radius: 50%;
                display: flex;
                align-items: center;
                justify-content: center;
                font-size: 20px;
                font-family: var(--font-heading);
                font-weight: 700;
                margin: 0 auto 20px;
                box-shadow: 0 0 20px rgba(155, 89, 182, 0.15);
            }
            .bp-step h3 {
                font-size: 18px;
                margin-bottom: 8px;
            }
            .bp-step p {
                font-size: 14px;
                color: var(--text-muted);
                line-height: 1.5;
            }
            @media (min-width: 992px) {
                .bp-step:not(:last-child)::after {
                    content: '';
                    position: absolute;
                    top: 28px;
                    right: -16px;
                    width: 32px;
                    height: 2px;
                    background: repeating-linear-gradient(to right, transparent, transparent 3px, #9b59b6 3px, #9b59b6 8px);
                    opacity: 0.3;
                }
            }

            /* ===== PRICING ===== */
            .bp-pricing-grid {
                display: grid;
                grid-template-columns: repeat(auto-fit, minmax(300px, 1fr));
                gap: 32px;
                align-items: stretch;
            }
            @media (min-width: 992px) {
                .bp-pricing-grid {
                    grid-template-columns: repeat(3, 1fr);
                }
            }
            .bp-pricing-card {
                background: var(--bg-surface);
                border: 1px solid var(--border-color);
                border-radius: var(--radius-md);
                padding: 48px 32px;
                text-align: center;
                transition: all 0.3s ease;
                box-shadow: var(--shadow-sm);
                display: flex;
                flex-direction: column;
            }
            .bp-pricing-card:hover {
                transform: translateY(-5px);
                border-color: rgba(255, 255, 255, 0.2);
                box-shadow: var(--shadow-md);
            }
            .bp-pricing-card.bp-popular {
                background: #1a1a24;
                border-color: #9b59b6;
                transform: scale(1.05);
                position: relative;
                padding: 64px 32px;
                z-index: 2;
                box-shadow: 0 0 40px rgba(155, 89, 182, 0.15);
            }
            .bp-pricing-card.bp-popular:hover {
                transform: scale(1.05) translateY(-5px);
            }
            .bp-popular-badge {
                position: absolute;
                top: 0;
                left: 50%;
                transform: translate(-50%, -50%);
                background: #9b59b6;
                color: #fff;
                font-size: 12px;
                font-weight: 700;
                text-transform: uppercase;
                letter-spacing: 1px;
                padding: 6px 16px;
                border-radius: 50px;
            }
            .bp-tier-name {
                font-size: 24px;
                margin-bottom: 16px;
            }
            .bp-tier-price {
                font-size: 40px;
                font-family: var(--font-heading);
                font-weight: 700;
                color: var(--text-primary);
                margin-bottom: 8px;
            }
            .bp-tier-cycle {
                font-size: 14px;
                color: var(--text-muted);
                margin-bottom: 24px;
            }
            .bp-tier-desc {
                font-size: 14px;
                color: var(--text-muted);
                margin-bottom: 32px;
                min-height: 42px;
            }
            .bp-tier-features {
                list-style: none;
                margin-bottom: 40px;
                text-align: left;
                flex-grow: 1;
            }
            .bp-tier-features li {
                font-size: 15px;
                margin-bottom: 14px;
                padding-left: 28px;
                position: relative;
                color: var(--text-muted);
            }
            .bp-tier-features li::before {
                content: '✓';
                position: absolute;
                left: 0;
                color: #9b59b6;
                font-weight: bold;
            }

            /* ===== FAQ ===== */
            .bp-faq-list {
                max-width: 800px;
                margin: 0 auto;
            }
            .bp-faq-item {
                border-bottom: 1px solid var(--border-color);
            }
            .bp-faq-question {
                width: 100%;
                background: transparent;
                border: none;
                color: var(--text-primary);
                font-family: var(--font-heading);
                font-size: 18px;
                font-weight: 600;
                padding: 24px 40px 24px 0;
                text-align: left;
                cursor: pointer;
                position: relative;
                transition: color 0.2s ease;
            }
            .bp-faq-question:hover {
                color: #9b59b6;
            }
            .bp-faq-question::after {
                content: '+';
                position: absolute;
                right: 0;
                top: 50%;
                transform: translateY(-50%);
                font-size: 24px;
                color: #9b59b6;
                transition: transform 0.3s ease;
            }
            .bp-faq-item.active .bp-faq-question::after {
                content: '−';
                transform: translateY(-50%) rotate(0deg);
            }
            .bp-faq-answer {
                max-height: 0;
                overflow: hidden;
                transition: max-height 0.4s ease, padding 0.3s ease;
                padding: 0;
            }
            .bp-faq-item.active .bp-faq-answer {
                max-height: 300px;
                padding-bottom: 24px;
            }
            .bp-faq-answer p {
                font-size: 15px;
                line-height: 1.7;
                color: var(--text-muted);
            }

            /* ===== CTA ===== */
            .bp-cta {
                background: rgba(155, 89, 182, 0.03);
                border-top: 1px solid var(--border-color);
            }
            .bp-cta-inner {
                max-width: 700px;
                margin: 0 auto;
                text-align: center;
            }
            .bp-cta-inner h2 {
                margin-bottom: 16px;
            }
            .bp-cta-inner p {
                color: var(--text-muted);
                margin-bottom: 32px;
                font-size: 17px;
            }
            .bp-cta-buttons {
                display: flex;
                gap: 16px;
                justify-content: center;
                flex-wrap: wrap;
            }

            @media (max-width: 768px) {
                .bp-hero {
                    min-height: 70vh;
                    padding: 100px 20px 60px;
                }
                .bp-pricing-card.bp-popular {
                    transform: scale(1);
                    padding: 48px 32px;
                }
                .bp-pricing-card.bp-popular:hover {
                    transform: translateY(-5px);
                }
            }
        </style>
    </fragment>

    <!-- ===== HERO ===== -->
    <section class="bp-hero">
        <div class="bp-hero-bg" style={`background-image: url('${heroBgImage}');`}></div>
        <div class="bp-hero-content animate-on-scroll slide-up">
            <div class="bp-badge">🎨 Brand Identity</div>
            <h1><span class="text-gradient">Professional Brand & Graphic Design</span></h1>
            <p class="hero-subtitle">Distinct visual identities that make your brand memorable and professional.</p>
            <div class="bp-hero-ctas">
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Get a Free Quote</a>
                <a href="#bp-pricing" class="btn btn-ghost btn-pill">View Pricing ↓</a>
            </div>
        </div>
    </section>

    <!-- ===== SERVICE TYPES ===== -->
    <section class="bp-types section-padding">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{servicesSection.heading || 'Brand Design Services'}</span></h2>
                <p>{servicesSection.subtitle || 'Logo design, brand kits, visual identity systems, and more.'}</p>
            </div>
            <div class="bp-types-grid">
                {serviceTypes.map((type: any, i: number) => (
                    <div class={`bp-type-card animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="bp-type-icon" set:html={type.iconSvg || '<svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"/></svg>'} />
                        <h3>{type.title}</h3>
                        <p>{type.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== SHOWREEL (Portfolio) ===== -->
    <section class="bp-showreel section-padding" id="bp-showreel">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">Our Portfolio Showcase</span></h2>
                <p>A look at our branding projects, from concept to delivery.</p>
            </div>
            <div class="bp-showreel-container animate-on-scroll slide-up delay-100">
                <div class="bp-player">
                    <div class="bp-play-btn">
                        <svg width="32" height="32" viewBox="0 0 24 24" fill="currentColor"><polygon points="5 3 19 12 5 21 5 3"/></svg>
                    </div>
                    <div class="bp-player-label">Branding Reel</div>
                    <div class="bp-coming-soon">Coming Soon</div>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== PORTFOLIO GALLERY ===== -->
    {portfolioGallery?.images && portfolioGallery.images.length > 0 && (
        <section class="section-padding" style="background: rgba(230, 0, 126, 0.02);">
            <div class="container">
                <div class="section-header animate-on-scroll slide-up" style="text-align: center; margin-bottom: 40px;">
                    <h2><span class="text-gradient" style="background: linear-gradient(90deg, #e6007e, #ff4d4d); -webkit-background-clip: text; -webkit-text-fill-color: transparent;">{portfolioGallery.heading || 'Our Work Gallery'}</span></h2>
                    <p>{portfolioGallery.subtitle}</p>
                </div>
                <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(300px, 1fr)); gap: 24px;">
                    {portfolioGallery.images.map((item: any, i: number) => {
                        const imgUrl = item.image ? buildPayloadImageUrl(item.image) : null;
                        if (!imgUrl) return null;
                        return (
                            <div class={`animate-on-scroll slide-up delay-${(i % 4 + 1) * 100}`} style="border-radius: 12px; overflow: hidden; aspect-ratio: 4/3; background: #111;">
                                <img src={imgUrl} alt="Portfolio Item" style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" onmouseover="this.style.transform='scale(1.05)'" onmouseout="this.style.transform='scale(1)'" loading="lazy" />
                            </div>
                        );
                    })}
                </div>
            </div>
        </section>
    )}

    <!-- ===== PROCESS ===== -->
    <section class="bp-process section-padding">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{processSection.heading || 'Our Design Process'}</span></h2>
                <p>{processSection.subtitle || 'A streamlined workflow that takes your project from idea to launch.'}</p>
            </div>
            <div class="bp-process-grid">
                {processSteps.map((step: any, i: number) => (
                    <div class={`bp-step animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        <div class="bp-step-number">{step.number || String(i + 1).padStart(2, '0')}</div>
                        <h3>{step.title}</h3>
                        <p>{step.description}</p>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- ===== PRICING ===== -->
    <section class="section-padding" id="bp-pricing">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{pricingSection.heading || 'Brand Identity Pricing'}</span></h2>
                <p>{pricingSection.subtitle || 'Transparent pricing for brand design projects of any scale.'}</p>
            </div>

            <div class="bp-pricing-grid">
                {pricingTiers.map((tier: any, i: number) => (
                    <div class={`bp-pricing-card ${tier.isPopular ? 'bp-popular' : ''} animate-on-scroll slide-up delay-${(i+1)*100}`}>
                        {tier.isPopular && <div class="bp-popular-badge">Most Popular</div>}
                        <h3 class="bp-tier-name">{tier.name}</h3>
                        <div class="bp-tier-price">{tier.price}</div>
                        <div class="bp-tier-cycle">{tier.period}</div>
                        <p class="bp-tier-desc">{tier.description}</p>
                        <ul class="bp-tier-features">
                            {tier.features?.map((f: any) => (
                                <li>{f.feature}</li>
                            ))}
                        </ul>
                        <a href="/contact/" class={`btn ${tier.isPopular ? 'btn-primary glow-effect' : 'btn-ghost'} btn-pill tier-btn`} style={tier.isPopular ? 'background: #9b59b6; border-color: #9b59b6;' : ''}>
                            {tier.isPopular ? 'Book a Call' : 'Get Started'}
                        </a>
                    </div>
                ))}
            </div>

            <div style="text-align: center; margin-top: 32px;">
                <p style="color: var(--text-muted); font-size: 14px;">{pricingSection.note || '* Prices are starting points. Final pricing depends on project scope, deliverables, and complexity.'}</p>
            </div>
        </div>
    </section>

    <!-- ===== FAQ ===== -->
    <section class="section-padding" style="background: var(--bg-surface); border-top: 1px solid var(--border-color); border-bottom: 1px solid var(--border-color);" id="bp-faq">
        <div class="container">
            <div class="section-header animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">{faqSection.heading || 'Brand Design FAQs'}</span></h2>
                <p>{faqSection.subtitle || 'Common questions about our branding services.'}</p>
            </div>

            <div class="bp-faq-list">
                {faqs.map((faq: any) => (
                    <div class="bp-faq-item">
                        <button class="bp-faq-question">{faq.question}</button>
                        <div class="bp-faq-answer">
                            <p>{faq.answer}</p>
                        </div>
                    </div>
                ))}
            </div>
        </div>
    </section>

    <!-- RELATED CASE STUDY -->
    <section class="section-padding" style="padding-top: 0;">
        <div class="container" style="text-align: center;">
            <div style="background: rgba(255,255,255,0.02); border: 1px solid rgba(255,255,255,0.05); border-radius: 16px; padding: 40px; max-width: 800px; margin: 0 auto;">
                <h3 style="margin-bottom: 16px;">See Our Branding in Action</h3>
                <p style="color: rgba(255,255,255,0.7); margin-bottom: 24px;">Discover how a cohesive brand identity and local SEO strategy transformed this local business.</p>
                <div style="display: flex; gap: 16px; justify-content: center; flex-wrap: wrap;">
                    <a href="/projects/brand-identity-local-seo/" class="btn btn-ghost btn-pill">Read the Case Study →</a>
                </div>
            </div>
        </div>
    </section>

    <!-- ===== CTA ===== -->
    <section class="bp-cta section-padding">
        <div class="container">
            <div class="bp-cta-inner animate-on-scroll slide-up" style="text-align: center;">
                <h2><span class="text-gradient">Ready to build a memorable brand?</span></h2>
                <p>Book a free branding consultation and let's talk through your visual identity. No commitment, just a conversation about your goals.</p>
                <div class="bp-cta-buttons">
                    <a href="/contact/" class="btn btn-primary btn-pill glow-effect" style="background: #9b59b6; border-color: #9b59b6; box-shadow: 0 0 20px rgba(155, 89, 182, 0.4);">Book a Free Consultation</a>
                    <a href={`https://wa.me/${whatsappNumber}?text=${encodeURIComponent("Hi Quadem! I'm interested in your branding services.")}`} target="_blank" rel="noopener noreferrer" class="btn btn-ghost btn-pill">💬 Chat on WhatsApp</a>
                </div>
            </div>
        </div>
    </section>

    <!-- FAQ Accordion Script -->
    <script is:inline>
        document.addEventListener('DOMContentLoaded', () => {
            document.querySelectorAll('.bp-faq-question').forEach(btn => {
                btn.addEventListener('click', () => {
                    const item = btn.parentElement;
                    const isActive = item.classList.contains('active');
                    // Close all
                    document.querySelectorAll('.bp-faq-item').forEach(i => i.classList.remove('active'));
                    // Toggle current
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });
        });

        document.addEventListener('astro:after-swap', () => {
            document.querySelectorAll('.bp-faq-question').forEach(btn => {
                btn.addEventListener('click', () => {
                    const item = btn.parentElement;
                    const isActive = item.classList.contains('active');
                    document.querySelectorAll('.bp-faq-item').forEach(i => i.classList.remove('active'));
                    if (!isActive) {
                        item.classList.add('active');
                    }
                });
            });
        });
    </script>
</BaseLayout>
