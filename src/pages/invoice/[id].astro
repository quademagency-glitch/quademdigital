---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch, payloadFetchGlobal } from "../../lib/payload";

const { id } = Astro.params;

const invoices = await payloadFetch('invoices', {
  'where[invoiceId][equals]': id,
  depth: '1'
});
const invoiceData = invoices[0];

if (!invoiceData) {
  return Astro.redirect('/404');
}

const siteSettings = await payloadFetchGlobal('siteSettings');
const bankDetails = siteSettings?.bankDetails || null;
const enablePaystack = siteSettings?.enablePaystack || false;
const paystackPublicKey = import.meta.env.PAYSTACK_PUBLIC_KEY || import.meta.env.PUBLIC_PAYSTACK_KEY || '';
const agency = {
    name: "Quadem Digital Enterprise",
    email: siteSettings?.contactEmail || "info@quademdigital.com",
    website: "https://quademdigital.com",
    address: "Accra, Ghana"
};

// `items` is optional in the collection schema, so an invoice with no line
// items used to crash this page on .reduce().
const subtotal = (invoiceData.items ?? []).reduce((acc: number, item: any) => acc + (item.rate * item.quantity), 0);
const taxRatePercent = invoiceData.taxRate || 0;
const taxAmount = subtotal * (taxRatePercent / 100);
const total = subtotal + taxAmount;

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

const formatCurrency = (amount: number) => {
  const currencyCode = invoiceData.currency || 'USD';
  // Two decimals: rounding the display to whole units meant a GHS 1,250.50
  // invoice showed as 1,251 while Math.round(total * 100) charged 125,050
  // minor units. Displayed and charged must be the same number.
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: currencyCode,
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(amount);
};
---

<BaseLayout title={`Invoice ${invoiceData.invoiceId} | Quadem Digital`} description="Client Invoice" activePage="invoice">
  <fragment slot="head">
    <meta name="robots" content="noindex, nofollow">
  </fragment>
  
  <div class="invoice-page-wrapper pt-150 pb-100">
    <div class="container">
      
      <!-- Actions Toolbar -->
      <div class="invoice-actions no-print">
        <button class="btn btn-secondary btn-pill" onclick="window.history.back()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back
        </button>
        <button class="btn btn-primary btn-pill glow-effect" onclick="window.print()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
          Print / Save PDF
        </button>
      </div>

      <!-- Invoice Container -->
      <div class="invoice-container">
        
        <!-- Background decorative elements -->
        <div class="invoice-glow-top"></div>
        <div class="invoice-glow-bottom"></div>

        <!-- Header Section -->
        <header class="invoice-header">
          <div class="invoice-brand">
            <h1 class="brand-name">QUADEM</h1>
            <span class="brand-suffix">DIGITAL ENTERPRISE</span>
          </div>
          <div class="invoice-meta">
            <h2 class="invoice-title">INVOICE</h2>
            <div class="meta-details">
              <div class="meta-item">
                <span class="meta-label">Invoice Number</span>
                <span class="meta-value">{invoiceData.invoiceId}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Date Issued</span>
                <span class="meta-value">{formatDate(invoiceData.dateIssued)}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Date Due</span>
                <span class="meta-value">{formatDate(invoiceData.dueDate)}</span>
              </div>
            </div>
            <div class={`invoice-status ${invoiceData.status.toLowerCase()}`}>{invoiceData.status}</div>
          </div>
        </header>

        <!-- Addresses Section -->
        <section class="invoice-addresses">
          <div class="address-block">
            <h3 class="address-title">Billed To:</h3>
            <p class="address-name">{invoiceData.client?.clientName || "Client"}</p>
            {invoiceData.client?.projectName && <p class="address-contact">Project: {invoiceData.client.projectName}</p>}
            <p class="address-email">{invoiceData.client?.clientEmail}</p>
          </div>
          <div class="address-block text-right">
            <h3 class="address-title">From:</h3>
            <p class="address-name">{agency.name}</p>
            <p class="address-text">{agency.address}</p>
            <p class="address-email">{agency.email}</p>
            <p class="address-website">{agency.website}</p>
          </div>
        </section>

        <!-- Line Items Table -->
        <section class="invoice-items">
          <table class="items-table">
            <thead>
              <tr>
                <th class="col-desc">Service Description</th>
                <th class="col-rate">Rate</th>
                <th class="col-qty">Qty</th>
                <th class="col-total">Line Total</th>
              </tr>
            </thead>
            <tbody>
              {invoiceData.items.map((item: any) => (
                <tr>
                  <td class="col-desc">
                    <div class="item-desc">{item.description}</div>
                  </td>
                  <td class="col-rate">{formatCurrency(item.rate)}</td>
                  <td class="col-qty">{item.quantity}</td>
                  <td class="col-total">{formatCurrency(item.rate * item.quantity)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <!-- Totals Section -->
        <section class="invoice-summary">
          <div class="payment-info">
            <h3 class="info-title">Payment Instructions</h3>
            <p class="info-text">Please make payment via Bank Transfer or Crypto (USDT).</p>
            <div class="bank-details">
              {bankDetails ? (
                <>
                  <p><strong>Bank:</strong> {bankDetails.bankName}</p>
                  <p><strong>Account Name:</strong> {bankDetails.accountName}</p>
                  <p><strong>Account No:</strong> {bankDetails.accountNumber}</p>
                </>
              ) : (
                <>
                  <p><strong>Bank:</strong> Zenith Bank Ghana</p>
                  <p><strong>Account Name:</strong> Quadem Digital</p>
                  <p><strong>Account No:</strong> 000011112222</p>
                </>
              )}
            </div>
          </div>
          {enablePaystack && invoiceData.status.toLowerCase() !== 'paid' && (
            <div class="paystack-checkout" style="margin-top: 1.5rem; width: 300px;">
              <button id="payWithPaystackBtn" class="btn btn-primary btn-pill glow-effect w-100" style="background: #09a5db; border-color: #09a5db; color: white;">
                <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                Pay Online Securely
              </button>
            </div>
          )}
          <div class="totals-box">
            <div class="total-row">
              <span class="total-label">Subtotal</span>
              <span class="total-value">{formatCurrency(subtotal)}</span>
            </div>
            <div class="total-row">
              <span class="total-label">Tax ({taxRatePercent}%)</span>
              <span class="total-value">{formatCurrency(taxAmount)}</span>
            </div>
            <div class="total-row grand-total">
              <span class="total-label">Amount Due</span>
              <span class="total-value">{formatCurrency(total)}</span>
            </div>
          </div>
        </section>

        <!-- Footer -->
        <footer class="invoice-footer">
          <p>Thank you for choosing Quadem Digital Enterprise.</p>
          <p class="footer-note">We appreciate your business.</p>
        </footer>

      </div>
    </div>
  </div>

  {enablePaystack && (
    <script is:inline src="https://js.paystack.co/v1/inline.js"></script>
    <script is:inline define:vars={{ 
        clientEmail: invoiceData.client?.clientEmail, 
        amount: Math.round(total * 100), 
        currency: invoiceData.currency || 'USD',
        documentId: invoiceData.id,
        paystackPublicKey
    }}>
      document.addEventListener('DOMContentLoaded', () => {
        const btn = document.getElementById('payWithPaystackBtn');
        if (btn) {
            btn.addEventListener('click', () => {
                if (!paystackPublicKey) {
                    alert("Paystack Public Key is missing! Contact support.");
                    return;
                }
                const handler = PaystackPop.setup({
                    key: paystackPublicKey,
                    email: clientEmail || 'client@example.com',
                    amount: amount,
                    currency: currency,
                    ref: 'INV_' + documentId + '_' + Math.floor((Math.random() * 1000000000) + 1),
                    callback: function(response) {
                        btn.textContent = 'Verifying Payment...';
                        btn.disabled = true;
                        
                        fetch('/api/verify-paystack/', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({ reference: response.reference, documentId })
                        }).then(res => res.json()).then(data => {
                            if (data.success) {
                                alert('Payment successful! Your invoice is now marked as Paid.');
                                window.location.reload();
                            } else {
                                alert('Verification failed: ' + data.error);
                                btn.innerHTML = 'Pay Online Securely';
                                btn.disabled = false;
                            }
                        }).catch(err => {
                            alert('An error occurred during verification.');
                            btn.innerHTML = 'Pay Online Securely';
                            btn.disabled = false;
                        });
                    },
                    onClose: function() {
                        console.log('Payment window closed.');
                    }
                });
                handler.openIframe();
            });
        }
      });
    </script>
  )}
</BaseLayout>

<style>
  /* Base Variables Specific to Invoice */
  :root {
    --inv-bg: #0a0a0c;
    --inv-card: rgba(255, 255, 255, 0.03);
    --inv-border: rgba(255, 255, 255, 0.08);
    --inv-text: #e2e8f0;
    --inv-text-muted: #94a3b8;
    --inv-accent: #06b6d4;
    --inv-accent-glow: rgba(6, 182, 212, 0.3);
  }

  .invoice-page-wrapper {
    min-height: 100vh;
    background-color: var(--inv-bg);
    position: relative;
    z-index: 1;
  }

  .invoice-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .invoice-container {
    max-width: 900px;
    margin: 0 auto;
    background: var(--inv-card);
    border: 1px solid var(--inv-border);
    border-radius: 24px;
    padding: 4rem;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(20px);
    box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    color: var(--inv-text);
  }

  /* Decorative Glows */
  .invoice-glow-top {
    position: absolute;
    top: -150px;
    right: -150px;
    width: 300px;
    height: 300px;
    background: var(--inv-accent);
    filter: blur(150px);
    opacity: 0.3;
    z-index: -1;
  }
  
  .invoice-glow-bottom {
    position: absolute;
    bottom: -150px;
    left: -150px;
    width: 300px;
    height: 300px;
    background: #6366f1;
    filter: blur(150px);
    opacity: 0.2;
    z-index: -1;
  }

  /* Header */
  .invoice-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--inv-border);
    padding-bottom: 3rem;
    margin-bottom: 3rem;
  }

  .invoice-brand {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -1px;
    background: linear-gradient(135deg, #fff 0%, #94a3b8 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-suffix {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--inv-accent);
    margin-top: 4px;
  }

  .invoice-meta {
    text-align: right;
  }

  .invoice-title {
    font-size: 3rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    letter-spacing: 2px;
    color: rgba(255, 255, 255, 0.1);
    text-transform: uppercase;
  }

  .meta-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .meta-item {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .meta-label {
    color: var(--inv-text-muted);
  }

  .meta-value {
    font-weight: 600;
    color: var(--inv-text);
    min-width: 120px;
  }

  .invoice-status {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .invoice-status.pending {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .invoice-status.paid {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  /* Addresses */
  .invoice-addresses {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4rem;
  }

  .address-block {
    flex: 1;
  }
  .text-right {
    text-align: right;
  }

  .address-title {
    font-size: 0.9rem;
    color: var(--inv-text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 1rem 0;
  }

  .address-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: #fff;
  }

  .address-contact, .address-text, .address-email, .address-website {
    margin: 0 0 0.25rem 0;
    color: var(--inv-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: pre-line;
  }

  /* Table */
  .invoice-items {
    margin-bottom: 4rem;
  }

  .items-table {
    width: 100%;
    border-collapse: collapse;
  }

  .items-table th {
    padding: 1rem 0;
    border-bottom: 1px solid rgba(255, 255, 255, 0.2);
    color: var(--inv-text-muted);
    font-size: 0.85rem;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 600;
    text-align: left;
  }

  .items-table th.col-rate, .items-table th.col-qty, .items-table th.col-total {
    text-align: right;
  }

  .items-table td {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--inv-border);
    vertical-align: middle;
  }

  .items-table td.col-rate, .items-table td.col-qty, .items-table td.col-total {
    text-align: right;
  }

  .col-desc { width: 50%; }
  .col-rate { width: 20%; }
  .col-qty { width: 10%; }
  .col-total { width: 20%; }

  .item-desc {
    font-weight: 500;
    font-size: 1.05rem;
    color: #fff;
  }

  .items-table td.col-rate, .items-table td.col-qty {
    color: var(--inv-text-muted);
  }
  
  .items-table td.col-total {
    font-weight: 600;
    color: #fff;
  }

  /* Summary / Totals */
  .invoice-summary {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    margin-bottom: 4rem;
  }

  .payment-info {
    flex: 1;
    max-width: 400px;
    background: rgba(0, 0, 0, 0.2);
    padding: 1.5rem;
    border-radius: 12px;
    border: 1px solid var(--inv-border);
  }

  .info-title {
    font-size: 0.9rem;
    color: #fff;
    margin: 0 0 0.5rem 0;
    font-weight: 600;
  }

  .info-text {
    font-size: 0.9rem;
    color: var(--inv-text-muted);
    margin: 0 0 1rem 0;
  }

  .bank-details p {
    margin: 0 0 0.25rem 0;
    font-size: 0.9rem;
    color: var(--inv-text-muted);
  }
  .bank-details strong {
    color: #fff;
    font-weight: 500;
  }

  .totals-box {
    width: 300px;
  }

  .total-row {
    display: flex;
    justify-content: space-between;
    padding: 1rem 0;
    border-bottom: 1px solid var(--inv-border);
  }

  .total-row:last-child {
    border-bottom: none;
  }

  .total-label {
    color: var(--inv-text-muted);
  }

  .total-value {
    font-weight: 600;
  }

  .grand-total {
    margin-top: 0.5rem;
    padding-top: 1.5rem;
    border-top: 2px solid rgba(255,255,255,0.2);
  }

  .grand-total .total-label {
    font-size: 1.2rem;
    font-weight: 700;
    color: #fff;
  }

  .grand-total .total-value {
    font-size: 1.5rem;
    font-weight: 800;
    color: var(--inv-accent);
  }

  /* Footer */
  .invoice-footer {
    text-align: center;
    border-top: 1px solid var(--inv-border);
    padding-top: 2rem;
  }

  .invoice-footer p {
    margin: 0 0 0.5rem 0;
    color: #fff;
    font-weight: 500;
  }

  .invoice-footer .footer-note {
    color: var(--inv-text-muted);
    font-size: 0.9rem;
    font-weight: 400;
  }

  /* Print Styles */
  @media print {
    @page { margin: 0; size: auto; }
    
    body * {
      visibility: hidden;
    }
    
    .invoice-container, .invoice-container * {
      visibility: visible;
    }
    
    .invoice-container {
      position: absolute;
      left: 0;
      top: 0;
      width: 100%;
      box-shadow: none;
      border: none;
      padding: 2rem;
      background: white !important;
      color: black !important;
      -webkit-print-color-adjust: exact;
      print-color-adjust: exact;
    }

    .no-print {
      display: none !important;
    }

    /* Override dark theme for print */
    :root {
      --inv-bg: #fff;
      --inv-card: #fff;
      --inv-border: #e2e8f0;
      --inv-text: #0f172a;
      --inv-text-muted: #64748b;
    }

    .invoice-glow-top, .invoice-glow-bottom {
      display: none;
    }

    .brand-name {
      -webkit-text-fill-color: #0f172a;
    }

    .invoice-title {
      color: rgba(0,0,0,0.05);
    }

    .item-desc, .address-name, .bank-details strong, .info-title, .items-table td.col-total {
      color: #0f172a;
    }

    .grand-total .total-label {
      color: #0f172a;
    }
  }

  /* Responsive */
  @media (max-width: 768px) {
    .invoice-container {
      padding: 2rem;
    }
    .invoice-header, .invoice-addresses, .invoice-summary {
      flex-direction: column;
      gap: 2rem;
    }
    .invoice-meta, .address-block.text-right {
      text-align: left;
    }
    .meta-item {
      justify-content: flex-start;
    }
    .totals-box {
      width: 100%;
    }
    .items-table th.col-rate, .items-table td.col-rate {
      display: none;
    }
  }
</style>
