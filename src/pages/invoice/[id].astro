---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch, payloadFetchGlobal } from "../../lib/payload";
import { verifySession } from "../../lib/session";

const { id } = Astro.params;

// skipCache: after paying, the browser returns here and would otherwise be
// served the 60s-memoised "pending" copy from the same warm instance, which
// reads as "my payment didn't work" and invites a second payment.
const invoices = await payloadFetch(
  'invoices',
  { 'where[invoiceId][equals]': String(id ?? ''), depth: '1' },
  { skipCache: true }
);
const invoiceData = invoices[0];

/*
  Access gate.

  src/lib/payload.ts attaches the admin API key to every read, which satisfies
  the Invoices collection's `read: Boolean(user)` rule on behalf of any visitor.
  Combined with hand-typed, sequential invoiceIds (INV-001, INV-002...), that
  made every client's name, email, project and line items readable by anyone who
  could count. Require the per-invoice token instead, or a portal session
  belonging to that invoice's client.

  404, never 403: a 403 would confirm which invoice ids exist.
*/
const providedToken = Astro.url.searchParams.get('t');
// Signature-checked, not read raw. An unsigned `client_auth` cookie used to be
// accepted here, which meant the token gate above could be walked straight
// past with `Cookie: client_auth=<client-slug>`.
const sessionClient = verifySession(Astro.cookies.get('client_auth')?.value);

const tokenMatches =
  !!providedToken &&
  !!invoiceData?.accessToken &&
  providedToken.length === invoiceData.accessToken.length &&
  providedToken === invoiceData.accessToken;

const sessionMatches =
  !!sessionClient && !!invoiceData?.client?.slug && sessionClient === invoiceData.client.slug;

if (!invoiceData || (!tokenMatches && !sessionMatches)) {
  return new Response(null, { status: 404 });
}

const siteSettings = await payloadFetchGlobal('siteSettings');
const bankDetails = siteSettings?.bankDetails || null;
const enablePaystack = siteSettings?.enablePaystack || false;
// The public key is no longer needed in the browser: checkout is started
// server-side and the visitor is redirected to Paystack's hosted page.
const agency = {
    name: "Quadem Digital Enterprise",
    email: siteSettings?.contactEmail || "info@quademdigital.com",
    website: "https://quademdigital.com",
    address: "Accra, Ghana"
};

// `items` is optional in the collection schema, so an invoice with no line
// items used to crash this page on .reduce().
const subtotal = (invoiceData.items ?? []).reduce((acc: number, item: any) => acc + (item.rate * item.quantity), 0);
const taxRatePercent = invoiceData.taxRate || 0;
const taxAmount = subtotal * (taxRatePercent / 100);
const total = subtotal + taxAmount;

function formatDate(dateStr: string) {
  if (!dateStr) return '';
  return new Date(dateStr).toLocaleDateString('en-US', { month: 'long', day: 'numeric', year: 'numeric' });
}

// Status is stored lowercase; clients should not read raw database values.
const statusLabel = String(invoiceData.status ?? 'pending').replace(/^./, (c: string) => c.toUpperCase());
const isPaid = String(invoiceData.status ?? '').toLowerCase() === 'paid';

/*
  Deposits. All figures come from the stored minor-unit values rather than the
  arithmetic above, because those are what settlement checks against: showing
  a client one number and validating another is how underpayments slip through.
*/
const totalMinor = Number(invoiceData.amountMinor) || Math.round(total * 100);
const amountPaidMinor = Math.max(0, Number(invoiceData.amountPaidMinor) || 0);
const outstandingMinor = Math.max(0, totalMinor - amountPaidMinor);
const depositMinor = Number(invoiceData.depositMinor) || 0;
// Offered only on a first payment: once anything is collected, the only thing
// left to pay is the balance.
const depositAvailable = !isPaid && amountPaidMinor <= 0 && depositMinor > 0 && depositMinor < totalMinor;
const partiallyPaid = !isPaid && amountPaidMinor > 0;

const formatCurrency = (amount: number) => {
  const currencyCode = invoiceData.currency || 'USD';
  // Two decimals: rounding the display to whole units meant a GHS 1,250.50
  // invoice showed as 1,251 while Math.round(total * 100) charged 125,050
  // minor units. Displayed and charged must be the same number.
  return new Intl.NumberFormat('en-US', {
    style: 'currency',
    currency: currencyCode,
    minimumFractionDigits: 2,
    maximumFractionDigits: 2,
  }).format(amount);
};
---

<BaseLayout title={`Invoice ${invoiceData.invoiceId} | Quadem Digital`} description="Client Invoice" activePage="invoice">
  <Fragment slot="head">
    <meta name="robots" content="noindex, nofollow">
  </Fragment>
  
  <div class="invoice-page-wrapper pt-150 pb-100">
    <div class="container">
      
      <!-- Actions Toolbar -->
      <div class="invoice-actions no-print">
        <button class="btn btn-secondary btn-pill" onclick="window.history.back()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><line x1="19" y1="12" x2="5" y2="12"></line><polyline points="12 19 5 12 12 5"></polyline></svg>
          Back
        </button>
        <button class="btn btn-primary btn-pill glow-effect" onclick="window.print()">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 8px;"><polyline points="6 9 6 2 18 2 18 9"></polyline><path d="M6 18H4a2 2 0 0 1-2-2v-5a2 2 0 0 1 2-2h16a2 2 0 0 1 2 2v5a2 2 0 0 1-2 2h-2"></path><rect x="6" y="14" width="12" height="8"></rect></svg>
          Print / Save PDF
        </button>
      </div>

      <!-- Invoice Container -->
      <div class="invoice-container">
        
        <!-- Background decorative elements -->
        <div class="invoice-glow-top"></div>
        <div class="invoice-glow-bottom"></div>

        <!-- Header Section -->
        <header class="invoice-header">
          <div class="invoice-brand">
            <h1 class="brand-name">QUADEM</h1>
            <span class="brand-suffix">DIGITAL ENTERPRISE</span>
          </div>
          <div class="invoice-meta">
            <h2 class="invoice-title">INVOICE</h2>
            <div class="meta-details">
              <div class="meta-item">
                <span class="meta-label">Invoice Number</span>
                <span class="meta-value">{invoiceData.invoiceId}</span>
              </div>
              <div class="meta-item">
                <span class="meta-label">Date Issued</span>
                <span class="meta-value">{formatDate(invoiceData.dateIssued)}</span>
              </div>
              {invoiceData.dueDate && (
                <div class="meta-item">
                  <span class="meta-label">Date Due</span>
                  <span class="meta-value">{formatDate(invoiceData.dueDate)}</span>
                </div>
              )}
            </div>
            <div class={`invoice-status ${String(invoiceData.status ?? "pending").toLowerCase()}`}>{statusLabel}</div>
          </div>
        </header>

        <!-- Addresses Section -->
        <section class="invoice-addresses">
          <div class="address-block">
            <h3 class="address-title">Billed To:</h3>
            <p class="address-name">{invoiceData.client?.clientName || "Client"}</p>
            {invoiceData.client?.projectName && <p class="address-contact">Project: {invoiceData.client.projectName}</p>}
            <p class="address-email">{invoiceData.client?.clientEmail}</p>
          </div>
          <div class="address-block text-right">
            <h3 class="address-title">From:</h3>
            <p class="address-name">{agency.name}</p>
            <p class="address-text">{agency.address}</p>
            <p class="address-email">{agency.email}</p>
            <p class="address-website">{agency.website}</p>
          </div>
        </section>

        <!-- Line Items Table -->
        <section class="invoice-items">
          <table class="items-table">
            <thead>
              <tr>
                <th class="col-desc">Service Description</th>
                <th class="col-rate">Rate</th>
                <th class="col-qty">Qty</th>
                <th class="col-total">Line Total</th>
              </tr>
            </thead>
            <tbody>
              {(invoiceData.items ?? []).map((item: any) => (
                <tr>
                  <td class="col-desc">
                    <div class="item-desc">{item.description}</div>
                  </td>
                  <td class="col-rate">{formatCurrency(item.rate)}</td>
                  <td class="col-qty">{item.quantity}</td>
                  <td class="col-total">{formatCurrency(item.rate * item.quantity)}</td>
                </tr>
              ))}
            </tbody>
          </table>
        </section>

        <!-- Totals Section -->
        <section class="invoice-summary">
          {isPaid ? (
            /* A settled invoice used to keep showing "Please make payment via
               Bank Transfer" next to the bank account, directly under a PAID
               badge. That reads as a demand for a second payment. Show a
               receipt instead: the reference is what a client quotes if they
               ever need to query the transaction. */
            <div class="payment-info is-paid">
              <h3 class="info-title">Payment Received</h3>
              <p class="info-text">This invoice has been paid in full. No further action is needed.</p>
              <div class="bank-details">
                {invoiceData.paidAt && <p><strong>Paid On:</strong> {formatDate(invoiceData.paidAt)}</p>}
                {invoiceData.paystackReference && (
                  <p><strong>Reference:</strong> {invoiceData.paystackReference}</p>
                )}
              </div>
            </div>
          ) : (
            <div class="payment-info">
              <h3 class="info-title">Payment Instructions</h3>
              <p class="info-text">Please make payment via Bank Transfer or Crypto (USDT).</p>
              <div class="bank-details">
                {bankDetails ? (
                  <>
                    <p><strong>Bank:</strong> {bankDetails.bankName}</p>
                    <p><strong>Account Name:</strong> {bankDetails.accountName}</p>
                    <p><strong>Account No:</strong> {bankDetails.accountNumber}</p>
                  </>
                ) : (
                  <>
                    <p><strong>Bank:</strong> Zenith Bank Ghana</p>
                    <p><strong>Account Name:</strong> Quadem Digital</p>
                    <p><strong>Account No:</strong> 000011112222</p>
                  </>
                )}
              </div>
            </div>
          )}
          {enablePaystack && invoiceData.status.toLowerCase() !== 'paid' && (
            <div class="paystack-checkout" style="margin-top: 1.5rem; width: 300px;">
              {depositAvailable && (
                <button id="payDepositBtn" data-pay="deposit" class="btn btn-primary btn-pill glow-effect w-100" style="background: #09a5db; border-color: #09a5db; color: white;">
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                  Pay {invoiceData.depositPercent}% Deposit: {formatCurrency(depositMinor / 100)}
                </button>
              )}
              <button
                id="payWithPaystackBtn"
                data-pay="full"
                class={`btn btn-pill w-100 ${depositAvailable ? 'btn-secondary' : 'btn-primary glow-effect'}`}
                style={depositAvailable ? 'margin-top: 10px;' : 'background: #09a5db; border-color: #09a5db; color: white;'}
              >
                {!depositAvailable && (
                  <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" style="margin-right: 8px; vertical-align: middle;"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"></rect><line x1="2" y1="10" x2="22" y2="10"></line></svg>
                )}
                {depositAvailable
                  ? `Pay in Full: ${formatCurrency(outstandingMinor / 100)}`
                  : partiallyPaid
                    ? `Pay Balance: ${formatCurrency(outstandingMinor / 100)}`
                    : 'Pay Online Securely'}
              </button>
              <p id="paystackStatus" class="paystack-status" style="display: none;" role="status" aria-live="polite"></p>
            </div>
          )}
          <div class="totals-box">
            <div class="total-row">
              <span class="total-label">Subtotal</span>
              <span class="total-value">{formatCurrency(subtotal)}</span>
            </div>
            <div class="total-row">
              <span class="total-label">Tax ({taxRatePercent}%)</span>
              <span class="total-value">{formatCurrency(taxAmount)}</span>
            </div>
            {partiallyPaid && (
              <div class="total-row">
                <span class="total-label">Paid so far</span>
                <span class="total-value">−{formatCurrency(amountPaidMinor / 100)}</span>
              </div>
            )}
            <div class="total-row grand-total">
              {/* "Amount Due: GHS 1.00" under a PAID badge told the client they
                  still owed the money they had just paid. */}
              <span class="total-label">
                {isPaid ? 'Amount Paid' : partiallyPaid ? 'Balance Due' : 'Amount Due'}
              </span>
              <span class="total-value">
                {formatCurrency(isPaid ? total : outstandingMinor / 100)}
              </span>
            </div>
            {depositAvailable && (
              <div class="deposit-note">
                Pay a {invoiceData.depositPercent}% deposit of {formatCurrency(depositMinor / 100)} now
                and the balance later.
              </div>
            )}
          </div>
        </section>

        <!-- Footer -->
        <footer class="invoice-footer">
          <p>Thank you for choosing Quadem Digital Enterprise.</p>
          <p class="footer-note">I appreciate your business.</p>
        </footer>

      </div>
    </div>
  </div>

  {enablePaystack && (
    <script is:inline define:vars={{ invoiceId: invoiceData.invoiceId, token: providedToken }}>
      /*
        Server-authoritative checkout.

        The old flow built the charge in the browser: amount, currency, email and
        reference were all client-side values, and the reference embedded a
        documentId that was always undefined (Payload REST returns `id`, not
        `_id`), so verification rejected the payment AFTER the card was charged.

        Now the server computes everything from the stored invoice and returns a
        Paystack authorization_url. Redirecting also behaves far better on mobile
        browsers than the inline iframe.
      */
      document.addEventListener('DOMContentLoaded', () => {
        // There can be two buttons now (deposit / full). Each remembers its own
        // label: the previous code restored the hardcoded string "Pay Online
        // Securely" on failure, which would have relabelled the deposit button
        // with the wrong amount.
        const buttons = Array.prototype.slice.call(document.querySelectorAll('[data-pay]'));
        if (!buttons.length) return;
        const btn = buttons[0];
        buttons.forEach((b) => { b.dataset.label = b.innerHTML; });
        const setBusy = (text) => buttons.forEach((b) => { b.disabled = true; b.textContent = text; });
        const restore = () => buttons.forEach((b) => { b.disabled = false; b.innerHTML = b.dataset.label; });

        // Returning from Paystack: settle, then show the real outcome.
        const params = new URLSearchParams(window.location.search);
        const ref = params.get('ref') || params.get('reference');
        const statusEl = document.getElementById('paystackStatus');

        const say = (msg, kind) => {
          if (!statusEl) return;
          statusEl.textContent = msg;
          statusEl.className = 'paystack-status ' + (kind || '');
          statusEl.style.display = 'block';
        };

        if (ref) {
          setBusy('Confirming payment...');
          say('Confirming your payment...', '');
          fetch('/api/verify-paystack/', {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ reference: ref }),
          })
            .then((r) => r.json())
            .then((data) => {
              if (data.ok) {
                // A deposit must not be reported as "paid": the client still
                // owes the balance and needs to be told so.
                let msg = 'Payment confirmed. Thank you!';
                if (data.alreadyPaid || data.alreadyApplied) {
                  msg = 'This payment has already been recorded. Thank you.';
                } else if (data.fullySettled === false) {
                  msg = 'Deposit received, thank you. The remaining balance is shown above.';
                }
                say(msg, 'ok');
                params.delete('ref');
                params.delete('reference');
                setTimeout(() => {
                  window.location.replace(window.location.pathname + '?' + params.toString());
                }, 1800);
              } else {
                // Never claim success on a failed settle: the customer has paid
                // and needs to know it did not land.
                say(data.error || 'I could not confirm this payment. Please contact me.', 'err');
                restore();
              }
            })
            .catch(() => {
              say('I could not confirm this payment. Please contact me with your reference.', 'err');
              restore();
            });
          return;
        }

        buttons.forEach((b) => {
          b.addEventListener('click', () => {
            const payWhat = b.dataset.pay === 'deposit' ? 'deposit' : 'full';
            setBusy('Starting secure checkout...');
            fetch('/api/paystack-init/', {
              method: 'POST',
              headers: { 'Content-Type': 'application/json' },
              // The server decides the amount; this only says which option was
              // chosen.
              body: JSON.stringify({ invoiceId, token, payWhat }),
            })
              .then((r) => r.json())
              .then((data) => {
                if (data.ok && data.authorizationUrl) {
                  window.location.href = data.authorizationUrl;
                } else {
                  say(data.error || 'Could not start payment. Please contact me.', 'err');
                  restore();
                }
              })
              .catch(() => {
                say('Could not start payment. Please contact me.', 'err');
                restore();
              });
          });
        });
      });
    </script>
  )}
</BaseLayout>

<style>
  .paystack-status {
    margin-top: 12px;
    padding: 10px 14px;
    border-radius: 8px;
    font-size: 0.95rem;
    text-align: center;
    background: var(--bg-inset);
    color: var(--text-primary);
  }
  .deposit-note {
    margin-top: 10px;
    font-size: 0.875rem;
    line-height: 1.6;
    color: var(--inv-text-muted);
  }
  .paystack-status.ok  { background: rgba(46, 204, 113, 0.12); color: #1e8449; }
  .paystack-status.err { background: rgba(231, 76, 60, 0.12);  color: #c0392b; }

  /* Base Variables Specific to Invoice */
  :root {
    --inv-bg: #0a0a0c;
    --inv-card: rgba(255, 255, 255, 0.03);
    --inv-border: rgba(255, 255, 255, 0.08);
    --inv-text: #e2e8f0;
    --inv-text-muted: #94a3b8;
    --inv-accent: #06b6d4;
    --inv-accent-glow: rgba(6, 182, 212, 0.3);
    --inv-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
    --inv-watermark: rgba(255, 255, 255, 0.1);
    --inv-brand-from: #fff;
    --inv-brand-to: #94a3b8;
  }

  /* Light mode. These were only ever defined dark, so in light mode the page
     chrome turned white while the invoice itself stayed black, and the toolbar
     buttons went white-on-white. The values mirror the @media print block
     below, which already had to solve exactly this problem. */
  :root[data-theme="light"] {
    --inv-bg: #eef2f7;
    --inv-card: #ffffff;
    --inv-border: #e2e8f0;
    --inv-text: #0f172a;
    --inv-text-muted: #64748b;
    --inv-accent: #0e7490;
    --inv-accent-glow: rgba(6, 182, 212, 0.14);
    --inv-shadow: 0 18px 40px -18px rgba(15, 23, 42, 0.28);
    --inv-watermark: rgba(15, 23, 42, 0.07);
    --inv-brand-from: #0f172a;
    --inv-brand-to: #475569;
  }

  .invoice-page-wrapper {
    min-height: 100vh;
    background-color: var(--inv-bg);
    position: relative;
    z-index: 1;
    /* The markup asked for `pt-150 pb-100`; neither class exists anywhere in
       the codebase, so the page had no top padding at all and slid underneath
       the position:fixed navbar: the Back and Print buttons rendered on top
       of the logo and the Book a Call button. Set real spacing here. */
    padding-top: 140px;
    padding-bottom: 100px;
  }

  @media (max-width: 768px) {
    .invoice-page-wrapper {
      padding-top: 110px;
      padding-bottom: 60px;
    }
  }

  .invoice-actions {
    display: flex;
    justify-content: space-between;
    align-items: center;
    margin-bottom: 2rem;
    max-width: 900px;
    margin-left: auto;
    margin-right: auto;
  }

  .invoice-container {
    max-width: 900px;
    margin: 0 auto;
    background: var(--inv-card);
    border: 1px solid var(--inv-border);
    border-radius: 24px;
    padding: 4rem;
    position: relative;
    overflow: hidden;
    backdrop-filter: blur(20px);
    box-shadow: var(--inv-shadow);
    color: var(--inv-text);
  }

  /* Decorative Glows */
  .invoice-glow-top {
    position: absolute;
    top: -150px;
    right: -150px;
    width: 300px;
    height: 300px;
    background: var(--inv-accent);
    filter: blur(150px);
    opacity: 0.3;
    z-index: -1;
  }
  
  .invoice-glow-bottom {
    position: absolute;
    bottom: -150px;
    left: -150px;
    width: 300px;
    height: 300px;
    background: #6366f1;
    filter: blur(150px);
    opacity: 0.2;
    z-index: -1;
  }

  /* Header */
  .invoice-header {
    display: flex;
    justify-content: space-between;
    align-items: flex-start;
    border-bottom: 1px solid var(--inv-border);
    padding-bottom: 3rem;
    margin-bottom: 3rem;
  }

  .invoice-brand {
    display: flex;
    flex-direction: column;
  }

  .brand-name {
    font-size: 2.5rem;
    font-weight: 800;
    margin: 0;
    letter-spacing: -1px;
    background: linear-gradient(135deg, var(--inv-brand-from) 0%, var(--inv-brand-to) 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
  }

  .brand-suffix {
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 4px;
    color: var(--inv-accent);
    margin-top: 4px;
  }

  .invoice-meta {
    text-align: right;
  }

  .invoice-title {
    font-size: 3rem;
    font-weight: 700;
    margin: 0 0 1rem 0;
    letter-spacing: 2px;
    color: var(--inv-watermark);
    text-transform: uppercase;
  }

  .meta-details {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    margin-bottom: 1.5rem;
  }

  .meta-item {
    display: flex;
    justify-content: flex-end;
    gap: 1rem;
    font-size: 0.95rem;
  }

  .meta-label {
    color: var(--inv-text-muted);
  }

  .meta-value {
    font-weight: 600;
    color: var(--inv-text);
    min-width: 120px;
  }

  .invoice-status {
    display: inline-block;
    padding: 0.4rem 1.2rem;
    border-radius: 50px;
    font-size: 0.85rem;
    font-weight: 700;
    letter-spacing: 1px;
    text-transform: uppercase;
  }

  .invoice-status.pending {
    background: rgba(245, 158, 11, 0.1);
    color: #f59e0b;
    border: 1px solid rgba(245, 158, 11, 0.3);
  }
  .invoice-status.paid {
    background: rgba(16, 185, 129, 0.1);
    color: #10b981;
    border: 1px solid rgba(16, 185, 129, 0.3);
  }

  /* Addresses */
  .invoice-addresses {
    display: flex;
    justify-content: space-between;
    margin-bottom: 4rem;
  }

  .address-block {
    flex: 1;
  }
  .text-right {
    text-align: right;
  }

  .address-title {
    font-size: 0.9rem;
    color: var(--inv-text-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin: 0 0 1rem 0;
  }

  .address-name {
    font-size: 1.2rem;
    font-weight: 700;
    margin: 0 0 0.5rem 0;
    color: var(--inv-text);
  }

  .address-contact, .address-text, .address-email, .address-website {
    margin: 0 0 0.25rem 0;
    color: var(--inv-text-muted);
    font-size: 0.95rem;
    line-height: 1.5;
    white-space: pre-line;
  }

  /* Table */
  .invoice-items {
    margin-bottom: 4rem;
  }

  .items-table {
    width: 100%;
    border-collapse: collapse;
  }

