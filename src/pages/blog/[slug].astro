---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { sanityClient } from "sanity:client";
import { PortableText } from "astro-portabletext";

// Fetch the post by slug
const { slug } = Astro.params;
const post = await sanityClient.fetch(
    `*[_type == "blogPost" && slug.current == $slug][0] {
        title,
        slug,
        excerpt,
        coverImage,
        body,
        publishedAt,
        author,
        seoDescription,
        "categoryTitle": category->title,
        "categorySlug": category->slug.current
    }`,
    { slug }
);

if (!post) {
    return Astro.redirect('/blog');
}

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

function buildImageUrl(ref: string, width: number = 1200) {
    if (!ref) return '';
    return `https://cdn.sanity.io/images/xectqauu/production/${ref.replace('image-', '').replace('-jpg', '.jpg').replace('-png', '.png').replace('-webp', '.webp').replace('-jpeg', '.jpeg')}?auto=format&fit=max&w=${width}&q=85`;
}

const coverUrl = post.coverImage?.asset?._ref ? buildImageUrl(post.coverImage.asset._ref) : null;
---
<BaseLayout title={`${post.title} | Quadem Digital Blog`} description={post.seoDescription || post.excerpt || ""} activePage="blog" navbarScrolled={true}>
    <section class="blog-post-hero">
        <div class="container">
            {post.categoryTitle && (
                <span style="color: var(--accent); font-weight: 500; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 12px; font-size: 0.85rem;">
                    {post.categoryTitle}
                </span>
            )}
            <h1 style="max-width: 800px; margin: 0 auto;">{post.title}</h1>
            <div class="blog-post-meta">
                {post.author && <span>By {post.author}</span>}
                {post.publishedAt && (
                    <>
                        <span>•</span>
                        <span>{formatDate(post.publishedAt)}</span>
                    </>
                )}
            </div>
        </div>
    </section>

    <div class="blog-post-content">
        {coverUrl && (
            <div class="blog-post-cover">
                <img src={coverUrl} alt={post.title} />
            </div>
        )}

        {post.body && (
            <div class="portable-text-body">
                <PortableText value={post.body} />
            </div>
        )}

        <div style="text-align: center; margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-color);">
            <a href="/blog" class="btn btn-ghost btn-pill">← Back to Blog</a>
            <a href="/contact" class="btn btn-primary btn-pill glow-effect" style="margin-left: 16px;">Start Your Project</a>
        </div>
    </div>
</BaseLayout>
