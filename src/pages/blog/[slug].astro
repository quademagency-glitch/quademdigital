---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch, buildPayloadImageUrl } from "../../lib/payload";
import { PortableText } from "astro-portabletext";
import PortableTextImage from "../../components/PortableTextImage.astro";

const portableTextComponents = {
  type: {
    image: PortableTextImage
  }
};

interface Props {
  post: any;
}

// Fetch the post by slug
const { slug } = Astro.params;
const posts = await payloadFetch('blogPosts', {
  'where[slug][equals]': slug,
  depth: '1'
});
const post = posts[0];

if (!post) {
    return Astro.redirect('/blog');
}

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

const coverUrl = post.coverImage ? buildPayloadImageUrl(post.coverImage) : null;

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "image": coverUrl ? [coverUrl] : [],
    "datePublished": post.publishedAt,
    "author": {
        "@type": "Person",
        "name": post.author || "Quadem Digital"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Quadem Digital Enterprise",
        "logo": {
            "@type": "ImageObject",
            "url": "https://quademdigital.com/images/logo.png"
        }
    },
    "description": post.seoDescription || post.excerpt || ""
};
---
<BaseLayout title={`${post.title} | Quadem Digital Blog`} description={post.seoDescription || post.excerpt || ""} activePage="blog" navbarScrolled={true} ogImage={coverUrl || undefined} jsonLd={jsonLd}>
    <section class="blog-post-hero">
        <div class="container">
            {post.category?.title && (
                <span style="color: var(--accent); font-weight: 500; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 12px; font-size: 0.85rem;">
                    {post.category.title}
                </span>
            )}
            <h1 style="max-width: 800px; margin: 0 auto;">{post.title}</h1>
            <div class="blog-post-meta">
                {post.author && <span>By {post.author}</span>}
                {post.publishedAt && (
                    <>
                        <span>•</span>
                        <span>{formatDate(post.publishedAt)}</span>
                    </>
                )}
            </div>
        </div>
    </section>

    <div class="blog-post-content">
        {coverUrl && (
            <div class="blog-post-cover">
                <img src={coverUrl} alt={post.title} />
            </div>
        )}

        {post.body && (
            <div class="portable-text-body">
                <PortableText value={post.body} components={portableTextComponents} />
            </div>
        )}

        <div style="text-align: center; margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-color);">
            <a href="/blog" class="btn btn-ghost btn-pill">← Back to Blog</a>
            <a href="/contact" class="btn btn-primary btn-pill glow-effect" style="margin-left: 16px;">Start Your Project</a>
        </div>
    </div>
</BaseLayout>
