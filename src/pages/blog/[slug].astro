---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { payloadFetch, buildPayloadImageUrl, lexicalToHtml } from "../../lib/payload";
import Picture from "../../components/Picture.astro";
import PreviewBanner from "../../components/PreviewBanner.astro";
import { isPreviewSession, PREVIEW_COOKIE } from "../../lib/preview";

interface Props {
  post: any;
}

// Fetch the post by slug. In a verified preview session, ask for the draft
// instead, so the Preview button in the CMS shows the real page template rather
// than a separate approximation of it that would drift out of step.
const isPreview = isPreviewSession(Astro.cookies.get(PREVIEW_COOKIE)?.value);
const { slug } = Astro.params;
const posts = await payloadFetch('blogPosts', {
  'where[slug][equals]': slug,
  depth: '1'
}, { draft: isPreview });
const post = posts[0];

if (!post) {
    return Astro.redirect('/blog');
}

// A draft must never be cached at the edge, or the next visitor gets it.
if (isPreview) Astro.response.headers.set('Cache-Control', 'no-store');

const allRecentPosts = await payloadFetch('blogPosts', {
    limit: 10,
    depth: '1',
    sort: '-publishedAt'
});
let relatedPosts = allRecentPosts.filter((p: any) => p.slug !== slug);
if (post.category?.id) {
    const sameCat = relatedPosts.filter((p: any) => p.category?.id === post.category.id);
    if (sameCat.length >= 3) {
        relatedPosts = sameCat;
    } else {
        const others = relatedPosts.filter((p: any) => p.category?.id !== post.category.id);
        relatedPosts = [...sameCat, ...others];
    }
}
relatedPosts = relatedPosts.slice(0, 3);

function formatDate(dateStr: string) {
    if (!dateStr) return '';
    return new Date(dateStr).toLocaleDateString('en-US', { year: 'numeric', month: 'long', day: 'numeric' });
}

/**
 * Topic-matched offer, shown where the post ends.
 *
 * The only CTA here used to be a generic "Start Your Project" button sitting
 * below the related articles — past the point most readers stop, and asking
 * for a project from someone who came to read one post. These point at the
 * three real offers instead, so the ask matches what they were just reading.
 *
 * Matched on category first, then on words in the slug: two posts
 * (5-signs-business-needs-website-redesign, ghanaian-business-social-media-
 * marketing) carry no category in the CMS, and new posts may not either.
 */
const OFFERS = {
    seo: {
        href: '/offers/free-seo-audit/',
        heading: 'Want to know what is holding your rankings back?',
        body: "I'll audit your site's technical setup and performance, then send you the fixes worth making, in the order worth making them. Free.",
        cta: 'Get My Free Audit'
    },
    social: {
        href: '/offers/social-media-bonus/',
        heading: 'Want your social handled for a month, on me?',
        body: 'Start a project with me and I run your social media for the first month at no extra cost. Posts, captions and scheduling included.',
        cta: 'Claim the Free Month'
    },
    web: {
        href: '/offers/web-dev-discount/',
        heading: 'Thinking about rebuilding your site?',
        body: "Your first custom web project is 15% off. You'll know the exact price and timeline before anything starts.",
        cta: 'Get 15% Off'
    }
};

function pickOffer(p: any) {
    const haystack = `${p.category?.title || p.category?.name || ''} ${p.slug || ''}`.toLowerCase();
    if (haystack.includes('seo') || haystack.includes('search')) return OFFERS.seo;
    if (haystack.includes('social') || haystack.includes('marketing')) return OFFERS.social;
    if (haystack.includes('web') || haystack.includes('design') || haystack.includes('site')) return OFFERS.web;
    return OFFERS.seo;
}

const offer = pickOffer(post);

/*
  coverUrl stays the full size file because og:image and schema.org want the
  largest version. What the page paints is a different question: the cover box
  is 760px of content minus padding, so 720px wide at most, and it was being
  handed the 1024px original, over 100KB, with nothing smaller offered.
*/
const coverUrl = post.coverImage ? buildPayloadImageUrl(post.coverImage) : null;
const COVER_SIZES = "(max-width: 760px) 100vw, 720px";

let pageDescription = post.seoDescription || post.excerpt || "";
if (slug === 'future-of-web-dev') {
    pageDescription = "Where web development is heading, from server components to AI in the browser, and what that means for your site.";
}

let pageTitle = `${post.title} | Quadem Digital`;
if (slug === 'how-to-choose-right-digital-agency') {
    pageTitle = 'How to Choose the Right Digital Agency | Quadem Digital';
} else if (slug === 'ghanaian-business-social-media-marketing') {
    /*
      Was keyed on the old nigerian- slug. That slug now 308s to this one, so
      this branch could never run: the post fell through to the length fallback
      below, which drops the suffix, and it was the only post on the site whose
      search result carried no brand name. The dead branch also still said
      "Nigerian Businesses", which would have contradicted the retitled post if
      it had ever fired.
    */
    pageTitle = 'Social Media Marketing in Ghana | Quadem Digital';
} else if (slug === 'mastering-seo-5-strategies-dominate-search') {
    pageTitle = 'Mastering SEO: 5 Strategies to Rank Higher | Quadem Digital';
} else if (slug === '5-signs-business-needs-website-redesign') {
    pageTitle = '5 Signs You Need a Website Redesign | Quadem Digital';
} else if (pageTitle.length > 65) {
    pageTitle = post.title;
}

const jsonLd = {
    "@context": "https://schema.org",
    "@type": "BlogPosting",
    "headline": post.title,
    "image": coverUrl ? [coverUrl] : [],
    "datePublished": post.publishedAt,
    "author": {
        // Declared as a Person, so the name has to be one. It fell back to the
        // company name, which is the one thing a Person must not be.
        "@type": "Person",
        "name": post.author || "Ernest Avorwlanu"
    },
    "publisher": {
        "@type": "Organization",
        "name": "Quadem Digital Enterprise",
        "logo": {
            "@type": "ImageObject",
            "url": "https://quademdigital.com/images/logo.webp"
        }
    },
    "description": pageDescription
};
---
<BaseLayout title={pageTitle} description={pageDescription} activePage="blog" navbarScrolled={true} ogImage={coverUrl || undefined} jsonLd={jsonLd}>
    {isPreview && (
        <PreviewBanner label="Draft blog post" unpublished={post._status !== 'published'} />
    )}
    <section class="blog-post-hero">
        <div class="container">
            {post.category?.title && (
                <span style="color: var(--accent-text); font-weight: 500; text-transform: uppercase; letter-spacing: 1px; display: block; margin-bottom: 12px; font-size: 0.85rem;">
                    {post.category.title}
                </span>
            )}
            <h1 style="max-width: 800px; margin: 0 auto;">{post.title}</h1>
            <div class="blog-post-meta">
                {post.author && <span>By {post.author}</span>}
                {post.publishedAt && (
                    <>
                        <span>•</span>
                        <span>{formatDate(post.publishedAt)}</span>
                    </>
                )}
            </div>
        </div>
    </section>

    <div class="blog-post-content">
        {coverUrl && (
            <div class="blog-post-cover">
                <Picture image={post.coverImage} alt={post.title} sizes={COVER_SIZES} size="medium" width={post.coverImage?.width ?? undefined} height={post.coverImage?.height ?? undefined} priority />
            </div>
        )}

        {post.content && (
            <div class="portable-text-body" set:html={lexicalToHtml(post.content)} />
        )}

        <aside class="blog-offer" aria-labelledby="blog-offer-heading">
            <h3 id="blog-offer-heading">{offer.heading}</h3>
            <p>{offer.body}</p>
            <a href={offer.href} class="btn btn-primary btn-pill glow-effect" data-track="blog_offer_cta" data-loc={`blog:${slug}`}>{offer.cta}</a>
        </aside>

        <div style="margin-top: 60px; padding-top: 40px; border-top: 1px solid var(--border-color);">
            <h3 style="margin-bottom: 24px;">Related Articles</h3>
            <div style="display: grid; grid-template-columns: repeat(auto-fill, minmax(280px, 1fr)); gap: 24px;">
                {relatedPosts.map((rp: any) => (
                    <a href={`/blog/${rp.slug}/`} style="text-decoration: none; color: inherit; background: var(--bg-card); border: 1px solid var(--border-color); border-radius: 12px; padding: 20px; display: block; transition: transform 0.2s, box-shadow 0.2s;">
                        <h4 style="font-size: 1.1rem; margin-bottom: 8px;">{rp.title}</h4>
                        <span style="font-size: 0.85rem; color: var(--text-muted);">{formatDate(rp.publishedAt)}</span>
                    </a>
                ))}
            </div>
            
            <div style="text-align: center; margin-top: 40px;">
                <a href="/blog/" class="btn btn-ghost btn-pill">← Back to Blog</a>
                <a href="/contact/" class="btn btn-primary btn-pill glow-effect" style="margin-left: 16px;">Start Your Project</a>
            </div>
        </div>
    </div>
</BaseLayout>
