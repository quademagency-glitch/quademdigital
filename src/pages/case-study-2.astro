---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Scaling User Acquisition with Targeted Ads | Quadem Digital" description="Case study detailing how we implemented a multi-channel ad strategy to bring in high-quality leads." activePage="projects" navbarScrolled={true}>
    <section class="section-padding" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
        <div class="container">
            <span class="badge glow-effect mb-4" style="display: inline-block;">Coming Soon</span>
            <h1 style="margin-bottom: 24px;">Scaling User Acquisition with Targeted Ads</h1>
            <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto 32px; line-height: 1.6;">
                We are currently writing this case study to share the ad strategies, creative testing, and funnel optimizations we used to achieve a 50% reduction in CPA for this SaaS startup.
            </p>
            <a href="/projects" class="btn btn-primary btn-pill glow-effect">Back to Projects</a>
        </div>
    </section>
</BaseLayout>
