---
// src/pages/brand-studio.astro
// Quadem Brand Studio: monthly content-subscription offer page.
// Blended styling: site theme tokens (navy + light/dark aware) with a
// purple→orange gradient reserved for the Brand Studio "pop" (headline,
// primary CTAs, popular card, step numbers). No backend, so CTAs go to
// WhatsApp (CMS number, prefilled) + the site's existing Calendly link.

import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetchGlobal } from "../lib/payload";

export const prerender = true;

const siteSettings = await payloadFetchGlobal("siteSettings");
const WHATSAPP = siteSettings?.whatsappNumber || "233530890302";
const CALENDLY = "https://calendly.com/quadem-agency/free-strategy-call";

const wa = (msg: string) =>
  `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const packages = [
  {
    name: "Starter",
    price: "1,800",
    blurb: "Stay consistent on one platform without doing it yourself.",
    features: [
      "12 branded posts / month",
      "4 short-form videos (reels)",
      "1 platform of your choice",
      "Monthly content calendar",
    ],
    popular: false,
    cta: "Start with Starter",
  },
  {
    name: "Growth",
    price: "3,500",
    blurb: "Content that keeps posting and ads that bring in sales.",
    features: [
      "20 branded posts / month",
      "6 short-form videos (reels)",
      "8 ad creatives for testing",
      "2 to 3 platforms, cross-posted",
      "Monthly performance report",
    ],
    popular: true,
    cta: "Get Growth",
  },
  {
    name: "Scale",
    price: "8,000",
    blurb: "Full coverage across every platform for brands growing fast.",
    features: [
      "30 branded posts / month",
      "10 short-form videos (reels)",
      "12 ad creatives + paid-ad creative",
      "All platforms covered",
      "Advanced analytics & reporting",
    ],
    popular: false,
    cta: "Go Scale",
  },
];

const steps = [
  { n: "1", t: "Brand DNA", d: "We map your voice, colours and offers once. You approve it, we lock it in." },
  { n: "2", t: "We produce", d: "Every month we create your posts, reels and ad creatives. No shoots, no waiting around." },
  { n: "3", t: "You approve", d: "You review the month's content in one go. Tweak anything you want." },
  { n: "4", t: "We publish & report", d: "We schedule everything across your platforms and send you the results." },
];

const faqs = [
  { q: "How is this different from your Branding & Identity service?", a: "Branding & Identity is a one-time project: your logo, colours and brand kit. Brand Studio is ongoing. It is a content team on subscription that produces and publishes fresh posts, reels and ads every month." },
  { q: "Do I need to send you photos or do a shoot?", a: "No. We produce premium visuals and video without a shoot. If you have a product photo or two, send them over and we'll use them, but it isn't required." },
  { q: "Can I change my plan later?", a: "Anytime. Most clients start on Growth and move up as results come in. There is no long lock-in." },
  { q: "How do I pay?", a: "Monthly, by MoMo or bank transfer. You know your cost up front, so there are no surprises." },
  { q: "What if I don't like a post?", a: "You approve everything before it goes live. Revisions are included, and we don't publish anything you haven't signed off on." },
];

// FAQ structured data for rich results
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title="Quadem Brand Studio | Your Brand's Content Team, On Subscription"
  description="Premium social posts, reels and ad creatives every month, with no shoots and no hassle. A monthly content subscription for Ghanaian brands that want to grow."
  activePage="brand-studio"
  navbarScrolled={true}
  jsonLd={jsonLd}
>
  <main class="bs">
    <!-- HERO -->
    <section class="bs-hero">
      <span class="bs-eyebrow">New · Quadem Brand Studio</span>
      <h1>Your brand's content team,<br /><span class="bs-grad">on subscription.</span></h1>
      <p class="bs-sub">
        Premium posts, reels and ad creatives, produced and published every month.
        No shoots to organise and no one to hire. You pay a fixed monthly fee and we keep your brand visible.
      </p>
      <div class="bs-hero-cta">
        <a class="bs-btn bs-btn-primary" href={CALENDLY} target="_blank" rel="noopener noreferrer">Book a Free Strategy Call</a>
        <a class="bs-btn bs-btn-ghost" href="#pricing">See Plans &amp; Pricing</a>
      </div>
      <p class="bs-trust">Built for Ghana. MoMo payments accepted, and you deal with the founder directly.</p>
    </section>

    <!-- HOW IT WORKS -->
    <section class="bs-how">
      <h2>How Brand Studio works</h2>
      <p class="bs-section-sub">Set it up once and fresh content lands in your inbox every month.</p>
      <div class="bs-steps">
        {steps.map((s) => (
          <div class="bs-step">
            <div class="bs-step-n">{s.n}</div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="bs-pricing">
      <h2>Simple monthly plans</h2>
      <p class="bs-section-sub">Fixed price, fixed scope, and you can cancel anytime. Prices in Ghana Cedis.</p>
      <div class="bs-grid">
        {packages.map((p) => (
          <div class={`bs-card${p.popular ? " bs-card-popular" : ""}`}>
            {p.popular && <span class="bs-badge">Most Popular</span>}
            <h3 class="bs-card-name">{p.name}</h3>
            <div class="bs-card-price"><span class="bs-from">from</span> GHS {p.price}<span class="bs-mo">/mo</span></div>
            <p class="bs-card-blurb">{p.blurb}</p>
            <ul class="bs-features">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a
              class={`bs-btn ${p.popular ? "bs-btn-primary" : "bs-btn-ghost"} bs-card-cta`}
              href={wa(`Hi Quadem! I'm interested in the Brand Studio ${p.name} plan.`)}
              target="_blank"
              rel="noopener noreferrer"
            >
              {p.cta}
            </a>
          </div>
        ))}
      </div>
      <p class="bs-addons">
        <strong>Add-ons:</strong> paid-ad management (10 to 15% of ad spend), one-off launch campaigns, and product-photo packs.
      </p>
      <p class="bs-unsure">
        Not sure which plan fits? <a href={wa("Hi Quadem! Which Brand Studio plan is right for my business?")} target="_blank" rel="noopener noreferrer">Chat with us on WhatsApp →</a>
      </p>
    </section>

    <!-- WHY -->
    <section class="bs-why">
      <h2>Why brands choose Brand Studio</h2>
      <div class="bs-why-grid">
        <div class="bs-why-item"><h3>Cheaper than one hire</h3><p>A full month of content costs less than a single junior marketer, and it shows up every month without fail.</p></div>
        <div class="bs-why-item"><h3>You never go quiet</h3><p>Consistency is what grows a page. We keep you posting even in your busiest weeks.</p></div>
        <div class="bs-why-item"><h3>Built to convert</h3><p>Every creative is designed to bring customers, not just likes, and the monthly report shows you what worked.</p></div>
      </div>
    </section>

    <!-- FAQ -->
    <section class="bs-faq">
      <h2>Frequently asked questions</h2>
      {faqs.map((f) => (
        <details class="bs-faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <!-- FINAL CTA -->
    <section class="bs-final">
      <h2>Ready to never worry about content again?</h2>
      <p>Book a free 15-minute call. We'll show you exactly what your first month would look like.</p>
      <div class="bs-hero-cta">
        <a class="bs-btn bs-btn-primary" href={CALENDLY} target="_blank" rel="noopener noreferrer">Book a Free Strategy Call</a>
        <a class="bs-btn bs-btn-ghost" href={wa("Hi Quadem! I'd like to start with Brand Studio.")} target="_blank" rel="noopener noreferrer">Chat on WhatsApp</a>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  /* Brand Studio gradient: the one deliberate deviation from site blue,
     used only for pop. Everything else rides the site's theme tokens. */
  .bs { --bs-g1:#7c5cff; --bs-g2:#f97316; color:var(--text-primary); }
  .bs section { max-width:1120px; margin:0 auto; padding:72px 20px; }
  .bs h1 { font-size:clamp(2.2rem,5vw,3.6rem); line-height:1.05; margin:.4em 0; font-weight:800; letter-spacing:-.02em; font-family:var(--font-heading); }
  .bs h2 { font-size:clamp(1.6rem,3vw,2.3rem); text-align:center; font-weight:800; letter-spacing:-.01em; font-family:var(--font-heading); color:var(--text-primary); }
  .bs h3 { color:var(--text-primary); }
  .bs-grad { background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .bs-section-sub { text-align:center; color:var(--text-muted); margin:.6em auto 2.5em; max-width:560px; }

  /* hero: extra top padding to clear the fixed navbar */
  .bs-hero { text-align:center; padding-top:140px; background:radial-gradient(circle at 50% 0%, rgba(124,92,255,0.08) 0%, transparent 55%); }
  .bs-eyebrow { display:inline-block; font-size:.8rem; letter-spacing:.08em; text-transform:uppercase;
                color:var(--bs-g1); border:1px solid var(--border-color); border-radius:999px; padding:6px 14px; }
  .bs-sub { color:var(--text-muted); font-size:1.12rem; max-width:620px; margin:1em auto 2em; line-height:1.6; }
  .bs-hero-cta { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
  .bs-trust { color:var(--text-muted); font-size:.9rem; margin-top:1.8em; }

  /* buttons */
  .bs-btn { display:inline-block; padding:14px 26px; border-radius:12px; font-weight:700; text-decoration:none;
            transition:transform .15s ease, opacity .15s ease; }
  .bs-btn:hover { transform:translateY(-2px); }
  .bs-btn-primary { background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2)); color:#fff; }
  .bs-btn-ghost { border:1px solid var(--border-color); color:var(--text-primary); background:rgba(255,255,255,0.03); }

  /* steps */
  .bs-steps { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
  .bs-step { background:rgba(255,255,255,0.02); border:1px solid var(--border-color); border-radius:16px; padding:24px; }
  .bs-step-n { width:38px; height:38px; border-radius:10px; display:grid; place-items:center; font-weight:800;
               background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2)); color:#fff; margin-bottom:12px; }
  .bs-step h3 { margin:.2em 0; font-size:1.05rem; }
  .bs-step p { color:var(--text-muted); font-size:.92rem; line-height:1.5; }

  /* pricing */
  .bs-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; align-items:stretch; }
  .bs-card { position:relative; background:rgba(255,255,255,0.02); border:1px solid var(--border-color); border-radius:20px;
             padding:30px 26px; display:flex; flex-direction:column; }
  .bs-card-popular { border-color:var(--bs-g1); box-shadow:0 0 0 1px var(--bs-g1), 0 20px 60px -30px var(--bs-g1); }
  .bs-badge { position:absolute; top:-13px; left:50%; transform:translateX(-50%); background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2));
              color:#fff; font-size:.72rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; padding:5px 14px; border-radius:999px; }
  .bs-card-name { font-size:1.3rem; margin:0 0 .2em; }
  .bs-card-price { font-size:2rem; font-weight:800; margin:.1em 0 .4em; color:var(--text-primary); }
  .bs-from { font-size:.85rem; color:var(--text-muted); font-weight:600; margin-right:6px; }
  .bs-mo { font-size:1rem; color:var(--text-muted); font-weight:600; }
  .bs-card-blurb { color:var(--text-muted); font-size:.95rem; margin-bottom:1.2em; line-height:1.5; }
  .bs-features { list-style:none; padding:0; margin:0 0 1.6em; flex:1; }
  .bs-features li { padding:9px 0 9px 26px; position:relative; border-top:1px solid var(--border-color); font-size:.94rem; }
  .bs-features li:before { content:"✓"; position:absolute; left:0; color:var(--bs-g1); font-weight:800; }
  .bs-card-cta { text-align:center; }
  .bs-addons { text-align:center; color:var(--text-muted); margin-top:2.4em; font-size:.95rem; }
  .bs-unsure { text-align:center; margin-top:.6em; }
  .bs-unsure a { color:var(--bs-g1); font-weight:700; text-decoration:none; }

  /* why */
  .bs-why-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:2.4em; }
  .bs-why-item { background:rgba(255,255,255,0.02); border:1px solid var(--border-color); border-radius:16px; padding:26px; }
  .bs-why-item h3 { margin:0 0 .4em; font-size:1.1rem; }
  .bs-why-item p { color:var(--text-muted); line-height:1.55; font-size:.95rem; }

  /* faq */
  .bs-faq { max-width:760px; }
  .bs-faq-item { background:rgba(255,255,255,0.02); border:1px solid var(--border-color); border-radius:12px; padding:4px 20px; margin:12px 0; }
  .bs-faq-item summary { cursor:pointer; padding:16px 0; font-weight:600; list-style:none; color:var(--text-primary); }
  .bs-faq-item summary::-webkit-details-marker { display:none; }
  .bs-faq-item summary:after { content:"+"; float:right; color:var(--bs-g1); font-weight:800; }
  .bs-faq-item[open] summary:after { content:"-"; }
  .bs-faq-item p { color:var(--text-muted); padding:0 0 16px; line-height:1.6; margin:0; }

  /* final */
  .bs-final { text-align:center; background:rgba(255,255,255,0.02); border:1px solid var(--border-color); border-radius:24px;
              max-width:1080px; margin:0 auto 72px; }
  .bs-final p { color:var(--text-muted); max-width:520px; margin:.8em auto 2em; }

  @media (max-width:880px){
    .bs-steps,.bs-grid,.bs-why-grid{ grid-template-columns:1fr; }
    .bs-card-popular{ order:-1; }
  }
</style>
