---
// src/pages/brand-studio.astro
// Quadem Brand Studio: monthly content-subscription offer page.
// Blended styling: site theme tokens (navy + light/dark aware) with a
// purple→orange gradient reserved for the Brand Studio "pop" (headline,
// primary CTAs, popular card, step numbers). No backend, so CTAs go to
// WhatsApp (CMS number, prefilled) + the site's existing Calendly link.

import BaseLayout from "../layouts/BaseLayout.astro";
import { payloadFetchGlobal, payloadFetch } from "../lib/payload";

export const prerender = true;

// Content is CMS-editable via the `brandStudioPage` global. Everything below
// falls back to the original copy when the global has no data yet (e.g. before
// the CMS is deployed), so the page renders identically either way.
const siteSettings = await payloadFetchGlobal("siteSettings");
const bs: any = (await payloadFetchGlobal("brandStudioPage")) || {};

// Social proof: up to 3 published testimonials (renders nothing if none exist).
const testimonialsRaw: any[] = (await payloadFetch("testimonials", { sort: "order", limit: "6", depth: "0" })) || [];
const testimonials = testimonialsRaw
  .filter((t) => t && t.quote && t.published !== false)
  .slice(0, 3);

const WHATSAPP = bs?.settings?.whatsappNumber || siteSettings?.whatsappNumber || "233530890302";
const CALENDLY = bs?.settings?.calendlyUrl || "https://calendly.com/quadem-agency/free-strategy-call";

const wa = (msg: string) =>
  `https://wa.me/${WHATSAPP}?text=${encodeURIComponent(msg)}`;

const metaTitle = bs?.title || "Quadem Brand Studio | Your Brand's Content Team, On Subscription";
const metaDescription = bs?.description || "Premium social posts, reels and ad creatives every month, with no shoots and no hassle. A monthly content subscription for Ghanaian brands that want to grow.";

const hero = {
  eyebrow: bs?.hero?.eyebrow || "New · Quadem Brand Studio",
  headingTop: bs?.hero?.headingTop || "Your brand's content team,",
  headingAccent: bs?.hero?.headingAccent || "on subscription.",
  subheading: bs?.hero?.subheading || "Premium posts, reels and ad creatives, produced and published every month. No shoots to organise and no one to hire. You pay a fixed monthly fee and we keep your brand visible.",
  primaryCtaText: bs?.hero?.primaryCtaText || "Book a Free Strategy Call",
  secondaryCtaText: bs?.hero?.secondaryCtaText || "See Plans & Pricing",
  trustText: bs?.hero?.trustText || "Built for Ghana. MoMo payments accepted, and you deal with the founder directly.",
};

const how = {
  heading: bs?.howSection?.heading || "How Brand Studio works",
  subheading: bs?.howSection?.subheading || "Set it up once and fresh content lands in your inbox every month.",
};
const stepsFallback = [
  { n: "1", t: "Brand DNA", d: "We map your voice, colours and offers once. You approve it, we lock it in." },
  { n: "2", t: "We produce", d: "Every month we create your posts, reels and ad creatives. No shoots, no waiting around." },
  { n: "3", t: "You approve", d: "You review the month's content in one go. Tweak anything you want." },
  { n: "4", t: "We publish & report", d: "We schedule everything across your platforms and send you the results." },
];
const steps = bs?.howSection?.steps?.length
  ? bs.howSection.steps.map((s: any) => ({ n: s.number, t: s.title, d: s.description }))
  : stepsFallback;

const pricing = {
  heading: bs?.pricingSection?.heading || "Simple monthly plans",
  subheading: bs?.pricingSection?.subheading || "Fixed price, fixed scope, and you can cancel anytime. Prices in Ghana Cedis.",
  addonsText: bs?.pricingSection?.addonsText || "paid-ad management (10 to 15% of ad spend), one-off launch campaigns, and product-photo packs.",
  unsureText: bs?.pricingSection?.unsureText || "Not sure which plan fits?",
};
const packagesFallback = [
  { name: "Starter", price: "1,800", blurb: "Stay consistent on one platform without doing it yourself.", features: ["12 branded posts / month", "4 short-form videos (reels)", "1 platform of your choice", "Monthly content calendar"], popular: false, cta: "Start with Starter" },
  { name: "Growth", price: "3,500", blurb: "Content that keeps posting and ads that bring in sales.", features: ["20 branded posts / month", "6 short-form videos (reels)", "8 ad creatives for testing", "2 to 3 platforms, cross-posted", "Monthly performance report"], popular: true, cta: "Get Growth" },
  { name: "Scale", price: "8,000", blurb: "Full coverage across every platform for brands growing fast.", features: ["30 branded posts / month", "10 short-form videos (reels)", "12 ad creatives + paid-ad creative", "All platforms covered", "Advanced analytics & reporting"], popular: false, cta: "Go Scale" },
];
const packages = bs?.pricingSection?.plans?.length
  ? bs.pricingSection.plans.map((p: any) => ({
      name: p.name,
      price: p.price,
      blurb: p.blurb,
      popular: !!p.isPopular,
      cta: p.ctaText || `Choose ${p.name}`,
      features: (p.features || []).map((f: any) => f.feature).filter(Boolean),
    }))
  : packagesFallback;

const why = { heading: bs?.whySection?.heading || "Why brands choose Brand Studio" };
const whyItemsFallback = [
  { title: "Cheaper than one hire", text: "A full month of content costs less than a single junior marketer, and it shows up every month without fail." },
  { title: "You never go quiet", text: "Consistency is what grows a page. We keep you posting even in your busiest weeks." },
  { title: "Built to convert", text: "Every creative is designed to bring customers, not just likes, and the monthly report shows you what worked." },
];
const whyItems = bs?.whySection?.items?.length
  ? bs.whySection.items.map((i: any) => ({ title: i.title, text: i.description }))
  : whyItemsFallback;

const faqHeading = bs?.faqSection?.heading || "Frequently asked questions";
const faqsFallback = [
  { q: "How is this different from your Branding & Identity service?", a: "Branding & Identity is a one-time project: your logo, colours and brand kit. Brand Studio is ongoing. It is a content team on subscription that produces and publishes fresh posts, reels and ads every month." },
  { q: "Do I need to send you photos or do a shoot?", a: "No. We produce premium visuals and video without a shoot. If you have a product photo or two, send them over and we'll use them, but it isn't required." },
  { q: "Can I change my plan later?", a: "Anytime. Most clients start on Growth and move up as results come in. There is no long lock-in." },
  { q: "How do I pay?", a: "Monthly, by MoMo or bank transfer. You know your cost up front, so there are no surprises." },
  { q: "What if I don't like a post?", a: "You approve everything before it goes live. Revisions are included, and we don't publish anything you haven't signed off on." },
];
const faqs = bs?.faqSection?.faqs?.length
  ? bs.faqSection.faqs.map((f: any) => ({ q: f.question, a: f.answer }))
  : faqsFallback;

const finalCta = {
  heading: bs?.finalCta?.heading || "Ready to never worry about content again?",
  subheading: bs?.finalCta?.subheading || "Book a free 15-minute call. We'll show you exactly what your first month would look like.",
  primaryCtaText: bs?.finalCta?.primaryCtaText || "Book a Free Strategy Call",
  whatsappCtaText: bs?.finalCta?.whatsappCtaText || "Chat on WhatsApp",
};

// FAQ structured data for rich results
const jsonLd = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((f) => ({
    "@type": "Question",
    name: f.q,
    acceptedAnswer: { "@type": "Answer", text: f.a },
  })),
};
---

<BaseLayout
  title={metaTitle}
  description={metaDescription}
  activePage="brand-studio"
  navbarScrolled={true}
  jsonLd={jsonLd}
>
  <main class="bs">
    <!-- HERO -->
    <section class="bs-hero">
      <span class="bs-eyebrow">{hero.eyebrow}</span>
      <h1>{hero.headingTop}<br /><span class="bs-grad">{hero.headingAccent}</span></h1>
      <p class="bs-sub">{hero.subheading}</p>
      <div class="bs-hero-cta">
        <a class="bs-btn bs-btn-primary" href={CALENDLY} target="_blank" rel="noopener noreferrer" data-track="brand_studio_calendly" data-loc="hero">{hero.primaryCtaText}</a>
        <a class="bs-btn bs-btn-ghost" href="#pricing" data-track="brand_studio_see_pricing" data-loc="hero">{hero.secondaryCtaText}</a>
      </div>
      <p class="bs-trust">{hero.trustText}</p>
    </section>

    <!-- HOW IT WORKS -->
    <section class="bs-how">
      <h2>{how.heading}</h2>
      <p class="bs-section-sub">{how.subheading}</p>
      <div class="bs-steps">
        {steps.map((s) => (
          <div class="bs-step">
            <div class="bs-step-n">{s.n}</div>
            <h3>{s.t}</h3>
            <p>{s.d}</p>
          </div>
        ))}
      </div>
    </section>

    <!-- PRICING -->
    <section id="pricing" class="bs-pricing">
      <h2>{pricing.heading}</h2>
      <p class="bs-section-sub">{pricing.subheading}</p>
      <div class="bs-grid">
        {packages.map((p) => (
          <div class={`bs-card${p.popular ? " bs-card-popular" : ""}`}>
            {p.popular && <span class="bs-badge">Most Popular</span>}
            <h3 class="bs-card-name">{p.name}</h3>
            <div class="bs-card-price"><span class="bs-from">from</span> GHS {p.price}<span class="bs-mo">/mo</span></div>
            <p class="bs-card-blurb">{p.blurb}</p>
            <ul class="bs-features">
              {p.features.map((f) => <li>{f}</li>)}
            </ul>
            <a
              class={`bs-btn ${p.popular ? "bs-btn-primary" : "bs-btn-ghost"} bs-card-cta`}
              href={wa(`Hi Quadem! I'm interested in the Brand Studio ${p.name} plan.`)}
              target="_blank"
              rel="noopener noreferrer"
              data-track="brand_studio_plan_whatsapp"
              data-plan={p.name}
            >
              {p.cta}
            </a>
          </div>
        ))}
      </div>
      <p class="bs-addons">
        <strong>Add-ons:</strong> {pricing.addonsText}
      </p>
      <p class="bs-unsure">
        {pricing.unsureText} <a href={wa("Hi Quadem! Which Brand Studio plan is right for my business?")} target="_blank" rel="noopener noreferrer" data-track="brand_studio_whatsapp_help">Chat with us on WhatsApp →</a>
      </p>
    </section>

    <!-- WHY -->
    <section class="bs-why">
      <h2>{why.heading}</h2>
      <div class="bs-why-grid">
        {whyItems.map((item) => (
          <div class="bs-why-item"><h3>{item.title}</h3><p>{item.text}</p></div>
        ))}
      </div>
    </section>

    <!-- SOCIAL PROOF -->
    {testimonials.length > 0 && (
      <section class="bs-proof">
        <h2>What clients say</h2>
        <div class="bs-proof-grid">
          {testimonials.map((t) => (
            <figure class="bs-proof-card">
              <div class="bs-stars" aria-label={`${Math.max(1, Math.min(5, Number(t.stars) || 5))} out of 5 stars`}>
                {"★".repeat(Math.max(1, Math.min(5, Number(t.stars) || 5)))}
              </div>
              <blockquote>{t.quote}</blockquote>
              <figcaption>
                <span class="bs-proof-name">{t.authorName}</span>
                {t.authorRole && <span class="bs-proof-role">{t.authorRole}</span>}
              </figcaption>
            </figure>
          ))}
        </div>
      </section>
    )}

    <!-- FAQ -->
    <section class="bs-faq">
      <h2>{faqHeading}</h2>
      {faqs.map((f) => (
        <details class="bs-faq-item">
          <summary>{f.q}</summary>
          <p>{f.a}</p>
        </details>
      ))}
    </section>

    <!-- FINAL CTA -->
    <section class="bs-final">
      <h2>{finalCta.heading}</h2>
      <p>{finalCta.subheading}</p>
      <div class="bs-hero-cta">
        <a class="bs-btn bs-btn-primary" href={CALENDLY} target="_blank" rel="noopener noreferrer" data-track="brand_studio_calendly" data-loc="final">{finalCta.primaryCtaText}</a>
        <a class="bs-btn bs-btn-ghost" href={wa("Hi Quadem! I'd like to start with Brand Studio.")} target="_blank" rel="noopener noreferrer" data-track="brand_studio_whatsapp_start" data-loc="final">{finalCta.whatsappCtaText}</a>
      </div>
      <p class="bs-form-lead-in">Prefer email? Leave your details and we'll reach out.</p>
      <form class="bs-lead-form" id="bsLeadForm" novalidate>
        <input type="text" name="name" placeholder="Your name" autocomplete="name" required />
        <input type="email" name="email" placeholder="Email address" autocomplete="email" required />
        <input type="text" name="message" placeholder="Which plan or goal? (optional)" />
        <button type="submit" class="bs-btn bs-btn-primary">Request a callback</button>
        <p class="bs-form-status" id="bsFormStatus" role="status" aria-live="polite"></p>
      </form>
    </section>
  </main>

  <!-- Lead form. CTA click tracking is handled by the site-wide [data-track]
       delegate in main.js — this page's buttons carry data-track attributes. -->
  <script is:inline>
    (function () {
      var form = document.getElementById("bsLeadForm");
      if (form) {
        var statusEl = document.getElementById("bsFormStatus");
        form.addEventListener("submit", function (e) {
          e.preventDefault();
          var fd = new FormData(form);
          var data = {
            source: "brand-studio",
            name: (fd.get("name") || "").trim(),
            email: (fd.get("email") || "").trim(),
            message: (fd.get("message") || "").trim(),
          };
          if (!data.name || !data.email) {
            statusEl.textContent = "Please add your name and email.";
            statusEl.className = "bs-form-status bs-form-err";
            return;
          }
          var btn = form.querySelector('button[type="submit"]');
          btn.disabled = true;
          statusEl.textContent = "Sending…";
          statusEl.className = "bs-form-status";
          fetch("/api/submit-form/", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify(data),
          })
            .then(function (res) {
              if (res.ok) {
                form.reset();
                statusEl.textContent = "Thanks! We'll be in touch within 24 hours.";
                statusEl.className = "bs-form-status bs-form-ok";
                window.trackEvent("generate_lead", { source: "brand-studio" });
              } else {
                return res.json().then(function (j) {
                  statusEl.textContent = (j && j.error) || "Something went wrong. Please try WhatsApp instead.";
                  statusEl.className = "bs-form-status bs-form-err";
                });
              }
            })
            .catch(function () {
              statusEl.textContent = "Network error. Please try WhatsApp instead.";
              statusEl.className = "bs-form-status bs-form-err";
            })
            .finally(function () {
              btn.disabled = false;
            });
        });
      }
    })();
  </script>
</BaseLayout>

<style>
  /* Brand Studio gradient: the one deliberate deviation from site blue,
     used only for pop. Everything else rides the site's theme tokens. */
  .bs { --bs-g1:#7c5cff; --bs-g2:#f97316; color:var(--text-primary);
        /* --bs-ink is the gradient colour used as TEXT. The bright purple only
           reaches 4.12:1 on a light ground, so light mode darkens it; on dark
           it stays identical to --bs-g1. */
        --bs-ink: var(--bs-g1); }
  :root[data-theme="light"] .bs { --bs-ink:#5b3fd6; }
  .bs section { max-width:1120px; margin:0 auto; padding:72px 20px; }
  .bs h1 { font-size:clamp(2.2rem,5vw,3.6rem); line-height:1.05; margin:.4em 0; font-weight:800; letter-spacing:-.02em; font-family:var(--font-heading); }
  .bs h2 { font-size:clamp(1.6rem,3vw,2.3rem); text-align:center; font-weight:800; letter-spacing:-.01em; font-family:var(--font-heading); color:var(--text-primary); }
  .bs h3 { color:var(--text-primary); }
  .bs-grad { background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2)); -webkit-background-clip:text; background-clip:text; color:transparent; }
  .bs-section-sub { text-align:center; color:var(--text-muted); margin:.6em auto 2.5em; max-width:560px; }

  /* hero: extra top padding to clear the fixed navbar */
  .bs-hero { text-align:center; padding-top:140px; background:radial-gradient(circle at 50% 0%, rgba(124,92,255,0.08) 0%, transparent 55%); }
  .bs-eyebrow { display:inline-block; font-size:.8rem; letter-spacing:.08em; text-transform:uppercase;
                color:var(--bs-ink); border:1px solid var(--border-color); border-radius:999px; padding:6px 14px; }
  .bs-sub { color:var(--text-muted); font-size:1.12rem; max-width:620px; margin:1em auto 2em; line-height:1.6; }
  .bs-hero-cta { display:flex; gap:14px; justify-content:center; flex-wrap:wrap; }
  .bs-trust { color:var(--text-muted); font-size:.9rem; margin-top:1.8em; }

  /* buttons */
  .bs-btn { display:inline-block; padding:14px 26px; border-radius:12px; font-weight:700; text-decoration:none;
            transition:transform .15s ease, opacity .15s ease; }
  .bs-btn:hover { transform:translateY(-2px); }
  .bs-btn-primary { background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2)); color:#fff; }
  .bs-btn-ghost { border:1px solid var(--border-color); color:var(--text-primary); background:var(--bg-inset); }

  /* steps */
  .bs-steps { display:grid; grid-template-columns:repeat(4,1fr); gap:20px; }
  .bs-step { background:var(--bg-inset); border:1px solid var(--border-color); border-radius:16px; padding:24px; }
  .bs-step-n { width:38px; height:38px; border-radius:10px; display:grid; place-items:center; font-weight:800;
               background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2)); color:#fff; margin-bottom:12px; }
  .bs-step h3 { margin:.2em 0; font-size:1.05rem; }
  .bs-step p { color:var(--text-muted); font-size:.92rem; line-height:1.5; }

  /* pricing */
  .bs-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:22px; align-items:stretch; }
  .bs-card { position:relative; background:var(--bg-inset); border:1px solid var(--border-color); border-radius:20px;
             padding:30px 26px; display:flex; flex-direction:column; }
  .bs-card-popular { border-color:var(--bs-g1); box-shadow:0 0 0 1px var(--bs-g1), 0 20px 60px -30px var(--bs-g1); }
  .bs-badge { position:absolute; top:-13px; left:50%; transform:translateX(-50%); background:linear-gradient(90deg,var(--bs-g1),var(--bs-g2));
              color:#fff; font-size:.72rem; font-weight:700; letter-spacing:.06em; text-transform:uppercase; padding:5px 14px; border-radius:999px; }
  .bs-card-name { font-size:1.3rem; margin:0 0 .2em; }
  .bs-card-price { font-size:2rem; font-weight:800; margin:.1em 0 .4em; color:var(--text-primary); }
  .bs-from { font-size:.85rem; color:var(--text-muted); font-weight:600; margin-right:6px; }
  .bs-mo { font-size:1rem; color:var(--text-muted); font-weight:600; }
  .bs-card-blurb { color:var(--text-muted); font-size:.95rem; margin-bottom:1.2em; line-height:1.5; }
  .bs-features { list-style:none; padding:0; margin:0 0 1.6em; flex:1; }
  .bs-features li { padding:9px 0 9px 26px; position:relative; border-top:1px solid var(--border-color); font-size:.94rem; }
  .bs-features li:before { content:"✓"; position:absolute; left:0; color:var(--bs-ink); font-weight:800; }
  .bs-card-cta { text-align:center; }
  .bs-addons { text-align:center; color:var(--text-muted); margin-top:2.4em; font-size:.95rem; }
  .bs-unsure { text-align:center; margin-top:.6em; }
  .bs-unsure a { color:var(--bs-ink); font-weight:700; text-decoration:none; }

  /* why */
  .bs-why-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:2.4em; }
  .bs-why-item { background:var(--bg-inset); border:1px solid var(--border-color); border-radius:16px; padding:26px; }
  .bs-why-item h3 { margin:0 0 .4em; font-size:1.1rem; }
  .bs-why-item p { color:var(--text-muted); line-height:1.55; font-size:.95rem; }

  /* social proof */
  .bs-proof-grid { display:grid; grid-template-columns:repeat(3,1fr); gap:20px; margin-top:2.4em; }
  .bs-proof-card { background:var(--bg-inset); border:1px solid var(--border-color); border-radius:16px; padding:26px; margin:0; display:flex; flex-direction:column; }
  .bs-stars { color:var(--bs-g2); letter-spacing:2px; font-size:.95rem; margin-bottom:.6em; }
  .bs-proof-card blockquote { margin:0 0 1.1em; font-size:1rem; line-height:1.6; color:var(--text-primary); flex:1; }
  .bs-proof-card figcaption { display:flex; flex-direction:column; gap:2px; }
  .bs-proof-name { font-weight:700; font-size:.95rem; }
  .bs-proof-role { color:var(--text-muted); font-size:.85rem; }

  /* faq */
  .bs-faq { max-width:760px; }
  .bs-faq-item { background:var(--bg-inset); border:1px solid var(--border-color); border-radius:12px; padding:4px 20px; margin:12px 0; }
  .bs-faq-item summary { cursor:pointer; padding:16px 0; font-weight:600; list-style:none; color:var(--text-primary); }
  .bs-faq-item summary::-webkit-details-marker { display:none; }
  .bs-faq-item summary:after { content:"+"; float:right; color:var(--bs-g1); font-weight:800; }
  .bs-faq-item[open] summary:after { content:"-"; }
  .bs-faq-item p { color:var(--text-muted); padding:0 0 16px; line-height:1.6; margin:0; }

  /* final */
  .bs-final { text-align:center; background:var(--bg-inset); border:1px solid var(--border-color); border-radius:24px;
              max-width:1080px; margin:0 auto 72px; }
  .bs-final p { color:var(--text-muted); max-width:520px; margin:.8em auto 2em; }

  /* lead form */
  .bs-form-lead-in { color:var(--text-muted); font-size:.9rem; margin:2.4em auto .8em; }
  .bs-lead-form { display:flex; flex-wrap:wrap; gap:10px; justify-content:center; max-width:620px; margin:0 auto; }
  .bs-lead-form input { flex:1 1 180px; min-width:0; padding:13px 16px; border-radius:12px; border:1px solid var(--border-color);
                        background:var(--bg-inset); color:var(--text-primary); font-size:.95rem; }
  .bs-lead-form input::placeholder { color:var(--text-muted); }
  .bs-lead-form input:focus { outline:none; border-color:var(--bs-g1); }
  .bs-lead-form button { flex:0 0 auto; cursor:pointer; border:none; }
  .bs-lead-form button:disabled { opacity:.6; cursor:default; }
  .bs-form-status { flex:1 1 100%; margin:.4em 0 0; font-size:.9rem; min-height:1.2em; }
  .bs-form-ok { color:#22c55e; }
  .bs-form-err { color:#ef4444; }

  @media (max-width:880px){
    .bs-steps,.bs-grid,.bs-why-grid,.bs-proof-grid{ grid-template-columns:1fr; }
    .bs-card-popular{ order:-1; }
  }
</style>
