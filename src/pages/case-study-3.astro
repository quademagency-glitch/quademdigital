            max-width: 800px;
            margin: 0 auto;
            padding: 40px 20px;
        }
        .case-study-content h2 {
            margin-top: 40px;
        }
        .case-study-content p {
            margin-bottom: 20px;
        }
        .case-study-image {
            width: 100%;
            height: 400px;
            background-color: #1a1a24;
            border-radius: 12px;
            margin: 40px 0;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--text-muted);
            font-family: var(--font-heading);
            font-size: 20px;
            border: 1px solid var(--border-color);
        }
