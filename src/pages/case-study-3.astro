---
import BaseLayout from "../layouts/BaseLayout.astro";
---
<BaseLayout title="Complete Brand Identity & Local SEO | Quadem Digital" description="Case study detailing how we built a fresh brand from the ground up and dominated local search results." activePage="projects" navbarScrolled={true}>
    <section class="section-padding" style="min-height: 60vh; display: flex; align-items: center; justify-content: center; text-align: center;">
        <div class="container">
            <span class="badge glow-effect mb-4" style="display: inline-block;">Coming Soon</span>
            <h1 style="margin-bottom: 24px;">Complete Brand Identity & Local SEO</h1>
            <p style="color: var(--text-muted); max-width: 600px; margin: 0 auto 32px; line-height: 1.6;">
                We are currently writing this case study to share how we established a compelling brand presence and executed a local SEO campaign to secure the #1 ranking for core keywords.
            </p>
            <a href="/projects" class="btn btn-primary btn-pill glow-effect">Back to Projects</a>
        </div>
    </section>
</BaseLayout>
