---
/**
 * One tile in a service page's portfolio gallery.
 *
 * This markup lived in four service pages as an exact copy. When the Video
 * Production gallery learned to show video, the other three did not, and they
 * would have rendered an uploaded reel as an img tag pointing at an mp4: a
 * broken image icon, on a page selling the work in it. Extracting it is what
 * stops that happening again, since the media collection accepts video for any
 * of these fields, not just the one page anyone thought about.
 */
import Picture from "./Picture.astro";
import { THIRD_MEDIA_SIZES } from '../lib/mediaPresentation';
import Video from "./Video.astro";
import { buildPayloadImageUrl, getPayloadImageSize, resolveVideo } from "../lib/payload";

interface Props {
  media: any;
  index?: number;
}

const { media, index = 0 } = Astro.props;

const isVideo = media?.mimeType?.startsWith("video");
const video = isVideo ? resolveVideo(media) : null;
const renderable = Boolean(media) && (isVideo || Boolean(getPayloadImageSize(media, "medium")));

/*
   Both stills and video keep their actual composition. The fallback only
   applies while a fresh upload has no recorded dimensions.
*/
const dimensions = isVideo ? video : media;
const ratio = dimensions?.width && dimensions?.height ? `${dimensions.width} / ${dimensions.height}` : "4 / 3";

/*
   Audio and controls are the same decision. A clip kept silent is decorative
   and loops by itself; one that kept its audio is meant to be played, so it
   gets the controls to play it with.
*/
const mode = media?.videoUsage === "playable" ? "player" : "background";
const fill = "width: 100%; height: 100%; object-fit: contain;";
---
{renderable && (
  <div
    class={`q-gallery-tile animate-on-scroll slide-up delay-${(index % 4 + 1) * 100}`}
    style={`border-radius: 12px; overflow: hidden; aspect-ratio: ${ratio}; background: var(--bg-inset);`}
  >
    {isVideo ? (
      <Video video={video} mode={mode} label={mode === "player" ? (media.alt || "Showreel") : undefined} style={fill} />
    ) : (
      <a class="portfolio-image-link" href={buildPayloadImageUrl(media)} target="_blank" rel="noopener noreferrer" aria-label={`Open full image: ${media.alt || 'Portfolio item'}`}>
      <Picture
        image={media}
        alt={media.alt || "Portfolio item"}
        sizes={THIRD_MEDIA_SIZES}
        size="medium"
        width={800}
        height={600}
        style={fill}
      />
      </a>
    )}
  </div>
)}
