---
import StrokeIcon from './StrokeIcon.astro';
import { resolveBookingHref } from '../lib/booking';
import { safeHref } from '../lib/payload';
import ServiceArtwork from './ServiceArtwork.astro';
import WorkCaption from './WorkCaption.astro';
interface Props {
  headline: string;
  words?: string[];
  eyebrow?: string;
  lead?: string;
  tail?: string;
  lede?: string;
  metaLabels?: string[];
  primaryCta?: { label: string; href: string; track?: string } | null;
  secondaryCta?: { label: string; href: string } | null;
  media?: { image: any; alt?: string; mode?: 'side' | 'cover'; position?: string; dim?: number } | null;
  mediaAspectRatio?: number;
  variant?: 'hero' | 'page';
  trackLocation?: string;
  id?: string;
  class?: string;
}
const { headline, eyebrow, lede, metaLabels = [], primaryCta, secondaryCta, media, mediaAspectRatio, trackLocation = 'hero', id, class: className } = Astro.props;
// A supplied CMS image is content; the page variant must not silently hide it.
const showMedia = Boolean(media?.image) || Astro.slots.has('media');
const mediaRatio = media?.image?.displayAspectRatio || mediaAspectRatio || (media?.image?.width && media?.image?.height ? media.image.width / media.image.height : .8);
const cta = (item: any) => item?.label ? { ...item, href: safeHref(resolveBookingHref(item.href, item.label)) } : null;
const primary = cta(primaryCta);
const secondary = cta(secondaryCta);
---
<section class:list={['studio-page-hero', { 'studio-page-hero--split': showMedia }, className]} id={id} data-page-hero={showMedia ? 'visual' : 'editorial'} data-title-size={headline.length > 52 ? 'long' : 'standard'}>
  <div class="container studio-page-hero-inner">
    <div class="studio-page-hero-copy">
      {eyebrow && <p class="studio-label">{eyebrow}</p>}
      <div class="studio-page-hero-story">
        <h1>{headline}</h1>
        <div class="studio-page-hero-detail">
          {lede && <p class="studio-lede">{lede}</p>}
          {(primary || secondary) && <div class="studio-actions">
            {primary && <a href={primary.href} target={/^https?:/.test(primary.href) ? '_blank' : undefined} rel={/^https?:/.test(primary.href) ? 'noopener noreferrer' : undefined} class="btn btn-primary btn-pill" data-track={primary.track || 'hero_primary_cta'} data-loc={trackLocation}>{primary.label}<StrokeIcon /></a>}
            {secondary && <a href={secondary.href} class="btn btn-light btn-pill" data-track="hero_secondary_cta" data-loc={trackLocation}>{secondary.label}</a>}
          </div>}
          {metaLabels.length > 0 && <ul class="studio-hero-meta">{metaLabels.map(label => <li>{label}</li>)}</ul>}
          <slot name="after-actions" />
        </div>
      </div>
    </div>
    {showMedia && <div class="studio-page-hero-media" data-hero-art data-service-art={media?.image?.source === 'local' ? 'work' : undefined} data-has-caption={Boolean(media?.image?.caption) || undefined} style={`--page-hero-media-ratio: ${Math.max(.55, Math.min(2, mediaRatio))}; --image-position: ${media?.position || 'center'};`}>
      <div class="studio-page-hero-media-image">
        <slot name="media"><ServiceArtwork image={media?.image} alt={media?.alt ?? media?.image?.alt ?? ''} sizes="(max-width: 800px) 90vw, (min-width: 1600px) 720px, 45vw" priority /></slot>
      </div>
      <WorkCaption image={media?.image} />
    </div>}
  </div>
</section>
