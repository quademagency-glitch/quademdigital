---
/**
 * The enquiry form on a service page.
 *
 * Every service page used to send people to /contact/, whose first question is
 * "what do you need help with?". Somebody reading the SEO page has already
 * answered that by being there, and being asked again is the moment a lot of
 * them leave. This puts the form on the page with that step already filled in,
 * and spends it on questions only this service needs instead.
 *
 * Shape and behaviour are deliberately the contact page's, not a new pattern:
 * the same three-step wizard, the same classes, the same ids. main.js binds the
 * wizard to `.wizard-form` and the submit to `#contactForm`, both of which are
 * generic, so this inherits step navigation, validation, the progress bar and
 * the partial-lead capture at step two without a line of new script. Only one
 * wizard can exist per page, which is true here: no service page carries
 * another form.
 *
 * Where the questions come from: `service.enquiryForm.questions` in the CMS,
 * three at most. Ernest writes and rewords them in the admin without a deploy.
 * Each answer is posted as `q_<key>` and swept into Leads.metadata, which is a
 * json column, so a new question never needs a migration. The key is derived
 * from the question text and stored separately, so rewording a question does
 * not orphan the answers already collected under the old wording.
 *
 * With no questions configured this renders the plain form instead: name,
 * email, message and budget. That is the documented fallback, and it is why a
 * service nobody has written questions for still has a working form rather than
 * a broken one.
 */
import BudgetBands from './BudgetBands.astro';
import NewsletterOptIn from "./NewsletterOptIn.astro";
import { payloadFetch } from "../../lib/payload";

interface Props {
    /** The CMS service document, when the page already has it. */
    service?: any;
    /**
     * The CMS slug, for the five hand-built service pages that load their own
     * page global rather than the Services collection. Their URLs and their CMS
     * slugs differ (/services/seo/ is `seo-paid-ads`), so the slug is passed
     * explicitly rather than guessed from the path.
     */
    slug?: string;
    /**
     * Where a no-JavaScript submit should land. Without it the endpoint sends
     * everyone to /contact/?sent=1, which for someone who filled in a form on
     * /services/seo/ is a different page telling them nothing about what they
     * just did.
     */
    returnTo?: string;
}

const { service: passedService, slug, returnTo } = Astro.props;

/*
  payloadFetch caches for 60 seconds, so a page that already loaded this
  document pays nothing extra and one that did not pays a single warm lookup.
*/
const service =
    passedService ??
    (slug ? (await payloadFetch("services", { "where[slug][equals]": slug, depth: "0" }))[0] : null);

const form = service?.enquiryForm || {};
const questions = (form.questions || [])
    .filter((q: any) => q?.label && q?.key)
    .slice(0, 3);

const hasQuestions = questions.length > 0;

const heading = form.heading || `Enquire about ${service?.title ?? "this service"}`;
const intro = form.intro || "Tell me what you need and I will come back with what it takes and what it costs.";
const questionsHeading = form.questionsHeading || "A few quick questions";
const buttonLabel = form.buttonLabel || "Send enquiry";

const backHref = returnTo || (service?.slug ? `/services/${service.slug}/` : "/services/");

/*
  Two ladders, shown by country, the same way the pricing sections already work.

  One dollar ladder starting at "under $2,000" was wrong at both ends. It is
  below the cheapest international thing on sale, so it implied a price that
  never existed. And the entire Ghana ladder, GH₵ 2,500 to GH₵ 11,500, is about
  $425 to $1,955, so every Ghanaian lead landed in that single bottom band and
  the question collected nothing about the site's main market.

  Both sets are in the HTML with one hidden, because public pages are edge
  cached for 60 seconds and a server that picked one would have it served to the
  wrong country. showMarket() in main.js reveals the right one after the geo
  lookup, and it fails open to the international set, which is the safe default
  for a page a stranger reached from a cold email.

  The bands themselves now live in src/components/forms/BudgetBands.astro,
  shared with the contact page, which used to ask this question on a different
  ladder in dollars only. See that file for why.
*/

/*
  A submit without JavaScript comes back here as a redirect carrying ?sent=1 or
  ?error=1, so the outcome has to be rendered on the server too. Without this
  the visitor is returned to an untouched form with no sign that anything
  happened, and sends it again.

  Query strings are part of the Vercel cache key, so these variants cache apart
  from the clean URL and one cannot be served in place of the other.
*/
const submitted = Astro.url.searchParams.get("sent") === "1";
const failed = Astro.url.searchParams.get("error") === "1";
---

<section class="sef section-padding" id="enquire">
    <div class="container">
        <div class="sef-head">
            <h2><span class="text-gradient">{heading}</span></h2>
            <p>{intro}</p>
        </div>

        <div class="sef-card animate-on-scroll slide-up">
            <form
                class:list={["contact-form", hasQuestions && "wizard-form"]}
                id="contactForm"
                action="/api/submit-form/"
                method="POST"
                data-start-step="1"
            >
                {/* The service is the answer to step one of the general form, so it
                    is sent rather than asked. */}
                <input type="hidden" name="source" value="cms-page" />
                <input type="hidden" name="services[]" value={service?.title} />
                <input type="hidden" name="returnTo" value={backHref} />

                <div class="form-group sef-note is-success" id="formSuccess" style={submitted ? undefined : "display: none;"}>
                    Thanks. I have got that and I will come back to you shortly.
                </div>
                <div class="form-group sef-note is-error" id="formError" style={failed ? undefined : "display: none;"}>
                    Something went wrong. Please try again, or send it on WhatsApp.
                </div>

                {hasQuestions ? (
                    <>
                        {/*
                            Every hook main.js drives is still here and still
                            named the same: it toggles .active on each
                            .step-indicator and sets the width of
                            #wizardProgressFill. What changed is that these
                            classes now have styles. They never did on this
                            component: the rules for them live in a scoped
                            <style> inside contact.astro, and Astro scopes
                            component styles, so copying the markup here brought
                            the class names and none of the CSS. Three bare
                            numbers stacked down the page was the result.
                        */}
                        <div class="wizard-progress">
                            <div class="sef-steps">
                                <div class="step-indicator active" data-step="1"><span>1</span></div>
                                <div class="step-indicator" data-step="2"><span>2</span></div>
                                <div class="step-indicator" data-step="3"><span>3</span></div>
                            </div>
                            <div class="progress-line">
                                <div class="progress-fill" id="wizardProgressFill"></div>
                            </div>
                            <p class="sef-steplabel"><span data-sef-stepnum>Step 1 of 3</span></p>
                        </div>

                        <div class="wizard-step active" id="wizardStep1">
                            <h3>{questionsHeading}</h3>
                            {questions.map((q: any, i: number) => (
                                <div class="sef-question">
                                    <p class="sef-label" id={`q-${q.key}-label`}>{q.label}</p>

                                    {q.inputType === "text" && (
                                        <input
                                            type="text"
                                            name={`q_${q.key}`}
                                            required={q.required !== false}
                                            placeholder={q.placeholder || undefined}
                                            aria-labelledby={`q-${q.key}-label`}
                                        />
                                    )}

                                    {q.inputType === "longtext" && (
                                        <textarea
                                            name={`q_${q.key}`}
                                            rows="3"
                                            required={q.required !== false}
                                            placeholder={q.placeholder || undefined}
                                            aria-labelledby={`q-${q.key}-label`}
                                        ></textarea>
                                    )}

                                    {(!q.inputType || q.inputType === "choice") && (
                                        <div class="sef-choices" role="radiogroup" aria-labelledby={`q-${q.key}-label`}>
                                            {(q.choices || []).map((c: any, j: number) => (
                                                <label class="sef-choice">
                                                    <input
                                                        type="radio"
                                                        name={`q_${q.key}`}
                                                        value={c.choice}
                                                        required={q.required !== false && j === 0}
                                                    />
                                                    <span>{c.choice}</span>
                                                </label>
                                            ))}
                                        </div>
                                    )}
                                </div>
                            ))}
                            <div class="sef-actions">
                                <button type="button" class="btn btn-primary btn-pill wizard-next-btn">Continue</button>
                            </div>
                        </div>

                        <div class="wizard-step" id="wizardStep2" style="display: none;">
                            <h3>How do I reach you?</h3>
                            <div class="form-group">
                                <label for="sefName">Name</label>
                                <input type="text" id="sefName" name="name" required autocomplete="name" placeholder="Your name" />
                            </div>
                            <div class="form-group">
                                <label for="sefEmail">Email</label>
                                <input type="email" id="sefEmail" name="email" required autocomplete="email" placeholder="you@example.com" />
                            </div>
                            <div class="form-group">
                                <label for="sefMessage">Anything else I should know?</label>
                                <textarea id="sefMessage" name="message" rows="4" required placeholder="A sentence or two is plenty."></textarea>
                            </div>
                            <div class="sef-actions">
                                <button type="button" class="btn btn-ghost btn-pill wizard-prev-btn">Back</button>
                                <button type="button" class="btn btn-primary btn-pill wizard-next-btn">Continue</button>
                            </div>
                        </div>

                        <div class="wizard-step" id="wizardStep3" style="display: none;">
                            <h3>Roughly what is the budget?</h3>
                            <BudgetBands hint="An honest range saves us both a call. Nothing here is binding." />
                            <NewsletterOptIn variant="card" />
                            <div class="sef-actions">
                                <button type="button" class="btn btn-ghost btn-pill wizard-prev-btn">Back</button>
                                <button type="submit" class="btn btn-primary btn-pill glow-effect" id="contactSubmitBtn">{buttonLabel}</button>
                            </div>
                        </div>
                    </>
                ) : (
                    /*
                      No questions written for this service yet. Rather than a
                      broken three-step wizard with an empty first step, this is
                      the general form: the same fields the contact page ends up
                      collecting, in one pass.
                    */
                    <>
                        <div class="form-group">
                            <label for="sefName">Name</label>
                            <input type="text" id="sefName" name="name" required autocomplete="name" placeholder="Your name" />
                        </div>
                        <div class="form-group">
                            <label for="sefEmail">Email</label>
                            <input type="email" id="sefEmail" name="email" required autocomplete="email" placeholder="you@example.com" />
                        </div>
                        <div class="form-group">
                            <label for="sefMessage">What do you need?</label>
                            <textarea id="sefMessage" name="message" rows="5" required placeholder="Tell me what you are trying to do."></textarea>
                        </div>
                        <div class="form-group">
                            <p class="sef-label">Roughly what is the budget?</p>
                            <BudgetBands />
                        </div>
                        <NewsletterOptIn />
                        <div class="sef-actions">
                            <button type="submit" class="btn btn-primary btn-pill glow-effect w-100" id="contactSubmitBtn">{buttonLabel}</button>
                        </div>
                    </>
                )}
            </form>
        </div>
    </div>
</section>

<style>
    .sef-head {
        text-align: center;
        max-width: 620px;
        margin: 0 auto 32px;
    }

    .sef-head h2 { margin-bottom: 10px; }
    .sef-head p { color: var(--text-muted); }

    .sef-card {
        max-width: 640px;
        margin: 0 auto;
        background: var(--bg-card);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        padding: 36px;
    }

    .sef-card h3 {
        font-size: 1.15rem;
        margin-bottom: 6px;
    }

    .sef-hint {
        color: var(--text-subtle);
        font-size: 0.9rem;
        margin-bottom: 16px;
    }

    .sef-question { margin: 22px 0; }

    /* ---- Progress header ------------------------------------------------
       None of this existed. The three .step-indicator divs had no rules at all,
       so they stacked as plain numbers down the left of the card. */
    .wizard-progress {
        position: relative;
        margin-bottom: 28px;
    }

    .sef-steps {
        position: relative;
        z-index: 1;
        display: flex;
        justify-content: space-between;
    }

    .step-indicator {
        width: 34px;
        height: 34px;
        border-radius: 50%;
        display: flex;
        align-items: center;
        justify-content: center;
        font-weight: 700;
        font-size: 14px;
        background: var(--bg-card);
        border: 1px solid var(--border-strong);
        color: var(--text-subtle);
        transition: background var(--transition-base), color var(--transition-base),
                    border-color var(--transition-base), transform var(--transition-base);
    }

    .step-indicator.active {
        background: var(--accent);
        border-color: var(--accent);
        /* Dark text on an accent fill, the same call .btn-primary makes. White
           on this blue reaches only 2.2:1. */
        color: #000; /* theme-exempt */
    }

    /* The step being filled in, as opposed to the ones already done. main.js
       marks every step up to the current one .active, so it cannot tell these
       apart on its own; the small script at the end of this file sets
       data-sef-current and that is what separates them. */
    .step-indicator[data-current] {
        transform: scale(1.12);
        box-shadow: 0 0 0 4px color-mix(in srgb, var(--accent) 20%, transparent);
    }

    /* A tick replaces the number once a step is behind you. */
    .step-indicator.active:not([data-current]) span {
        display: none;
    }

    .step-indicator.active:not([data-current])::after {
        content: "";
        width: 12px;
        height: 7px;
        border-left: 2.5px solid #000; /* theme-exempt: sits on the accent fill */
        border-bottom: 2.5px solid #000; /* theme-exempt */
        transform: rotate(-45deg) translate(1px, -2px);
    }

    .progress-line {
        position: absolute;
        top: 17px;
        left: 0;
        width: 100%;
        height: 2px;
        background: var(--border-color);
        z-index: 0;
    }

    .progress-fill {
        width: 0%;
        height: 100%;
        background: var(--accent);
        transition: width var(--transition-base);
    }

    .sef-steplabel {
        margin: 14px 0 0;
        font-size: 13px;
        letter-spacing: 0.4px;
        text-transform: uppercase;
        color: var(--text-subtle);
        font-weight: 600;
    }

    @media (prefers-reduced-motion: reduce) {
        .step-indicator,
        .progress-fill {
            transition: none;
        }

        .step-indicator[data-current] {
            transform: none;
        }
    }

    .sef-label {
        font-weight: 600;
        color: var(--text-primary);
        margin-bottom: 10px;
    }

    /* The shared field rule in style.css is `.form-group input`. These inputs
       live in .sef-question, so none of it applied and they rendered as bare
       unpadded bars with the placeholder against the left edge. Same values, so
       a field here and a field on /contact/ look identical. */
    .sef-question input[type="text"],
    .sef-question input[type="email"],
    .sef-question input[type="url"],
    .sef-question input[type="tel"],
    .sef-question select,
    .sef-question textarea {
        width: 100%;
        background-color: var(--field-bg);
        border: 1px solid var(--border-color);
        color: var(--field-text);
        padding: 14px 16px;
        border-radius: var(--radius-sm);
        font-family: var(--font-body);
        font-size: 15px;
        outline: none;
        transition: border-color var(--transition-base), box-shadow var(--transition-base);
    }

    .sef-question input:focus,
    .sef-question select:focus,
    .sef-question textarea:focus {
        border-color: var(--accent);
        /* A ring as well as a border. On a dark field a 1px colour change is
           easy to miss, and this is the only signal that typing goes here. */
        box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 18%, transparent);
    }

    .sef-question input::placeholder,
    .sef-question textarea::placeholder {
        color: var(--text-subtle);
    }

    /* Choices are labels wrapping a radio, so the whole row is the hit target
       rather than the 16px dot. */
    .sef-choices {
        display: grid;
        gap: 10px;
        margin-bottom: 8px;
    }

    @media (min-width: 560px) {
        .sef-choices { grid-template-columns: 1fr 1fr; }
    }

    .sef-choice {
        position: relative;
        display: flex;
        align-items: center;
        gap: 12px;
        padding: 14px 16px;
        border: 1px solid var(--border-color);
        border-radius: var(--radius-sm);
        background: var(--bg-inset);
        cursor: pointer;
        transition: border-color var(--transition-fast), background var(--transition-fast),
                    transform var(--transition-fast);
        font-size: 0.95rem;
        color: var(--text-muted);
    }

    .sef-choice:hover {
        border-color: var(--accent);
        background: var(--bg-hover);
        transform: translateY(-1px);
    }

    /*
       The real radio is restyled, not hidden behind a decorative span.

       A zero-size or opacity-0 required control cannot be the anchor for a
       browser validation bubble: Chrome refuses with "an invalid form control
       is not focusable" and the visitor is told nothing about what is missing.
       Since these radio groups are exactly what step one now validates, hiding
       them would have swapped one silent dead end for another. appearance:none
       keeps one element that is the control, the focus target and the artwork.
    */
    .sef-choice input[type="radio"] {
        appearance: none;
        -webkit-appearance: none;
        flex: 0 0 auto;
        margin: 0;
        width: 20px;
        height: 20px;
        border-radius: 50%;
        border: 2px solid var(--border-strong);
        background: transparent;
        display: grid;
        place-items: center;
        cursor: pointer;
        transition: border-color var(--transition-fast), background var(--transition-fast);
    }

    .sef-choice input[type="radio"]::after {
        content: "";
        width: 9px;
        height: 5px;
        border-left: 2px solid #000; /* theme-exempt: sits on the accent fill */
        border-bottom: 2px solid #000; /* theme-exempt */
        transform: rotate(-45deg) translate(1px, -1px) scale(0);
        transition: transform var(--transition-fast);
    }

    .sef-choice input[type="radio"]:checked {
        border-color: var(--accent);
        background: var(--accent);
    }

    .sef-choice input[type="radio"]:checked::after {
        transform: rotate(-45deg) translate(1px, -1px) scale(1);
    }

    .sef-choice:has(input:checked) {
        border-color: var(--accent);
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        color: var(--text-primary);
        font-weight: 500;
    }

    @media (prefers-reduced-motion: reduce) {
        .sef-choice,
        .sef-choice input[type="radio"]::after {
            transition: none;
        }

        .sef-choice:hover { transform: none; }
    }

    .sef-choice:focus-within {
        outline: 2px solid var(--accent);
        outline-offset: 2px;
    }

    .sef-actions {
        display: flex;
        gap: 12px;
        margin-top: 22px;
    }

    .sef-actions .btn { flex: 1; }
    .sef-actions .wizard-prev-btn { flex: 0 0 auto; }

    .sef-note {
        padding: 16px;
        border-radius: var(--radius-sm);
        margin-bottom: 20px;
    }

    .sef-note.is-success {
        background: var(--bg-inset);
        border: 1px solid var(--accent);
        color: var(--accent-text);
    }

    /* No warning token exists. The fill is a translucent red that works on both
       grounds; the text is the part that has to move, so light mode darkens it. */
    .sef-note.is-error {
        background: rgba(231, 76, 60, 0.12);
        border: 1px solid rgb(231, 76, 60);
        color: rgb(231, 138, 124);
    }

    :global(:root[data-theme="light"]) .sef-note.is-error {
        color: rgb(169, 42, 30);
    }

    @media (max-width: 560px) {
        .sef-card { padding: 24px 20px; }
        .sef-actions { flex-wrap: wrap; }
    }
</style>

<script>
    /*
       A small companion to the wizard in main.js, not a replacement for it.

       main.js owns stepping: it shows and hides #wizardStep1..3, sets the width
       of #wizardProgressFill, and toggles .active on every indicator up to the
       current one. Two things it cannot do, because .active means "reached"
       rather than "on":

         - tell the step you are filling in from the ones already behind you,
           which is what turns a finished step's number into a tick
         - say "Step 2 of 3" in words

       Rather than reach into main.js and risk the contact page, this watches
       which .wizard-step is visible and writes data-sef-current. Nothing here
       drives navigation, so if it fails the form still works exactly as before.
    */
    function initSefProgress() {
        document.querySelectorAll<HTMLElement>('.sef-card').forEach((card) => {
            if (card.dataset.sefProgressBound === '1') return;
            const steps = Array.from(card.querySelectorAll<HTMLElement>('.wizard-step'));
            const dots = Array.from(card.querySelectorAll<HTMLElement>('.step-indicator'));
            const label = card.querySelector<HTMLElement>('[data-sef-stepnum]');
            if (steps.length < 2 || !dots.length) return;
            card.dataset.sefProgressBound = '1';

            function sync() {
                // The visible one is the current one. Reading the rendered state
                // rather than counting clicks means this cannot drift out of
                // step with main.js, whatever route got the visitor here.
                const i = steps.findIndex((s) => s.offsetParent !== null);
                if (i < 0) return;
                dots.forEach((d, j) => {
                    if (j === i) d.setAttribute('data-current', '');
                    else d.removeAttribute('data-current');
                });
                if (label) label.textContent = `Step ${i + 1} of ${steps.length}`;
            }

            // display is set inline by main.js, so the attribute is what changes.
            const obs = new MutationObserver(sync);
            steps.forEach((s) => obs.observe(s, { attributes: true, attributeFilter: ['style'] }));
            sync();
        });
    }

    document.addEventListener('astro:page-load', initSefProgress);
    initSefProgress();
</script>
