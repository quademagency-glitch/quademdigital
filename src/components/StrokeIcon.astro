---
interface Props { name?: 'arrow' | 'right' | 'up' | 'close' | 'plus'; size?: number; }
const { name = 'arrow', size = 20 } = Astro.props;
const paths = { arrow: 'M5 19 19 5M5 5h14v14', right: 'M4 12h16M13 5l7 7-7 7', up: 'M12 20V4M5 11l7-7 7 7', close: 'm6 6 12 12M6 18 18 6', plus: 'M5 12h14M12 5v14' };
---
<svg class="lab-stroke-icon" aria-hidden="true" width={size} height={size} viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"><path d={paths[name]} /></svg>
