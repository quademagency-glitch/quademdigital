---
import { buildPayloadImageUrl } from "../lib/payload";
const { node } = Astro.props;

let url = "";
let altText = "Image";

if (node && node.image) {
    url = buildPayloadImageUrl(node.image);
    altText = node.image.alt || altText;
} else if (node && node.url) {
    url = node.url;
    altText = node.alt || altText;
}
---
{url ? (
  <img 
    src={url} 
    alt={altText} 
    loading="lazy"
    width="800"
    height="500"
    style="max-width: 100%; height: auto; border-radius: 8px; margin: 2rem 0;" 
  />
) : null}
