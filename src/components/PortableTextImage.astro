---
/*
  A picture inside Portable Text. It used to render the untouched original with
  hardcoded 800x500 dimensions, which were not the picture's dimensions: any
  image with a different shape was told to reserve the wrong box, so the
  article still shifted when it loaded, which is the whole thing width and
  height exist to prevent.
*/
import Picture from "./Picture.astro";
const { node } = Astro.props;

const image = node?.image ?? null;
// A node that carries a bare url rather than a media doc has no derivatives to
// choose from, so it stays a plain img.
const rawUrl = !image && node?.url ? node.url : null;
const rawAlt = node?.alt || "Image";

const STYLE = "max-width: 100%; height: auto; border-radius: 8px; margin: 2rem 0;";
const SIZES = "(max-width: 800px) 100vw, 800px";
---

{image && (
  <Picture
    image={image}
    alt={image.alt || "Image"}
    sizes={SIZES}
    size="medium"
    width={image.width ?? undefined}
    height={image.height ?? undefined}
    style={STYLE}
  />
)}

{rawUrl && (
  <img src={rawUrl} alt={rawAlt} loading="lazy" decoding="async" style={STYLE} />
)}
