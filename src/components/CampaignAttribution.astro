{/* Capture the first campaign landing on any public layout. */}
<script is:inline>
            try {
                var KEYS = ['utm_source','utm_medium','utm_campaign','utm_content','utm_term','gclid','ref'];
                var q = new URLSearchParams(location.search);
                var found = {};
                for (var i = 0; i < KEYS.length; i++) {
                    var v = q.get(KEYS[i]);
                    if (v) found[KEYS[i]] = v.slice(0, 120);
                }
                if (Object.keys(found).length) {
                    var raw = JSON.stringify(found);
                    sessionStorage.setItem('qd_utm', raw);
                    document.cookie = 'qd_utm=' + encodeURIComponent(raw) + ';path=/;max-age=2592000;samesite=lax';
                }

                /* How this visit reached the site, for the enquiry forms (src/lib/leadArrival.ts):
                   the site that sent them and the page they landed on. It lasts for the visit, and
                   only a new arrival from outside rewrites it, never a move between our own pages. */
                var from = '';
                try { from = new URL(document.referrer).hostname; } catch (e) { /* no referrer */ }
                if (from === location.hostname) from = '';
                var tagged = Object.keys(found).length > 0;
                var clicked = q.has('fbclid');
                if (from || tagged || clicked || !/(?:^|;\s*)qd_arrival=/.test(document.cookie)) {
                    var arrival = { r: from.slice(0, 100), l: location.pathname.slice(0, 200) };
                    if (tagged) arrival.c = 1;
                    if (clicked) arrival.f = 1;
                    document.cookie = 'qd_arrival=' + encodeURIComponent(JSON.stringify(arrival)) + ';path=/;samesite=lax';
                }
            } catch (e) { /* private mode, or no storage. Attribution is not worth an error. */ }
</script>
