</div>
</div>
</section>

<script>
  import { initStories } from '../../scripts/d-story.js';
  import { storyExtras } from '../../scripts/home-d/story-extras.js';

  const REEL = 3;
  // Where the story rests, one stop per scroll (d-story.js moves one step per
  // wheel gesture, swipe or key): the home screen, each app fully open with
  // everything shown (k + 0.2), then where to start. In the canvas's scroll
  // units, chapter k = k. data-steps is stops.length - 1.
  const stops = [0, 1.2, 2.2, 3.2, 4.2, 5.2, 6.2, 7];

  function setup() {
    const section = document.querySelector<HTMLElement>('[data-ds-root]');
    if (!section || section.dataset.dsReady) return;
    section.dataset.dsReady = '1';

    // The reel only runs while its app is open and the section is on screen,
    // and the visitor can pause it (WCAG 2.2.2).
    const idle = (chapter: number) => section.classList.toggle('ds-reel-idle', chapter !== REEL);
    idle(0);
    section.addEventListener('d-story:chapter', (e) => idle((e as CustomEvent).detail.chapter));
    storyExtras(section, { stops, chapters: 8 });
    if ('IntersectionObserver' in window) {
      const io = new IntersectionObserver((entries) => entries.forEach((en) => section.classList.toggle('ds-off', !en.isIntersecting)));
      io.observe(section);
      document.addEventListener('astro:before-swap', () => io.disconnect(), { once: true });
    }
    const btn = section.querySelector<HTMLButtonElement>('[data-ds-reel]');
    const label = btn?.querySelector('[data-ds-reel-label]');
    btn?.addEventListener('click', () => {
      const paused = section.classList.toggle('ds-reel-paused');
      if (label) label.textContent = paused ? 'Play the video' : 'Pause the video';
    });

    initStories();
  }
  document.addEventListener('astro:page-load', setup);
</script>
