---
// Home page proof section, row D final (ProofD2 on the design canvas): the
// "receipts" chat. A pinned phone story in eight steps: the locked phone, six
// results arriving as chat messages (score, speed, replies, leads, search, the
// client's words), then the ask with a printed receipt. Words and every number
// come from loadProof() (CMS group dProof over the approved defaults, the quote
// from a published testimonial when there is one). The phone is a drawing, so
// it is hidden from screen readers; the step copy carries the same facts.
import Picture from '../Picture.astro';
import workImages from '../../lib/workImageManifest.json';
import { emph } from '../../lib/homeD/emph';
import { splitTitle } from '../../lib/homeD/hero';
import { factNumber, type DProofWords } from '../../lib/homeD/proof';
import '../../styles/home-d/proof.css';

interface Props {
  words: DProofWords;
  /** The caseStudies collection, for the Omek cover behind the locked phone. */
  studies?: any[] | null;
}

const { words, studies } = Astro.props;
const steps = words.steps;
const f = words.facts;
const q = words.quote;
const notes = words.phone.notes;

const omek = (studies || []).find((s: any) => s?.slug === 'omek-storefront');
const omekCover = omek?.coverImage && typeof omek.coverImage === 'object' && omek.coverImage.url ? omek.coverImage : null;
const local = (url: string, width: number, height: number, sizes: [string, number, number][]) => ({
  source: 'local',
  url,
  width,
  height,
  sizes: Object.fromEntries(sizes.map(([u, w, h]) => [String(w), { url: u, width: w, height: h }])),
});
const omekPhone = local('/images/omek-storefront-phone.webp', 780, 1245, [['/images/omek-storefront-phone.webp', 780, 1245]]);
const erpLanding = local('/images/quaderp/landing-clean-640.webp', 1440, 900, [
  ['/images/quaderp/landing-clean-640.webp', 640, 400],
  ['/images/quaderp/landing-clean-960.webp', 960, 600],
  ['/images/quaderp/landing-clean-1440.webp', 1440, 900],
]);
const erpDashboard = local('/images/quaderp-dashboard.webp', 1024, 1024, [['/images/quaderp-dashboard.webp', 1024, 1024]]);
const fieldwork = workImages['fieldwork-record'];
const LOGO = '/images/logo-104.webp';

const scoreFrom = factNumber(f.scoreFrom, 50);
const scoreTo = factNumber(f.scoreTo, 95);
const replySecs = factNumber(f.replySecs, 64);
const leads = factNumber(f.leads, 40);
const seo = factNumber(f.seo, 100);
const bestPractices = factNumber(f.bestPractices, 100);

// Where each step's cards fly in, and how each looks (the canvas's places).
type Slot = { side: 'L' | 'R'; pos: string; kind: 'chip' | 'solid' | 'amber' | 'glass' | 'paper' | 'chat' | 'dashboard' | 'receipt'; icon?: 'check' | 'clock' | 'lock' };
const FLY: Slot[][] = [
  [{ side: 'L', pos: 'dp-p0a', kind: 'solid' }, { side: 'R', pos: 'dp-p0b', kind: 'chip', icon: 'check' }],
  [{ side: 'L', pos: 'dp-p1a', kind: 'chip' }, { side: 'R', pos: 'dp-p1b', kind: 'paper' }],
  [{ side: 'L', pos: 'dp-p2a', kind: 'glass' }, { side: 'R', pos: 'dp-p2b', kind: 'paper' }],
  [{ side: 'L', pos: 'dp-p3a', kind: 'chat' }, { side: 'R', pos: 'dp-p3b', kind: 'chip', icon: 'clock' }],
  [{ side: 'L', pos: 'dp-p4a', kind: 'solid' }, { side: 'R', pos: 'dp-p4b', kind: 'chip', icon: 'lock' }],
  [{ side: 'L', pos: 'dp-p5a', kind: 'dashboard' }, { side: 'R', pos: 'dp-p5b', kind: 'glass' }],
  [{ side: 'L', pos: 'dp-p6a', kind: 'amber' }, { side: 'R', pos: 'dp-p6b', kind: 'chip' }],
  [{ side: 'L', pos: 'dp-p7a', kind: 'solid' }, { side: 'R', pos: 'dp-p7b', kind: 'receipt' }],
];

const ticked = '<svg class="dp-ic dp-ic-xs" viewBox="0 0 24 24" aria-hidden="true"><path d="m2 13 4 4 8-9"></path><path d="m10 16 1 1 8-9"></path></svg>';
---
<section id="proof" class="d-story d-scope d-dark dp" data-story data-dp data-steps="7" data-seg="0.75" style="--d-steps: 7; --d-seg: 0.75" aria-label="Results from our work">
  <div class="d-track">
    <div class="d-stage">
      <div class="dp-glow" aria-hidden="true"></div>
      <div class="dp-dotsbg" aria-hidden="true"></div>
      <p class="d-pagetitle" aria-hidden="true"><span class="d-pagetitle-name">{words.pageTitle}</span><span class="d-pagetitle-count" data-story-count>{`01 / ${String(steps.length).padStart(2, '0')}`}</span></p>

      <div class="dp-inner">
        <div class="dp-copycol">
          <div class="dp-copyslot">
            {steps.map((step, k) => {
              const t = splitTitle(step.title);
              const Heading = k === 0 ? 'h2' : 'h3';
              return (
                <div class:list={['dp-ch dp-seq', `dp-k${k}`, { on: k === 0 }]} data-step={k} data-step-aria="hide" data-dp-ch aria-hidden={k === 0 ? 'false' : 'true'} inert={k !== 0}>
                  <p class="dp-lab">{step.label}</p>
                  <Heading class="dp-h"><span class="dp-ln dp-l1"><span set:html={emph(t.first)} /></span><span class="dp-ln dp-l2"><span set:html={emph(t.second)} /></span></Heading>
                  <p class="dp-sub" set:html={emph(step.text)} />
                  {k === 6 && (
                    <blockquote class="d-sr"><p>{q.text}</p><footer>{q.name}{q.role && `, ${q.role}`}</footer></blockquote>
                  )}
                  {step.links.length > 0 && (
                    <div class="dp-links">
                      {step.links.map((link) => <a class="dp-more" href={link.href} data-track="proof_link" data-loc={`home-proof-${k}`}>{link.label}</a>)}
                    </div>
                  )}
                </div>
              );
            })}
          </div>
          <div class="dp-ctas">
            <a class="dp-btn dp-grow" href={words.cta.href} data-track="checkup_cta" data-loc="home-proof">{words.cta.label} <svg class="dp-ic" viewBox="0 0 24 24" aria-hidden="true"><path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path></svg></a>
            <p class="dp-trust">{words.trust}</p>
          </div>
        </div>

        <div class="dp-phonecol">
          {steps.map((step, k) => <span class:list={['dp-word dp-seq', `dp-k${k}`]} aria-hidden="true">{step.word}</span>)}

          <div class="dp-phonebox">
            <div class="dp-phone" aria-hidden="true">
              <div class="dp-screen">
                <span class="dp-notch"></span>

                <div class="dp-scr dp-lock dp-seq dp-k0">
                  <Picture image={omekCover || omekPhone} alt="" sizes="300px" size="thumbnail" class="dp-lockbg" />
                  <div class="dp-lk">
                    <svg class="dp-ic dp-ic-s" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                    <b>Results</b>
                    <span>From Quadem Digital</span>
                  </div>
                  <div class="dp-nstack">
                    {notes.map((note) => (
                      <div class="dp-ntf"><span class="dp-lg"><img src={LOGO} alt="" width="26" height="26" loading="lazy" decoding="async" /></span><div><b>Quadem results <em>now</em></b><p>{note.text}</p></div></div>
                    ))}
                    <div class="dp-ntf dp-edge"></div>
                  </div>
                  <div class="dp-hint"><svg class="dp-ic dp-ic-s" viewBox="0 0 24 24"><path d="m6 15 6-6 6 6"></path></svg>Scroll to open<i></i></div>
                </div>

                <div class="dp-scr dp-chat">
                  <div class="dp-chead">
                    <svg class="dp-ic dp-back" viewBox="0 0 24 24"><path d="m15 6-6 6 6 6"></path></svg>
                    <span class="dp-av"><img src={LOGO} alt="" width="26" height="26" loading="lazy" decoding="async" /></span>
                    <div><b>Quadem results</b><span>Real work, real numbers</span></div>
                  </div>
                  <div class="dp-thread">
                    <div class="dp-m dp-out dp-txt dp-seq dp-k1 dp-early">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc"><div class="dp-bub">{words.phone.first}</div></div>
                    </div>

                    <div class="dp-m dp-out dp-seq dp-k1 dp-late">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc">
                        <div class="dp-rc dp-rpaper">
                          <p class="dp-rk">{f.scoreSource}</p>
                          <div class="dp-psr">
                            <span class="dp-ring" style={`--dp-from: ${scoreFrom}; --dp-to: ${scoreTo}`}><span class="dp-cnt" data-final={String(scoreTo)}></span></span>
                            <div class="dp-pst"><b>{f.scoreSite}</b><span>Performance score</span><span>{f.scoreKind}</span></div>
                          </div>
                          <div class="dp-pcmp"><span>{f.scoreFromDate} <b>{f.scoreFrom}</b></span><span>{f.scoreToDate} <b>{f.scoreTo}</b></span></div>
                        </div>
                        <p class="dp-meta">Measured, not estimated <Fragment set:html={ticked} /></p>
                      </div>
                    </div>

                    <div class="dp-m dp-out dp-seq dp-k2">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc">
                        <div class="dp-rc">
                          <p class="dp-rk">{f.picLabel}</p>
                          <p class="dp-sp"><s>{f.picFrom}</s><b>{f.picTo}</b></p>
                          <div class="dp-bars"><span class="dp-bb"><em>Before</em><i></i></span><span class="dp-ba"><em>After</em><i></i></span></div>
                          <p class="dp-rs">{f.picGain}</p>
                        </div>
                        <p class="dp-meta">{f.picSource} <Fragment set:html={ticked} /></p>
                      </div>
                    </div>

                    <div class="dp-m dp-out dp-seq dp-k3">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc">
                        <div class="dp-rc">
                          <p class="dp-rk">{f.replyLabel}</p>
                          <div class="dp-tm">
                            <span class="dp-clock"><span class="dp-hand"></span></span>
                            <div><p class="dp-tbig"><span class="dp-cnt" style={`--dp-to: ${replySecs}`} data-final={String(replySecs)}></span>s</p><em>{f.replyText}</em></div>
                          </div>
                          <div class="dp-thumb"><span class="dp-mchat"><i></i><i class="dp-o"></i><i></i></span>Sample conversation</div>
                        </div>
                        <p class="dp-meta">{f.replySource} <Fragment set:html={ticked} /></p>
                      </div>
                    </div>

                    <div class="dp-m dp-out dp-seq dp-k4">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc">
                        <div class="dp-rc dp-file">
                          <div class="dp-fprev"><Picture image={fieldwork} alt="" sizes="340px" /><span class="dp-tag">Details masked</span></div>
                          <div class="dp-frow"><span class="dp-fic"><svg class="dp-ic dp-ic-s" viewBox="0 0 24 24"><rect x="4" y="4" width="16" height="16" rx="2"></rect><path d="M4 10h16M4 15h16M10 4v16"></path></svg></span><div><b>{f.leadsTitle}</b><span><span class="dp-cnt" style={`--dp-to: ${leads}`} data-final={String(leads)}></span> {f.leadsText}</span></div></div>
                          <div class="dp-ticks"><span class="dp-rev dp-j1">Contact checked</span><span class="dp-rev dp-j2">Reason to call</span></div>
                        </div>
                        <p class="dp-meta">{f.leadsSource} <Fragment set:html={ticked} /></p>
                      </div>
                    </div>

                    <div class="dp-m dp-out dp-seq dp-k5">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc">
                        <div class="dp-rc dp-lnk">
                          <div class="dp-lprev"><Picture image={erpLanding} alt="" sizes="260px" /><span class="dp-tag">Demo data</span></div>
                          <div class="dp-lmeta"><b>{f.seoSite}</b><span>{f.seoKind}</span></div>
                          <div class="dp-minis">
                            <span class="dp-mini"><span class="dp-mring"><span class="dp-cnt" style={`--dp-to: ${seo}`} data-final={String(seo)}></span></span><em>SEO</em></span>
                            <span class="dp-mini"><span class="dp-mring"><span class="dp-cnt" style={`--dp-to: ${bestPractices}`} data-final={String(bestPractices)}></span></span><em>Best practices</em></span>
                          </div>
                        </div>
                        <p class="dp-meta">{f.seoSource} <Fragment set:html={ticked} /></p>
                      </div>
                    </div>

                    <div class="dp-m dp-in dp-seq dp-k6">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc">
                        <div class="dp-ph"><span class="dp-phl">Client quote</span><p>{q.text}</p><span class="dp-who">{q.name}{q.role && ` · ${q.role}`}</span></div>
                      </div>
                    </div>

                    <div class="dp-m dp-out dp-txt dp-seq dp-k7">
                      <span class="dp-dots"><i></i><i></i><i></i></span>
                      <div class="dp-mc"><div class="dp-bub">{words.phone.last}</div></div>
                    </div>
                  </div>
                  <div class="dp-cbar"><span>Message</span><svg class="dp-ic dp-ic-s" viewBox="0 0 24 24"><rect x="9" y="3" width="6" height="11" rx="3"></rect><path d="M5 11a7 7 0 0 0 14 0M12 18v3"></path></svg></div>
                </div>
              </div>
            </div>

            {FLY.map((slots, k) => slots.map((slot, j) => {
              const card = steps[k]?.cards[j];
              if (slot.kind !== 'receipt' && !card) return null;
              const chip = slot.kind === 'chip' || slot.kind === 'solid' || slot.kind === 'amber';
              return (
                <div class:list={['dp-fly dp-seq', `dp-k${k}`, `dp-${slot.side}`, slot.pos]} aria-hidden="true">
                  {chip && card && (
                    <span class:list={['dp-chip', { 'dp-solid': slot.kind === 'solid', 'dp-amber': slot.kind === 'amber' }]}>
                      {slot.icon === 'check' && <svg class="dp-ic dp-ic-s" viewBox="0 0 24 24"><path d="M4 12.5 9 17 20 6"></path></svg>}
                      {slot.icon === 'clock' && <svg class="dp-ic dp-ic-s" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path></svg>}
                      {slot.icon === 'lock' && <svg class="dp-ic dp-ic-s" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>}
                      {card.label || card.value}
                    </span>
                  )}
                  {(slot.kind === 'glass' || slot.kind === 'paper') && card && (
                    <div class:list={['dp-card', slot.kind === 'paper' ? 'dp-paper' : 'dp-glass']}>
                      {card.label && <p class="dp-k">{card.label}</p>}
                      {card.value && <p class="dp-fig">{card.value}</p>}
                      {card.note && <p class="dp-small">{card.note}</p>}
                    </div>
                  )}
                  {slot.kind === 'chat' && card && (
                    <div class="dp-pic"><span class="dp-mchat"><i></i><i class="dp-o"></i><i></i><i class="dp-o"></i></span><p><b>{card.label}</b>{card.note && ` · ${card.note}`}</p></div>
                  )}
                  {slot.kind === 'dashboard' && card && (
                    <div class="dp-pic"><Picture image={erpDashboard} alt="" sizes="194px" /><p><b>{card.label}</b>{card.note && ` · ${card.note}`}</p></div>
                  )}
                  {slot.kind === 'receipt' && (
                    <div class="dp-tillw"><div class="dp-till">
                      <p class="dp-tt"><img src={LOGO} alt="" width="24" height="24" loading="lazy" decoding="async" />{words.receipt.title}</p>
                      <p class="dp-ts">{words.receipt.sub}</p>
                      <ul class="dp-tli">
                        {words.receipt.rows.map((row) => <li><span>{row.label}</span><i></i><b>{row.value}</b></li>)}
                      </ul>
                      <p class="dp-ttot"><span>{words.receipt.totalLabel}</span><b>{words.receipt.total}</b></p>
                    </div></div>
                  )}
                </div>
              );
            }))}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  import { initStories } from '../../scripts/d-story.js';

  // The proof section's own state on top of d-story.js: chapters that are not
  // showing cannot take focus, reduced motion reads the step number (each
  // step's finished state) instead of the scroll position, and the typing dots
  // and the button's shine stop while the section is off screen.
  function initProof() {
    document.querySelectorAll<HTMLElement>('[data-dp]').forEach((el) => {
      const node = el as HTMLElement & { __dp?: boolean };
      if (node.__dp) return;
      node.__dp = true;
      const steps = Number(el.dataset.steps || 7);
      const sync = (i: number) => {
        el.style.setProperty('--dp-q', String(Math.min(i, steps)));
        el.querySelectorAll<HTMLElement>('[data-dp-ch]').forEach((ch) => { ch.inert = Number(ch.dataset.step) !== i; });
      };
      el.addEventListener('d-story:step', (e) => sync((e as CustomEvent<{ step: number }>).detail.step));
      if ('IntersectionObserver' in window) {
        new IntersectionObserver((entries) => {
          el.classList.toggle('dp-live', entries.some((entry) => entry.isIntersecting));
        }).observe(el);
      } else {
        el.classList.add('dp-live');
      }
      sync(Number(el.dataset.active || 0));
    });
    initStories();
  }

  document.addEventListener('astro:page-load', initProof);
  initProof();
</script>
