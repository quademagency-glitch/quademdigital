<script>
  import { initStories } from '../../scripts/d-story.js';

  // Section behaviour beyond the shared story helper: links in hidden steps
  // leave the tab order, the loops rest off screen, and calm mode applies for
  // reduced motion or motion paused on this website.
  let controller: AbortController | undefined;

  function setup() {
    controller?.abort();
    const root = document.querySelector<HTMLElement>('section.dx[data-story]');
    if (!root) return;
    controller = new AbortController();
    const { signal } = controller;

    const sync = (i: number) => {
      root.querySelectorAll<HTMLElement>('[data-dx-f]').forEach((el) => { el.tabIndex = Number(el.dataset.dxF) === i ? 0 : -1; });
    };
    root.addEventListener('d-story:step', (event) => sync((event as CustomEvent).detail.step), { signal });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const calm = () => root.toggleAttribute('data-calm', reduce.matches || document.body.dataset.motion === 'paused');
    reduce.addEventListener('change', calm, { signal });
    const watch = new MutationObserver(calm);
    watch.observe(document.body, { attributes: true, attributeFilter: ['data-motion'] });
    calm();

    const seen = new IntersectionObserver(([entry]) => root.classList.toggle('dx-off', !entry.isIntersecting));
    seen.observe(root);
    signal.addEventListener('abort', () => { watch.disconnect(); seen.disconnect(); });

    initStories(document);
    sync(Number(root.dataset.active || 0));
  }

  document.addEventListener('astro:page-load', setup);
</script>
