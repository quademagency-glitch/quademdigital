---
// The background behind a page's sections (Ernest, 27 Oct 2026: "both picture
// wall and our services work, depending on page; the words should be rotating
// on the background"). Put it first inside a section, or inside a pinned
// story's .d-stage so it stays put while the story plays.
//   wall:  our real work, one tilted picture faded into the section's ground.
//          On the pages about us and our work: About, Work, case studies, Contact.
//   words: the six services in huge faint letters, rows sliding left and right.
//          On the pages about what we do: services, each service, the check-up.
// Decoration only, hidden from screen readers. The words are letter shapes in
// an SVG (not text), so search engines do not read them as repeated keywords.
// The rows slide on the compositor, and only while the section is on screen
// and the site's motion is on. Pictures in public/images/backdrops; styles in
// d-system.css.
interface Props {
  kind: 'wall' | 'words';
}
const { kind } = Astro.props;
const ROWS = [0, 1, 2, 3, 4, 5, 6];
---
<div class:list={['d-bd', `d-bd-${kind}`]} aria-hidden="true" data-d-bd={kind}>
  {kind === 'words' && <div class="d-bd-rows">{ROWS.map(() => <span class="d-bd-row"></span>)}</div>}
</div>

<script>
  // The words slide only while their section is on screen.
  function watchBackdrops() {
    const rows = document.querySelectorAll<HTMLElement>('[data-d-bd="words"]:not([data-bd-seen])');
    if (!rows.length) return;
    if (!('IntersectionObserver' in window)) { rows.forEach((el) => el.toggleAttribute('data-on', true)); return; }
    const io = new IntersectionObserver((entries) => entries.forEach((e) => (e.target as HTMLElement).toggleAttribute('data-on', e.isIntersecting)));
    rows.forEach((el) => { el.toggleAttribute('data-bd-seen', true); io.observe(el); });
  }
  document.addEventListener('astro:page-load', watchBackdrops);
</script>
