              )}
              {VISUAL[i] === 'thumbs' && (
                <div class="dq-thumbs"><img src="/images/work-based/video-fashion-480.webp" width="480" height="853" alt="" aria-hidden="true" loading="lazy" decoding="async" /><img src="/images/work-based/video-story-480.webp" width="480" height="853" alt="" aria-hidden="true" loading="lazy" decoding="async" /><img src="/images/work-based/campaign-opening-480.webp" width="480" height="853" alt="" aria-hidden="true" loading="lazy" decoding="async" /></div>
              )}
              {VISUAL[i] === 'record' && (
                <div class="dq-fw"><img src="/images/work-based/fieldwork-record-640.webp" width="640" height="774" alt="" aria-hidden="true" loading="lazy" decoding="async" /><span>Details masked</span></div>
              )}
              {p.fixNote && <p class={NOTE[i]} set:html={emph(p.fixNote)} />}
              <a class="dq-fmore" href={p.linkHref} tabindex="-1" data-dtab>{p.linkLabel} <svg class="dq-ic dq-s" viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} /></a>
            </div>
          </div>
        ))}

        <div class="dq-fx dq-seq dq-k7" data-dstep="7" data-dstep-aria="hide" aria-hidden="true">
          <div class="dq-fixed">
            <p class="dq-fk"><i><svg class="dq-ic dq-xs" viewBox="0 0 24 24" aria-hidden="true" set:html={CHECK} /></i>{data.recapLabel}</p>
            <ul>
              {problems.map((p) => <li><svg class="dq-ic dq-s" viewBox="0 0 24 24" aria-hidden="true" set:html={CHECK} /><s>{p.word}</s><b>{p.recap}</b></li>)}
            </ul>
          </div>
        </div>
      </div>
    </div>
  </div>

</div>
</div>
</section>

<script>
  import { initStories } from '../../scripts/d-story.js';
  import { storyExtras } from '../../scripts/home-d/story-extras.js';
  import { skipFarChapters } from '../../scripts/home-d/far-chapters.js';

  // Where the story rests, one stop per scroll (d-story.js moves one step per
  // wheel gesture, swipe or key): the opening, then each problem twice, once
  // played (k + 0.24) and once fixed (k + 0.45), then the check-up. In the
  // canvas's scroll units, chapter k = k. data-steps is stops.length - 1.
  const stops = [0, 1.24, 1.45, 2.24, 2.45, 3.24, 3.45, 4.24, 4.45, 5.24, 5.45, 6.24, 6.45, 7];

  function setup() {
    const section = document.querySelector<HTMLElement>('[data-dq-root]');
    if (!section) return;
    skipFarChapters(section, '.dq-scr, .dq-fly, .dq-fx', 'd-story:chapter');
    storyExtras(section, { stops, chapters: 8 });
    initStories();
  }
  document.addEventListener('astro:page-load', setup);
</script>
