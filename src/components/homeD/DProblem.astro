              <div class="dq-gw">
                <div class="dq-lay dq-good">
                  <div class="dq-sbar"><svg class="dq-ic dq-s" viewBox="0 0 24 24"><circle cx="11" cy="11" r="6.5"></circle><path d="m20 20-4.2-4.2"></path></svg><span>tv shop open now</span></div>
                  <div class="dq-map">
                    <span class="dq-mp" style="left: 20%; top: 28%"></span>
                    <span class="dq-mp" style="left: 68%; top: 22%"></span>
                    <span class="dq-mp" style="left: 36%; top: 66%"></span>
                    <span class="dq-mp" style="left: 78%; top: 62%"></span>
                    <span class="dq-mp dq-you" style="left: 50%; top: 36%"></span>
                  </div>
                  <div class="dq-rows">
                    <div class="dq-row dq-you"><span class="dq-pin dq-blue"><svg class="dq-ic dq-xs" viewBox="0 0 24 24"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"></path></svg></span><div><b>Your business</b><span class="dq-sm">Open now · Directions · Website</span></div></div>
                    <div class="dq-row"><span class="dq-pin"></span><div><i class="dq-sk" style="width: 58%"></i><i class="dq-sk" style="width: 40%"></i></div></div>
                    <div class="dq-row"><span class="dq-pin"></span><div><i class="dq-sk" style="width: 50%"></i><i class="dq-sk" style="width: 34%"></i></div></div>
                  </div>
                  <span class="dq-tag">Illustration</span>
                </div>
              </div>
              <span class="dq-wipe"><span><svg class="dq-ic dq-s" viewBox="0 0 24 24"><path d="M5 12.5 10 17 19 7"></path></svg></span></span>
            </div>

            <div class="dq-scr dq-s4 dq-seq dq-k4" data-dstep="4">
              <div class="dq-lay dq-bad">
                <div class="dq-prof"><span class="dq-av"><svg class="dq-ic dq-s" viewBox="0 0 24 24"><path d="M4 10h16l-1.5-5h-13z"></path><path d="M5 10v9h14v-9"></path><path d="M10 19v-5h4v5"></path></svg></span><div><b>Your brand</b><span>Posting calendar, this month</span></div></div>
                <div class="dq-wk"><span>M</span><span>T</span><span>W</span><span>T</span><span>F</span><span>S</span><span>S</span></div>
                <div class="dq-cal dq-n6">
                  <div class="dq-cw dq-rv dq-j0"><i></i><i class="dq-old"></i><i></i><i></i><i></i><i></i><i></i></div>
                  <div class="dq-cw dq-rv dq-j1"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  <div class="dq-cw dq-rv dq-j2"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  <div class="dq-cw dq-rv dq-j3"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  <div class="dq-cw dq-rv dq-j4"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
