                    <div class="dq-trio"><span><b>1.1s</b>First thing on screen</span><span><b>2.9s</b>Main picture</span><span><b>2.7s</b>Looks finished</span></div>
                  </div>
                </div>
              </div>
              <span class="dq-wipe"><span><svg class="dq-ic dq-s" viewBox="0 0 24 24"><path d="M5 12.5 10 17 19 7"></path></svg></span></span>
            </div>

            <div class="dq-scr dq-s2 dq-seq dq-k2" data-dstep="2">
              <div class="dq-lay dq-bad dq-chat">
                <div class="dq-chead"><svg class="dq-ic dq-back" viewBox="0 0 24 24"><path d="m15 6-6 6 6 6"></path></svg><span class="dq-av"><svg class="dq-ic dq-s" viewBox="0 0 24 24"><path d="M4 10h16l-1.5-5h-13z"></path><path d="M5 10v9h14v-9"></path><path d="M10 19v-5h4v5"></path></svg></span><div><b>Your business</b><span>Business account</span></div></div>
