                    <div class="dq-cw"><i></i><i class="dq-vid"><img src="/images/work-based/video-story-480.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" /></i><i></i><i></i><i class="dq-vid"><img src="/images/work-based/video-fashion-480.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" /></i><i></i><i></i></div>
                    <div class="dq-cw"><i></i><i class="dq-vid"><img src="/images/work-based/campaign-opening-480.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" /></i><i></i><i></i><i class="dq-vid"><img src="/images/work-based/campaign-opening-480.webp" alt="" aria-hidden="true" loading="lazy" decoding="async" /></i><i></i><i></i></div>
                    <div class="dq-cw"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                  </div>
