---
// Home page, problem section (row D final, 24 Oct 2026): a pinned device story.
// Above 900px the device is a laptop with desktop screens (owner, 24 Oct 2026);
// at 900px and below it is the canvas's phone. Both are rendered and CSS shows
// one; images in the hidden one are lazy, so they are never fetched.
// Step 0 opens on a buyer's bad evening, steps 1 to 6 show one problem each on
// the phone and then wipe across to its fix, step 7 is the free check-up. Port
// of the approved canvas design ProblemD2: same layout, motion and words.
// Words: loadProblem(homepage) (CMS group dProblem over problem.defaults.json).
// The phone's own small words are part of the drawing and stay here.
import '../../styles/home-d/problem.css';
import Picture from '../Picture.astro';
import { emph, plain } from '../../lib/homeD/emph';
import { splitTitle, type DProblemWords } from '../../lib/homeD/problem';

interface Props {
  data: DProblemWords;
  /** Where the main button goes; defaults to the check-up link the loader resolved. */
  ctaHref?: string;
  /** The caseStudies collection, for Omek's desktop storefront cover on the laptop. */
  studies?: any[] | null;
}
const { data, ctaHref = data.ctaHref, studies } = Astro.props;
const omekStudy = (studies || []).find((s: any) => s?.slug === 'omek-storefront');
const omekCover = omekStudy?.coverImage && typeof omekStudy.coverImage === 'object' && omekStudy.coverImage.url ? omekStudy.coverImage : null;
const problems = data.problems;
const num = (i: number) => String(i + 1).padStart(2, '0');
const opening = splitTitle(data.title);
const closing = splitTitle(data.closeTitle);
const CHECK = '<path d="M5 12.5 10 17 19 7"></path>';
const ARROW = '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>';
// The red label beside the phone for each problem: its icon.
const BAD_ICON = [
  '<circle cx="12" cy="12" r="8.5"></circle><path d="M12 7.5V12l3 2"></path>',
  '<path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"></path>',
  '<path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"></path>',
  '<rect x="4" y="5" width="16" height="15" rx="2"></rect><path d="M4 10h16M9 3v4M15 3v4"></path>',
  '<path d="M12 20s-7-4.4-7-10a4 4 0 0 1 7-2.6A4 4 0 0 1 19 10c0 5.6-7 10-7 10z"></path>',
  '<path d="M6 6l12 12M18 6 6 18"></path>',
];
// Which fix card carries which picture: the speed table (1), AI video frames (4), the masked lead list (6).
const VISUAL = ['table', '', '', 'thumbs', '', 'record'];
const NOTE = ['dq-src', 'dq-fs', 'dq-fs', 'dq-cap', 'dq-fs', 'dq-fs'];
const table = data.speedTable;
---
<section id="problem" class="dq-root d-scope d-dark d-story" data-story data-steps="13" data-seg="0.5385" data-dq-root aria-label={plain(data.label)}>
<div class="d-track">
<div class="d-stage dq-stage">

  <div class="d-bigtitle" aria-hidden="true"><span class="d-bigtitle-word">{data.pageTitle}</span><span class="d-bigtitle-sub"><span class="d-bigtitle-label">{data.pageLabel}</span><span class="d-pagetitle-count" data-dcount>01 / 08</span></span></div>

  <div class="dq-dotsbg" aria-hidden="true"></div>

  <div class="dq-inner">
    <div class="dq-copycol">
      <div class="dq-copyslot">
        <div class="dq-ch dq-seq dq-k0 on" data-dstep="0" data-dstep-aria="hide" aria-hidden="false">
          <p class="dq-lab dq-bad">{data.eyebrow}</p>
          <h2 class="dq-h"><span class="dq-ln dq-l1"><span set:html={emph(opening.first)} /></span><span class="dq-ln dq-l2"><span set:html={emph(opening.second)} /></span></h2>
          <p class="dq-sub" set:html={emph(data.lead)} />
        </div>
        {problems.map((p, i) => {
          const t = splitTitle(p.title);
          return (
            <div class={`dq-ch dq-seq dq-k${i + 1}`} data-dstep={i + 1} data-dstep-aria="hide" aria-hidden="true">
              <p class="dq-lab dq-bad">{num(i)} · {data.problemLabel}</p>
              <h3 class="dq-h"><span class="dq-ln dq-l1"><span set:html={emph(t.first)} /></span><span class="dq-ln dq-l2"><span set:html={emph(t.second)} /></span></h3>
              <div class="dq-swap">
                <p class="dq-sub" set:html={emph(p.problem)} />
                <div class="dq-fxm"><p class="dq-fxl"><svg class="dq-ic dq-xs" viewBox="0 0 24 24" aria-hidden="true" set:html={CHECK} />{data.fixLabel}</p><p class="dq-fxt" set:html={emph(p.fix)} /><a class="dq-more" href={p.linkHref} tabindex="-1" data-dtab>{p.linkLabel}</a></div>
              </div>
            </div>
          );
        })}
        <div class="dq-ch dq-seq dq-k7" data-dstep="7" data-dstep-aria="hide" aria-hidden="true">
          <p class="dq-lab">{data.closeEyebrow}</p>
          <h3 class="dq-h"><span class="dq-ln dq-l1"><span set:html={emph(closing.first)} /></span><span class="dq-ln dq-l2"><span set:html={emph(closing.second)} /></span></h3>
          <p class="dq-sub" set:html={emph(data.closeText)} />
        </div>
      </div>
      <div class="dq-ctas">
        <a class="dq-btn dq-grow" href={ctaHref} data-track="home_problem_cta" data-loc="home-problem">{data.ctaLabel} <svg class="dq-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ARROW} /></a>
        <p class="dq-trust">{data.trust}</p>
      </div>
    </div>

    <div class="dq-phonecol">
      <span class="dq-halo" aria-hidden="true"></span>

      <span class="dq-word dq-seq dq-k0" style={`--dq-len: ${data.startWord.length}`} aria-hidden="true">{data.startWord}</span>
      {problems.map((p, i) => <span class={`dq-word dq-seq dq-k${i + 1}`} style={`--dq-len: ${p.word.length}`} aria-hidden="true">{p.word}</span>)}
      <span class="dq-word dq-b dq-seq dq-k7" style={`--dq-len: ${data.closeWord.length}`} aria-hidden="true">{data.closeWord}</span>

      <div class="dq-phonebox d-only-phone">
        <div class="dq-phone" aria-hidden="true">
          <div class="dq-screen">
            <span class="dq-notch"></span>

            <div class="dq-scr dq-lock dq-seq dq-k0 on" data-dstep="0">
              <div class="dq-lk">
                <svg class="dq-ic dq-s" viewBox="0 0 24 24"><rect x="5" y="11" width="14" height="10" rx="2"></rect><path d="M8 11V8a4 4 0 0 1 8 0v3"></path></svg>
                <b>Evening</b>
                <span>A buyer, looking for a TV</span>
                <span class="dq-pill">Illustration</span>
              </div>
              <div class="dq-nstack">
                <div class="dq-ntf"><span class="dq-ni"><svg class="dq-ic dq-s" viewBox="0 0 24 24"><circle cx="12" cy="12" r="8.5"></circle><path d="M3.5 12h17M12 3.5c2.5 2.6 2.5 14.4 0 17M12 3.5c-2.5 2.6-2.5 14.4 0 17"></path></svg></span><div><b>Browser <em>now</em></b><p>Still loading the shop's page…</p></div></div>
                <div class="dq-ntf"><span class="dq-ni"><svg class="dq-ic dq-s" viewBox="0 0 24 24"><path d="M20 12a8 8 0 0 1-11.6 7.1L4 20l1-4.2A8 8 0 1 1 20 12z"></path></svg></span><div><b>WhatsApp <em class="dq-r">Seen</em></b><p>You: Hi, is this TV still available?</p></div></div>
                <div class="dq-ntf"><span class="dq-ni"><svg class="dq-ic dq-s" viewBox="0 0 24 24"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"></path><circle cx="12" cy="10" r="2.3"></circle></svg></span><div><b>Maps <em>now</em></b><p>Other TV shops open now near you</p></div></div>
