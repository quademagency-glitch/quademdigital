                  <div class="dq-row dq-rv dq-j2"><span class="dq-pin"><svg class="dq-ic dq-xs" viewBox="0 0 24 24"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"></path></svg></span><div><b>Another shop</b><i class="dq-sk" style="width: 44%"></i></div></div>
                  <div class="dq-row dq-rv dq-j3"><span class="dq-pin"><svg class="dq-ic dq-xs" viewBox="0 0 24 24"><path d="M12 21s-6.5-6-6.5-11a6.5 6.5 0 0 1 13 0c0 5-6.5 11-6.5 11z"></path></svg></span><div><b>Another shop</b><i class="dq-sk" style="width: 52%"></i></div></div>
                  <div class="dq-row dq-miss dq-rv dq-j5"><span class="dq-pin">?</span><div><b>Your business</b><span class="dq-sm">Not in the results</span></div></div>
                </div>
                <span class="dq-tag">Illustration</span>
