---
// Home page Work section, as a cinematic carousel (owner, 26 Oct 2026: "Our
// work section on the homepage, I want them in a cinematic carousel format").
// Still a pinned story of eight steps, so the hero's results strip and every
// link into it land where they did: an opening title card, the six projects as
// wide frames on navy (the frames either side wait, dimmed, at the edges; the
// frame showing drifts slowly closer), and the closing card. One scroll, swipe
// (up, down or sideways), arrow key or tap on the index moves one frame.
//
// Words come from loadWork (CMS group dWork over work.defaults.json), the
// same approved words as before. Pictures: Omek's and Quajo Speaks's
// screenshots are CMS media (caseStudies); the rest are public files: the
// QuadERP site (our product, demo data, labelled), the AI video frames (made
// with AI, labelled), the masked Fieldwork list, and the sample conversation,
// which is drawn here and labelled as a sample.
import DBackdrop from './DBackdrop.astro';
import Picture from '../Picture.astro';
import { emph } from '../../lib/homeD/emph';
import { splitTitle } from '../../lib/homeD/hero';
import type { DWorkWords } from '../../lib/homeD/work';
import '../../styles/home-d/work.css';

interface Props { words: DWorkWords; studies?: any[] }
const { words, studies = [] } = Astro.props;
const { steps } = words;
const LAST = steps.length - 1;

const media = (slug: string) => {
  const doc = (studies || []).find((study: any) => study?.slug === slug);
  return doc?.coverImage && typeof doc.coverImage === 'object' ? doc.coverImage : null;
};
const omek = media('omek-storefront');
// Quajo Speaks is the website proof after Omek (Ernest, 26 Oct 2026: "use
// quajospeaks instead of SAN collection for websites proof").
const quajo = media('quajo-speaks');

const vid = (name: string) => ({
  src: `/images/work-based/${name}-640.webp`,
  srcset: `/images/work-based/${name}-480.webp 480w, /images/work-based/${name}-640.webp 640w, /images/work-based/${name}-720.webp 720w`,
});
const reel = [vid('video-fashion'), vid('video-story'), vid('campaign-opening')];
const erpSrcset = '/images/quaderp/landing-clean-640.webp 640w, /images/quaderp/landing-clean-960.webp 960w, /images/quaderp/landing-clean-1440.webp 1440w';
const fieldSrcset = '/images/work-based/fieldwork-record-640.webp 640w, /images/work-based/fieldwork-record-960.webp 960w, /images/work-based/fieldwork-record-1536.webp 1536w';
const FRAME_SIZES = '(max-width: 900px) 90vw, 1180px';

const ICON = {
  arrow: '<path d="M5 12h14"></path><path d="m13 6 6 6-6 6"></path>',
  prev: '<path d="m15 6-6 6 6 6"></path>',
  next: '<path d="m9 6 6 6-6 6"></path>',
  timer: '<circle cx="12" cy="13" r="8"></circle><path d="M12 9v4l2.5 2"></path><path d="M10 2h4"></path>',
};
const CHIP: Record<string, string> = { client: 'dwc-cl', progress: 'dwc-prog', live: 'dwc-live', own: 'dwc-own' };

// The measured result on each frame: Omek's before and after, else the card
// that carries a value. A project with no number shows none.
const resultOf = (k: number) => {
  if (k === 1 && words.results.length) {
    const note = steps[1].cards.find((c) => c.label && c.note && !c.value && /PageSpeed|test/i.test(c.note))?.note || '';
    return { rows: words.results.slice(0, 2), value: '', note };
  }
  const card = steps[k]?.cards.find((c) => c.value);
  return card ? { rows: [], value: card.value, note: card.note } : null;
};
const nameOf = (label: string) => label.replace(/^\s*\d+\s*·\s*/, '');
const pad = (n: number) => String(n).padStart(2, '0');
---
<section id="work" class="dw d-scope d-dark d-story" data-story data-steps={String(LAST)} data-seg="0.9" data-active="0" data-swipe-steps aria-label={words.aria}>
  <div class="d-track">
    <div class="d-stage">
      <DBackdrop kind="wall" />
      <div class="d-bigtitle" aria-hidden="true">
        <span class="d-bigtitle-word">{words.pageTitle}</span>
        <span class="d-bigtitle-sub"><span class="d-bigtitle-label">{words.titleLabel}</span><span class="d-pagetitle-count" data-story-count>{`01 / ${pad(steps.length)}`}</span></span>
      </div>
      <div class="dwc-glow" aria-hidden="true"></div>

      <div class="dwc-reel">
        <div class="dwc-track">
          {steps.map((_, k) => (
            <figure class:list={['dwc-frame', `dwc-f${k}`, { on: k === 0 }]} data-step={k} data-step-aria="hide" aria-hidden={k === 0 ? 'false' : 'true'}>
              {(k === 0 || k === LAST) && (
                <div class:list={['dwc-montage', { 'dwc-montage-end': k === LAST }]}>
                  <span>{omek && <Picture image={omek} alt="" sizes="400px" size="card" />}</span>
                  <span>{quajo && <Picture image={quajo} alt="" sizes="400px" size="card" />}</span>
                  <span><img src="/images/quaderp/landing-clean-640.webp" width="640" height="400" alt="" loading="lazy" decoding="async" /></span>
                  <span><img src={reel[0].src} width="640" height="1138" alt="" loading="lazy" decoding="async" style="object-position: 50% 25%" /></span>
                  <span><img src="/images/work-based/fieldwork-record-640.webp" width="640" height="774" alt="" loading="lazy" decoding="async" style="object-position: 50% 0" /></span>
                  <span><img src={reel[2].src} width="640" height="1138" alt="" loading="lazy" decoding="async" style="object-position: 50% 30%" /></span>
                </div>
              )}
              {k === 1 && <div class="dwc-kb">{omek ? <Picture image={omek} alt="" sizes={FRAME_SIZES} size="large" class="dwc-img" style="object-position: 50% 0" /> : <img class="dwc-img" src="/images/omek-storefront-phone.webp" width="780" height="1245" alt="" loading="lazy" decoding="async" />}</div>}
              {k === 2 && <div class="dwc-kb">{quajo && <Picture image={quajo} alt="" sizes={FRAME_SIZES} size="large" class="dwc-img" style="object-position: 50% 30%" />}</div>}
              {k === 3 && (
                <div class="dwc-kb">
                  <img class="dwc-img" src="/images/quaderp/landing-clean-1440.webp" srcset={erpSrcset} sizes={FRAME_SIZES} width="1440" height="900" alt="" loading="lazy" decoding="async" style="object-position: 50% 0" />
                  <span class="dwc-tag">Demo data</span>
                </div>
              )}
              {k === 4 && (
                <div class="dwc-kb dwc-chatbg">
                  <div class="dwc-chat">
                    <div class="dwc-chead"><span class="dwc-av"><img src="/images/logo-104.webp" width="104" height="104" alt="" loading="lazy" decoding="async" /></span><div><b>Quadem</b><span>AI automation</span></div></div>
                    <span class="dwc-pill">Sample conversation</span>
                    <p class="dwc-msg dwc-in">Hi, can you help my shop get more orders online?</p>
                    <span class="dwc-timer"><svg class="dwc-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.timer} />First reply in <b>64s</b></span>
                    <p class="dwc-msg dwc-out">Yes, we can. What do you sell, and do you have a website today?</p>
                    <p class="dwc-msg dwc-in">Phones and accessories. Our site is slow.</p>
                    <p class="dwc-msg dwc-out">Thanks. Shall we start with a free website check-up? We'll send you a short list of what to fix first.</p>
                  </div>
                </div>
              )}
              {k === 5 && (
                <div class="dwc-kb dwc-trip">
                  {reel.map((frame) => <img src={frame.src} srcset={frame.srcset} sizes="(max-width: 900px) 30vw, 360px" width="640" height="1138" alt="" loading="lazy" decoding="async" />)}
                  <span class="dwc-tag">Made with AI</span>
                </div>
              )}
              {k === 6 && (
                <div class="dwc-kb dwc-docbg">
                  <img class="dwc-doc" src="/images/work-based/fieldwork-record-960.webp" srcset={fieldSrcset} sizes="(max-width: 900px) 70vw, 620px" width="960" height="1161" alt="" loading="lazy" decoding="async" />
                  <span class="dwc-tag">Details masked</span>
                </div>
              )}
              {k === LAST && <div class="dwc-endbg" aria-hidden="true"></div>}
            </figure>
          ))}
        </div>

        <div class="dwc-caps">
          {steps.map((step, k) => {
            const t = splitTitle(step.title);
            const H = k === 0 ? 'h2' : 'h3';
            const result = k > 0 && k < LAST ? resultOf(k) : null;
            const edge = k === 0 || k === LAST;
            return (
              <div class:list={['dwc-cap', { 'dwc-cap-edge': edge, on: k === 0 }]} data-step={k} data-step-aria="hide" aria-hidden={k === 0 ? 'false' : 'true'}>
                <div class="dwc-copy">
                  <p class="dwc-lab">{step.label}</p>
                  <H class="dwc-h">
                    {t.first && <span class="dwc-l1" set:html={emph(t.first)} />}
                    {t.second && <span class="dwc-l2" set:html={emph(t.second)} />}
                  </H>
                  {step.text && <p class="dwc-sub" set:html={emph(step.text)} />}
                  {(step.chips.length > 0 || step.links.length > 0 || k === LAST) && (
                    <div class="dwc-meta">
                      {step.chips.length > 0 && <ul class="dwc-chips">{step.chips.map((chip) => <li class:list={['dwc-chip', CHIP[chip.kind]]}>{chip.text}</li>)}</ul>}
                      {k === LAST && (
                        <a class="d-btn d-btn-primary dwc-btn" href={words.cta.href} tabindex="-1" data-dwc-f={k} data-track="home_work_cta" data-loc="home-work">{words.cta.label} <svg class="dwc-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.arrow} /></a>
                      )}
                      {step.links.map((link) => (
                        <a class="dwc-more" href={link.href} tabindex={k === 0 ? '0' : '-1'} data-dwc-f={k} data-track="home_work_link" data-loc="home-work">{link.label} <svg class="dwc-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.arrow} /></a>
                      ))}
                      {k === LAST && words.trust && <p class="dwc-trust">{words.trust}</p>}
                    </div>
                  )}
                </div>
                {result && (
                  <div class="dwc-res">
                    {result.rows.length > 0
                      ? result.rows.map((row) => <p class="dwc-ba"><span class="dwc-before">{row.before}</span><svg class="dwc-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.arrow} /><b>{row.after}</b><small>{row.label}</small></p>)
                      : <p class="dwc-big">{result.value}</p>}
                    {result.note && <p class="dwc-note">{result.note}</p>}
                  </div>
                )}
              </div>
            );
          })}
        </div>
      </div>

      <nav class="dwc-index" aria-label="Projects">
        <button type="button" class="dwc-arrow" data-goto="work" data-goto-dir="-1" aria-label="Previous project"><svg class="dwc-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.prev} /></button>
        <ol>
          {steps.slice(1, LAST).map((step, i) => (
            <li><button type="button" class="dwc-ix" data-step={i + 1} data-step-aria="current" data-goto="work" data-goto-step={i + 1}><span class="dwc-ixn">{pad(i + 1)}</span><span class="dwc-ixt">{nameOf(step.label)}</span></button></li>
          ))}
        </ol>
        <button type="button" class="dwc-arrow" data-goto="work" data-goto-dir="1" aria-label="Next project"><svg class="dwc-ic" viewBox="0 0 24 24" aria-hidden="true" set:html={ICON.next} /></button>
      </nav>
    </div>
  </div>
</section>
<script>
  import { initStories } from '../../scripts/d-story.js';

  // Beyond the shared story helper: links on frames that are not showing leave
  // the tab order, calm mode (reduced motion, or motion paused on this site)
  // stops the slow drift, and the pictures load before the visitor arrives.
  let controller: AbortController | undefined;

  function setup() {
    controller?.abort();
    const root = document.querySelector<HTMLElement>('section.dw[data-story]');
    if (!root) return;
    controller = new AbortController();
    const { signal } = controller;

    const sync = (i: number) => {
      root.querySelectorAll<HTMLElement>('[data-dwc-f]').forEach((el) => { el.tabIndex = Number(el.dataset.dwcF) === i ? 0 : -1; });
    };
    root.addEventListener('d-story:step', (event) => sync((event as CustomEvent).detail.step), { signal });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const calm = () => root.toggleAttribute('data-calm', reduce.matches || document.body.dataset.motion === 'paused');
    reduce.addEventListener('change', calm, { signal });
    const watch = new MutationObserver(calm);
    watch.observe(document.body, { attributes: true, attributeFilter: ['data-motion'] });
    calm();

    const near = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      root.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => { img.loading = 'eager'; });
      near.disconnect();
    }, { rootMargin: '150% 0px' });
    near.observe(root);
    signal.addEventListener('abort', () => { watch.disconnect(); near.disconnect(); });

    initStories(document);
    sync(Number(root.dataset.active || 0));
  }

  document.addEventListener('astro:page-load', setup);
</script>
