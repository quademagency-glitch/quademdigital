<script>
  import { initStories } from '../../scripts/d-story.js';

  // Section behaviour beyond the shared story helper: links in hidden steps
  // leave the tab order, the reel pauses (button, off screen, away from its
  // step), calm mode for reduced motion or motion paused on this website, and
  // the phone pictures load before the visitor reaches them.
  let controller: AbortController | undefined;

  function setup() {
    controller?.abort();
    const root = document.querySelector<HTMLElement>('section.dw[data-story]');
    if (!root) return;
    controller = new AbortController();
    const { signal } = controller;

    const sync = (i: number) => {
      root.querySelectorAll<HTMLElement>('[data-dw-f]').forEach((el) => { el.tabIndex = Number(el.dataset.dwF) === i ? 0 : -1; });
      root.classList.toggle('dw-rest', Math.abs(i - 5) > 1);
    };
    root.addEventListener('d-story:step', (event) => sync((event as CustomEvent).detail.step), { signal });

    const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
    const calm = () => root.toggleAttribute('data-calm', reduce.matches || document.body.dataset.motion === 'paused');
    reduce.addEventListener('change', calm, { signal });
    const watch = new MutationObserver(calm);
    watch.observe(document.body, { attributes: true, attributeFilter: ['data-motion'] });
    calm();

    const seen = new IntersectionObserver(([entry]) => root.classList.toggle('dw-off', !entry.isIntersecting));
    seen.observe(root);
    const near = new IntersectionObserver(([entry]) => {
      if (!entry.isIntersecting) return;
      root.querySelectorAll<HTMLImageElement>('img[loading="lazy"]').forEach((img) => { img.loading = 'eager'; });
      near.disconnect();
    }, { rootMargin: '150% 0px' });
    near.observe(root);
    signal.addEventListener('abort', () => { watch.disconnect(); seen.disconnect(); near.disconnect(); });

    const reelButton = root.querySelector<HTMLButtonElement>('[data-dw-reel]');
    reelButton?.addEventListener('click', () => {
      const paused = root.dataset.reel !== 'paused';
      root.dataset.reel = paused ? 'paused' : 'playing';
      const label = reelButton.querySelector('[data-dw-reel-label]');
      if (label) label.textContent = (paused ? reelButton.dataset.play : reelButton.dataset.pause) || '';
    }, { signal });

    initStories(document);
    sync(Number(root.dataset.active || 0));
  }

  document.addEventListener('astro:page-load', setup);
</script>
