---
/**
 * "Work we've delivered" — the real case studies tagged for one service page.
 *
 * Driven by CaseStudies.showUnderServices in the CMS, so adding a project to a
 * service page is a checkbox there rather than a code change. Renders nothing
 * when a service has no projects yet, which is deliberate: an empty portfolio
 * strip reads worse than no strip at all.
 */
import { payloadFetch, getPayloadImageSize, getPayloadImageSrcset } from "../lib/payload";

interface Props {
    /** Matches a CaseStudies.showUnderServices option value. */
    service: string;
    heading?: string;
    subtitle?: string;
    /** CSS background for the gradient heading, so each service keeps its accent. */
    accentGradient?: string;
    /** Cap on cards shown; the rest stay on /projects/. */
    limit?: number;
}

const {
    service,
    heading = "Work we've delivered",
    subtitle = "Real projects, built and shipped by us. Open any one to see how it was done.",
    accentGradient,
    limit = 3,
} = Astro.props;

const allStudies = await payloadFetch('caseStudies', { sort: 'order', depth: '1', limit: '100' });

const projects = (allStudies ?? [])
    .filter((s: any) => s.published === true)
    .filter((s: any) => Array.isArray(s.showUnderServices) && s.showUnderServices.includes(service))
    .slice(0, limit);

const typeBadge: Record<string, string> = {
    client: '',
    concept: 'Concept',
    self: 'Internal',
};
---
{projects.length > 0 && (
<section class="work section-padding" id="service-projects">
    <div class="container">
        <div class="section-header animate-on-scroll slide-up">
            <h2>
                <span class="text-gradient" style={accentGradient ? `background: ${accentGradient}; -webkit-background-clip: text; -webkit-text-fill-color: transparent;` : undefined}>{heading}</span>
            </h2>
            <p>{subtitle}</p>
        </div>

        <div class="archive-grid">
            {projects.map((study: any, index: number) => {
                const badge = typeBadge[study.projectType ?? 'client'];
                const href = study.slug ? `/projects/${study.slug}/` : '#';
                return (
                    <div class={`work-card glow-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <a href={href} style="display: block; overflow: hidden; border-radius: 12px 12px 0 0; position: relative;">
                            <div class="work-img">
                                {study.coverImage ? (
                                    <img
                                        src={getPayloadImageSize(study.coverImage, 'medium')}
                                        srcset={getPayloadImageSrcset(study.coverImage) || undefined}
                                        sizes="(max-width: 992px) 80vw, 400px"
                                        alt={study.coverImage.alt || study.title}
                                        loading="lazy"
                                        decoding="async"
                                        width="800"
                                        height="500"
                                        style="width:100%; height:100%; object-fit:cover;"
                                    />
                                ) : (
                                    <div style="width:100%; height:100%; background: rgba(0,174,239,0.06); display:flex; align-items:center; justify-content:center; color: var(--border-strong); font-size: 2rem;">◻</div>
                                )}
                            </div>
                            {badge && <span class="sp-type-badge">{badge}</span>}
                        </a>
                        <div class="work-content">
                            <span class="work-tag">{study.tag}</span>
                            <h3 class="work-title">{study.title}</h3>
                            <p class="work-desc">{study.description}</p>
                            {(study.resultMetric || study.resultText) && (
                                <div class="work-result">
                                    <span class="result-metric">{study.resultMetric}</span>
                                    <span class="result-text">{study.resultText}</span>
                                </div>
                            )}
                            <a href={href} class="work-link">View Project →</a>
                        </div>
                    </div>
                );
            })}
        </div>

        <div class="work-cta" style="margin-top: 40px;">
            <a href="/projects/" class="btn btn-ghost btn-pill">See all our work</a>
        </div>
    </div>
</section>
)}

<style>
    .sp-type-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(0, 0, 0, 0.65);
        border: 1px solid var(--border-strong);
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 50px;
        backdrop-filter: blur(6px);
    }
</style>
