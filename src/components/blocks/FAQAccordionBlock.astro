---
/**
 * Questions and answers.
 *
 * Deliberately reuses the site's own `.faq-item` / `.faq-question` /
 * `.faq-answer` classes rather than styling its own. main.js already binds
 * every one of those on the page and handles more than one group correctly,
 * so this block gets the same open and close behaviour as the service pages
 * for no extra script.
 */
import BlockHeader from "./BlockHeader.astro";

interface Props {
  block: any;
}

const { block } = Astro.props;
const faqs = (block?.faqs ?? []).filter((f: any) => f?.question && f?.answer);
---

{faqs.length > 0 && (
  <section class="faq section-padding">
    <div class="container">
      <BlockHeader heading={block.heading} subheading={block.subheading} />
      <div class="faq-list">
        {faqs.map((faq: any) => (
          <div class="faq-item">
            <button class="faq-question" type="button">
              <span>{faq.question}</span>
              <span class="faq-icon" aria-hidden="true">+</span>
            </button>
            <div class="faq-answer">
              <p>{faq.answer}</p>
            </div>
          </div>
        ))}
      </div>
    </div>
  </section>
)}
