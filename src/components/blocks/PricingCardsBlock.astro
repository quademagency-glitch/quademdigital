---
/**
 * The CMS page-builder's pricing block.
 *
 * It used to draw its own card: a different corner radius, a different
 * background, no shadow, no hover, cards that did not stretch to a common
 * height, and a badge reading "Most popular" where the rest of the site says
 * "Most Popular". That was the seventh price card design on this site, found on
 * 3 September 2026 by scripts/check-price-cards.mjs on its first run.
 *
 * No live page used it, which is the only reason nobody had seen it. The next
 * page an editor built with a pricing block would have shipped it.
 *
 * It now maps the block's fields onto PricingCards and draws nothing itself.
 * Editors keep the per-card button link and label the block has always had;
 * those ride through as `href` and `label` on each tier.
 */
import PricingCards from "../PricingCards.astro";
import { safeHref } from "../../lib/payload";

interface Props {
  block: any;
}

const { block } = Astro.props;

const tiers = (block?.cards ?? [])
  .filter((c: any) => c?.tierName)
  .map((c: any) => ({
    name: c.tierName,
    /* The block holds one price, not a pair, so it goes in the visible slot and
       PricingCards falls the cedi slot back to the same figure. */
    priceUsd: c.price,
    period: c.billingPeriod,
    description: c.description,
    features: (c.features ?? []).filter((f: any) => f?.feature),
    isPopular: c.isPopular,
    href: safeHref(c.buttonUrl) || undefined,
    label: c.buttonLabel || undefined,
  }));
---

<PricingCards
  tiers={tiers}
  heading={block?.heading}
  subtitle={block?.subheading}
/>
