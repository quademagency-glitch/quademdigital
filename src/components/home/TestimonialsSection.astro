---
import { buildPayloadImageUrl } from "../../lib/payload";
interface Props {
    testimonials: any[];
}

const { testimonials } = Astro.props;

// Only show testimonials that have been explicitly published (default: false protects against placeholders)
const publishedTestimonials = (testimonials ?? []).filter((t: any) => t.published === true);
---
{publishedTestimonials.length > 0 && (
<section class="testimonials section-padding" id="testimonials">
    <div class="container">
        <div class="section-header animate-on-scroll slide-up">
            <h2><span class="text-gradient">What Clients Say</span></h2>
            <p>Real feedback from businesses we've worked with.</p>
        </div>

        <div class="testimonial-carousel">
            <div class="testimonial-track">
            {publishedTestimonials.map((test: any) => (
                <div class="testimonial-card" style="position: relative;">
                    {test.videoUrl && (
                        <button class="play-video-btn" data-video-url={test.videoUrl} aria-label="Play Testimonial Video" style="position: absolute; top: 20px; right: 20px; background: rgba(0, 174, 239, 0.1); border: 1px solid var(--accent); color: var(--accent-text); padding: 8px 16px; border-radius: 50px; cursor: pointer; display: flex; align-items: center; gap: 8px; font-size: 0.9rem; transition: 0.3s; z-index: 10;">
                            <svg viewBox="0 0 24 24" fill="currentColor" width="16" height="16"><path d="M8 5v14l11-7z"/></svg>
                            Watch Video
                        </button>
                    )}
                    <div class="testimonial-stars">{"★".repeat(test.stars || 5)}</div>
                    <p class="testimonial-quote">"{test.quote}"</p>
                    <div class="testimonial-author">
                        <div class="author-avatar">
                            {test.avatar ? (
                                <img src={buildPayloadImageUrl(test.avatar)} alt={test.authorName} loading="lazy" style="width: 100%; height: 100%; border-radius: 50%; object-fit: cover;" width="200" height="200"/>
                            ) : (
                                <div style="width: 100%; height: 100%; border-radius: 50%; background: rgba(0,174,239,0.15); display: flex; align-items: center; justify-content: center; font-size: 1.25rem; color: var(--accent-text);">
                                    {(test.authorName || '?')[0].toUpperCase()}
                                </div>
                            )}
                        </div>
                        <div class="author-info">
                            <h3 class="author-name">{test.authorName}</h3>
                            <p class="author-role">{test.authorRole}</p>
                        </div>
                    </div>
                </div>
            ))}
            </div>
            <div class="carousel-controls">
                <button class="carousel-btn prev" aria-label="Previous testimonial">←</button>
                <div class="carousel-dots"></div>
                <button class="carousel-btn next" aria-label="Next testimonial">→</button>
            </div>
        </div>
    </div>
</section>
)}
