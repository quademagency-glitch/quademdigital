---
// SeoPromoSection.astro
---

<section class="seo-promo section-padding" id="seo-promo">
    <div class="container">
        <div class="sp-promo-card animate-on-scroll slide-up">
            <div class="sp-promo-bg"></div>
            <div class="sp-promo-content">
                <div class="badge">Growth Service</div>
                <h2>Data-Driven <span class="text-gradient">SEO & Content</span></h2>
                <p>Dominate search rankings, drive organic traffic, and turn clicks into customers with my comprehensive SEO and content strategies.</p>
                <a href="/services/seo/" class="btn btn-primary btn-pill glow-effect mt-4">Explore SEO Services →</a>
            </div>
            <div class="sp-promo-visual">
                <div class="seo-mockup">
                    <div class="chart-container">
                        <!-- Chart Line -->
                        <svg class="chart-line" viewBox="0 0 200 100" fill="none" xmlns="http://www.w3.org/2000/svg">
                            <path d="M0 90 L40 70 L80 80 L120 40 L160 50 L200 10" stroke="#2ecc71" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
                            <path d="M0 90 L40 70 L80 80 L120 40 L160 50 L200 10 L200 100 L0 100 Z" fill="url(#chart-gradient)" opacity="0.2" />
                            <defs>
                                <linearGradient id="chart-gradient" x1="100" y1="10" x2="100" y2="100" gradientUnits="userSpaceOnUse">
                                    <stop stop-color="#2ecc71" />
                                    <stop offset="1" stop-color="#2ecc71" stop-opacity="0" />
                                </linearGradient>
                            </defs>
                        </svg>
                        
                        <!-- Chart Nodes -->
                        <div class="chart-node" style="left: 40px; bottom: 30px;"></div>
                        <div class="chart-node" style="left: 80px; bottom: 20px;"></div>
                        <div class="chart-node" style="left: 120px; bottom: 60px;"></div>
                        <div class="chart-node" style="left: 160px; bottom: 50px;"></div>
                        {/*
                          This chart is decoration, not data. This last node used
                          to carry a tooltip claiming a specific traffic increase,
                          which read as a real client result and was not one:
                          nothing produced or measured that figure. The rising
                          line can stay as artwork; a number cannot.

                          A JSX comment, not an HTML one. Astro passes HTML
                          comments straight through to the page, so writing the
                          old figure into a <!-- --> here put it back in the
                          markup, which is exactly what this removes.
                        */}
                        <div class="chart-node highlight" style="left: 200px; bottom: 90px;"></div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .seo-promo {
        padding-top: 40px;
        padding-bottom: 40px;
    }

    .sp-promo-card {
        position: relative;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
    }

    .sp-promo-card:hover {
        border-color: rgba(46, 204, 113, 0.3);
        box-shadow: var(--shadow-lg);
    }

    @media (min-width: 992px) {
        .sp-promo-card {
            flex-direction: row;
            align-items: center;
        }
    }

    @media (max-width: 991px) {
        .sp-promo-content {
            text-align: center;
        }

        .sp-promo-content p {
            margin-left: auto;
            margin-right: auto;
        }
    }

    .sp-promo-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top left, rgba(46, 204, 113, 0.12), transparent 60%);
        z-index: 0;
        pointer-events: none;
    }

    .sp-promo-content {
        position: relative;
        z-index: 1;
        padding: 48px;
        flex: 1;
    }

    .sp-promo-content .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: #2ecc71;
        background: rgba(46, 204, 113, 0.1);
        border: 1px solid rgba(46, 204, 113, 0.2);
        margin-bottom: 20px;
    }

    .sp-promo-content h2 {
        font-size: clamp(28px, 4vw, 40px);
        margin-bottom: 16px;
        line-height: 1.2;
    }

    .sp-promo-content .text-gradient {
        background: linear-gradient(90deg, #2ecc71, #27ae60);
        -webkit-background-clip: text;
        -webkit-text-fill-color: transparent;
    }

    .sp-promo-content p {
        font-size: 16px;
        color: var(--text-muted);
        max-width: 500px;
        line-height: 1.6;
    }

    .sp-promo-content .btn-primary {
        background: #2ecc71;
        border-color: #2ecc71;
        color: #000;  /* theme-exempt: dark text on an accent-filled control; must not invert */
    }

    .sp-promo-content .btn-primary:hover {
        box-shadow: 0 0 20px rgba(46, 204, 113, 0.4);
    }

    .sp-promo-visual {
        position: relative;
        z-index: 1;
        flex: 1;
        min-height: 300px;
        background: linear-gradient(135deg, var(--bg-surface) 0%, #0d1a15 100%);  /* theme-exempt: brand gradient tint, not a surface */
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
    }

    @media (min-width: 992px) {
        .sp-promo-visual {
            min-height: 400px;
            clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);
        }
    }

    /* Abstract SEO Chart Mockup */
    .seo-mockup {
        width: 100%;
        max-width: 320px;
        height: 200px;
        background: var(--bg-inset);
        border-radius: 12px;
        border: 1px solid var(--bg-hover);
        padding: 20px;
        box-shadow: 0 20px 40px rgba(0, 0, 0, 0.3);
        transform: perspective(800px) rotateY(-10deg) rotateX(5deg);
        transition: transform 0.5s ease;
    }

    .sp-promo-card:hover .seo-mockup {
        transform: perspective(800px) rotateY(-5deg) rotateX(2deg) translateY(-5px);
    }

    .chart-container {
        position: relative;
        width: 100%;
        height: 100%;
        border-bottom: 2px solid var(--border-color);
        border-left: 2px solid var(--border-color);
    }

    .chart-line {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
        animation: drawLine 2s ease-out forwards;
        stroke-dasharray: 400;
        stroke-dashoffset: 400;
    }

    @keyframes drawLine {
        to { stroke-dashoffset: 0; }
    }

    .chart-node {
        position: absolute;
        width: 8px;
        height: 8px;
        background: #2ecc71;
        border-radius: 50%;
        transform: translate(-50%, 50%);
        box-shadow: 0 0 10px rgba(46, 204, 113, 0.5);
        opacity: 0;
        animation: fadeIn 0.5s ease forwards;
        animation-delay: 1.5s;
    }

    .chart-node.highlight {
        width: 12px;
        height: 12px;
        background: #fff;
        border: 2px solid #2ecc71;
    }

    @keyframes fadeIn {
        to { opacity: 1; }
    }

    @media (max-width: 768px) {
        .sp-promo-content {
            padding: 28px 20px;
        }

        .sp-promo-visual {
            min-height: 220px;
            padding: 24px;
        }

        .seo-mockup {
            max-width: 280px;
            height: 170px;
            transform: perspective(800px) rotateY(-5deg) rotateX(3deg);
        }
    }

    @media (max-width: 480px) {
        .sp-promo-content {
            padding: 24px 16px;
        }

        .sp-promo-content h2 {
            font-size: 1.5rem;
        }

        .sp-promo-content p {
            font-size: 14px;
        }

        .sp-promo-visual {
            min-height: 180px;
            padding: 20px;
        }

        .seo-mockup {
            max-width: 240px;
            height: 150px;
            transform: none;
            padding: 14px;
        }
    }
</style>
