---
import StrokeIcon from '../StrokeIcon.astro';
import { BOOKING_PATH } from "../../lib/booking";
import { billingCadence, billingKind } from "../../lib/billing.js";
import ProjectCalculator from "../ProjectCalculator.astro";
import { CMS_AFRICA_MARKET } from "../../lib/markets.js";

interface Props {
    pricingPlans: any[];
    calculatorServices: any[];
    whatsappNumber: string;
    showCalculator?: boolean;
}

const { pricingPlans, calculatorServices, whatsappNumber, showCalculator = true } = Astro.props;

/*
  What a plan costs, as a number, in the currency its own list is written in.

  This is the figure the browser converts. Getting the base wrong here is the
  one mistake in this file that cannot be seen by looking at the page: an africa
  plan whose base was read as USD would be converted from 5,500 dollars instead
  of 5,500 cedis and quote a Nigerian roughly six times the right price. So the
  market decides the field, and there is no fallback across the two.
*/
function priceAmount(plan: any, market: string): number | null {
    const n = market === 'africa'
        ? Number(plan.priceGHS ?? plan.price)
        : Number(plan.priceUSD);
    return Number.isFinite(n) && n > 0 ? n : null;
}

/*
  "from", on every plan that has a number.

  The CMS held both spellings across the two lists: the international plans said
  "from $3,000" in priceLabel and the africa plans said nothing at all, so the
  homepage carousel showed three hedged prices and three bare ones side by side.
  Forced here so the eleventh plan cannot be typed differently, and matched by
  PricingCards.astro so the homepage and the service pages agree.
*/
function pricePrefix(plan: any, market: string): string {
    return priceAmount(plan, market) === null ? '' : 'from';
}

/**
 * A plan's display price for the initial server render, before the geo lookup
 * runs, in the base currency of the list it belongs to.
 *
 * priceLabel is honoured only on the international list, because that is the
 * only list it was ever written for: the africa plans carry a priceLabel that
 * is empty or null, and the one that is set holds a dollar string. Reading it
 * for an africa plan is how "$425" came to be the server-rendered price of a
 * GH₵ 2,500 website.
 */
function getDisplayPrice(plan: any, market: string): string {
    const amount = priceAmount(plan, market);
    if (amount === null) return plan.priceLabel || plan.price || 'Custom';
    const money = market === 'africa'
        ? `GH\u20b5 ${amount.toLocaleString('en-US')}`
        : `$${amount.toLocaleString('en-US')}`;
    return `from ${money}`;
}


/*
  How often you pay, on its own line under the amount.

  It used to be glued to the number as "/mo", which made the longest string on
  the card longer still and read as part of the price. Worse, a one-off had no
  marker at all, so "from $3,000" and "from $1,500/mo" looked like the same kind
  of thing scanned quickly, and the difference between buying a website once and
  paying every month is the single most important fact on the card.
*/
function cadenceLabel(plan: any): string {
    return billingCadence(plan.billingCycle);
}

/*
  Africa and the rest of the world get different tiers, not the same tier at a
  different exchange rate. Africa buys packages, everyone else buys service
  lines, and the two lists differ in name, contents and count. Which currency
  each list is then PRINTED in is a second, separate question, answered per
  visitor by src/scripts/main.js: a Nigerian gets this list in naira, a Ghanaian
  in cedis, and both are reading the same list.

  Both are rendered and one is revealed after the geo lookup, the same way the
  currency note and the Ghana-only offer links work, because public pages are
  edge-cached for 60 seconds and a server-rendered choice would be handed to the
  wrong country.

  International is the visible default, so the cached copy that a stranger gets
  is the international one, and a failed geo lookup shows international prices
  rather than cedis.
*/
/* Bundles only. The same CMS list also holds each service's own packages
   (kind 'package', spec 4.7), which the team portal's price list and quotes
   read; they are not cards for this grid. A plan switched off ('active'
   false) is hidden too. Plans from before the field have no kind and stay. */
const allPlans: any[] = (pricingPlans || []).filter((p: any) => p?.kind !== 'package' && p?.active !== false);
/* The CMS still stores this list as 'ghana'; the site now shows it across the
   whole continent. Renaming the stored value would need a migration and would
   break every plan an editor has already filed, so the translation happens here
   and nowhere else: 'ghana' in the database, 'africa' on the page. */
const ghanaPlans = allPlans.filter((p: any) => p.market === CMS_AFRICA_MARKET);
const intlPlans = allPlans.filter((p: any) => p.market === 'international');

// Until the seed script runs, no plan carries a market at all. Falling back to
// the single undivided list keeps the section rendering rather than showing a
// stranger an empty price grid.
const marketsReady = ghanaPlans.length > 0 && intlPlans.length > 0;
const planGroups = marketsReady
    ? [
          { market: 'international', plans: intlPlans, hidden: false },
          { market: 'africa', plans: ghanaPlans, hidden: true },
      ]
    : [{ market: 'international', plans: allPlans, hidden: false }];

/*
  Two rows per market: what you pay for once, then what runs every month.

  Until 19 October 2026 each market was one carousel of three cards, and the
  three mixed the two kinds: Africa saw a landing page (once), a website and
  logo (once) and a video and search plan (every month) side by side, read as
  small, medium and large of one thing. Ernest's restructure puts the one-off
  work in "Build it" and the monthly plans in "Grow it", so a row only ever
  compares like with like. The split reads the billing cycle the CMS already
  holds, so no field was added: a plan that bills monthly is Grow, anything
  else is Build.
*/
const ROWS = [
    { key: 'build', title: 'Build it', kicker: 'Pay once', note: '' },
    { key: 'grow', title: 'Grow it', kicker: 'Every month', note: 'Monthly plans renew each month. Cancel with 30 days\u2019 notice. Your ad budget is separate and paid directly to Meta or Google.' },
];
const rowOf = (plan: any) => (billingKind(plan.billingCycle) === 'monthly' ? 'grow' : 'build');
const rowsFor = (plans: any[]) =>
    ROWS.map((row) => ({ ...row, plans: plans.filter((p) => rowOf(p) === row.key) })).filter((row) => row.plans.length > 0);

const CHECKUP_PATH = '/offers/free-seo-audit/';

---
<!-- Project Cost Calculator. Shared with /calculator/, which used to be a
     second implementation with its own currency toggle that ignored the
     visitor's country. See src/components/ProjectCalculator.astro. -->
{showCalculator && <ProjectCalculator services={calculatorServices || []} heading="Project Cost Calculator" />}

{/* Section 7: Pricing / Packages */}
<section class="pricing section-padding" id="pricing">
    <div class="container">
        <div class="section-header animate-on-scroll slide-up">
            {/*
                "Transparent Pricing / Flexible packages designed to fit
                businesses at any stage of growth" was stock pricing-page
                filler and the only paragraph on the homepage that sounded
                like a template. It also promised transparency directly above
                a grid whose cards led nowhere and whose buttons said three
                different things.

                The replacement says the one thing that is actually true of
                every card and is worth knowing before reading a number: these
                are starting points. It is the same framing the Fieldwork page
                uses above its own tiers, in the same words, because it is the
                same promise.
            */}
            <h2><span class="text-gradient">Clear scope. Clear pricing.</span></h2>
            <p>
                Start with a free check-up. Pay once for what we build, then choose a monthly plan if you want help growing.
            </p>
        </div>

        {/* Step one of three, before any price. The free audit is the one
            offer Ernest kept on 19 October 2026, renamed the free website
            check-up, and it is the main button on the homepage hero too. */}
        <a href={CHECKUP_PATH} class="pricing-checkup animate-on-scroll slide-up" data-track="pricing_checkup" data-loc="pricing">
            <span class="pricing-checkup-label">Free</span>
            <span class="pricing-checkup-text"><strong>Not sure where to start?</strong> Get a free website check-up. We look at your website and how you show up on Google, then send you a short list of what to fix first.</span>
            <span class="pricing-checkup-cta">Get my free check-up <StrokeIcon name="right" /></span>
        </a>

        <div class="pricing-rows">
            {/* Which currency these are in.

                 Prices switch to cedis for a visitor in Ghana and stay in dollars
                 for everyone else, which is right, and silent: a buyer in London
                 seeing an unlabelled "425" has to guess. Hidden by default and
                 revealed by initDynamicPricing once the country is known, so it
                 never flashes the wrong label while the lookup is in flight. */}
            <p class="pricing-currency-note" data-currency-note hidden></p>
            {/* Each row carries its market, so initDynamicPricing reveals both
                rows of one list and hides both of the other. The carousel
                arrows that used to sit here scrolled "the first visible grid",
                which stopped meaning anything once a market had two; each row
                holds three cards, which fit a desktop row, and a phone swipes. */}
            {allPlans.length > 0 && planGroups.map((group) => rowsFor(group.plans).map((row) => (
            <div class="pricing-row" data-market={group.market} data-row={row.key} hidden={group.hidden}>
                <div class="pricing-row-head">
                    <h3>{row.title}</h3>
                    <p>{row.kicker}</p>
                </div>
                <div class="pricing-grid" role="region" aria-label={`${row.title} plans`} tabindex="0">
                    {row.plans.map((plan: any, index: number) => (
                        <div class={`pricing-card ${plan.isPopular ? 'popular-tier' : ''} animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                            {plan.isPopular && <div class="popular-badge">Most Popular</div>}
                            <h4 class="tier-name">{plan.name}</h4>
                            {/* data-price/-amount/-base are what the browser converts.
                                The base is the currency THIS list is written in, so the
                                africa list converts from cedis and the international
                                one from dollars, and neither is ever read as the
                                other. A plan with no number (Custom) ships no
                                data-amount and is left alone. */}
                            <div
                                class="tier-price"
                                data-price
                                data-base={group.market === 'africa' ? 'GHS' : 'USD'}
                                data-amount={priceAmount(plan, group.market) ?? undefined}
                                data-prefix={pricePrefix(plan, group.market) || undefined}
                            >
                                {getDisplayPrice(plan, group.market)}
                            </div>
                            <p class="tier-cadence">{cadenceLabel(plan)}</p>
                            <p class="tier-desc">{plan.description}</p>
                            <ul class="tier-features">
                                {plan.features && plan.features.map((f: any) => (
                                    <li>{typeof f === 'string' ? f : f.feature}</li>
                                ))}
                            </ul>
                            {/*
                                Two actions, and they are different actions.

                                The button opens the booking section on the contact page. It used to go to `pageUrl`
                                when one was set, which would have put a button
                                reading "Book a call" on a route that books nothing.

                                The link under it goes to the page that explains
                                what the price buys. Until 2 September 2026 the
                                `pageUrl` field did not exist on the collection at
                                all, so this link had never rendered once and the
                                button silently fell back to the contact form. The
                                homepage quoted six prices and could not reach any
                                of the seven pages that say what they cover.
                            */}
                            <a href={BOOKING_PATH} data-track="pricing_cta" data-loc="pricing" class={`btn ${plan.isPopular ? 'btn-primary glow-effect' : 'btn-ghost'} btn-pill tier-btn`}>{plan.buttonText || 'Book a call'}</a>
                            {plan.pageUrl && (
                                <a href={plan.pageUrl} class="tier-detail-link">What this covers &rarr;</a>
                            )}
                        </div>
                    ))}
                </div>
                {row.note && <p class="pricing-row-note">{row.note}</p>}
            </div>
            )))}
            {allPlans.length === 0 && (
            <div class="pricing-row" data-market="international" data-row="fallback">
                <!-- Fallback Static Content. Only renders if the CMS returns no
                     plans at all. It used to read Custom / Custom / Retainer
                     directly under a "Transparent Pricing" heading, so the one
                     time a visitor saw it was the one time the page contradicted
                     itself.

                     These are the international plans, not the Africa ones
                     converted. The converted ones are what let the homepage sell
                     a website at $425 while /global sold it from $1,200, and a
                     CMS outage is the worst moment to reintroduce that: nobody
                     is watching, and the campaign is pointed at the other page.
                     Failing to the international list also matches the visible
                     default above, so an outage changes the source of the prices
                     and not the prices themselves.

                     One card per row: the cheapest way in to each. Mirrors the
                     international bundles written by
                     cms/scripts/restructure-services-2026-10.mjs. Change both. -->
                <div class="pricing-row-head"><h3>Build it</h3><p>Pay once</p></div>
                <div class="pricing-grid" role="region" aria-label="Build it plans" tabindex="0">
                    <div class="pricing-card animate-on-scroll slide-up delay-100">
                        <h4 class="tier-name">One-page website</h4>
                        <div class="tier-price">from $3,000</div>
                        <p class="tier-cadence">one off</p>
                        <p class="tier-desc">One page, built to do one job, like bringing in enquiries for a single service or a launch.</p>
                        <ul class="tier-features">
                            <li>One custom-designed page, written to bring in enquiries</li>
                            <li>Works properly on a phone</li>
                            <li>Set up so Google can find it</li>
                            <li>About a week from start to live</li>
                        </ul>
                        <a href={BOOKING_PATH} class="btn btn-ghost btn-pill tier-btn">Book a call</a>
                    </div>
                </div>
                <div class="pricing-row-head"><h3>Grow it</h3><p>Every month</p></div>
                <div class="pricing-grid" role="region" aria-label="Grow it plans" tabindex="0">
                    <div class="pricing-card animate-on-scroll slide-up delay-100">
                        <h4 class="tier-name">Get seen</h4>
                        <div class="tier-price">from $1,750</div>
                        <p class="tier-cadence">a month</p>
                        <p class="tier-desc">Show up every week, without filming anything.</p>
                        <ul class="tier-features">
                            <li>4 AI videos and 12 posts a month, on one platform</li>
                            <li>A monthly content calendar</li>
                            <li>Comments and messages answered</li>
                            <li>A short monthly report</li>
                        </ul>
                        <a href={BOOKING_PATH} class="btn btn-ghost btn-pill tier-btn">Book a call</a>
                    </div>
                </div>
            </div>
            )}
        </div>

        <div class="pricing-footer">
            <p id={showCalculator ? undefined : 'calculator'}>Need a more specific estimate? <a href="/calculator/">Try the project calculator</a>.</p>
            <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="whatsapp-link" data-track="whatsapp_click" data-loc="pricing">Chat with us on WhatsApp <StrokeIcon name="right" /></a>
        </div>
    </div>
</section>
