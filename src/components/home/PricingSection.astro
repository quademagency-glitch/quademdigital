---
import { getBookingUrl } from "../../lib/booking";

interface Props {
    pricingPlans: any[];
    calculatorServices: any[];
    whatsappNumber: string;
}

const { pricingPlans, calculatorServices, whatsappNumber } = Astro.props;

/*
  Resolved here rather than taken as a prop, so the homepage does not have to
  know about booking at all. The link under the price calculator pointed at
  https://calendly.com/quadem-agency/free-strategy-call, which answers 404: the
  single most qualified click on the homepage, a visitor who has just totalled
  up what they want to spend, went to a Calendly error page.
*/
const bookingUrl = await getBookingUrl();

/*
  The field's description asks for "/mo", but the Premium plan holds "month",
  and both the Ghana price switch and this component concatenate the value
  straight on to the number. So a cedi price rendered as "GH₵ 8,000month".
  Normalising here means a tidy-up in the admin is welcome rather than required.
*/
function formatCycle(raw: unknown): string {
    const cycle = typeof raw === 'string' ? raw.trim() : '';
    if (!cycle) return '';
    if (cycle.startsWith('/')) return cycle;
    const key = cycle.toLowerCase();
    if (key === 'month' || key === 'monthly' || key === 'mo') return '/mo';
    if (key === 'year' || key === 'yearly' || key === 'yr') return '/yr';
    return `/${cycle}`;
}

/**
 * Resolve a plan's display price for the initial server render, before the geo
 * lookup runs. Priority: priceLabel, then priceUSD formatted, then the legacy
 * price text field, then "Custom".
 */
function getDisplayPrice(plan: any): string {
    if (plan.priceLabel) return plan.priceLabel;
    if (plan.priceUSD && plan.priceUSD > 0) return `$${plan.priceUSD.toLocaleString('en-US')}`;
    // Legacy fallback for old CMS data that only has the 'price' text field
    if (plan.price) return plan.price;
    return 'Custom';
}

/*
  How often you pay, on its own line under the amount.

  It used to be glued to the number as "/mo", which made the longest string on
  the card longer still and read as part of the price. Worse, a one-off had no
  marker at all, so "from $3,000" and "from $1,500/mo" looked like the same kind
  of thing scanned quickly, and the difference between buying a website once and
  paying every month is the single most important fact on the card.
*/
function cadenceLabel(plan: any): string {
    const cycle = formatCycle(plan.billingCycle);
    if (cycle === '/mo') return 'a month';
    if (cycle === '/yr') return 'a year';
    if (cycle) return cycle.replace(/^\//, '');
    return 'one off';
}

/*
  Ghana and the rest of the world get different tiers, not the same tier at a
  different exchange rate. Ghana buys packages, everyone else buys service
  lines, and the two lists differ in name, contents and count.

  Both are rendered and one is revealed after the geo lookup, the same way the
  currency note and the Ghana-only offer links work, because public pages are
  edge-cached for 60 seconds and a server-rendered choice would be handed to the
  wrong country.

  International is the visible default, so the cached copy that a stranger gets
  is the international one, and a failed geo lookup shows international prices
  rather than cedis.
*/
const allPlans: any[] = pricingPlans || [];
const ghanaPlans = allPlans.filter((p: any) => p.market === 'ghana');
const intlPlans = allPlans.filter((p: any) => p.market === 'international');

// Until the seed script runs, no plan carries a market at all. Falling back to
// the single undivided list keeps the section rendering rather than showing a
// stranger an empty price grid.
const marketsReady = ghanaPlans.length > 0 && intlPlans.length > 0;
const planGroups = marketsReady
    ? [
          { market: 'international', plans: intlPlans, hidden: false },
          { market: 'ghana', plans: ghanaPlans, hidden: true },
      ]
    : [{ market: 'international', plans: allPlans, hidden: false }];

/**
 * Resolve a calculator service's display price for SSR.
 * Falls back to legacy basePrice if priceUSD isn't set yet.
 */
function getServiceUSD(service: any): number {
    return service.priceUSD ?? service.basePrice ?? 0;
}
function getServiceGHS(service: any): number {
    return service.priceGHS ?? service.basePrice ?? 0;
}
---
<!-- Project Cost Calculator -->
<section class="calculator section-padding" id="calculator" style="background: rgba(0, 174, 239, 0.02);">
    <div class="container">
        <div class="section-header text-center animate-on-scroll slide-up">
            <h2>Project Cost <span class="text-gradient">Calculator</span></h2>
            <p>Get an instant estimate for your project based on your specific needs.</p>
        </div>
        
        <div class="calculator-container animate-on-scroll slide-up delay-100">
            <div class="calc-options">
                <h3 class="calc-step-title">1. Select Services</h3>
                <div class="calc-grid">
                    {calculatorServices && calculatorServices.length > 0 ? (
                        calculatorServices.map((service: any) => (
                            <label class="calc-checkbox">
                                <input type="checkbox" value={getServiceUSD(service)} data-ghs={getServiceGHS(service)} data-service={service.name} />
                                <div class="calc-checkbox-content">
                                    <span class="service-name">{service.name}</span>
                                    <span class="service-price dynamic-calc-label" data-usd={getServiceUSD(service)} data-ghs={getServiceGHS(service)} data-cycle={formatCycle(service.billingCycle)}>From ${getServiceUSD(service).toLocaleString('en-US')}</span>
                                </div>
                            </label>
                        ))
                    ) : (
                        <p class="calc-empty-text">Configure services in Payload CMS.</p>
                    )}
                </div>

                <h3 class="calc-step-title" style="margin-top: 40px;">2. Project Timeline</h3>
                <div class="calc-timeline">
                    <label class="calc-radio">
                        <input type="radio" name="timeline" value="1" checked />
                        <span class="timeline-name">Standard (4-8 weeks)</span>
                    </label>
                    <label class="calc-radio">
                        <input type="radio" name="timeline" value="1.25" />
                        <span class="timeline-name">Expedited (+25%)</span>
                    </label>
                </div>
            </div>

            <div class="calc-summary glow-card">
                <h3 class="calc-summary-title">Estimated Investment</h3>
                <div class="calc-total" id="calcTotal">$0</div>
                <p class="calc-summary-text">This is a rough estimate. Final scope and pricing will be determined during discovery.</p>
                {/* Which currency the estimate is in. Hidden until the country is
                    known and filled in by initDynamicPricing, the same as the one
                    on the pricing section: the page is edge-cached, so a currency
                    name baked into the HTML would be served to the wrong country. */}
                <p class="calc-summary-text" data-currency-note hidden>All prices in USD.</p>
                <a href={bookingUrl} target="_blank" rel="noopener noreferrer" class="btn btn-primary btn-pill glow-effect" data-track="calendly_click" data-loc="calculator" style="width: 100%; text-align: center;">Book a Strategy Call</a>
            </div>
        </div>
    </div>
</section>

{/* Section 7: Pricing / Packages */}
<section class="pricing section-padding" id="pricing">
    <div class="container">
        <div class="section-header animate-on-scroll slide-up">
            {/*
                "Transparent Pricing / Flexible packages designed to fit
                businesses at any stage of growth" was stock pricing-page
                filler and the only paragraph on the homepage that sounded
                like a template. It also promised transparency directly above
                a grid whose cards led nowhere and whose buttons said three
                different things.

                The replacement says the one thing that is actually true of
                every card and is worth knowing before reading a number: these
                are starting points. It is the same framing the Fieldwork page
                uses above its own tiers, in the same words, because it is the
                same promise.
            */}
            <h2><span class="text-gradient">What things cost</span></h2>
            <p>
                Starting points, not a rate card. What you pay depends on the
                scope, and I will tell you which of these you actually need
                rather than the most expensive one.
            </p>
        </div>
        
        <div class="carousel-wrapper">
            {/* The arrows scroll the visible grid. There are two now, one per
                market, and querySelector returns the first match, so without
                :not([hidden]) a visitor in Ghana would press these and watch a
                hidden grid scroll while nothing on screen moved. */}
            <div class="carousel-nav floating hidden-mobile">
                <button class="carousel-btn prev-btn" aria-label="Previous" onclick="document.querySelector('.pricing-grid:not([hidden])').scrollBy({left: -400, behavior: 'smooth'})">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button class="carousel-btn next-btn" aria-label="Next" onclick="document.querySelector('.pricing-grid:not([hidden])').scrollBy({left: 400, behavior: 'smooth'})">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                </button>
            </div>
            {/* Which currency these are in.

                 Prices switch to cedis for a visitor in Ghana and stay in dollars
                 for everyone else, which is right, and silent: a buyer in London
                 seeing an unlabelled "425" has to guess. Hidden by default and
                 revealed by initDynamicPricing once the country is known, so it
                 never flashes the wrong label while the lookup is in flight. */}
            <p class="pricing-currency-note" data-currency-note hidden>All prices in USD.</p>
            {allPlans.length > 0 && planGroups.map((group) => (
            <div class="pricing-grid" role="region" aria-label="Pricing plans" tabindex="0" data-market={group.market} hidden={group.hidden}>
                {group.plans.map((plan: any, index: number) => (
                    <div class={`pricing-card ${plan.isPopular ? 'popular-tier' : ''} animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        {plan.isPopular && <div class="popular-badge">Most Popular</div>}
                        <h3 class="tier-name">{plan.name}</h3>
                        <div class="tier-price dynamic-price" data-usd={plan.priceUSD || 0} data-ghs={plan.priceGHS || 0}>
                            {getDisplayPrice(plan)}
                        </div>
                        <p class="tier-cadence">{cadenceLabel(plan)}</p>
                        <p class="tier-desc">{plan.description}</p>
                        <ul class="tier-features">
                            {plan.features && plan.features.map((f: any) => (
                                <li>{typeof f === 'string' ? f : f.feature}</li>
                            ))}
                        </ul>
                        {/*
                            Two actions, and they are different actions.

                            The button books a call and therefore goes to the
                            contact form, always. It used to go to `pageUrl`
                            when one was set, which would have put a button
                            reading "Book a call" on a route that books nothing.

                            The link under it goes to the page that explains
                            what the price buys. Until 2 September 2026 the
                            `pageUrl` field did not exist on the collection at
                            all, so this link had never rendered once and the
                            button silently fell back to the contact form. The
                            homepage quoted six prices and could not reach any
                            of the seven pages that say what they cover.
                        */}
                        <a href="/contact/" data-track="pricing_cta" data-loc="pricing" class={`btn ${plan.isPopular ? 'btn-primary glow-effect' : 'btn-ghost'} btn-pill tier-btn`}>{plan.buttonText || 'Book a call'}</a>
                        {plan.pageUrl && (
                            <a href={plan.pageUrl} class="tier-detail-link">What this covers &rarr;</a>
                        )}
                    </div>
                ))}
            </div>
            ))}
            {allPlans.length === 0 && (
            <div class="pricing-grid" role="region" aria-label="Pricing plans" tabindex="0" data-market="international">
                <!-- Fallback Static Content. Only renders if the CMS returns no
                     plans at all. It used to read Custom / Custom / Retainer
                     directly under a "Transparent Pricing" heading, so the one
                     time a visitor saw it was the one time the page contradicted
                     itself.

                     These are the international tiers, not the Ghana packages
                     converted. The converted ones are what let the homepage sell
                     a website at $425 while /global sold it from $1,200, and a
                     CMS outage is the worst moment to reintroduce that: nobody
                     is watching, and the campaign is pointed at the other page.
                     Failing to the international list also matches the visible
                     default above, so an outage changes the source of the prices
                     and not the prices themselves.

                     Mirrors the seeded international plans in
                     cms/scripts/seed-international-pricing.mjs. Change both. -->
                <div class="pricing-card animate-on-scroll slide-up delay-100">
                    <h3 class="tier-name">Website build</h3>
                    <div class="tier-price">from $3,000</div>
                    <p class="tier-desc">One page, built to do one job. About a week from start to live.</p>
                    <ul class="tier-features">
                        <li>One custom designed page, written to convert</li>
                        <li>Written for search, not just decorated</li>
                        <li>Fixed price agreed before anything starts</li>
                        <li>One month of changes after launch</li>
                    </ul>
                    <a href="/contact/" class="btn btn-ghost btn-pill tier-btn">Book a call</a>
                </div>

                <div class="pricing-card popular-tier animate-on-scroll slide-up delay-200">
                    <div class="popular-badge">Most Popular</div>
                    <h3 class="tier-name">Video retainer</h3>
                    <div class="tier-price">from $1,500/mo</div>
                    <p class="tier-desc">Four short videos a month, rolling monthly.</p>
                    <ul class="tier-features">
                        <li>Four short videos a month</li>
                        <li>Twelve branded posts a month</li>
                        <li>One platform of your choice</li>
                        <li>No shoot day, no crew, no studio</li>
                        <li>You film a few clips on your phone once a month</li>
                        <li>Rolling monthly, cancel with 30 days notice</li>
                    </ul>
                    <a href="/contact/" class="btn btn-primary btn-pill tier-btn glow-effect">Book a call</a>
                </div>

                <div class="pricing-card animate-on-scroll slide-up delay-300">
                    <h3 class="tier-name">Growth retainer</h3>
                    <div class="tier-price">from $3,750/mo</div>
                    <p class="tier-desc">Video, SEO, content and site work combined. $5,500 if you bought the two separately.</p>
                    <ul class="tier-features">
                        <li>Everything in the video retainer, plus two more videos a month</li>
                        <li>Twenty branded posts a month</li>
                        <li>Eight ad creatives for testing</li>
                        <li>Search work every month: technical fixes, link building and four blog posts</li>
                        <li>Ongoing changes to the site</li>
                        <li>Direct line to me, not a queue</li>
                        <li>Rolling monthly, cancel with 30 days notice</li>
                    </ul>
                    <a href="/contact/" class="btn btn-ghost btn-pill tier-btn">Book a call</a>
                </div>
            </div>
            )}
        </div>
        
        <div class="pricing-footer">
            <p>Not sure which plan is right for you?</p>
            <a href={`https://wa.me/${whatsappNumber}`} target="_blank" rel="noopener noreferrer" class="whatsapp-link" data-track="whatsapp_click" data-loc="pricing">Chat with me on WhatsApp →</a>
        </div>
    </div>
</section>
