---
import HeroHeadline from './HeroHeadline';

interface Props {
    heroHeadline: string;
    heroTagline: string;
    heroServices: { service: string, suffix: string, mediaUrl: string, mimeType: string }[];
    heroSubheadline?: string;
    primaryCta?: { label?: string; link?: string };
    secondaryCta?: { label?: string; link?: string };
}

const {
    heroHeadline,
    heroTagline,
    heroServices,
    heroSubheadline,
    primaryCta,
    secondaryCta,
} = Astro.props;

const primaryLabel = primaryCta?.label || 'Book a Free Call';
const primaryLink  = primaryCta?.link  || '/contact/';
const secondaryLabel = secondaryCta?.label || 'See Our Projects';
const secondaryLink  = secondaryCta?.link  || '/projects/';
---
<section class="hero" id="hero" style="position: relative; overflow: hidden;">
    <div class="hero-bg-container" style="position: absolute; inset: 0; z-index: 0;">
        <div class="bg-gradient-mesh active-bg"></div>
        <div class="hero-overlay" style="z-index: 1;"></div>
        <div class="hero-noise" style="z-index: 2;"></div>
    </div>

    <div class="container hero-layout-grid" style="position: relative; z-index: 10;">
        <div class="hero-content-col">
            <h1 class="hero-title">
                <HeroHeadline headline={heroHeadline} services={heroServices} client:load />
            </h1>
            <p class="hero-subtitle hero-reveal" style="animation-delay: 0.2s;">{heroTagline}</p>
            {heroSubheadline && (
                <p class="hero-subheadline hero-reveal" style="animation-delay: 0.32s;">{heroSubheadline}</p>
            )}
            <div class="hero-ctas hero-reveal" style="animation-delay: 0.44s;">
                <a href={primaryLink} class="btn btn-primary btn-pill glow-effect">{primaryLabel}</a>
                <a href={secondaryLink} class="btn btn-ghost btn-pill">{secondaryLabel}</a>
            </div>
        </div>
        
        <div class="hero-media-col hero-reveal" style="animation-delay: 0.5s;">
            <div class="hero-carousel-wrapper">
                <div class="hero-carousel-track">
                    {heroServices.map((item, index) => (
                        <div class="hero-carousel-slide" data-index={index}>
                            {item.mimeType?.startsWith('video') ? (
                                <video 
                                    src={item.mediaUrl} 
                                    autoplay 
                                    loop 
                                    muted 
                                    playsinline 
                                    class="hero-carousel-video"
                                ></video>
                            ) : (
                                <div 
                                    class="hero-carousel-image" 
                                    style={`background-image: url('${item.mediaUrl}');`}
                                    role="img"
                                    aria-label={item.service}
                                ></div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', () => {
        const track = document.querySelector('.hero-carousel-track') as HTMLElement;
        if (!track) return;

        window.addEventListener('hero-slide-change', (e: any) => {
            const index = e.detail?.index;
            if (index !== undefined) {
                track.style.transform = `translateY(-${index * 100}%)`;
            }
        });
    });
</script>

<style>
    /* ── Hero Layout ───────────────────────── */
    .hero {
        height: auto;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-layout-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 4rem;
        align-items: center;
        padding-top: 4rem;
        padding-bottom: 4rem;
        width: 100%;
    }

    .hero-content-col {
        text-align: left;
    }

    /* ── Carousel ──────────────────────────── */
    .hero-media-col {
        position: relative;
        width: 100%;
        height: 680px;
        perspective: 1200px;
    }

    .hero-carousel-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 24px;
        overflow: hidden;
        /* Glassmorphism Effect */
        background: rgba(255, 255, 255, 0.02);
        backdrop-filter: blur(20px);
        -webkit-backdrop-filter: blur(20px);
        border: 1px solid rgba(255, 255, 255, 0.1);
        box-shadow: -20px 30px 60px -15px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        /* 3D Transform */
        transform: rotateY(-15deg) rotateX(10deg) rotateZ(12deg) scale(1.05);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
        transform-origin: right center;
        animation: heroFloat 8s ease-in-out infinite;
    }

    @keyframes heroFloat {
        0%, 100% {
            transform: translateY(0) rotateY(-15deg) rotateX(10deg) rotateZ(12deg) scale(1.05);
        }
        50% {
            transform: translateY(-20px) rotateY(-12deg) rotateX(12deg) rotateZ(14deg) scale(1.05);
        }
    }

    .hero-carousel-wrapper:hover {
        transform: translateY(-5px) rotateY(-6deg) rotateX(4deg) rotateZ(4deg) scale(1.08) !important;
        box-shadow: -10px 40px 80px -10px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        background: rgba(255, 255, 255, 0.04);
        animation-play-state: paused;
    }

    .hero-carousel-track {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }

    .hero-carousel-slide {
        flex: 0 0 100%;
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .hero-carousel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-carousel-image {
        width: 100%;
        height: 100%;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
    }

    /* ── Title ─────────────────────────────── */
    .hero-title {
        font-family: 'Bricolage Grotesque Variable', var(--font-heading);
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.035em;
        color: var(--text-primary);
        margin: 0 0 1.5rem;
    }

    /* Headline wrapper from React component */
    :global(.hero-headline-wrapper) {
        display: block;
    }

    :global(.hero-line) {
        display: block;
    }

    :global(.hero-line-1) {
        color: var(--text-primary);
    }

    :global(.hero-line-3) {
        color: var(--text-primary);
    }

    /* ── Rotating Word ────────────────────── */
    :global(.hero-rotator-row) {
        display: block;
        position: relative;
        overflow: hidden;
        height: 1.15em;
        margin: 0.08em 0;
    }

    :global(.hero-rotator-container) {
        display: block;
        position: relative;
        height: 100%;
    }

    :global(.hero-rotator-word) {
        display: block;
        background: linear-gradient(135deg, #00aeef 0%, #5ef7ff 40%, #a78bfa 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-weight: 900;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.hero-rotator-word.in) {
        transform: translateY(0);
        opacity: 1;
        filter: blur(0);
    }

    :global(.hero-rotator-word.out) {
        transform: translateY(-80%);
        opacity: 0;
        filter: blur(4px);
    }

    /* Shine sweep once word settles */
    :global(.hero-rotator-word.in)::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 60%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
        animation: heroWordShine 1.6s ease 0.5s forwards;
        pointer-events: none;
    }

    @keyframes heroWordShine {
        to { left: 200%; }
    }

    /* ── Subtitle ─────────────────────────── */
    .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.125rem);
        color: var(--text-muted);
        max-width: 520px;
        line-height: 1.7;
        margin: 0 0 2rem;
        font-weight: 400;
    }

    .hero-subheadline {
        font-size: 0.9375rem;
        color: var(--text-muted);
        max-width: 520px;
        line-height: 1.6;
        margin: -0.75rem 0 2rem;
    }

    /* ── CTAs ──────────────────────────────── */
    .hero-ctas {
        display: flex;
        gap: 0.875rem;
        flex-wrap: wrap;
    }

    /* ── Reveal animation ─────────────────── */
    /* Runs unconditionally. It used to be gated on :global(body.loader-done),
       a class only the splash screen set — so the subtitle, subheadline, CTA
       row and media column were opacity:0 until JS ran, and stayed invisible
       forever if it failed. The animation is now an enhancement on content
       that is already painted, not a gate on it appearing. */
    .hero-reveal {
        opacity: 0;
        transform: translateY(28px);
        filter: blur(6px);
        animation: heroRevealIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes heroRevealIn {
        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    /* No animation support / reduced motion: content must simply be visible. */
    @media (prefers-reduced-motion: reduce) {
        .hero-reveal {
            animation: none;
            opacity: 1;
            transform: none;
            filter: none;
        }
    }

    /* ── CTA pulse ────────────────────────── */
    .hero-ctas .btn-primary {
        animation: heroCtaPulse 3.2s ease-in-out 1.4s infinite;
    }

    @keyframes heroCtaPulse {
        0%, 100% { box-shadow: 0 8px 25px rgba(0, 174, 239, 0.4); }
        50% { box-shadow: 0 8px 34px rgba(0, 174, 239, 0.65); }
    }

    /* ── Background ───────────────────────── */
    .hero-image-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        animation: heroImageZoom 30s ease-in-out infinite alternate;
        will-change: transform;
    }

    @keyframes heroImageZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.08); }
    }

    @media (max-width: 992px) {
        .hero {
            min-height: auto;
        }

        .hero-layout-grid {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 3rem;
            padding-top: 8rem;
        }

        .hero-content-col {
            text-align: center;
            max-width: 700px;
            margin: 0 auto;
        }

        .hero-title {
            font-size: clamp(2.5rem, 8vw, 3.5rem);
        }

        .hero-subtitle,
        .hero-subheadline {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-ctas {
            justify-content: center;
        }

        .hero-media-col {
            height: 400px;
        }

        .hero-carousel-wrapper {
            transform: none;
            animation: none;
        }

        :global(.hero-rotator-row) {
            height: 1.2em;
        }
    }

    @media (max-width: 768px) {
        .hero-layout-grid {
            gap: 2rem;
            padding-top: 7rem;
            padding-bottom: 3rem;
        }

        .hero-title {
            font-size: clamp(1.8rem, 7vw, 2.8rem);
        }

        .hero-subtitle {
            font-size: 0.95rem;
        }

        .hero-media-col {
            height: 280px;
        }

        .hero-carousel-wrapper {
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }
    }

    @media (max-width: 480px) {
        .hero-layout-grid {
            gap: 1.5rem;
            padding-top: 6.5rem;
            padding-bottom: 2rem;
        }

        .hero-title {
            font-size: clamp(1.65rem, 8vw, 2.2rem);
        }

        .hero-subtitle {
            font-size: 0.95rem;
            line-height: 1.65;
        }

        .hero-media-col {
            height: 220px;
            perspective: none;
        }

        .hero-carousel-wrapper {
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }

        .hero-ctas {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .hero-ctas .btn {
            text-align: center;
            padding: 12px 20px;
            font-size: 0.85rem;
            flex: 1;
            max-width: 180px;
        }

        .hero-ctas .btn-ghost {
            border: 1px solid rgba(255, 255, 255, 0.25);
        }

        :global(.hero-rotator-row) {
            height: 1.25em;
        }
    }

    @media (max-width: 375px) {
        .hero-layout-grid {
            padding-top: 6rem;
            padding-bottom: 1.5rem;
            gap: 1.25rem;
        }

        .hero-title {
            font-size: 1.5rem;
            letter-spacing: -0.02em;
        }

        .hero-subtitle {
            font-size: 0.875rem;
        }

        .hero-media-col {
            height: 180px;
        }

        .hero-carousel-wrapper {
            border-radius: 10px;
        }

        .hero-ctas {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .hero-ctas .btn {
            padding: 13px 20px;
            font-size: 0.85rem;
            max-width: 100%;
        }

        :global(.hero-rotator-row) {
            height: 1.3em;
        }
    }

    /* ── Reduced motion ───────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .hero-image-bg {
            animation: none;
        }

        .hero-reveal {
            opacity: 1;
            transform: none;
            filter: none;
            animation: none;
        }

        .hero-ctas .btn-primary {
            animation: none;
        }

        :global(.hero-rotator-word) {
            transition: none;
        }
    }
</style>
