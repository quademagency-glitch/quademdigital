---
interface Props {
    heroHeadline: string;
    heroTagline: string;
    heroServices: string[];
    heroSubheadline?: string;
    primaryCta?: { label?: string; link?: string };
    secondaryCta?: { label?: string; link?: string };
}

const {
    heroHeadline,
    heroTagline,
    heroServices,
    heroSubheadline,
    primaryCta,
    secondaryCta,
} = Astro.props;

const primaryLabel = primaryCta?.label || 'Book a Free Call';
const primaryLink  = primaryCta?.link  || '/contact';
const secondaryLabel = secondaryCta?.label || 'See Our Projects';
const secondaryLink  = secondaryCta?.link  || '/projects';
---
<section class="hero" id="hero" style="position: relative; overflow: hidden;">
    <!-- Advanced 3D Interactive Background -->
    <div class="hero-bg-container" style="position: absolute; inset: 0; z-index: 0; pointer-events: auto;">
        <!-- Layer 0: Animated Gradient -->
        <div class="hero-animated-gradient"></div>
        <!-- Layer 1: Gradient Mesh -->
        <div class="bg-gradient-mesh active-bg"></div>

        <!-- Overall Overlay to ensure text readability -->
        <div class="hero-overlay" style="z-index: 1;"></div>
        <div class="hero-noise" style="z-index: 2;"></div>

        <!-- 3D Canvas (Brought to the forefront, above the overlays) -->
        <canvas id="hero-3d-canvas" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 5; pointer-events: none; mix-blend-mode: screen; opacity: 1.0;"></canvas>
    </div>

    <div class="container hero-container" style="position: relative; z-index: 10; pointer-events: none;">
        <h1 class="hero-title">
            {heroHeadline} <span class="typewriter text-gradient" id="typewriter" data-services={JSON.stringify(heroServices)}>{heroServices[0]}</span><span class="cursor text-gradient">|</span>
        </h1>
        <p class="hero-subtitle">{heroTagline}</p>
        {heroSubheadline && (
            <p class="hero-subheadline">{heroSubheadline}</p>
        )}
        <div class="hero-ctas" style="pointer-events: auto;">
            <a href={primaryLink} class="btn btn-primary btn-pill glow-effect">{primaryLabel}</a>
            <a href={secondaryLink} class="btn btn-ghost btn-pill">{secondaryLabel}</a>
        </div>
    </div>
</section>

<style>
    .hero-subheadline {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.55);
        max-width: 560px;
        line-height: 1.6;
        margin: 0.75rem auto 0;
    }

    @media (max-width: 768px) {
        .hero-subheadline {
            font-size: 0.9375rem;
        }
    }
</style>

<script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

    const init3DBackground = () => {
        const canvas = document.getElementById('hero-3d-canvas');
        if (!canvas) return;

        // Scene setup
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x0d0d14, 0.015); // Less fog so shapes are clearer
        
        // Camera setup (Brought closer from z=40 to z=25)
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 25;

        // Renderer setup
        const renderer = new THREE.WebGLRenderer({ 
            canvas, 
            alpha: true, 
            antialias: true,
            powerPreference: "high-performance"
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // Group to hold all objects for rotation
        const group = new THREE.Group();
        scene.add(group);

        // Premium Solid Materials (Increased brightness)
        const materials = [
            // Cyan Glass/Metallic
            new THREE.MeshPhysicalMaterial({
                color: 0x00d4ff, // Brighter cyan
                metalness: 0.1,
                roughness: 0.1,
                transmission: 0.8, // More glass-like
                thickness: 0.5,
                clearcoat: 1.0,
                clearcoatRoughness: 0.05
            }),
            // Magenta Accent
            new THREE.MeshPhysicalMaterial({
                color: 0xff0099, // Brighter magenta
                metalness: 0.4,
                roughness: 0.1,
                clearcoat: 1.0,
            }),
            // Dark Sleek Matte/Metallic
            new THREE.MeshPhysicalMaterial({
                color: 0x2a2a35, // Slightly lighter dark for visibility
                metalness: 0.9,
                roughness: 0.3,
                clearcoat: 0.5,
            }),
            // Pure White/Silver
            new THREE.MeshPhysicalMaterial({
                color: 0xffffff,
                metalness: 1.0,
                roughness: 0.05,
                clearcoat: 1.0,
            })
        ];

        // Object generation helper
        const createSolidShape = (geometry, x, y, z, scale) => {
            // Pick a random premium material
            const material = materials[Math.floor(Math.random() * materials.length)];
            const mesh = new THREE.Mesh(geometry, material);
            
            mesh.position.set(x, y, z);
            mesh.scale.set(scale, scale, scale);
            
            // Random initial rotation
            mesh.rotation.x = Math.random() * Math.PI;
            mesh.rotation.y = Math.random() * Math.PI;
            
            // Give each object a random rotation speed
            mesh.userData = {
                rotX: (Math.random() - 0.5) * 0.015,
                rotY: (Math.random() - 0.5) * 0.015,
                rotZ: (Math.random() - 0.5) * 0.015,
                floatSpeed: 0.2 + Math.random() * 0.8,
                floatOffset: Math.random() * Math.PI * 2
            };
            
            return mesh;
        };

        const shapes = [];

        // 1. Central Complex Shape (Icosahedron)
        const centerMaterial = new THREE.MeshPhysicalMaterial({
            color: 0x00d4ff,
            metalness: 0.2,
            roughness: 0.05,
            transmission: 0.9,
            thickness: 1.5,
            clearcoat: 1.0
        });
        const centerShape = new THREE.Mesh(new THREE.IcosahedronGeometry(8, 0), centerMaterial);
        
        // Add a secondary inner shape for a cool glass refraction effect
        const innerShape = new THREE.Mesh(new THREE.IcosahedronGeometry(5, 0), materials[1]);
        centerShape.add(innerShape);

        group.add(centerShape);
        shapes.push(centerShape);

        // 2. Add multiple floating shapes around the scene
        const geometries = [
            new THREE.OctahedronGeometry(4, 0),
            new THREE.TetrahedronGeometry(4, 0),
            new THREE.DodecahedronGeometry(3, 0),
            new THREE.TorusGeometry(3, 1, 16, 100),
            new THREE.BoxGeometry(5, 5, 5),
            new THREE.CylinderGeometry(2, 2, 6, 32)
        ];

        for(let i = 0; i < 20; i++) { // Increased count slightly
            const geo = geometries[Math.floor(Math.random() * geometries.length)];
            // Spread them wider but bring them closer to the camera (Z between -10 and +15)
            const x = (Math.random() - 0.5) * 80;
            const y = (Math.random() - 0.5) * 50;
            const z = (Math.random() - 0.5) * 25 + 5; 
            
            // Keep away from exact center to not occlude text too much
            if (Math.abs(x) < 12 && Math.abs(y) < 12) continue;
            
            const scale = 0.5 + Math.random() * 1.8;
            const shape = createSolidShape(geo, x, y, z, scale);
            group.add(shape);
            shapes.push(shape);
        }

        // 3. Floating Particles (Dense field)
        const particlesGeometry = new THREE.BufferGeometry();
        const particlesCount = 800;
        const posArray = new Float32Array(particlesCount * 3);

        for(let i = 0; i < particlesCount * 3; i++) {
            posArray[i] = (Math.random() - 0.5) * 120;
        }

        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        const particlesMaterial = new THREE.PointsMaterial({
            size: 0.2, // Slightly larger particles
            color: 0x00d4ff,
            transparent: true,
            opacity: 0.8, // Brighter particles
            blending: THREE.AdditiveBlending
        });

        const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
        scene.add(particlesMesh);

        // Lighting (Increased intensities to make shapes punchier)
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.8);
        scene.add(ambientLight);

        const pointLight1 = new THREE.PointLight(0x00d4ff, 300);
        pointLight1.position.set(30, 30, 20);
        scene.add(pointLight1);
        
        const pointLight2 = new THREE.PointLight(0xff0099, 300); 
        pointLight2.position.set(-30, -20, 20);
        scene.add(pointLight2);
        
        const pointLight3 = new THREE.PointLight(0xffffff, 150);
        pointLight3.position.set(0, 0, 40);
        scene.add(pointLight3);

        // Mouse Interaction
        let mouseX = 0;
        let mouseY = 0;
        let targetX = 0;
        let targetY = 0;
        const windowHalfX = window.innerWidth / 2;
        const windowHalfY = window.innerHeight / 2;

        document.addEventListener('mousemove', (event) => {
            mouseX = (event.clientX - windowHalfX) * 0.0015; // Increased parallax intensity
            mouseY = (event.clientY - windowHalfY) * 0.0015;
        });

        // Animation Loop
        const clock = new THREE.Clock();

        const animate = () => {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();

            // Smooth mouse follow for the entire group
            targetX = mouseX * 0.5;
            targetY = mouseY * 0.5;
            
            group.rotation.y += 0.002;
            group.rotation.x += 0.001;
            
            // Mouse parallax effect
            group.rotation.y += 0.08 * (targetX - group.rotation.y); // Faster response
            group.rotation.x += 0.08 * (targetY - group.rotation.x);

            // Animate individual shapes
            shapes.forEach(shape => {
                shape.rotation.x += shape.userData.rotX;
                shape.rotation.y += shape.userData.rotY;
                shape.rotation.z += shape.userData.rotZ;
                
                // Gentle floating up and down
                shape.position.y += Math.sin(elapsedTime * shape.userData.floatSpeed + shape.userData.floatOffset) * 0.03;
            });

            // Slowly rotate particles
            particlesMesh.rotation.y = -elapsedTime * 0.02;
            particlesMesh.rotation.x = elapsedTime * 0.01;

            renderer.render(scene, camera);
        };

        animate();

        // Handle Resize
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    };

    // Run on mount (handles Astro view transitions)
    document.addEventListener('astro:page-load', init3DBackground);
    // Fallback for initial load if view transitions aren't active
    if (document.readyState === 'complete') {
        init3DBackground();
    } else {
        window.addEventListener('load', init3DBackground);
    }
</script>
