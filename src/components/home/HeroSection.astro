---
interface Props {
    heroHeadline: string;
    heroTagline: string;
    heroServices: string[];
}

const { heroHeadline, heroTagline, heroServices } = Astro.props;
---
<section class="hero" id="hero" style="position: relative; overflow: hidden;">
    <!-- Advanced 3D Interactive Background -->
    <div class="hero-bg-container" style="position: absolute; inset: 0; z-index: 0; pointer-events: auto;">
        <!-- Layer 0: Animated Gradient -->
        <div class="hero-animated-gradient"></div>
        <!-- Layer 1: Gradient Mesh -->
        <div class="bg-gradient-mesh active-bg"></div>
        
        <!-- 3D Canvas -->
        <canvas id="hero-3d-canvas" style="position: absolute; top: 0; left: 0; width: 100%; height: 100%; z-index: 2; pointer-events: none; mix-blend-mode: screen; opacity: 0.8;"></canvas>
        
        <!-- Overall Overlay to ensure text readability -->
        <div class="hero-overlay" style="z-index: 3;"></div>
        <div class="hero-noise" style="z-index: 4;"></div>
    </div>
    
    <div class="container hero-container" style="position: relative; z-index: 10; pointer-events: none;">
        <h1 class="hero-title">
            {heroHeadline} <span class="typewriter text-gradient" id="typewriter" data-services={JSON.stringify(heroServices)}>{heroServices[0]}</span><span class="cursor text-gradient">|</span>
        </h1>
        <p class="hero-subtitle">{heroTagline}</p>
        <div class="hero-ctas" style="pointer-events: auto;">
            <a href="/contact" class="btn btn-primary btn-pill glow-effect">Book a Free Call</a>
            <a href="/projects" class="btn btn-ghost btn-pill">See Our Projects</a>
        </div>
    </div>
</section>

<script type="module">
    import * as THREE from 'https://cdn.jsdelivr.net/npm/three@0.160.0/build/three.module.js';

    const init3DBackground = () => {
        const canvas = document.getElementById('hero-3d-canvas');
        if (!canvas) return;

        // Scene setup
        const scene = new THREE.Scene();
        scene.fog = new THREE.FogExp2(0x0d0d14, 0.02);
        
        // Camera setup
        const camera = new THREE.PerspectiveCamera(75, window.innerWidth / window.innerHeight, 0.1, 1000);
        camera.position.z = 40;

        // Renderer setup
        const renderer = new THREE.WebGLRenderer({ 
            canvas, 
            alpha: true, 
            antialias: true,
            powerPreference: "high-performance"
        });
        renderer.setSize(window.innerWidth, window.innerHeight);
        renderer.setPixelRatio(Math.min(window.devicePixelRatio, 2));

        // Group to hold all objects for rotation
        const group = new THREE.Group();
        scene.add(group);

        // Materials
        const wireframeMaterial = new THREE.MeshBasicMaterial({ 
            color: 0x00aeef, 
            wireframe: true, 
            transparent: true, 
            opacity: 0.15 
        });
        
        const solidMaterial = new THREE.MeshPhysicalMaterial({
            color: 0x0d0d14,
            metalness: 0.9,
            roughness: 0.1,
            clearcoat: 1.0,
            clearcoatRoughness: 0.1,
            transparent: true,
            opacity: 0.8
        });

        // Object generation helper
        const createComplexShape = (geometry, x, y, z, scale) => {
            const meshGroup = new THREE.Group();
            
            const solidMesh = new THREE.Mesh(geometry, solidMaterial);
            const wireMesh = new THREE.Mesh(geometry, wireframeMaterial);
            wireMesh.scale.set(1.05, 1.05, 1.05);
            
            meshGroup.add(solidMesh);
            meshGroup.add(wireMesh);
            
            meshGroup.position.set(x, y, z);
            meshGroup.scale.set(scale, scale, scale);
            
            // Random initial rotation
            meshGroup.rotation.x = Math.random() * Math.PI;
            meshGroup.rotation.y = Math.random() * Math.PI;
            
            // Give each object a random rotation speed
            meshGroup.userData = {
                rotX: (Math.random() - 0.5) * 0.01,
                rotY: (Math.random() - 0.5) * 0.01,
                rotZ: (Math.random() - 0.5) * 0.01,
                floatSpeed: 0.2 + Math.random() * 0.8,
                floatOffset: Math.random() * Math.PI * 2
            };
            
            return meshGroup;
        };

        const shapes = [];

        // 1. Central Complex Shape (Icosahedron)
        const centerShape = createComplexShape(new THREE.IcosahedronGeometry(8, 1), 0, 0, 0, 1);
        group.add(centerShape);
        shapes.push(centerShape);

        // 2. Add multiple floating shapes around the scene
        const geometries = [
            new THREE.OctahedronGeometry(4, 0),
            new THREE.TetrahedronGeometry(4, 0),
            new THREE.DodecahedronGeometry(3, 0),
            new THREE.TorusGeometry(3, 1, 16, 100),
            new THREE.BoxGeometry(5, 5, 5),
            new THREE.CylinderGeometry(2, 2, 6, 32)
        ];

        for(let i = 0; i < 15; i++) {
            const geo = geometries[Math.floor(Math.random() * geometries.length)];
            const x = (Math.random() - 0.5) * 60;
            const y = (Math.random() - 0.5) * 40;
            const z = (Math.random() - 0.5) * 30 - 10;
            
            // Keep away from exact center to not occlude text too much
            if (Math.abs(x) < 10 && Math.abs(y) < 10) continue;
            
            const scale = 0.5 + Math.random() * 1.5;
            const shape = createComplexShape(geo, x, y, z, scale);
            group.add(shape);
            shapes.push(shape);
        }

        // 3. Floating Particles (Dense field)
        const particlesGeometry = new THREE.BufferGeometry();
        const particlesCount = 800;
        const posArray = new Float32Array(particlesCount * 3);

        for(let i = 0; i < particlesCount * 3; i++) {
            posArray[i] = (Math.random() - 0.5) * 120;
        }

        particlesGeometry.setAttribute('position', new THREE.BufferAttribute(posArray, 3));
        const particlesMaterial = new THREE.PointsMaterial({
            size: 0.15,
            color: 0x00aeef,
            transparent: true,
            opacity: 0.5,
            blending: THREE.AdditiveBlending
        });

        const particlesMesh = new THREE.Points(particlesGeometry, particlesMaterial);
        scene.add(particlesMesh);

        // Lighting
        const ambientLight = new THREE.AmbientLight(0xffffff, 0.5);
        scene.add(ambientLight);

        const pointLight1 = new THREE.PointLight(0x00aeef, 250);
        pointLight1.position.set(30, 30, 20);
        scene.add(pointLight1);
        
        const pointLight2 = new THREE.PointLight(0xec008c, 250); // Pink/Magenta accent
        pointLight2.position.set(-30, -20, 20);
        scene.add(pointLight2);
        
        const pointLight3 = new THREE.PointLight(0xffffff, 100);
        pointLight3.position.set(0, 0, 40);
        scene.add(pointLight3);

        // Mouse Interaction
        let mouseX = 0;
        let mouseY = 0;
        let targetX = 0;
        let targetY = 0;
        const windowHalfX = window.innerWidth / 2;
        const windowHalfY = window.innerHeight / 2;

        document.addEventListener('mousemove', (event) => {
            mouseX = (event.clientX - windowHalfX) * 0.001;
            mouseY = (event.clientY - windowHalfY) * 0.001;
        });

        // Animation Loop
        const clock = new THREE.Clock();

        const animate = () => {
            requestAnimationFrame(animate);
            const elapsedTime = clock.getElapsedTime();

            // Smooth mouse follow for the entire group
            targetX = mouseX * 0.5;
            targetY = mouseY * 0.5;
            
            group.rotation.y += 0.002;
            group.rotation.x += 0.001;
            
            // Mouse parallax effect
            group.rotation.y += 0.05 * (targetX - group.rotation.y);
            group.rotation.x += 0.05 * (targetY - group.rotation.x);

            // Animate individual shapes
            shapes.forEach(shape => {
                shape.rotation.x += shape.userData.rotX;
                shape.rotation.y += shape.userData.rotY;
                shape.rotation.z += shape.userData.rotZ;
                
                // Gentle floating up and down
                shape.position.y += Math.sin(elapsedTime * shape.userData.floatSpeed + shape.userData.floatOffset) * 0.02;
            });

            // Slowly rotate particles
            particlesMesh.rotation.y = -elapsedTime * 0.02;
            particlesMesh.rotation.x = elapsedTime * 0.01;

            renderer.render(scene, camera);
        };

        animate();

        // Handle Resize
        window.addEventListener('resize', () => {
            camera.aspect = window.innerWidth / window.innerHeight;
            camera.updateProjectionMatrix();
            renderer.setSize(window.innerWidth, window.innerHeight);
        });
    };

    // Run on mount (handles Astro view transitions)
    document.addEventListener('astro:page-load', init3DBackground);
    // Fallback for initial load if view transitions aren't active
    if (document.readyState === 'complete') {
        init3DBackground();
    } else {
        window.addEventListener('load', init3DBackground);
    }
</script>
