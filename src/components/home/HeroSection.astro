---
import HeroHeadline from './HeroHeadline';

interface Props {
    heroHeadline: string;
    heroTagline: string;
    heroServices: string[];
    heroSubheadline?: string;
    primaryCta?: { label?: string; link?: string };
    secondaryCta?: { label?: string; link?: string };
}

const {
    heroHeadline,
    heroTagline,
    heroServices,
    heroSubheadline,
    primaryCta,
    secondaryCta,
} = Astro.props;

const primaryLabel = primaryCta?.label || 'Book a Free Call';
const primaryLink  = primaryCta?.link  || '/contact';
const secondaryLabel = secondaryCta?.label || 'See Our Projects';
const secondaryLink  = secondaryCta?.link  || '/projects';
---
<section class="hero" id="hero" style="position: relative; overflow: hidden;">
    <div class="hero-bg-container" style="position: absolute; inset: 0; z-index: 0;">
        <!-- Brand imagery background -->
        <div class="hero-image-bg" style="background-image: url('/images/hero-bg.jpg');"></div>
        <!-- Layer 1: Gradient Mesh (kept for depth/color on top of image) -->
        <div class="bg-gradient-mesh active-bg"></div>

        <!-- Overall Overlay to ensure text readability -->
        <div class="hero-overlay" style="z-index: 1;"></div>
        <div class="hero-noise" style="z-index: 2;"></div>
    </div>

    <div class="container hero-container" style="position: relative; z-index: 10; pointer-events: none;">
        <h1 class="hero-title">
            <HeroHeadline headline={heroHeadline} services={heroServices} client:load />
        </h1>
        <p class="hero-subtitle hero-reveal" style="animation-delay: 0.2s;">{heroTagline}</p>
        {heroSubheadline && (
            <p class="hero-subheadline hero-reveal" style="animation-delay: 0.32s;">{heroSubheadline}</p>
        )}
        <div class="hero-ctas hero-reveal" style="pointer-events: auto; animation-delay: 0.44s;">
            <a href={primaryLink} class="btn btn-primary btn-pill glow-effect">{primaryLabel}</a>
            <a href={secondaryLink} class="btn btn-ghost btn-pill">{secondaryLabel}</a>
        </div>
    </div>
</section>

<style>
    .hero-title {
        font-family: 'Bricolage Grotesque Variable', var(--font-heading);
        letter-spacing: -0.015em;
    }

    .hero-sr-only {
        position: absolute;
        width: 1px;
        height: 1px;
        overflow: hidden;
        clip: rect(0 0 0 0);
        white-space: nowrap;
    }

    /* Finishing touch once the decode/scramble reveal locks in: a single light
       sweep across the settled headline, like glass catching a reflection. */
    .hero-headline-text.is-decoded {
        background-image: linear-gradient(110deg, #fff 35%, #aee9ff 48%, #fff 60%);
        background-size: 250% 100%;
        background-position: 200% 0;
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        animation: heroShineSweep 1.1s ease forwards;
    }

    @keyframes heroShineSweep {
        to { background-position: -50% 0; }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-headline-text.is-decoded {
            animation: none;
            background-position: 0 0;
        }
    }

    .hero-subheadline {
        font-size: 1rem;
        color: rgba(255, 255, 255, 0.55);
        max-width: 560px;
        line-height: 1.6;
        margin: 0.75rem auto 0;
    }

    @media (max-width: 768px) {
        .hero-subheadline {
            font-size: 0.9375rem;
        }
    }

    .hero-image-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        animation: heroImageZoom 30s ease-in-out infinite alternate;
        will-change: transform;
    }

    @keyframes heroImageZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.08); }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-image-bg {
            animation: none;
        }
    }

    /* Hidden until the splash screen actually dismisses (body.loader-done) —
       otherwise the reveal finishes behind the opaque splash and is never seen. */
    .hero-reveal {
        opacity: 0;
        transform: translateY(28px);
        filter: blur(6px);
    }

    :global(body.loader-done) .hero-reveal {
        animation: heroRevealIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes heroRevealIn {
        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    /* Gentle ongoing life on the primary CTA so the hero doesn't feel static */
    .hero-ctas .btn-primary {
        animation: heroCtaPulse 3.2s ease-in-out 1.4s infinite;
    }

    @keyframes heroCtaPulse {
        0%, 100% { box-shadow: 0 8px 25px rgba(0, 174, 239, 0.4); }
        50% { box-shadow: 0 8px 34px rgba(0, 174, 239, 0.65); }
    }

    @media (prefers-reduced-motion: reduce) {
        .hero-reveal {
            opacity: 1;
            transform: none;
            filter: none;
            animation: none;
        }

        .hero-ctas .btn-primary {
            animation: none;
        }
    }
</style>
