---
import HeroHeadline from './HeroHeadline';

interface Props {
    heroHeadline: string;
    heroTagline: string;
    heroServices: { service: string, suffix: string, mediaUrl: string, mimeType: string }[];
    heroSubheadline?: string;
    primaryCta?: { label?: string; link?: string };
    secondaryCta?: { label?: string; link?: string };
}

const {
    heroHeadline,
    heroTagline,
    heroServices,
    heroSubheadline,
    primaryCta,
    secondaryCta,
} = Astro.props;

const primaryLabel = primaryCta?.label || 'Book a Free Call';
const primaryLink  = primaryCta?.link  || '/contact';
const secondaryLabel = secondaryCta?.label || 'See Our Projects';
const secondaryLink  = secondaryCta?.link  || '/projects';
---
<section class="hero" id="hero" style="position: relative; overflow: hidden;">
    <div class="hero-bg-container" style="position: absolute; inset: 0; z-index: 0;">
        <div class="bg-gradient-mesh active-bg"></div>
        <div class="hero-overlay" style="z-index: 1;"></div>
        <div class="hero-noise" style="z-index: 2;"></div>
    </div>

    <div class="container hero-layout-grid" style="position: relative; z-index: 10;">
        <div class="hero-content-col" style="pointer-events: none;">
            <h1 class="hero-title">
                <HeroHeadline headline={heroHeadline} services={heroServices} client:load />
            </h1>
            <p class="hero-subtitle hero-reveal" style="animation-delay: 0.2s;">{heroTagline}</p>
            {heroSubheadline && (
                <p class="hero-subheadline hero-reveal" style="animation-delay: 0.32s;">{heroSubheadline}</p>
            )}
            <div class="hero-ctas hero-reveal" style="pointer-events: auto; animation-delay: 0.44s;">
                <a href={primaryLink} class="btn btn-primary btn-pill glow-effect">{primaryLabel}</a>
                <a href={secondaryLink} class="btn btn-ghost btn-pill">{secondaryLabel}</a>
            </div>
        </div>
        
        <div class="hero-media-col hero-reveal" style="animation-delay: 0.5s;">
            <div class="hero-carousel-wrapper">
                {heroServices.map((item, index) => (
                    <div class={`hero-carousel-slide ${index === 0 ? 'active' : ''}`} data-index={index}>
                        {item.mimeType?.startsWith('video') ? (
                            <video 
                                src={item.mediaUrl} 
                                autoplay 
                                loop 
                                muted 
                                playsinline 
                                class="hero-carousel-video"
                            ></video>
                        ) : (
                            <div 
                                class="hero-carousel-image" 
                                style={`background-image: url('${item.mediaUrl}');`}
                            ></div>
                        )}
                        <div class="hero-carousel-overlay"></div>
                    </div>
                ))}
            </div>
        </div>
    </div>
</section>

<script>
    document.addEventListener('astro:page-load', () => {
        const slides = document.querySelectorAll('.hero-carousel-slide');
        if (!slides.length) return;

        window.addEventListener('hero-slide-change', (e: any) => {
            const index = e.detail?.index;
            if (index !== undefined) {
                slides.forEach((slide) => {
                    if (parseInt(slide.getAttribute('data-index') || '0', 10) === index) {
                        slide.classList.add('active');
                    } else {
                        slide.classList.remove('active');
                    }
                });
            }
        });
    });
</script>

<style>
    /* ── Hero Layout ───────────────────────── */
    .hero {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-layout-grid {
        display: grid;
        grid-template-columns: 1.1fr 0.9fr;
        gap: 4rem;
        align-items: center;
        padding-top: 6rem;
        padding-bottom: 4rem;
        width: 100%;
    }

    .hero-content-col {
        text-align: left;
    }

    /* ── Carousel ──────────────────────────── */
    .hero-media-col {
        position: relative;
        width: 100%;
        height: 600px;
        perspective: 1000px;
    }

    .hero-carousel-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 24px;
        overflow: hidden;
        box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.5);
        border: 1px solid rgba(255, 255, 255, 0.1);
        transform: rotateY(-5deg) rotateX(2deg);
        transition: transform 0.5s ease;
    }

    .hero-carousel-wrapper:hover {
        transform: rotateY(0) rotateX(0);
    }

    .hero-carousel-slide {
        position: absolute;
        inset: 0;
        opacity: 0;
        visibility: hidden;
        transition: opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1), visibility 0.8s;
        z-index: 1;
    }

    .hero-carousel-slide.active {
        opacity: 1;
        visibility: visible;
        z-index: 2;
    }

    .hero-carousel-image, .hero-carousel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-carousel-image {
        background-size: cover;
        background-position: center;
        transform: scale(1.1);
        transition: transform 6s ease-out;
    }

    .hero-carousel-slide.active .hero-carousel-image {
        transform: scale(1); /* Ken Burns effect */
    }

    .hero-carousel-overlay {
        position: absolute;
        inset: 0;
        background: linear-gradient(to top, rgba(10, 15, 37, 0.8) 0%, rgba(10, 15, 37, 0.2) 50%, transparent 100%);
        pointer-events: none;
    }

    /* ── Title ─────────────────────────────── */
    .hero-title {
        font-family: 'Bricolage Grotesque Variable', var(--font-heading);
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.035em;
        color: #fff;
        margin: 0 0 1.5rem;
    }

    /* Headline wrapper from React component */
    :global(.hero-headline-wrapper) {
        display: block;
    }

    :global(.hero-line) {
        display: block;
    }

    :global(.hero-line-1) {
        color: rgba(255, 255, 255, 0.88);
    }

    :global(.hero-line-3) {
        color: rgba(255, 255, 255, 0.88);
    }

    /* ── Rotating Word ────────────────────── */
    :global(.hero-rotator-row) {
        display: block;
        position: relative;
        overflow: hidden;
        height: 1.15em;
        margin: 0.08em 0;
    }

    :global(.hero-rotator-container) {
        display: block;
        position: relative;
        height: 100%;
    }

    :global(.hero-rotator-word) {
        display: block;
        background: linear-gradient(135deg, #00aeef 0%, #5ef7ff 40%, #a78bfa 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-weight: 900;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.hero-rotator-word.in) {
        transform: translateY(0);
        opacity: 1;
        filter: blur(0);
    }

    :global(.hero-rotator-word.out) {
        transform: translateY(-80%);
        opacity: 0;
        filter: blur(4px);
    }

    /* Shine sweep once word settles */
    :global(.hero-rotator-word.in)::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 60%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
        animation: heroWordShine 1.6s ease 0.5s forwards;
        pointer-events: none;
    }

    @keyframes heroWordShine {
        to { left: 200%; }
    }

    /* ── Subtitle ─────────────────────────── */
    .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.125rem);
        color: rgba(255, 255, 255, 0.58);
        max-width: 520px;
        line-height: 1.7;
        margin: 0 0 2rem;
        font-weight: 400;
    }

    .hero-subheadline {
        font-size: 0.9375rem;
        color: rgba(255, 255, 255, 0.42);
        max-width: 520px;
        line-height: 1.6;
        margin: -0.75rem 0 2rem;
    }

    /* ── CTAs ──────────────────────────────── */
    .hero-ctas {
        display: flex;
        gap: 0.875rem;
        flex-wrap: wrap;
    }

    /* ── Reveal animation ─────────────────── */
    .hero-reveal {
        opacity: 0;
        transform: translateY(28px);
        filter: blur(6px);
    }

    :global(body.loader-done) .hero-reveal {
        animation: heroRevealIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes heroRevealIn {
        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    /* ── CTA pulse ────────────────────────── */
    .hero-ctas .btn-primary {
        animation: heroCtaPulse 3.2s ease-in-out 1.4s infinite;
    }

    @keyframes heroCtaPulse {
        0%, 100% { box-shadow: 0 8px 25px rgba(0, 174, 239, 0.4); }
        50% { box-shadow: 0 8px 34px rgba(0, 174, 239, 0.65); }
    }

    /* ── Background ───────────────────────── */
    .hero-image-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        animation: heroImageZoom 30s ease-in-out infinite alternate;
        will-change: transform;
    }

    @keyframes heroImageZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.08); }
    }

    @media (max-width: 992px) {
        .hero-layout-grid {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 3rem;
            padding-top: 7rem;
        }

        .hero-content-col {
            text-align: center;
            max-width: 700px;
            margin: 0 auto;
        }

        .hero-title {
            font-size: clamp(2.5rem, 8vw, 3.5rem);
        }

        .hero-subtitle,
        .hero-subheadline {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-ctas {
            justify-content: center;
        }

        .hero-media-col {
            height: 400px;
        }

        .hero-carousel-wrapper {
            transform: none;
        }

        :global(.hero-rotator-row) {
            height: 1.2em;
        }
    }

        .hero-subtitle,
        .hero-subheadline {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-ctas {
            justify-content: center;
        }

        :global(.hero-rotator-row) {
            height: 1.2em;
        }
    }

    /* ── Reduced motion ───────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .hero-image-bg {
            animation: none;
        }

        .hero-reveal {
            opacity: 1;
            transform: none;
            filter: none;
            animation: none;
        }

        .hero-ctas .btn-primary {
            animation: none;
        }

        :global(.hero-rotator-word) {
            transition: none;
        }
    }
</style>
