---
import HeroHeadline from './HeroHeadline';

interface Props {
    heroHeadline: string;
    heroTagline: string;
    heroServices: { service: string, suffix: string, mediaUrl: string, mimeType: string, mobileUrl?: string | null }[];
    heroSubheadline?: string;
    primaryCta?: { label?: string; link?: string };
    secondaryCta?: { label?: string; link?: string };
}

const {
    heroHeadline,
    heroTagline,
    heroServices,
    heroSubheadline,
    primaryCta,
    secondaryCta,
} = Astro.props;

const primaryLabel = primaryCta?.label || 'Book a Free Call';
const primaryLink  = primaryCta?.link  || '/contact/';
const secondaryLabel = secondaryCta?.label || 'See My Projects';
const secondaryLink  = secondaryCta?.link  || '/projects/';
---
<section class="hero" id="hero" style="position: relative; overflow: hidden;">
    <div class="hero-bg-container" style="position: absolute; inset: 0; z-index: 0;">
        <div class="bg-gradient-mesh active-bg"></div>
        <div class="hero-overlay" style="z-index: 1;"></div>
        <div class="hero-noise" style="z-index: 2;"></div>
    </div>

    <div class="container hero-layout-grid" style="position: relative; z-index: 10;">
        <div class="hero-content-col">
            <h1 class="hero-title">
                <HeroHeadline headline={heroHeadline} services={heroServices} client:load />
            </h1>
            <p class="hero-subtitle hero-reveal" style="animation-delay: 0.2s;">{heroTagline}</p>
            {heroSubheadline && (
                <p class="hero-subheadline hero-reveal" style="animation-delay: 0.32s;">{heroSubheadline}</p>
            )}
            <div class="hero-ctas hero-reveal" style="animation-delay: 0.44s;">
                <a href={primaryLink} class="btn btn-primary btn-pill glow-effect" data-track="hero_primary_cta" data-loc="hero">{primaryLabel}</a>
                <a href={secondaryLink} class="btn btn-ghost btn-pill" data-track="hero_secondary_cta" data-loc="hero">{secondaryLabel}</a>
            </div>
        </div>
        
        <div class="hero-media-col hero-reveal" style="animation-delay: 0.5s;">
            <div class="hero-carousel-wrapper">
                <div class="hero-carousel-track">
                    {/*
                       Only slide one carries its artwork in the HTML. The other
                       three used to be 145KB of images a phone downloaded before
                       first paint for pictures nobody sees until 3.2s in, so they
                       hold their URL in data-bg and are filled in after load. See
                       the script below.
                    */}
                    {heroServices.map((item, index) => (
                        <div class:list={["hero-carousel-slide", item.mobileUrl && "has-mobile-art"]} data-index={index}>
                            {item.mobileUrl && !item.mimeType?.startsWith('video') && (
                                <div
                                    class="hero-carousel-image hero-carousel-image-mobile"
                                    style={index === 0 ? `background-image: url('${item.mobileUrl}');` : undefined}
                                    data-bg={index === 0 ? undefined : item.mobileUrl}
                                    aria-hidden="true"
                                ></div>
                            )}
                            {item.mimeType?.startsWith('video') ? (
                                /*
                                   No src in the markup, for any slide including
                                   the first. The file a phone should fetch is
                                   not the file a desktop should, and <source
                                   media> is ignored inside <video>, so the
                                   choice can only be made in script. The poster
                                   is what paints in the meantime, and it is a
                                   few KB of webp rather than the first megabyte
                                   of an mp4.
                                */
                                <video
                                    data-sources={JSON.stringify(item.video?.sources ?? [{ src: item.mediaUrl, type: item.mimeType }])}
                                    data-mobile={item.video?.mobileSrc ?? undefined}
                                    poster={item.video?.poster ?? undefined}
                                    loop
                                    muted
                                    playsinline
                                    preload="none"
                                    aria-label={item.service}
                                    class="hero-carousel-video"
                                ></video>
                            ) : (
                                <div
                                    class="hero-carousel-image"
                                    style={index === 0 ? `background-image: url('${item.mediaUrl}');` : undefined}
                                    data-bg={index === 0 ? undefined : item.mediaUrl}
                                    role="img"
                                    aria-label={item.service}
                                ></div>
                            )}
                        </div>
                    ))}
                </div>
            </div>
        </div>
    </div>
</section>

<script>
    import { attachVideoSources, playSilently, prefersReducedMotion } from '../../scripts/videoSources';

    document.addEventListener('astro:page-load', () => {
        const track = document.querySelector('.hero-carousel-track') as HTMLElement;
        if (!track) return;

        const slides = Array.from(track.querySelectorAll('.hero-carousel-slide')) as HTMLElement[];

        /*
           Give a slide the artwork it was rendered without. Both the wide and
           the portrait element are filled, which costs nothing: whichever one
           this breakpoint hides is display:none, and a background-image on a
           display:none element is never fetched.
        */
        const hydrate = (slide?: HTMLElement) => {
            if (!slide) return;
            slide.querySelectorAll('[data-bg]').forEach((node) => {
                const el = node as HTMLElement;
                el.style.backgroundImage = `url('${el.dataset.bg}')`;
                delete el.dataset.bg;
            });
            slide.querySelectorAll('video[data-sources]').forEach((node) => {
                const el = node as HTMLVideoElement;
                // Reduced motion means the poster and nothing else: no source
                // is attached, so not one video byte is requested.
                if (prefersReducedMotion()) return;
                attachVideoSources(el);
            });
        };

        /*
           Only the slide on screen plays. Attaching a source used to start
           playback too, which meant every hero video in the carousel was
           decoding frames at once while three of the four were translated out
           of sight: work that costs a phone battery and shows nobody anything.
           The others sit paused on their poster until their turn.
        */
        const playOnly = (index: number) => {
            slides.forEach((slide, i) => {
                slide.querySelectorAll('video').forEach((node) => {
                    const el = node as HTMLVideoElement;
                    if (i === index) playSilently(el);
                    else if (!el.paused) el.pause();
                });
            });
        };

        /*
           Listeners are dropped before a View Transition swaps this page out,
           so leaving the homepage and coming back does not leave one bound per
           visit, each writing to a track that is no longer in the document.
        */
        const teardown = new AbortController();
        document.addEventListener('astro:before-swap', () => teardown.abort(), { once: true });

        /*
           The remaining slides load once the page itself has finished. The
           first rotation is 3.2s after hydration, so there is room; the
           hydrate call in the handler covers the case where load is slower
           than that, and a slide would otherwise arrive empty.
        */
        /*
           Slide one's video no longer carries a src in the markup, because the
           right file depends on viewport width. It is hydrated immediately
           rather than waiting for load: it is the one piece of hero media on
           the critical path, and its poster is already painted so the wait
           costs a visitor nothing visible either way.
        */
        hydrate(slides[0]);
        playOnly(0);

        const loadRest = () => slides.slice(1).forEach(hydrate);
        if (document.readyState === 'complete') loadRest();
        else window.addEventListener('load', loadRest, { once: true, signal: teardown.signal });

        window.addEventListener('hero-slide-change', (e: any) => {
            const index = e.detail?.index;
            if (index === undefined) return;
            hydrate(slides[index]);
            playOnly(index);
            track.style.transform = `translateY(-${index * 100}%)`;
        }, { signal: teardown.signal });
    });
</script>

<style>
    /* ── Hero Layout ───────────────────────── */
    .hero {
        height: auto;
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-layout-grid {
        display: grid;
        grid-template-columns: 0.95fr 1.05fr;
        gap: 4rem;
        align-items: center;
        padding-top: 4rem;
        padding-bottom: 4rem;
        width: 100%;
    }

    .hero-content-col {
        text-align: left;
    }

    /* ── Carousel ──────────────────────────── */
    .hero-media-col {
        position: relative;
        width: 100%;
        height: 680px;
        perspective: 1200px;
    }

    .hero-carousel-wrapper {
        position: relative;
        width: 100%;
        height: 100%;
        border-radius: 24px;
        overflow: hidden;
        /* Glassmorphism Effect */
        background: var(--bg-inset);
        /* No backdrop-filter: it blurred the page behind an element that is
           fully covered by an opaque image/video carousel, costing a
           full-viewport backdrop composite every frame of the 8s float loop
           for no visible effect. */
        border: 1px solid var(--border-color);
        box-shadow: -20px 30px 60px -15px rgba(0, 0, 0, 0.6), inset 0 1px 0 rgba(255, 255, 255, 0.15);
        /* 3D Transform */
        transform: rotateY(-15deg) rotateX(10deg) rotateZ(12deg) scale(1.05);
        transition: transform 0.6s cubic-bezier(0.16, 1, 0.3, 1), box-shadow 0.6s ease;
        transform-origin: right center;
        animation: heroFloat 8s ease-in-out infinite;
    }

    @keyframes heroFloat {
        0%, 100% {
            transform: translateY(0) rotateY(-15deg) rotateX(10deg) rotateZ(12deg) scale(1.05);
        }
        50% {
            transform: translateY(-20px) rotateY(-12deg) rotateX(12deg) rotateZ(14deg) scale(1.05);
        }
    }

    .hero-carousel-wrapper:hover {
        transform: translateY(-5px) rotateY(-6deg) rotateX(4deg) rotateZ(4deg) scale(1.08) !important;
        box-shadow: -10px 40px 80px -10px rgba(0, 0, 0, 0.8), inset 0 1px 0 rgba(255, 255, 255, 0.2);
        background: var(--bg-hover);
        animation-play-state: paused;
    }

    .hero-carousel-track {
        display: flex;
        flex-direction: column;
        width: 100%;
        height: 100%;
        transition: transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
        will-change: transform;
    }

    .hero-carousel-slide {
        flex: 0 0 100%;
        width: 100%;
        height: 100%;
        position: relative;
        overflow: hidden;
    }

    .hero-carousel-video {
        width: 100%;
        height: 100%;
        object-fit: cover;
    }

    .hero-carousel-image {
        width: 100%;
        height: 100%;
        background-size: contain;
        background-position: center;
        background-repeat: no-repeat;
    }

    /* Only paints once the panel is wide, see the 992px block below. */
    .hero-carousel-image-mobile {
        display: none;
    }

    /* ── Title ─────────────────────────────── */
    .hero-title {
        font-family: 'Bricolage Grotesque Variable', var(--font-heading);
        font-size: clamp(2rem, 5vw, 4rem);
        font-weight: 800;
        line-height: 1.1;
        letter-spacing: -0.035em;
        color: var(--text-primary);
        margin: 0 0 1.5rem;
    }

    /* Headline wrapper from React component */
    :global(.hero-headline-wrapper) {
        display: block;
    }

    :global(.hero-line) {
        display: block;
    }

    :global(.hero-line-1) {
        color: var(--text-primary);
    }

    :global(.hero-line-3) {
        color: var(--text-primary);
    }

    /* ── Rotating Word ────────────────────── */
    :global(.hero-rotator-row) {
        display: block;
        position: relative;
        overflow: hidden;
        height: 1.15em;
        margin: 0.08em 0;
    }

    :global(.hero-rotator-container) {
        display: block;
        position: relative;
        height: 100%;
    }

    :global(.hero-rotator-word) {
        display: block;
        background: linear-gradient(135deg, #00aeef 0%, #5ef7ff 40%, #a78bfa 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-weight: 900;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.hero-rotator-word.in) {
        transform: translateY(0);
        opacity: 1;
        filter: blur(0);
    }

    :global(.hero-rotator-word.out) {
        transform: translateY(-80%);
        opacity: 0;
        filter: blur(4px);
    }

    /* Shine sweep once word settles */
    :global(.hero-rotator-word.in)::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 60%;
        height: 100%;
        background: linear-gradient(90deg, transparent, var(--border-strong), transparent);
        animation: heroWordShine 1.6s ease 0.5s forwards;
        pointer-events: none;
    }

    @keyframes heroWordShine {
        to { left: 200%; }
    }

    /* ── Subtitle ─────────────────────────── */
    .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.125rem);
        color: var(--text-muted);
        max-width: 520px;
        line-height: 1.7;
        margin: 0 0 2rem;
        font-weight: 400;
    }

    .hero-subheadline {
        font-size: 0.9375rem;
        color: var(--text-muted);
        max-width: 520px;
        line-height: 1.6;
        margin: -0.75rem 0 2rem;
    }

    /* ── CTAs ──────────────────────────────── */
    .hero-ctas {
        display: flex;
        gap: 0.875rem;
        flex-wrap: wrap;
    }

    /* ── Reveal animation ─────────────────── */
    /* Runs unconditionally. It used to be gated on :global(body.loader-done),
       a class only the splash screen set, so the subtitle, subheadline, CTA
       row and media column were opacity:0 until JS ran, and stayed invisible
       forever if it failed. The animation is now an enhancement on content
       that is already painted, not a gate on it appearing. */
    .hero-reveal {
        opacity: 0;
        transform: translateY(28px);
        filter: blur(6px);
        animation: heroRevealIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes heroRevealIn {
        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    /* No animation support / reduced motion: content must simply be visible. */
    @media (prefers-reduced-motion: reduce) {
        .hero-reveal {
            animation: none;
            opacity: 1;
            transform: none;
            filter: none;
        }
    }

    /* ── CTA pulse ────────────────────────── */
    .hero-ctas .btn-primary {
        animation: heroCtaPulse 3.2s ease-in-out 1.4s infinite;
    }

    @keyframes heroCtaPulse {
        0%, 100% { box-shadow: 0 8px 25px rgba(0, 174, 239, 0.4); }
        50% { box-shadow: 0 8px 34px rgba(0, 174, 239, 0.65); }
    }

    /* ── Background ───────────────────────── */
    .hero-image-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        animation: heroImageZoom 30s ease-in-out infinite alternate;
        will-change: transform;
    }

    @keyframes heroImageZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.08); }
    }

    @media (max-width: 992px) {
        .hero {
            min-height: auto;
        }

        .hero-layout-grid {
            grid-template-columns: 1fr;
            text-align: center;
            gap: 3rem;
            padding-top: 8rem;
        }

        .hero-content-col {
            text-align: center;
            max-width: 700px;
            margin: 0 auto;
        }

        .hero-title {
            font-size: clamp(2.5rem, 8vw, 3.5rem);
        }

        .hero-subtitle,
        .hero-subheadline {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-ctas {
            justify-content: center;
        }

        /*
           A fixed height meant the panel's shape depended on screen width, and
           at 375px it came out 343x180. The art in the CMS is 4:5 portrait, so
           `contain` fitted it whole inside that wide box: the picture filled
           about 144px of 343px with an empty bar either side.

           An explicit 16:9 gives the panel the same shape as the phone art
           imported in index.astro, so it fills edge to edge with nothing
           cropped and nothing letterboxed.
        */
        .hero-media-col {
            height: auto;
            aspect-ratio: 16 / 9;
        }

        /* Swap to the wide art. Scoped to .has-mobile-art so a slide with no
           16:9 version keeps its portrait image rather than showing nothing. */
        .has-mobile-art .hero-carousel-image:not(.hero-carousel-image-mobile) {
            display: none;
        }

        .has-mobile-art .hero-carousel-image-mobile {
            display: block;
            background-size: cover;
        }

        .hero-carousel-wrapper {
            transform: none;
            animation: none;
        }

        :global(.hero-rotator-row) {
            height: 1.2em;
        }
    }

    @media (max-width: 768px) {
        .hero-layout-grid {
            gap: 2rem;
            padding-top: 7rem;
            padding-bottom: 3rem;
        }

        .hero-title {
            font-size: clamp(1.8rem, 7vw, 2.8rem);
        }

        .hero-subtitle {
            font-size: 0.95rem;
        }

        /* height comes from the 16:9 aspect-ratio set at 992px */

        .hero-carousel-wrapper {
            border-radius: 16px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
        }
    }

    @media (max-width: 480px) {
        .hero-layout-grid {
            gap: 1.5rem;
            padding-top: 6.5rem;
            padding-bottom: 2rem;
        }

        .hero-title {
            font-size: clamp(1.65rem, 8vw, 2.2rem);
        }

        .hero-subtitle {
            font-size: 0.95rem;
            line-height: 1.65;
        }

        .hero-media-col {
            perspective: none;
        }

        .hero-carousel-wrapper {
            border-radius: 12px;
            box-shadow: 0 8px 20px rgba(0, 0, 0, 0.3);
        }

        .hero-ctas {
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 12px;
        }

        .hero-ctas .btn {
            text-align: center;
            padding: 12px 20px;
            font-size: 0.85rem;
            flex: 1;
            max-width: 180px;
        }

        .hero-ctas .btn-ghost {
            border: 1px solid var(--border-strong);
        }

        :global(.hero-rotator-row) {
            height: 1.25em;
        }
    }

    @media (max-width: 375px) {
        .hero-layout-grid {
            padding-top: 6rem;
            padding-bottom: 1.5rem;
            gap: 1.25rem;
        }

        .hero-title {
            font-size: 1.5rem;
            letter-spacing: -0.02em;
        }

        .hero-subtitle {
            font-size: 0.875rem;
        }

        /* No fixed height: the 16:9 aspect-ratio set at 992px decides it, so
           the panel keeps the shape of the art rather than the shape of the
           screen. This rule is what made the panel 343x180 at 375px. */

        .hero-carousel-wrapper {
            border-radius: 10px;
        }

        .hero-ctas {
            flex-direction: column;
            align-items: stretch;
            gap: 10px;
        }

        .hero-ctas .btn {
            padding: 13px 20px;
            font-size: 0.85rem;
            max-width: 100%;
        }

        :global(.hero-rotator-row) {
            height: 1.3em;
        }
    }

    /* ── Reduced motion ───────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .hero-image-bg {
            animation: none;
        }

        .hero-reveal {
            opacity: 1;
            transform: none;
            filter: none;
            animation: none;
        }

        .hero-ctas .btn-primary {
            animation: none;
        }

        :global(.hero-rotator-word) {
            transition: none;
        }
    }
</style>
