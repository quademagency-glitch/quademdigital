---
import HeroHeadline from './HeroHeadline';

interface Props {
    heroHeadline: string;
    heroTagline: string;
    heroServices: string[];
    heroSubheadline?: string;
    primaryCta?: { label?: string; link?: string };
    secondaryCta?: { label?: string; link?: string };
}

const {
    heroHeadline,
    heroTagline,
    heroServices,
    heroSubheadline,
    primaryCta,
    secondaryCta,
} = Astro.props;

const primaryLabel = primaryCta?.label || 'Book a Free Call';
const primaryLink  = primaryCta?.link  || '/contact';
const secondaryLabel = secondaryCta?.label || 'See Our Projects';
const secondaryLink  = secondaryCta?.link  || '/projects';
---
<section class="hero" id="hero" style="position: relative; overflow: hidden;">
    <div class="hero-bg-container" style="position: absolute; inset: 0; z-index: 0;">
        <!-- Brand imagery background -->
        <div class="hero-image-bg" style="background-image: url('/images/hero-bg.jpg');"></div>
        <!-- Layer 1: Gradient Mesh -->
        <div class="bg-gradient-mesh active-bg"></div>
        <!-- Overlays -->
        <div class="hero-overlay" style="z-index: 1;"></div>
        <div class="hero-noise" style="z-index: 2;"></div>
    </div>

    <div class="container hero-container" style="position: relative; z-index: 10; pointer-events: none;">
        <h1 class="hero-title">
            <HeroHeadline headline={heroHeadline} services={heroServices} client:load />
        </h1>
        <p class="hero-subtitle hero-reveal" style="animation-delay: 0.2s;">{heroTagline}</p>
        {heroSubheadline && (
            <p class="hero-subheadline hero-reveal" style="animation-delay: 0.32s;">{heroSubheadline}</p>
        )}
        <div class="hero-ctas hero-reveal" style="pointer-events: auto; animation-delay: 0.44s;">
            <a href={primaryLink} class="btn btn-primary btn-pill glow-effect">{primaryLabel}</a>
            <a href={secondaryLink} class="btn btn-ghost btn-pill">{secondaryLabel}</a>
        </div>
    </div>
</section>

<style>
    /* ── Hero Layout ───────────────────────── */
    .hero {
        min-height: 100vh;
        min-height: 100dvh;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    .hero-container {
        text-align: left;
        max-width: 860px;
        padding-top: 5rem;
        padding-bottom: 4rem;
    }

    /* ── Title ─────────────────────────────── */
    .hero-title {
        font-family: 'Bricolage Grotesque Variable', var(--font-heading);
        font-size: clamp(2.5rem, 6.5vw, 4.5rem);
        font-weight: 800;
        line-height: 1.08;
        letter-spacing: -0.035em;
        color: #fff;
        margin: 0 0 1.5rem;
    }

    /* Headline wrapper from React component */
    :global(.hero-headline-wrapper) {
        display: block;
    }

    :global(.hero-line) {
        display: block;
    }

    :global(.hero-line-1) {
        color: rgba(255, 255, 255, 0.88);
    }

    :global(.hero-line-3) {
        color: rgba(255, 255, 255, 0.88);
    }

    /* ── Rotating Word ────────────────────── */
    :global(.hero-rotator-row) {
        display: block;
        position: relative;
        overflow: hidden;
        height: 1.15em;
        margin: 0.08em 0;
    }

    :global(.hero-rotator-container) {
        display: block;
        position: relative;
        height: 100%;
    }

    :global(.hero-rotator-word) {
        display: block;
        background: linear-gradient(135deg, #00aeef 0%, #5ef7ff 40%, #a78bfa 100%);
        -webkit-background-clip: text;
        background-clip: text;
        color: transparent;
        font-weight: 900;
        transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    opacity 0.4s cubic-bezier(0.16, 1, 0.3, 1),
                    filter 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    }

    :global(.hero-rotator-word.in) {
        transform: translateY(0);
        opacity: 1;
        filter: blur(0);
    }

    :global(.hero-rotator-word.out) {
        transform: translateY(-80%);
        opacity: 0;
        filter: blur(4px);
    }

    /* Shine sweep once word settles */
    :global(.hero-rotator-word.in)::after {
        content: '';
        position: absolute;
        top: 0;
        left: -100%;
        width: 60%;
        height: 100%;
        background: linear-gradient(90deg, transparent, rgba(255,255,255,0.18), transparent);
        animation: heroWordShine 1.6s ease 0.5s forwards;
        pointer-events: none;
    }

    @keyframes heroWordShine {
        to { left: 200%; }
    }

    /* ── Subtitle ─────────────────────────── */
    .hero-subtitle {
        font-size: clamp(1rem, 2vw, 1.125rem);
        color: rgba(255, 255, 255, 0.58);
        max-width: 520px;
        line-height: 1.7;
        margin: 0 0 2rem;
        font-weight: 400;
    }

    .hero-subheadline {
        font-size: 0.9375rem;
        color: rgba(255, 255, 255, 0.42);
        max-width: 520px;
        line-height: 1.6;
        margin: -0.75rem 0 2rem;
    }

    /* ── CTAs ──────────────────────────────── */
    .hero-ctas {
        display: flex;
        gap: 0.875rem;
        flex-wrap: wrap;
    }

    /* ── Reveal animation ─────────────────── */
    .hero-reveal {
        opacity: 0;
        transform: translateY(28px);
        filter: blur(6px);
    }

    :global(body.loader-done) .hero-reveal {
        animation: heroRevealIn 0.9s cubic-bezier(0.16, 1, 0.3, 1) forwards;
    }

    @keyframes heroRevealIn {
        to {
            opacity: 1;
            transform: translateY(0);
            filter: blur(0);
        }
    }

    /* ── CTA pulse ────────────────────────── */
    .hero-ctas .btn-primary {
        animation: heroCtaPulse 3.2s ease-in-out 1.4s infinite;
    }

    @keyframes heroCtaPulse {
        0%, 100% { box-shadow: 0 8px 25px rgba(0, 174, 239, 0.4); }
        50% { box-shadow: 0 8px 34px rgba(0, 174, 239, 0.65); }
    }

    /* ── Background ───────────────────────── */
    .hero-image-bg {
        position: absolute;
        inset: 0;
        background-size: cover;
        background-position: center;
        animation: heroImageZoom 30s ease-in-out infinite alternate;
        will-change: transform;
    }

    @keyframes heroImageZoom {
        0% { transform: scale(1); }
        100% { transform: scale(1.08); }
    }

    /* ── Responsive ───────────────────────── */
    @media (max-width: 768px) {
        .hero-container {
            text-align: center;
            padding-top: 6rem;
        }

        .hero-subtitle,
        .hero-subheadline {
            margin-left: auto;
            margin-right: auto;
        }

        .hero-ctas {
            justify-content: center;
        }

        :global(.hero-rotator-row) {
            height: 1.2em;
        }
    }

    /* ── Reduced motion ───────────────────── */
    @media (prefers-reduced-motion: reduce) {
        .hero-image-bg {
            animation: none;
        }

        .hero-reveal {
            opacity: 1;
            transform: none;
            filter: none;
            animation: none;
        }

        .hero-ctas .btn-primary {
            animation: none;
        }

        :global(.hero-rotator-word) {
            transition: none;
        }
    }
</style>
