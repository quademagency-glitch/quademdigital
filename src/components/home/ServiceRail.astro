---
/**
 * The seven services, as one screen you push sideways.
 *
 * WHY THIS REPLACED SEVEN SECTIONS
 *
 * The homepage ran seven near-identical promo blocks in a row: a card with a
 * heading, three lines and a button, about 490px tall, seven times, 3,450px of
 * page. They were the reason the middle of the page read as flat, and no amount
 * of animation fixes the same block repeated seven times. This is the same
 * seven, same CMS copy, same links, in one screen that moves sideways as the
 * page scrolls down.
 *
 * HOW THE SIDEWAYS MOVE WORKS
 *
 * The section is taller than the screen. Inside it a sticky frame holds still
 * while that extra height scrolls past, and the row of cards is translated
 * across by a scroll-driven animation over exactly the period the frame is
 * pinned. No JavaScript, no scroll listener, no library.
 *
 * The travel distance and the section height are both computed from the number
 * of cards, so adding an eighth in the CMS lengthens the scroll rather than
 * cutting the eighth card off.
 *
 * WHAT HAPPENS WHERE IT IS NOT SUPPORTED
 *
 * The default, and what a phone always gets, is a plain horizontal scroller
 * with snap points: swipe it. The sticky version is layered on top of that
 * inside @supports, so a browser without scroll timelines gets something that
 * works rather than a broken version of something that does not.
 */
import { safeHref } from '../../lib/payload';

interface Card {
  badge?: string;
  heading: string;
  headingAccent?: string;
  body: string;
  ctaLabel?: string;
  ctaUrl?: string;
}

interface Props {
  cards: Card[];
  eyebrow?: string;
  title?: string;
}

const { cards, eyebrow = 'What I do', title = 'Seven ways I can help' } = Astro.props;

const clean = (cards ?? []).filter((c) => c?.heading && c?.body);
const count = clean.length;
---

{count > 0 && (
  <section class="rail-sec" id="services-rail" style={`--rail-count:${count}`}>
    <div class="rail-rules" aria-hidden="true">
      <span></span><span></span><span></span><span></span><span></span>
    </div>

    <div class="rail-stick">
      <div class="rail-head">
        <div>
          <p class="rail-eyebrow"><span class="rail-mark" aria-hidden="true"></span><span>[ {eyebrow} ]</span></p>
          <h2 class="rail-title">{title}</h2>
        </div>
        <p class="rail-count" aria-hidden="true">{String(count).padStart(2, '0')} services</p>
      </div>

      <ul class="rail-track">
        {clean.map((card, i) => (
          <li class="rail-card">
            <span class="rail-no">{String(i + 1).padStart(2, '0')}</span>
            <h3 class="rail-card-title">
              {card.heading}{card.headingAccent && <>{' '}<span class="rail-accent">{card.headingAccent}</span></>}
            </h3>
            <p class="rail-card-body">{card.body}</p>
            {card.ctaLabel && card.ctaUrl && (
              <a
                class="rail-go"
                href={safeHref(card.ctaUrl)}
                data-track="service_rail_cta"
                data-loc="service_rail"
              >{card.ctaLabel} <span aria-hidden="true">→</span></a>
            )}
          </li>
        ))}
      </ul>

      <div class="rail-progress" aria-hidden="true"><i></i></div>
    </div>
  </section>
)}

<style>
  /*
     Card geometry lives here as custom properties because three separate things
     are derived from it: how far the row has to travel, how tall the section
     has to be to give it that travel, and how wide a card is. Changing the card
     width in one place keeps all three in step.
  */
  .rail-sec {
    --rail-card-w: 360px;
    --rail-gap: 22px;
    --rail-pad: clamp(1.25rem, 8vw, 8rem);
    --rail-width: calc(
      var(--rail-count) * var(--rail-card-w) + (var(--rail-count) - 1) * var(--rail-gap)
    );
    /* What has to pass the right edge of the screen, never negative. */
    --rail-travel: max(0px, calc(var(--rail-width) + var(--rail-pad) * 2 - 100vw));

    position: relative;
    background: var(--bg-page);
  }

  .rail-rules {
    position: absolute;
    inset: 0;
    display: flex;
    justify-content: space-between;
    padding: 0 8vw;
    pointer-events: none;
    z-index: 0;
  }
  .rail-rules span { width: 1px; background: var(--border-color); }

  .rail-stick {
    position: relative;
    z-index: 1;
    padding: 7.5rem 0 0 var(--rail-pad);
    display: grid;
    grid-template-rows: auto 1fr auto;
    /*
       minmax(0, 1fr), not the default auto.

       On auto the single column sizes itself to the widest thing in it, which
       is the row of cards at 2,652px, and everything else in the grid stretched
       to match: the "07 services" counter was laid out 2,665px to the right,
       a thousand pixels off the side of the screen. The row is meant to
       overflow; nothing else is.
    */
    grid-template-columns: minmax(0, 1fr);
    row-gap: 2rem;
  }

  .rail-head {
    display: flex;
    align-items: flex-end;
    justify-content: space-between;
    gap: 2rem;
    padding-right: var(--rail-pad);
  }

  .rail-eyebrow {
    display: flex;
    align-items: center;
    gap: 10px;
    margin: 0;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--accent-text, var(--accent));
  }
  .rail-mark { width: 8px; height: 8px; background: var(--accent); display: block; }

  .rail-title {
    font-family: 'Bricolage Grotesque Variable', var(--font-heading);
    font-weight: 800;
    font-size: clamp(2.25rem, 6vw, 6rem);
    line-height: 0.94;
    letter-spacing: -0.04em;
    margin: 1.1rem 0 0;
    color: var(--text-primary);
  }

  .rail-count {
    margin: 0;
    font-size: 0.8rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--text-muted);
    white-space: nowrap;
  }

  /*
     The default, and what every phone gets: a real horizontal scroller you
     swipe, with snap points. The sticky, scroll-driven version below replaces
     this only where it is both supported and there is room for it.
  */
  .rail-track {
    list-style: none;
    margin: 0;
    padding: 0 var(--rail-pad) 0 0;
    display: flex;
    gap: var(--rail-gap);
    align-items: flex-start;
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scrollbar-width: thin;
    -webkit-overflow-scrolling: touch;
    /* Centred in its row. Pinned to the top it left a 400px hole underneath,
       which read as the section having failed to finish loading. */
    align-self: center;
    /* The one thing allowed to be wider than the screen. */
    width: max-content;
    max-width: 100%;
  }

  .rail-card {
    flex: 0 0 var(--rail-card-w);
    max-width: 88vw;
    scroll-snap-align: start;
    background: var(--bg-card);
    border: 1px solid var(--border-color);
    border-radius: 16px;
    padding: 28px 26px;
    min-height: 360px;
    display: flex;
    flex-direction: column;
  }

  .rail-no {
    font-family: var(--font-heading);
    font-size: 0.75rem;
    letter-spacing: 0.2em;
    color: var(--accent-text, var(--accent));
  }

  .rail-card-title {
    font-family: var(--font-heading);
    font-size: 1.6rem;
    line-height: 1.15;
    font-weight: 700;
    margin: 1.9rem 0 0.75rem;
    color: var(--text-primary);
  }
  .rail-accent { color: var(--accent-text, var(--accent)); }

  .rail-card-body {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.95rem;
    line-height: 1.55;
  }

  .rail-go {
    margin-top: auto;
    padding-top: 1.5rem;
    font-size: 0.9rem;
    font-weight: 600;
    color: var(--accent-text, var(--accent));
    text-decoration: none;
  }
  .rail-go:hover { text-decoration: underline; }

  .rail-progress {
    position: relative;
    height: 2px;
    /* The right margin clears the floating WhatsApp button, which is fixed to
       the bottom right of every page. */
    margin: 0 max(var(--rail-pad), 7rem) 3.5rem 0;
    background: var(--border-color);
  }
  .rail-progress i {
    position: absolute;
    inset: 0 auto 0 0;
    width: 22%;
    background: var(--accent);
  }

  @media (max-width: 900px) {
    /* 6rem, not 3.5rem. The navbar is about 64px on a phone and 3.5rem is 56,
       so the eyebrow was sitting underneath it. */
    .rail-stick { padding-top: 6rem; row-gap: 1.5rem; }
    .rail-head { flex-direction: column; align-items: flex-start; gap: 0.75rem; }
    .rail-progress { margin-bottom: 2.5rem; }
  }

  /*
     The sideways move.

     Only above 901px, and only where scroll timelines exist. Below that the
     scroller above is the better answer anyway: a phone already has a gesture
     for moving something sideways, and taking the page scroll away from it to
     do the same job is worse, not better.
  */
  @supports (animation-timeline: view()) {
    @media (min-width: 901px) and (prefers-reduced-motion: no-preference) {
      .rail-sec {
        /*
           Tall enough to give the row its travel. 0.85 rather than 1 because a
           pixel of page scroll per pixel of card travel feels like wading; this
           is a little quicker than the cards move.
        */
        height: calc(100vh + var(--rail-travel) * 0.85);
        view-timeline-name: --rail;
        view-timeline-axis: block;
      }

      .rail-stick {
        position: sticky;
        top: 0;
        height: 100vh;
        /*
           clip, NEVER hidden. `overflow: hidden` makes an element a scroll
           container even when nothing scrolls inside it, and that pins every
           animation-timeline underneath it: the cards would simply never move.
        */
        overflow-x: clip;
      }

      .rail-track {
        overflow: visible;
        scroll-snap-type: none;
        max-width: none;
        animation: rail-slide linear both;
        animation-timeline: --rail;
        /*
           `contain` is exactly the stretch where the section covers the whole
           screen, which is exactly the stretch where the frame is stuck. Start
           and finish are therefore pinned to the pinned period, not guessed at.
        */
        animation-range: contain 0% contain 100%;
        will-change: transform;
      }

      @keyframes rail-slide {
        from { transform: translateX(0); }
        to { transform: translateX(calc(var(--rail-travel) * -1)); }
      }

      .rail-progress i {
        animation: rail-progress linear both;
        animation-timeline: --rail;
        animation-range: contain 0% contain 100%;
      }

      @keyframes rail-progress {
        from { transform: translateX(0); }
        to { transform: translateX(calc((100% / 0.22) - 100%)); }
      }
    }
  }
</style>
