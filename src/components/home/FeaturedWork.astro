---
import { buildPayloadImageUrl } from "../../lib/payload";
interface Props {
    fetchedCaseStudies: any[];
}

const { fetchedCaseStudies } = Astro.props;

// Only show explicitly published case studies — default is false so placeholders stay hidden
const publishedStudies = (fetchedCaseStudies ?? []).filter((s: any) => s.published === true);

const projectTypeBadge: Record<string, string> = {
    client: '',
    concept: 'Concept',
    self: 'Internal',
};
---
{publishedStudies.length > 0 && (
<section class="work section-padding" id="work">
    <div class="container">
        <div class="section-header animate-on-scroll slide-up">
            <h2><span class="text-gradient">Featured Work</span></h2>
            <p>A look at what we build, for clients and for ourselves.</p>
        </div>

        <div class="carousel-wrapper">
            <div class="carousel-nav floating hidden-mobile">
                <button class="carousel-btn prev-btn" aria-label="Previous" onclick="document.querySelector('.work-grid').scrollBy({left: -450, behavior: 'smooth'})">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button class="carousel-btn next-btn" aria-label="Next" onclick="document.querySelector('.work-grid').scrollBy({left: 450, behavior: 'smooth'})">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                </button>
            </div>
            <div class="work-grid" role="region" aria-label="Featured work" tabindex="0">
            {publishedStudies.map((study: any, index: number) => {
                const typeBadge = projectTypeBadge[study.projectType ?? 'client'];
                return (
                    <div class={`work-card glow-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`}>
                        <a href={study.slug ? `/projects/${study.slug}/` : '#'} style="display: block; overflow: hidden; border-radius: 12px 12px 0 0; position: relative;">
                            <div class="work-img">
                                {study.coverImage ? (
                                    <img src={buildPayloadImageUrl(study.coverImage)} alt={study.title} loading="lazy" style="width:100%; height:100%; object-fit:cover;" width="800" height="600" />
                                ) : (
                                    <div style="width:100%; height:100%; background: rgba(0,174,239,0.06); display:flex; align-items:center; justify-content:center; color: var(--border-strong); font-size: 2rem;">◻</div>
                                )}
                            </div>
                            {typeBadge && (
                                <span class="project-type-badge">{typeBadge}</span>
                            )}
                        </a>
                        <div class="work-content">
                            <span class="work-tag">{study.tag}</span>
                            <h3 class="work-title">{study.title}</h3>
                            <p class="work-desc">{study.description}</p>
                            {(study.resultMetric || study.resultText) && (
                                <div class="work-result">
                                    <span class="result-metric">{study.resultMetric}</span>
                                    <span class="result-text">{study.resultText}</span>
                                </div>
                            )}
                            <a href={study.slug ? `/projects/${study.slug}/` : '#'} class="work-link">View Project →</a>
                        </div>
                    </div>
                );
            })}
            </div>
        </div>

        <div class="work-cta">
            <a href="/projects/" class="btn btn-ghost btn-pill" style="margin-right: 16px;">View All Projects</a>
            <a href="/contact/" class="btn btn-primary btn-pill glow-effect">Start Your Project</a>
        </div>
    </div>
</section>
)}

<style>
    .project-type-badge {
        position: absolute;
        top: 12px;
        left: 12px;
        background: rgba(0, 0, 0, 0.65);
        border: 1px solid var(--border-strong);
        color: rgba(255, 255, 255, 0.85);
        font-size: 0.7rem;
        font-weight: 600;
        letter-spacing: 0.06em;
        text-transform: uppercase;
        padding: 3px 10px;
        border-radius: 50px;
        backdrop-filter: blur(6px);
    }
</style>
