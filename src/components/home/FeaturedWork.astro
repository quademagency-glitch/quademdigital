---
import StrokeIcon from '../StrokeIcon.astro';
import WorkCard from '../WorkCard.astro';
interface Props { fetchedCaseStudies: any[]; }
const { fetchedCaseStudies } = Astro.props;
const studies = (fetchedCaseStudies || []).filter((s: any) => s.published === true && s.slug)
  .sort((a: any,b: any) => Number(a.projectType !== 'client') - Number(b.projectType !== 'client')).slice(0, 4);
---
{studies.length > 0 && <section class="section-padding studio-selected-work" id="work">
  <div class="container">
    <div class="studio-motion-heading"><h2>See what that looks like<br />in practice.</h2><p>Real project screens, the brief behind them and what I built. Explore the details before deciding who to work with.</p></div>
    <div class="studio-work-stack" data-work-stack>{studies.map((study: any) => <WorkCard study={study} stacked compactOnMobile />)}</div>
    <div class="studio-section-link"><a href="/projects/">Explore all projects <span aria-hidden="true"><StrokeIcon /></span></a></div>
  </div>
</section>}
