---
import StrokeIcon from '../StrokeIcon.astro';
interface Props { faqs: any[]; }
const { faqs = [] } = Astro.props;
const questions = faqs.filter((faq: any) => faq.question && faq.answer);
---
{questions.length > 0 && <section class="section-padding lab-faq" id="faq">
  <div class="container studio-faq-grid">
    <div class="studio-faq-intro">
      <h2>Questions? Answers.</h2>
      <p>Have something else in mind? Tell me about your project and I will help you work it out.</p>
      <a href="/contact/" class="btn btn-ghost btn-pill">Ask Ernest <span aria-hidden="true"><StrokeIcon /></span></a>
    </div>
    <div class="studio-faq-list" data-disclosure-group>{questions.map((faq: any) => <details class="studio-faq-item" data-motion-disclosure>
      <summary>{faq.question}<span class="lab-faq-symbol"><StrokeIcon name="plus" size={18} /></span></summary><div data-disclosure-panel><p>{faq.answer}</p></div>
    </details>)}</div>
  </div>
</section>}
