---
/**
 * VideoPromoSection
 *
 * The words come from `homepage.promoSections` in the CMS. The illustration
 * beside them stays here: it is artwork, not content, and there is nothing in
 * it for an editor to change.
 *
 * The defaults are what the card said before it became editable, so the page
 * still renders if the CMS is unreachable or the array is empty.
 */
import { safeHref } from "../../lib/payload";

interface Props {
    badge?: string;
    heading?: string;
    headingAccent?: string;
    body?: string;
    ctaLabel?: string;
    ctaUrl?: string;
    /** Set when more than one card uses this artwork, to keep the id unique. */
    idSuffix?: string;
}

const {
    badge = "AI Video",
    heading = "Post every week with",
    headingAccent = "AI Video & Reels",
    body = "Short-form video made with AI. No camera, no crew, no shoot day to organise. Reels, ads and product videos built from your logo and your products, from GHS 1,500.",
    ctaLabel = "See AI Video & Reels",
    ctaUrl = "/services/video-production/",
    idSuffix = "",
} = Astro.props;

// The link is typed into the CMS now, so it is not trusted markup.
const href = safeHref(ctaUrl);
---
<section class="video-promo section-padding" id={`video-promo${idSuffix}`}>
    <div class="container">
        <div class="vp-promo-card animate-on-scroll slide-up">
            <div class="vp-promo-bg"></div>
            <div class="vp-promo-content">
                {badge && <div class="badge">{badge}</div>}
                <h2>{heading}{headingAccent && <> <span class="text-gradient">{headingAccent}</span></>}</h2>
                <p>{body}</p>
                {ctaLabel && href && (
                    <a href={href} class="btn btn-primary btn-pill glow-effect mt-4">{ctaLabel} &rarr;</a>
                )}
            </div>
            <div class="vp-promo-visual">
                <div class="play-btn-mock">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor">
                        <polygon points="5 3 19 12 5 21 5 3"></polygon>
                    </svg>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .video-promo {
        padding-top: 40px;
        padding-bottom: 40px;
    }

    .vp-promo-card {
        position: relative;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-md);
    }

    @media (min-width: 992px) {
        .vp-promo-card {
            flex-direction: row;
            align-items: center;
        }
    }

    @media (max-width: 991px) {
        .vp-promo-content {
            text-align: center;
        }

        .vp-promo-content p {
            margin-left: auto;
            margin-right: auto;
        }
    }

    .vp-promo-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at bottom right, rgba(0, 174, 239, 0.15), transparent 50%);
        z-index: 0;
        pointer-events: none;
    }

    .vp-promo-content {
        position: relative;
        z-index: 1;
        padding: 48px;
        flex: 1;
    }

    .vp-promo-content .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--accent-text);
        background: rgba(0, 174, 239, 0.1);
        border: 1px solid rgba(0, 174, 239, 0.2);
        margin-bottom: 20px;
    }

    .vp-promo-content h2 {
        font-size: clamp(28px, 4vw, 40px);
        margin-bottom: 16px;
        line-height: 1.2;
    }

    .vp-promo-content p {
        font-size: 16px;
        color: var(--text-muted);
        max-width: 500px;
        line-height: 1.6;
    }

    .vp-promo-visual {
        position: relative;
        z-index: 1;
        flex: 1;
        /* The card centres its two columns, so a paragraph taller than the
           artwork left this panel floating with page colour above and below it.
           Stretching keeps it full height whatever an editor types. */
        align-self: stretch;
        min-height: 300px;
        background-image: url('/images/service-video.webp');
        background-size: cover;
        background-position: center;
        display: flex;
        align-items: center;
        justify-content: center;
    }

    @media (min-width: 992px) {
        .vp-promo-visual {
            min-height: 400px;
            clip-path: polygon(15% 0, 100% 0, 100% 100%, 0 100%);
        }
    }

    .vp-promo-visual::after {
        content: '';
        position: absolute;
        inset: 0;
        background: rgba(5, 8, 20, 0.5);
    }

    .play-btn-mock {
        position: relative;
        z-index: 2;
        width: 64px;
        height: 64px;
        border-radius: 50%;
        background: rgba(0, 174, 239, 0.8);
        border: 2px solid white;
        display: flex;
        align-items: center;
        justify-content: center;
        color: white;
        box-shadow: 0 10px 30px rgba(0, 0, 0, 0.5);
        animation: pulse 2s infinite;
    }

    .play-btn-mock svg {
        margin-left: 4px;
    }

    @keyframes pulse {
        0% { box-shadow: 0 0 0 0 rgba(0, 174, 239, 0.6); }
        70% { box-shadow: 0 0 0 20px rgba(0, 174, 239, 0); }
        100% { box-shadow: 0 0 0 0 rgba(0, 174, 239, 0); }
    }

    @media (max-width: 768px) {
        .vp-promo-content {
            padding: 28px 20px;
        }

        .vp-promo-visual {
            min-height: 220px;
        }

        .play-btn-mock {
            width: 52px;
            height: 52px;
        }
    }

    @media (max-width: 480px) {
        .vp-promo-content {
            padding: 24px 16px;
        }

        .vp-promo-content h2 {
            font-size: 1.5rem;
        }

        .vp-promo-content p {
            font-size: 14px;
        }

        .vp-promo-visual {
            min-height: 180px;
        }

        .play-btn-mock {
            width: 44px;
            height: 44px;
        }

        .play-btn-mock svg {
            width: 18px;
            height: 18px;
        }
    }
</style>
