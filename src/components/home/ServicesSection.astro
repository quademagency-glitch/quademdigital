---
interface Props {
    fetchedServices: any[];
}

const { fetchedServices } = Astro.props;
---
<section class="services section-padding" id="services">
    <div class="container">
        <div class="section-header animate-on-scroll slide-up">
            <h2><span class="text-gradient">Our Services</span></h2>
            <p>Everything you need to scale your brand digitally, all in one place.</p>
        </div>
        
        <div class="carousel-wrapper">
            <div class="carousel-nav floating hidden-mobile">
                <button class="carousel-btn prev-btn" aria-label="Previous" onclick="document.querySelector('.services-grid').scrollBy({left: -400, behavior: 'smooth'})">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>
                </button>
                <button class="carousel-btn next-btn" aria-label="Next" onclick="document.querySelector('.services-grid').scrollBy({left: 400, behavior: 'smooth'})">
                    <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M9 18l6-6-6-6"/></svg>
                </button>
            </div>
            <div class="services-grid" role="region" aria-label="Our services" tabindex="0">
            {fetchedServices && fetchedServices.length > 0 ? (
                fetchedServices.map((service, index) => {
                    const slug = service.slug?.current || (service.title || '').toLowerCase().replace(/[^a-z0-9]+/g, '-');
                    const localImage = slug.includes('web') ? '/images/service-web-design.png' :
                                     slug.includes('market') || slug.includes('social') ? '/images/service-digital-marketing.png' :
                                     slug.includes('brand') || slug.includes('graphic') ? '/images/service-branding.png' :
                                     slug.includes('video') ? '/images/service-video.png' :
                                     slug.includes('seo') || slug.includes('ads') ? '/images/service-seo.png' : null;
                    const cardHref = slug.includes('video') ? '/services/video-production' : `/services#${slug}`;
                    return (
                    <a href={cardHref} class={`service-card glow-card animate-on-scroll slide-up delay-${(index % 3 + 1) * 100}`} style="text-decoration: none; display: block; color: inherit;">
                        {localImage && (
                            <div class="service-image">
                                <img src={localImage} alt={service.title} loading="lazy" />
                            </div>
                        )}
                        <div class="service-icon" set:html={service.iconSvg || '<svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="12" cy="12" r="10"></circle></svg>'} />
                        <h3 class="service-title">{service.title}</h3>
                        <p class="service-desc">{service.description}</p>
                        {service.tags && service.tags.length > 0 && (
                            <div class="service-tags">
                                {service.tags.map((t: any) => <span>{typeof t === 'string' ? t : t.tag}</span>)}
                            </div>
                        )}
                    </a>
                    );
                })
            ) : (
                <!-- Fallback to static if empty in CMS -->
                <>
                    <a href="/services#web-design-development" class="service-card glow-card animate-on-scroll slide-up delay-100" style="text-decoration: none; display: block; color: inherit;">
                        <div class="service-image">
                            <img src="/images/service-web-design.png" alt="Web Design & Development" loading="lazy" />
                        </div>
                        <div class="service-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 2L2 7l10 5 10-5-10-5zM2 17l10 5 10-5M2 12l10 5 10-5"/></svg>
                        </div>
                        <h3 class="service-title">Web Design & Development</h3>
                        <p class="service-desc">Custom, responsive websites built to convert visitors into loyal customers.</p>
                        <div class="service-tags">
                            <span>Custom Websites</span>
                            <span>Landing Pages</span>
                            <span>E-commerce</span>
                        </div>
                    </a>
                    <a href="/services#digital-marketing-social-media" class="service-card glow-card animate-on-scroll slide-up delay-200" style="text-decoration: none; display: block; color: inherit;">
                        <div class="service-image">
                            <img src="/images/service-digital-marketing.png" alt="Digital Marketing & Social Media" loading="lazy" />
                        </div>
                        <div class="service-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                        </div>
                        <h3 class="service-title">Digital Marketing & Social Media</h3>
                        <p class="service-desc">Engaging content and strategies to grow your audience and brand presence.</p>
                        <div class="service-tags">
                            <span>Strategy</span>
                            <span>Content Calendar</span>
                            <span>Page Management</span>
                        </div>
                    </a>
                    <a href="/services#branding-graphic-design" class="service-card glow-card animate-on-scroll slide-up delay-300" style="text-decoration: none; display: block; color: inherit;">
                        <div class="service-image">
                            <img src="/images/service-branding.png" alt="Branding & Graphic Design" loading="lazy" />
                        </div>
                        <div class="service-icon">
                            <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 19l7-7 3 3-7 7-3-3z"></path><path d="M18 13l-1.5-7.5L2 2l3.5 14.5L13 18l5-5z"></path><path d="M2 2l7.586 7.586"></path><circle cx="11" cy="11" r="2"></circle></svg>
                        </div>
                        <h3 class="service-title">Branding & Graphic Design</h3>
                        <p class="service-desc">Distinct visual identities that make your brand memorable and professional.</p>
                        <div class="service-tags">
                            <span>Logo Design</span>
                            <span>Brand Kit</span>
                            <span>Visual Identity</span>
                        </div>
                    </a>
                </>
            )}
        </div>
        </div>
    </div>
</section>
