---
/**
 * DigitalMarketingPromoSection
 *
 * The words come from `homepage.promoSections` in the CMS. The illustration
 * beside them stays here: it is artwork, not content, and there is nothing in
 * it for an editor to change.
 *
 * The artwork is a planned week with one post drawn out of it, in bars rather
 * than words. Content Calendar is one of the three things this service lists on
 * /services/ , and a calendar is the one social media object that reads at a
 * glance without needing a single legible character in it.
 *
 * The default wording is condensed from the service's own page, which argues
 * that the calendar is the output of knowing the buyer rather than the input.
 * Nothing here claims a result.
 *
 * Colour comes from the brand token through color-mix rather than a hex tint,
 * so the card follows the theme instead of pinning one shade of blue.
 */
import { safeHref } from "../../lib/payload";

interface Props {
    badge?: string;
    heading?: string;
    headingAccent?: string;
    body?: string;
    ctaLabel?: string;
    ctaUrl?: string;
    /** Set when more than one card uses this artwork, to keep the id unique. */
    idSuffix?: string;
}

const {
    badge = "Social Media",
    heading = "Strategy first with",
    headingAccent = "Digital Marketing",
    body = "Most social media work starts with a calendar and works backwards to an audience. I start with who actually buys, and what makes them buy today rather than next month. The calendar comes out of that.",
    ctaLabel = "See Digital Marketing",
    ctaUrl = "/services/digital-marketing-social-media/",
    idSuffix = "",
} = Astro.props;

// The link is typed into the CMS now, so it is not trusted markup.
const href = safeHref(ctaUrl);

/* Seven days, three of them posting days. Three because a week with something
   on every day reads as a content treadmill, which is the opposite of what the
   page argues for. */
const WEEK = [false, true, false, true, false, true, false];
---
<section class="dm-promo section-padding" id={`dm-promo${idSuffix}`}>
    <div class="container">
        <div class="dm-promo-card animate-on-scroll slide-up">
            <div class="dm-promo-bg"></div>
            <div class="dm-promo-content">
                {badge && <div class="badge">{badge}</div>}
                <h2>{heading}{headingAccent && <> <span class="text-gradient">{headingAccent}</span></>}</h2>
                <p>{body}</p>
                {ctaLabel && href && (
                    <a href={href} class="btn btn-primary btn-pill glow-effect mt-4">{ctaLabel} &rarr;</a>
                )}
            </div>
            <div class="dm-promo-visual">
                {/* Decorative only. Screen readers get the heading and paragraph
                    above, which say the same thing in words. */}
                <div class="dm-mockup" aria-hidden="true">
                    <div class="dm-week">
                        {WEEK.map((posting) => (
                            <span class={`dm-day${posting ? ' posting' : ''}`}></span>
                        ))}
                    </div>
                    <div class="dm-post">
                        <div class="dm-post-head">
                            <span class="dm-avatar"></span>
                            <span class="dm-head-bars">
                                <span class="dm-line"></span>
                                <span class="dm-line short"></span>
                            </span>
                        </div>
                        <div class="dm-post-media"></div>
                        <div class="dm-post-actions">
                            <svg class="dm-glyph liked" viewBox="0 0 24 24" fill="currentColor" stroke="none">
                                <path d="M20.8 4.6a5.5 5.5 0 0 0-7.8 0L12 5.7l-1.1-1.1a5.5 5.5 0 0 0-7.8 7.8l1.1 1.1L12 21.2l7.8-7.7 1.1-1.1a5.5 5.5 0 0 0 0-7.8z"></path>
                            </svg>
                            <span class="dm-count"></span>
                            <svg class="dm-glyph" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M21 11.5a8.4 8.4 0 0 1-9 8.5 8.9 8.9 0 0 1-3.8-.9L3 21l1.9-5.1A8.4 8.4 0 0 1 12 3a8.4 8.4 0 0 1 9 8.5z"></path>
                            </svg>
                            <span class="dm-count short"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</section>

<style>
    .dm-promo {
        padding-top: 40px;
        padding-bottom: 40px;
    }

    /* One named tint scale, mixed from the brand token, so every accent in this
       card moves together and none of them is a literal. */
    .dm-promo-card {
        --dm-wash: color-mix(in srgb, var(--accent) 12%, transparent);
        --dm-edge: color-mix(in srgb, var(--accent) 30%, transparent);
        --dm-fill: color-mix(in srgb, var(--accent) 16%, transparent);
        --dm-ink: color-mix(in srgb, var(--accent) 55%, transparent);

        position: relative;
        background: var(--bg-surface);
        border: 1px solid var(--border-color);
        border-radius: var(--radius-lg);
        overflow: hidden;
        display: flex;
        flex-direction: column;
        box-shadow: var(--shadow-md);
        transition: all 0.3s ease;
    }

    .dm-promo-card:hover {
        border-color: var(--dm-edge);
        box-shadow: var(--shadow-lg);
    }

    @media (min-width: 992px) {
        .dm-promo-card {
            flex-direction: row;
            align-items: center;
        }
    }

    @media (max-width: 991px) {
        .dm-promo-content {
            text-align: center;
        }

        .dm-promo-content p {
            margin-left: auto;
            margin-right: auto;
        }
    }

    .dm-promo-bg {
        position: absolute;
        inset: 0;
        background: radial-gradient(circle at top left, var(--dm-wash), transparent 60%);
        z-index: 0;
        pointer-events: none;
    }

    .dm-promo-content {
        position: relative;
        z-index: 1;
        padding: 48px;
        flex: 1;
    }

    .dm-promo-content .badge {
        display: inline-block;
        padding: 4px 12px;
        border-radius: 50px;
        font-size: 12px;
        font-weight: 600;
        text-transform: uppercase;
        letter-spacing: 1px;
        color: var(--accent-text);
        background: color-mix(in srgb, var(--accent) 10%, transparent);
        border: 1px solid color-mix(in srgb, var(--accent) 20%, transparent);
        margin-bottom: 20px;
    }

    .dm-promo-content h2 {
        font-size: clamp(28px, 4vw, 40px);
        margin-bottom: 16px;
        line-height: 1.2;
    }

    .dm-promo-content p {
        font-size: 16px;
        color: var(--text-muted);
        max-width: 500px;
        line-height: 1.6;
    }

    .dm-promo-visual {
        position: relative;
        z-index: 1;
        flex: 1;
        /* The card centres its two columns, so a long paragraph on the left
           leaves the artwork floating with page colour under it. Stretching
           keeps the panel full height whatever an editor types. */
        align-self: stretch;
        min-height: 300px;
        background: linear-gradient(135deg, var(--bg-surface) 0%, var(--bg-card) 100%);
        display: flex;
        align-items: center;
        justify-content: center;
        padding: 32px;
    }

    @media (min-width: 992px) {
        .dm-promo-visual {
            min-height: 400px;
            clip-path: polygon(10% 0, 100% 0, 100% 100%, 0 100%);
        }
    }

    /* Abstract calendar and post mockup */
    .dm-mockup {
        width: 100%;
        max-width: 320px;
        background: var(--bg-card);
        border-radius: 8px;
        border: 1px solid var(--border-color);
        overflow: hidden;
        box-shadow: var(--shadow-lg);
        transform: perspective(800px) rotateY(-10deg) rotateX(5deg);
        transition: transform 0.5s ease;
    }

    .dm-promo-card:hover .dm-mockup {
        transform: perspective(800px) rotateY(-5deg) rotateX(2deg) translateY(-5px);
    }

    .dm-week {
        display: grid;
        grid-template-columns: repeat(7, 1fr);
        gap: 5px;
        padding: 12px;
        background: var(--bg-page);
        border-bottom: 1px solid var(--bg-hover);
    }

    .dm-day {
        height: 20px;
        border-radius: 3px;
        background: var(--bg-inset);
        border: 1px solid var(--border-color);
    }

    /* The days something goes out. */
    .dm-day.posting {
        background: var(--dm-fill);
        border-color: var(--dm-edge);
    }

    .dm-post {
        padding: 14px;
        display: flex;
        flex-direction: column;
        gap: 10px;
    }

    .dm-post-head {
        display: flex;
        align-items: center;
        gap: 10px;
    }

    .dm-avatar {
        flex: none;
        width: 22px;
        height: 22px;
        border-radius: 50%;
        background: var(--dm-ink);
    }

    /* A width, not a max-width. The bars inside are `width: 100%` of a box with
       no content of its own, so a shrink-to-fit parent collapses them. */
    .dm-head-bars {
        width: 60%;
        display: flex;
        flex-direction: column;
        gap: 5px;
    }

    .dm-line {
        display: block;
        height: 5px;
        border-radius: 3px;
        background: var(--border-strong);
        width: 100%;
    }

    .dm-line.short {
        width: 55%;
    }

    .dm-post-media {
        height: 84px;
        border-radius: 5px;
        background: var(--dm-fill);
        border: 1px solid var(--dm-edge);
    }

    .dm-post-actions {
        display: flex;
        align-items: center;
        gap: 8px;
    }

    .dm-glyph {
        flex: none;
        width: 14px;
        height: 14px;
        color: var(--text-subtle);
    }

    .dm-glyph.liked {
        color: var(--accent-text);
    }

    .dm-count {
        width: 30px;
        height: 5px;
        border-radius: 3px;
        background: var(--border-strong);
    }

    .dm-count.short {
        width: 20px;
    }

    @media (prefers-reduced-motion: reduce) {
        .dm-mockup,
        .dm-promo-card:hover .dm-mockup {
            transition: none;
        }
    }

    @media (max-width: 768px) {
        .dm-promo-content {
            padding: 28px 20px;
        }

        .dm-promo-visual {
            min-height: 220px;
            padding: 24px;
        }

        .dm-mockup {
            max-width: 280px;
            transform: perspective(800px) rotateY(-5deg) rotateX(3deg);
        }
    }

    @media (max-width: 480px) {
        .dm-promo-content {
            padding: 24px 16px;
        }

        .dm-promo-content h2 {
            font-size: 1.5rem;
        }

        .dm-promo-content p {
            font-size: 14px;
        }

        .dm-promo-visual {
            min-height: 180px;
            padding: 20px;
        }

        .dm-mockup {
            max-width: 240px;
            transform: none;
        }
    }
</style>
