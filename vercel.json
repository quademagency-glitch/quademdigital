    {
      "source": "/(.*)",
      "has": [
        {
          "type": "host",
          "value": "www.quademdigital.com"
        }
      ],
      "destination": "https://quademdigital.com/$1",
      "permanent": true
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; base-uri 'self'; object-src 'none'; frame-ancestors 'self'; script-src 'self' 'unsafe-inline' https://analytics.ahrefs.com https://www.googletagmanager.com https://assets.calendly.com https://embed.tawk.to https://tracker.metricool.com https://cdn.jsdelivr.net https://js.paystack.co; style-src 'self' 'unsafe-inline' https://cdn.jsdelivr.net https://assets.calendly.com; img-src 'self' data: https:; font-src 'self' data:; connect-src 'self' https://cms.quademdigital.com https://www.googletagmanager.com https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://stats.g.doubleclick.net https://www.google.com https://analytics.ahrefs.com https://embed.tawk.to https://*.tawk.to wss://*.tawk.to https://api.paystack.co; frame-src https://calendly.com https://embed.tawk.to https://www.youtube.com https://player.vimeo.com https://js.paystack.co; form-action 'self'"
        }
      ]
    }
